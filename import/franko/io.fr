// franko/io — input.
//
// Input fills a caller-provided buffer (arrays cannot be returned
// directly) and reports how much arrived. Both functions go through
// the same OS bridge `print` writes with: os::posix::read on
// linux/macos, os::win32::ReadFile on windows, so input shares a
// channel with raw fd reads.

// Read up to `count` bytes from stdin into `buf`; return the number of
// bytes read, 0 at end of input, or -1 on error (a null `buf`, or
// `count` larger than the buffer). A short result is normal: the
// return value may be smaller than `count` even before end of input.
//
// On Windows, reading a stdin pipe whose writer has closed makes
// ReadFile report failure (ERROR_BROKEN_PIPE) with zero bytes instead
// of succeeding with 0 bytes as POSIX read does. The os::win32 bridge
// stays a thin ReadFile wrapper, so that end-of-input normalization
// lives here.
func read_bytes(mview<[byte]> buf, uint32 count) -> int64 {
    if (buf == null) {
        return -1
    }
    if ($(buf).length() < count) {
        return -1
    }
    if (os::IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_INPUT_HANDLE)
        // GetStdHandle returns NULL or INVALID_HANDLE_VALUE on failure.
        if (h == 0 || h == 0xFFFFFFFFFFFFFFFF) {
            return -1
        }
        uint32 n = 0
        int32 ok = os::win32::ReadFile(h, buf, count, getmview(n))
        if (ok == 0 && n == 0) {
            // A failed read that delivered no bytes: on Windows a closed
            // stdin pipe is reported this way (ERROR_BROKEN_PIPE) rather
            // than as a successful zero-byte read, so treat it as EOF.
            return 0
        }
        return cast<int64>(n)
    } else if (os::IS_LINUX || os::IS_MACOS) {
        return os::posix::read(os::posix::STDIN_FILENO, buf, cast<uint64>(count))
    }
    return -1
}

// Read one line from stdin into `buf`, at most `max` bytes. Reading
// stops at a `\n` (consumed and not stored; a preceding `\r` is
// dropped too, so `\r\n` counts as one terminator), at `max` bytes, or
// at end of input. Returns the number of bytes stored, or -1 on error
// (a null `buf`, `max` zero, or `max` larger than the buffer).
// A line longer than `max` is split: the remainder, including its line
// ending, stays in stdin for the next call. A zero return means an
// empty line or end of input with nothing pending.
func read_line(mview<[byte]> buf, uint32 max) -> int64 {
    if (buf == null) {
        return -1
    }
    if (max == 0) {
        return -1
    }
    if ($(buf).length() < max) {
        return -1
    }
    [byte, 1] one
    uint32 n = 0
    while (n < max) {
        int64 r = read_bytes(getmview(one), 1)
        if (r < 0) {
            return -1
        }
        if (r == 0) {
            break
        }
        byte b = one[0]
        if (b == 10) {
            if (n != 0) {
                if ($(buf)[n - 1] == 13) {
                    n = n - 1
                }
            }
            break
        }
        $(buf)[n] = b
        n = n + 1
    }
    return cast<int64>(n)
}
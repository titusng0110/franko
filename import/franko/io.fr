func print(int8 num) -> void {
    int64 w = cast<int64>(num)
    if (w < 0) {
        [byte, 20] krev
        uint32 klen = 0
        int64 kn = w
        while (kn != 0) {
            int64 kr = kn % 10
            int64 kd = 0 - kr
            krev[klen] = unsafe_cast<byte>(kd + 48)
            klen = klen + 1
            kn = kn / 10
        }
        [byte, 22] kout
        kout[0] = 45
        uint32 kj = 0
        while (kj < klen) {
            kout[kj + 1] = krev[klen - 1 - kj]
            kj = kj + 1
        }
        kout[klen + 1] = 10
        uint32 ktotal = klen + 2
        if (os::IS_WINDOWS) {
            uint64 kh = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
            os::win32::WriteFile(kh, getptr(kout), ktotal, null)
        } else if (os::IS_LINUX || os::IS_MACOS) {
            os::posix::write(os::posix::STDOUT_FILENO, getptr(kout), cast<uint64>(ktotal))
        }
        return
    }
    [byte, 20] rev
    uint32 len = 0
    uint64 v = unsafe_cast<uint64>(w)
    if (v == 0) {
        rev[0] = 48
        len = 1
    } else {
        uint64 n = v
        while (n != 0) {
            uint64 d = n % 10
            rev[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
            n = n / 10
        }
    }
    [byte, 22] out
    uint32 j = 0
    while (j < len) {
        out[j] = rev[len - 1 - j]
        j = j + 1
    }
    out[len] = 10
    uint32 total = len + 1
    if (os::IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, getptr(out), total, null)
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(total))
    }
}


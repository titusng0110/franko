    int64 w = cast<int64>(num)
    if (w < 0) {
        [byte, 20] krev
        uint32 klen = 0
        int64 kn = w
        while (kn != 0) {
            int64 kr = kn % 10
            int64 kd = 0 - kr
            krev[klen] = unsafe_cast<byte>(kd + 48)
            klen = klen + 1
            kn = kn / 10
        }
        [byte, 21] kout
        kout[0] = 45
        uint32 kj = 0
        while (kj < klen) {
            kout[kj + 1] = krev[klen - 1 - kj]
            kj = kj + 1
        }
        uint32 ktotal = klen + 1
        if (os::IS_WINDOWS) {
            uint64 kh = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
            os::win32::WriteFile(kh, getptr(kout), ktotal, null)
            if (end != null) {
                uint32 km = $(end).length()
                if (km != 0) {
                    os::win32::WriteFile(kh, end, km, null)
                }
            }
        } else if (os::IS_LINUX || os::IS_MACOS) {
            os::posix::write(os::posix::STDOUT_FILENO, getptr(kout), cast<uint64>(ktotal))
            if (end != null) {
                uint32 km = $(end).length()
                if (km != 0) {
                    os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(km))
                }
            }
        }
        return
    }
    [byte, 20] rev
    uint32 len = 0
    uint64 v = unsafe_cast<uint64>(w)
    if (v == 0) {
        rev[0] = 48
        len = 1
    } else {
        uint64 n = v
        while (n != 0) {
            uint64 d = n % 10
            rev[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
            n = n / 10
        }

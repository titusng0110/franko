        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::win32::WriteFile(h, end, m, null)
            }
        }
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(len))
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(m))
            }
        }
    }
}


// franko/io — input.
//
// Input fills a caller-provided buffer (arrays cannot be returned
// directly) and reports how much arrived. Both functions go through
// the same OS bridge `print` writes with: os::posix::read on
// linux/macos, os::win32::ReadFile on windows, so input shares a
// channel with raw fd reads.

// Fill the shared stdin buffer when it is empty. Returns 1 when bytes
// are available, 0 at end of input, and -1 on error.
func __io_fill() -> int32 {
    if (__io_input_pos < __io_input_len) {
        return 1
    }
    __io_input_pos = 0
    __io_input_len = 0
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_INPUT_HANDLE)
        // GetStdHandle returns NULL or INVALID_HANDLE_VALUE on failure.
        if (h == 0 || h == 0xFFFFFFFFFFFFFFFF) {
            return -1
        }
        uint32 n = 0
        int32 ok = os::win32::ReadFile(h, getmview(__io_input), 8192, getmview(n))
        if (ok == 0 && n == 0) {
            // A failed read that delivered no bytes: on Windows a closed
            // stdin pipe is reported this way (ERROR_BROKEN_PIPE) rather
            // than as a successful zero-byte read, so treat it as EOF.
            return 0
        }
        __io_input_len = n
        return 1
    } #else #if (#IS_LINUX || #IS_MACOS) {
        int64 n = os::posix::read(os::posix::STDIN_FILENO, getmview(__io_input), 8192)
        if (n < 0) {
            return -1
        }
        if (n == 0) {
            return 0
        }
        __io_input_len = unsafe_cast<uint32>(n)
        return 1
    }
    return -1
}

// Read up to `count` bytes from stdin into `buf`, looping over the
// shared 8192-byte input buffer until `count` bytes have been stored,
// end of input is reached, or a read error occurs. Returns (val, err),
// where val is the number of bytes stored and err is 0 on success or
// -1 on error (a null `buf`, or `count` larger than the buffer). A val
// smaller than `count` means end of input, or an error with the bytes
// stored before it in val.
//
// Reads are serviced from the shared stdin buffer first; the OS is read
// in 8192-byte chunks and excess bytes stay buffered for the next call.
// A request larger than 8192 bytes is filled from as many chunks as
// needed.
//
// On Windows, reading a stdin pipe whose writer has closed makes
// ReadFile report failure (ERROR_BROKEN_PIPE) with zero bytes instead
// of succeeding with 0 bytes as POSIX read does. The os::win32 bridge
// stays a thin ReadFile wrapper, so that end-of-input normalization
// lives here.
func read_bytes(mview<[byte]> buf, const uint32 count) -> (uint32 val, int32 err) {
    (uint32 val, int32 err) result
    result.val = 0
    result.err = -1
    if (buf == null) {
        return result
    }
    if ($(buf).length() < count) {
        return result
    }
    if (count == 0) {
        result.err = 0
        return result
    }
    uint32 copied = 0
    while (copied < count) {
        if (__io_input_pos == __io_input_len) {
            int32 fill = __io_fill()
            if (fill < 0) {
                result.val = copied
                result.err = -1
                return result
            }
            if (fill == 0) {
                break
            }
            if (__io_input_len == 0) {
                break
            }
        }
        uint32 available = __io_input_len - __io_input_pos
        uint32 take = count - copied
        if (take > available) {
            take = available
        }
        $(buf).memcpy(getview(__io_input), copied, __io_input_pos, take)
        copied = copied + take
        __io_input_pos = __io_input_pos + take
        if (__io_input_pos == __io_input_len) {
            __io_input_pos = 0
            __io_input_len = 0
        }
    }
    result.val = copied
    result.err = 0
    return result
}

// Read one line from stdin into `out`. Reading stops at `\n`, `\r\n`,
// or end of input. The line ending is consumed but not stored. The
// local line buffer is initialized to the exact size of the first
// chunk; when a line does not fit, it doubles up to 81920 bytes. A
// longer line is consumed through its line ending and
// reported as -2, which means "line too long" rather than a memory or
// read error. Returns 0 on success, -1 for a null `out`, a read error,
// or an allocation failure, and -2 for an over-long line. An empty
// string means an empty line or end of input with nothing pending.
func read_line(ptr<std::String> out) -> int32 {
    if (out == null) {
        return -1
    }
    view<[byte]> empty = null
    if ($(out).from(empty) != 0) {
        return -1
    }
    __IoLineBuffer line
    uint32 cap = 0
    uint32 len = 0
    uint8 too_long = 0
    while (1) {
        if (__io_input_pos == __io_input_len) {
            int32 fill = __io_fill()
            if (fill < 0) {
                if (cap != 0) {
                    line.data.uninit()
                }
                return -1
            }
            if (fill == 0) {
                break
            }
        }
        uint32 available = __io_input_len - __io_input_pos
        uint32 nl = __io_input.memchr(10, __io_input_pos, available)
        uint32 take = available
        uint32 advance = available
        uint8 found = 0
        uint8 strip_cr = 0
        if (nl != 0xFFFFFFFF) {
            take = nl - __io_input_pos
            advance = take
            found = 1
            if (take != 0) {
                // Drop the CR of a CRLF ending before the size check so
                // it does not count as line content.
                if (__io_input[__io_input_pos + take - 1] == 13) {
                    take = take - 1
                }
            } else {
                // The LF follows bytes from a previous chunk: a trailing
                // CR there is the CR of a split CRLF.
                strip_cr = 1
            }
        }
        if (too_long == 0 && take != 0) {
            uint32 needed = len + take
            if (needed > 81920) {
                too_long = 1
            } else {
                if (cap == 0) {
                    int32 st = line.data.init(needed)
                    if (st != 0) {
                        return -1
                    }
                    cap = needed
                } else {
                    while (cap < needed) {
                        uint32 next_cap = cap * 2
                        if (next_cap < needed) {
                            next_cap = needed
                        }
                        if (next_cap > 81920) {
                            next_cap = 81920
                        }
                        int32 st = line.data.resize(next_cap)
                        if (st != 0) {
                            line.data.uninit()
                            return -1
                        }
                        cap = next_cap
                    }
                }
                line.data.memcpy(getview(__io_input), len, __io_input_pos, take)
                len = needed
            }
        }
        __io_input_pos = __io_input_pos + advance
        if (found != 0) {
            __io_input_pos = __io_input_pos + 1
            if (__io_input_pos == __io_input_len) {
                __io_input_pos = 0
                __io_input_len = 0
            }
            if (too_long == 0 && strip_cr != 0 && len != 0) {
                if (line.data[len - 1] == 13) {
                    len = len - 1
                }
            }
            break
        }
        if (__io_input_pos == __io_input_len) {
            __io_input_pos = 0
            __io_input_len = 0
        }
    }
    if (too_long != 0) {
        if (cap != 0) {
            line.data.uninit()
        }
        return -2
    }
    if (len == 0) {
        if (cap != 0) {
            line.data.uninit()
        }
        return 0
    }
    if (len != cap) {
        int32 st = line.data.resize(len)
        if (st != 0) {
            line.data.uninit()
            return -1
        }
    }
    int32 st = $(out).from(getview(line.data))
    line.data.uninit()
    if (st != 0) {
        return -1
    }
    return 0
}

import "./os"
import "./string"

// Shared stdin buffer. Bytes read ahead by read_bytes/read_line stay
// here until the next call consumes them.
[byte, 8192] __io_input
uint32 __io_input_pos = 0
uint32 __io_input_len = 0

// Internal line accumulator. The dynamic array lives in a struct so the
// local-array lifecycle checker does not track it. read_line initializes
// it to the exact size of the first chunk and doubles it up to the
// 81920-byte line limit.
struct __IoLineBuffer {
    [byte] data
}

// franko/io — user-level output and input.
//
// `print` is an ordinary overloaded function (not a statement).
// Single-argument `print(x)` writes `x` followed by `\n` in a single
// write. Two-argument `print(x, end)` writes `x` followed by `end`
// verbatim (a null or empty `end` means no suffix, so no newline
// either). `print()` writes a bare newline. `print(str)` writes the
// UTF-8 bytes verbatim followed by `\n`; a null or empty view prints
// nothing. The `std::String` overloads write only the live bytes, not
// the backing buffer's unused capacity.
//
// Output goes through the OS bridge (posix `write` on linux/macos,
// `WriteFile` on windows), so it shares a channel with raw fd writes.
//
// Each overload is self-contained: integer digits are converted with
// repeated `% 10` / `/ 10` (negatives stay negative throughout so
// `INT64_MIN` needs no overflow-prone negation) and emitted with the
// suffix in as few writes as possible.
//
// Input: `read_bytes` reads into a caller-provided buffer and reports
// how much arrived; `read_line` reads one line into a `std::String`
// using an internal growable buffer. See their comments below.

func print() -> void {
    [byte, 1] nl
    nl[0] = 10
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, getptr(nl), 1, null)
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(nl), 1)
    }
}

func print(uint8 num) -> void {
    uint64 v = cast<uint64>(num)
    [byte, 20] rev
    uint32 len = 0
    if (v == 0) {
        rev[0] = 48
        len = 1
    } else {
        for (uint64 n = v; n != 0; n = n / 10) {
            uint64 d = n % 10
            rev[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
        }
    }
    [byte, 22] out
    for (uint32 j = 0; j < len; j++) {
        out[j] = rev[len - 1 - j]
    }
    out[len] = 10
    uint32 total = len + 1
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, getptr(out), total, null)
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(total))
    }
}


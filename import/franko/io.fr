import "./os"
import "./string"

// Shared stdin buffer. Bytes read ahead by read_bytes/read_line stay
// here until the next call consumes them.
[byte, 8192] __io_input
uint32 __io_input_pos = 0
uint32 __io_input_len = 0

// Internal line accumulator. The dynamic array lives in a struct so the
// local-array lifecycle checker does not track it. read_line initializes
// it to the exact size of the first chunk and doubles it up to the
// 81920-byte line limit.
struct __IoLineBuffer {
    [byte] data
}

// Internal write helpers. Formatting happens in the print/print_err
// functions; these only flush a byte view to a standard stream.
func __io_write_stdout(const view<[byte]> payload, const uint32 count) -> void {
    if (payload == null || count == 0) {
        return
    }
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, payload, count, null)
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, payload, cast<uint64>(count))
    }
}

func __io_write_stderr(const view<[byte]> payload, const uint32 count) -> void {
    if (payload == null || count == 0) {
        return
    }
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_ERROR_HANDLE)
        os::win32::WriteFile(h, payload, count, null)
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDERR_FILENO, payload, cast<uint64>(count))
    }
}

// franko/io — user-level output and input.
//
// `print` is an ordinary overloaded function (not a statement).
// Single-argument `print(x)` writes `x` followed by `\n`. Two-argument
// `print(x, end)` writes `x` followed by `end` verbatim (a null or
// empty `end` means no suffix, so no newline either). `print()`
// writes a bare newline. `print(str)` writes the UTF-8 bytes verbatim
// followed by `\n`; a null or empty view prints nothing. The
// `std::String` overloads write only the live bytes, not the backing
// buffer's unused capacity.
//
// `print_err` mirrors every `print` overload on stderr.
//
// Integer printing formats into a 25-byte stack buffer. The longest
// integer is 20 digits (plus a possible sign), so the separator is
// appended into the spare bytes when it fits and the whole line goes
// out in one write; a longer separator is emitted in a second write.
// Text and `std::String` printing write the payload and suffix
// separately.
//
// Output goes through the OS bridge (posix `write` on linux/macos,
// `WriteFile` on windows), so it shares a channel with raw fd writes.
//
// Input: `read_bytes` reads into a caller-provided buffer and reports
// how much arrived; `read_line` reads one line into a `std::String`
// using an internal growable buffer. See their comments below.

func print() -> void {
    __io_write_stdout([10], 1)
}

func print_err() -> void {
    __io_write_stderr([10], 1)
}

// ------------------------------------------------------------
// print: unsigned integers
// ------------------------------------------------------------

func print(const uint64 num, const view<[uint8]> end) -> void {
    [byte, 25] out
    uint32 len = 0
    if (num == 0) {
        out[0] = 48
        len = 1
    } else {
        for (uint64 n = num; n != 0; n = n / 10) {
            uint64 d = n % 10
            out[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
        }
    }
    uint32 a = 0
    uint32 b = len - 1
    while (a < b) {
        byte tmp = out[a]
        out[a] = out[b]
        out[b] = tmp
        a = a + 1
        b = b - 1
    }
    uint32 total = len
    uint32 m = 0
    if (end != null) {
        m = $(end).length()
        if (m != 0 && m <= 25 - len) {
            out.memcpy(end, len, 0, m)
            total = len + m
            m = 0
        }
    }
    __io_write_stdout(getview(out), total)
    if (m != 0) {
        __io_write_stdout(end, m)
    }
}

func print(const uint8 num, const view<[uint8]> end) -> void {
    print(cast<uint64>(num), end)
}

func print(const uint16 num, const view<[uint8]> end) -> void {
    print(cast<uint64>(num), end)
}

func print(const uint32 num, const view<[uint8]> end) -> void {
    print(cast<uint64>(num), end)
}

func print(const uint64 num) -> void {
    print(num, [10])
}

func print(const uint8 num) -> void {
    print(cast<uint64>(num))
}

func print(const uint16 num) -> void {
    print(cast<uint64>(num))
}

func print(const uint32 num) -> void {
    print(cast<uint64>(num))
}

// ------------------------------------------------------------
// print: signed integers
// ------------------------------------------------------------

func print(const int64 num, const view<[uint8]> end) -> void {
    if (num >= 0) {
        print(unsafe_cast<uint64>(num), end)
        return
    }
    [byte, 25] out
    uint32 len = 0
    for (int64 n = num; n != 0; n = n / 10) {
        int64 r = n % 10
        int64 d = 0 - r
        out[len] = unsafe_cast<byte>(d + 48)
        len = len + 1
    }
    out[len] = 45
    len = len + 1
    uint32 a = 0
    uint32 b = len - 1
    while (a < b) {
        byte tmp = out[a]
        out[a] = out[b]
        out[b] = tmp
        a = a + 1
        b = b - 1
    }
    uint32 total = len
    uint32 m = 0
    if (end != null) {
        m = $(end).length()
        if (m != 0 && m <= 25 - len) {
            out.memcpy(end, len, 0, m)
            total = len + m
            m = 0
        }
    }
    __io_write_stdout(getview(out), total)
    if (m != 0) {
        __io_write_stdout(end, m)
    }
}

func print(const int8 num, const view<[uint8]> end) -> void {
    print(cast<int64>(num), end)
}

func print(const int16 num, const view<[uint8]> end) -> void {
    print(cast<int64>(num), end)
}

func print(const int32 num, const view<[uint8]> end) -> void {
    print(cast<int64>(num), end)
}

func print(const int64 num) -> void {
    print(num, [10])
}

func print(const int8 num) -> void {
    print(cast<int64>(num))
}

func print(const int16 num) -> void {
    print(cast<int64>(num))
}

func print(const int32 num) -> void {
    print(cast<int64>(num))
}

// ------------------------------------------------------------
// print: text and std::String
// ------------------------------------------------------------

func print(const view<[uint8]> utf8str) -> void {
    if (utf8str == null) {
        return
    }
    if ($(utf8str).length() == 0) {
        return
    }
    print(utf8str, [10])
}

func print(const view<[uint8]> utf8str, const view<[uint8]> end) -> void {
    if (utf8str != null) {
        uint32 n = $(utf8str).length()
        if (n != 0) {
            __io_write_stdout(utf8str, n)
        }
    }
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0) {
            __io_write_stdout(end, m)
        }
    }
}

func print(const view<std::String> str) -> void {
    if (str == null) {
        return
    }
    if ($(str).length() == 0) {
        return
    }
    print(str, [10])
    return
}

func print(const view<std::String> str, const view<std::String> end) -> void {
    [byte] endbuf
    view<[uint8]> endbytes = null
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0 && $(end).to(getptr(endbuf)) == 0) {
            endbytes = getview(endbuf)
        }
    }
    print(str, endbytes)
    if (endbuf.length() != 0) {
        endbuf.uninit()
    }
    return
}

func print(const view<std::String> str, const view<[byte]> end) -> void {
    if (str != null) {
        uint32 n = $(str).length()
        if (n != 0) {
            [byte] buf
            if ($(str).to(getptr(buf)) == 0) {
                print(getview(buf), end)
            }
            if (buf.length() != 0) {
                buf.uninit()
            }
            return
        }
    }
    view<[uint8]> empty = null
    print(empty, end)
    return
}


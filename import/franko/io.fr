func print(view<[uint8]> utf8str) -> void {
    if (utf8str == null) {
        return
    }
    uint32 n = $(utf8str).length()
    if (n == 0) {
        return
    }
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, utf8str, n, null)
        [byte, 1] nl
        nl[0] = 10
        os::win32::WriteFile(h, getptr(nl), 1, null)
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, utf8str, cast<uint64>(n))
        [byte, 1] nl
        nl[0] = 10
        os::posix::write(os::posix::STDOUT_FILENO, getptr(nl), 1)
    }
}

func print(view<[uint8]> utf8str, view<[uint8]> end) -> void {
    if (utf8str != null) {
        uint32 n = $(utf8str).length()
        if (n != 0) {
            #if (#IS_WINDOWS) {
                uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
                os::win32::WriteFile(h, utf8str, n, null)
            } #else #if (#IS_LINUX || #IS_MACOS) {
                os::posix::write(os::posix::STDOUT_FILENO, utf8str, cast<uint64>(n))
            }
        }
    }
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0) {
            #if (#IS_WINDOWS) {
                uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
                os::win32::WriteFile(h, end, m, null)
            } #else #if (#IS_LINUX || #IS_MACOS) {
                os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(m))
            }
        }
    }
}

func print(view<std::String> str) -> void {
    if (str == null) {
        return
    }
    if ($(str).length() == 0) {
        return
    }
    [byte, 1] nl
    nl[0] = 10
    print(str, getview(nl))
    return
}

func print(view<std::String> str, view<std::String> end) -> void {
    [byte] endbuf
    view<[uint8]> endbytes = null
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0 && $(end).to(getptr(endbuf)) == 0) {
            endbytes = getview(endbuf)
        }
    }
    print(str, endbytes)
    if (endbuf.length() != 0) {
        endbuf.uninit()
    }
    return
}

func print(view<std::String> str, view<[byte]> end) -> void {
    if (str != null) {
        uint32 n = $(str).length()
        if (n != 0) {
            [byte] buf
            if ($(str).to(getptr(buf)) == 0) {
                print(getview(buf), end)
            }
            if (buf.length() != 0) {
                buf.uninit()
            }
            return
        }
    }
    view<[uint8]> empty = null
    print(empty, end)
    return
}

func print(uint8 num, view<[uint8]> end) -> void {
    uint64 v = cast<uint64>(num)
    [byte, 20] rev
    uint32 len = 0
    if (v == 0) {
        rev[0] = 48
        len = 1
    } else {
        for (uint64 n = v; n != 0; n = n / 10) {
            uint64 d = n % 10
            rev[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
        }
    }
    [byte, 20] out
    for (uint32 j = 0; j < len; j++) {
        out[j] = rev[len - 1 - j]
    }
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, getptr(out), len, null)
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::win32::WriteFile(h, end, m, null)
            }
        }
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(len))
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(m))
            }
        }
    }
}


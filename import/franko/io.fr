        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::win32::WriteFile(h, end, m, null)
            }
        }
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(len))
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(m))
            }
        }
    }
}

func print(int16 num, view<[uint8]> end) -> void {
    int64 w = cast<int64>(num)
    if (w < 0) {
        [byte, 20] krev
        uint32 klen = 0
        for (int64 kn = w; kn != 0; kn = kn / 10) {
            int64 kr = kn % 10
            int64 kd = 0 - kr
            krev[klen] = unsafe_cast<byte>(kd + 48)
            klen = klen + 1
        }
        [byte, 21] kout
        kout[0] = 45
        for (uint32 kj = 0; kj < klen; kj++) {
            kout[kj + 1] = krev[klen - 1 - kj]
        }
        uint32 ktotal = klen + 1
        #if (#IS_WINDOWS) {
            uint64 kh = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
            os::win32::WriteFile(kh, getptr(kout), ktotal, null)
            if (end != null) {
                uint32 km = $(end).length()
                if (km != 0) {
                    os::win32::WriteFile(kh, end, km, null)
                }
            }
        } #else #if (#IS_LINUX || #IS_MACOS) {
            os::posix::write(os::posix::STDOUT_FILENO, getptr(kout), cast<uint64>(ktotal))
            if (end != null) {
                uint32 km = $(end).length()
                if (km != 0) {
                    os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(km))
                }
            }
        }
        return
    }
    [byte, 20] rev
    uint32 len = 0
    uint64 v = unsafe_cast<uint64>(w)
    if (v == 0) {
        rev[0] = 48
        len = 1
    } else {
        for (uint64 n = v; n != 0; n = n / 10) {
            uint64 d = n % 10
            rev[len] = unsafe_cast<byte>(d + 48)
            len = len + 1
        }
    }
    [byte, 20] out
    for (uint32 j = 0; j < len; j++) {
        out[j] = rev[len - 1 - j]
    }
    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE)
        os::win32::WriteFile(h, getptr(out), len, null)
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::win32::WriteFile(h, end, m, null)
            }
        }
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64>(len))
        if (end != null) {
            uint32 m = $(end).length()
            if (m != 0) {
                os::posix::write(os::posix::STDOUT_FILENO, end, cast<uint64>(m))
            }
        }
    }
}


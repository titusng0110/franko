// franko/limit — integer type limits.
//
// One global per bound per primitive integer type, named after the
// C conventions (INT32_MAX, UINT8_MIN, ...), wrapped in `namespace std`
// like the other std modules. Each is a `const` global with a constant
// initializer (folded at compile time). Because they are named globals
// rather than literals,
// they cannot appear in constant-expression slots (static array sizes,
// struct field defaults, `break N` levels) and they do not get the
// fluid-constant fit rules — their declared type is exact.
//
//   import "franko/limit"
//
//   if (n == std::INT32_MAX) { ... }

namespace std {
    const int8 INT8_MIN = -128
    const int8 INT8_MAX = 127

    const int16 INT16_MIN = -32768
    const int16 INT16_MAX = 32767

    const int32 INT32_MIN = -2147483648
    const int32 INT32_MAX = 2147483647

    const int64 INT64_MIN = -9223372036854775808
    const int64 INT64_MAX = 9223372036854775807

    const uint8 UINT8_MIN = 0
    const uint8 UINT8_MAX = 255

    const uint16 UINT16_MIN = 0
    const uint16 UINT16_MAX = 65535

    const uint32 UINT32_MIN = 0
    const uint32 UINT32_MAX = 4294967295

    const uint64 UINT64_MIN = 0
    const uint64 UINT64_MAX = 18446744073709551615
}

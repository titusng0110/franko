                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
        } else if (n == 9) {
            // 9-input network: 25 comparators, 7 layers
            // layer 1
            if ($(values)[lo + 3] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp

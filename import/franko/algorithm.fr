    #generic func heapsort<typename T>(mview<[T]> values, uint32 start, uint32 end) -> void {
        #if (!#is_comparable(T) || !#is_assignable(T)) {
            #panic("franko/algorithm requires an element type that supports ordering and assignment, got " + #what_type(T))
        }

        if (values == null || start >= end) {
            return
        }
        __heap_sort_values<T>(values, start, end - start)
        return
    }

    #generic func heapsort<typename T>(mview<[T]> values) -> void {

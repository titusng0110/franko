    #generic struct __QuicksortContext<typename T> {
        uint32 pivot_cursor = 0
        uint32 sample_pivot_pos = 0
        T sample_pivot
        uint8 use_dnf = 0
    }

    #generic func __sort_network<typename T>(mview<[T]> values, const uint32 lo, uint32 n) -> void {
        if (values == null) {
            return
        }
        if (n < 2) {
            return
        }

        if (n == 2) {
            // layer 1
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
        } else if (n == 3) {
            // layer 1
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            // layer 2
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            // layer 3
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
        } else if (n == 4) {
            // layer 1
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 2
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 3
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
        } else if (n == 5) {
            // layer 1
            if ($(values)[lo + 3] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 2
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 3
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 4
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 5
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
        } else if (n == 6) {
            // layer 1
            if ($(values)[lo + 5] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 2
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 3
            if ($(values)[lo + 3] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            // layer 4
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            // layer 5
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
        } else if (n == 7) {
            // layer 1
            if ($(values)[lo + 6] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            // layer 2
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            // layer 3
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 4
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            // layer 5
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            // layer 6
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
        } else if (n == 8) {
            // layer 1
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            // layer 2
            if ($(values)[lo + 4] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            // layer 3
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 6]) {
                T tmp = $(values)[lo + 6]
                $(values)[lo + 6] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            // layer 4
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            // layer 5
            if ($(values)[lo + 4] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            // layer 6
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
        } else if (n == 9) {
            // 9-input network: 25 comparators, 7 layers
            // layer 1
            if ($(values)[lo + 3] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 8] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 8]
                $(values)[lo + 8] = tmp
            }
            // layer 2
            if ($(values)[lo + 7] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 8] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 8]
                $(values)[lo + 8] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            // layer 3
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 8] < $(values)[lo + 7]) {
                T tmp = $(values)[lo + 7]
                $(values)[lo + 7] = $(values)[lo + 8]
                $(values)[lo + 8] = tmp
            }
            // layer 4
            if ($(values)[lo + 4] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            // layer 5
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 8] < $(values)[lo + 6]) {
                T tmp = $(values)[lo + 6]
                $(values)[lo + 6] = $(values)[lo + 8]
                $(values)[lo + 8] = tmp
            }
            // layer 6
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 5] < $(values)[lo + 4]) {
                T tmp = $(values)[lo + 4]
                $(values)[lo + 4] = $(values)[lo + 5]
                $(values)[lo + 5] = tmp
            }
            if ($(values)[lo + 7] < $(values)[lo + 6]) {
                T tmp = $(values)[lo + 6]
                $(values)[lo + 6] = $(values)[lo + 7]
                $(values)[lo + 7] = tmp
            }
            // layer 7
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
        }
        return
    }

    // Read-only sortedness check. Returns 1 when values[lo .. hi] is
    // nondecreasing. No writes.
    #generic func __is_sorted<typename T>(view<[T]> values, const uint32 lo, const uint32 hi) -> byte {
        if (values == null) {
            return 0
        }
        uint32 i = lo + 1
        while (i <= hi) {
            if ($(values)[i] < $(values)[i - 1]) {
                return 0
            }
            i = i + 1
        }
        return 1
    }

    // Heapsort helpers used only for the small distinctness sample.
    #generic func __sift_down_indices<typename T>(mview<[uint32]> sample, view<[T]> values, uint32 root, const uint32 end) -> void {
        if (sample == null || values == null) {
            return
        }
        while (root * 2 + 1 <= end) {
            uint32 child = root * 2 + 1
            if (child + 1 <= end && $(values)[$(sample)[child]] < $(values)[$(sample)[child + 1]]) {
                child = child + 1
            }
            if ($(values)[$(sample)[root]] < $(values)[$(sample)[child]]) {
                uint32 tmp = $(sample)[root]
                $(sample)[root] = $(sample)[child]
                $(sample)[child] = tmp
                root = child
            } else {
                return
            }
        }
        return
    }

    #generic func __sort_sample_indices<typename T>(mview<[uint32]> sample, view<[T]> values, const uint32 n) -> void {
        if (sample == null || values == null || n < 2) {
            return
        }
        uint32 start = n / 2
        while (start > 0) {
            start = start - 1
            __sift_down_indices<T>(sample, values, start, n - 1)
        }
        uint32 end = n - 1
        while (end > 0) {
            uint32 tmp = $(sample)[0]
            $(sample)[0] = $(sample)[end]
            $(sample)[end] = tmp
            end = end - 1
            __sift_down_indices<T>(sample, values, 0, end)
        }
        return
    }

    #generic func __insertion_sort_values<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi) -> void {
        if (values == null) {
            return
        }
        uint32 i = lo + 1
        while (i <= hi) {
            T key = $(values)[i]
            uint32 j = i
            while (j > lo && key < $(values)[j - 1]) {
                $(values)[j] = $(values)[j - 1]
                j = j - 1
            }
            $(values)[j] = key
            i = i + 1
        }
        return
    }

    #generic func __sift_down_values<typename T>(mview<[T]> values, const uint32 lo, uint32 root, const uint32 end) -> void {
        if (values == null) {
            return
        }
        while (root * 2 + 1 <= end) {
            uint32 child = root * 2 + 1
            if (child + 1 <= end && $(values)[lo + child] < $(values)[lo + child + 1]) {
                child = child + 1
            }
            if ($(values)[lo + root] < $(values)[lo + child]) {
                T tmp = $(values)[lo + root]
                $(values)[lo + root] = $(values)[lo + child]
                $(values)[lo + child] = tmp
                root = child
            } else {
                return
            }
        }
        return
    }

    #generic func __heap_sort_values<typename T>(mview<[T]> values, const uint32 lo, const uint32 n) -> void {
        if (values == null || n < 2) {
            return
        }
        if (n <= __SMALL_SORT_LIMIT) {
            if (n <= __NETWORK_LIMIT) {
                __sort_network<T>(values, lo, n)
            } else {
                __insertion_sort_values<T>(values, lo, lo + n - 1)
            }
            return
        }
        uint32 start = n / 2
        while (start > 0) {
            start = start - 1
            __sift_down_values<T>(values, lo, start, n - 1)
        }
        uint32 end = n - 1
        while (end > 0) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[lo + end]
            $(values)[lo + end] = tmp
            end = end - 1
            __sift_down_values<T>(values, lo, 0, end)
        }
        return
    }

    #generic func __insertion_sort_values<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi) -> void {
        if (values == null) {
            return
        }
        uint32 i = lo + 1
        while (i <= hi) {
            T key = $(values)[i]
            uint32 j = i
            while (j > lo && key < $(values)[j - 1]) {
                $(values)[j] = $(values)[j - 1]
                j = j - 1
            }
            $(values)[j] = key
            i = i + 1
        }
        return
    }

    #generic func __sift_down_values<typename T>(ptr<[T]> values, const uint32 lo, uint32 root, const uint32 end) -> void {
        if (values == null) {
            return
        }
        while (root * 2 + 1 <= end) {
            uint32 child = root * 2 + 1
            if (child + 1 <= end && $(values)[lo + child] < $(values)[lo + child + 1]) {
                child = child + 1
            }
            if ($(values)[lo + root] < $(values)[lo + child]) {
                T tmp = $(values)[lo + root]
                $(values)[lo + root] = $(values)[lo + child]
                $(values)[lo + child] = tmp
                root = child
            } else {
                return
            }
        }
        return
    }

    #generic func __heap_sort_values<typename T>(ptr<[T]> values, const uint32 lo, const uint32 n) -> void {
        if (values == null || n < 2) {
            return
        }
        if ($(values).length() == 0) {
            return
        }
        if (n <= __SMALL_SORT_LIMIT) {
            __insertion_sort_values<T>(getptr($(values)), lo, lo + n - 1)
            return
        }
        uint32 start = n / 2
        while (start > 0) {
            start = start - 1
            __sift_down_values<T>(getptr($(values)), lo, start, n - 1)
        }
        uint32 end = n - 1
        while (end > 0) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[lo + end]
            $(values)[lo + end] = tmp
            end = end - 1
            __sift_down_values<T>(getptr($(values)), lo, 0, end)
        }
        return
    }

    func __floor_log2(uint32 n) -> uint32 {
        uint32 r = 0
        if (n >= 0x10000) {
            n = n >> 16
            r = r + 16
        }
        if (n >= 0x100) {
            n = n >> 8
            r = r + 8
        }
        if (n >= 0x10) {
            n = n >> 4
            r = r + 4
        }
        if (n >= 0x4) {
            n = n >> 2
            r = r + 2
        }
        if (n >= 0x2) {
            n = n >> 1
            r = r + 1
        }
        return r
    }

    func __next_random_word(mview<uint32> cursor) -> uint32 {
        if (__RANDOM_PIVOTS == null || cursor == null) {
            return 0
        }
        uint32 index = $(cursor) & 127
        uint32 r = $(__RANDOM_PIVOTS)[index]
        $(cursor) = $(cursor) + 1
        return r
    }

    func __get_random_pivot_pos(mview<uint32> cursor, const uint32 lo, const uint32 hi) -> uint32 {
        uint32 count = hi - lo + 1
        uint32 offset = unsafe_cast<uint32>((cast<uint64>(__next_random_word(cursor)) * cast<uint64>(count)) >> 32)
        return lo + offset
    }

    // Fixed-size randomized static probe: one random offset per equal segment.
    #generic func __sample_has_duplicates<typename T>(view<[T]> values, const uint32 start, const uint32 count, const uint32 sample_size, ptr<__QuicksortContext<T>> ctx) -> byte {
        if (values == null || ctx == null || count < sample_size || sample_size > 64) {
            if (ctx != null) {
                $(ctx).sample_pivot_pos = start
            }
            return 0
        }
        [uint32, 64] sample
        uint32 step = count / sample_size
        if (step == 0) {
            step = 1
        }
        uint32 j = 0
        while (j < sample_size) {
            uint32 block_start = j * step
            uint32 remaining = count - block_start
            uint32 span = step
            if (span > remaining) {
                span = remaining
            }
            uint32 r = __next_random_word(getptr($(ctx).pivot_cursor))
            r = r ^ (j * 0x9E3779B9)
            r = r ^ (r >> 16)
            uint64 scaled = cast<uint64>(r) * cast<uint64>(span)
            uint32 offset = unsafe_cast<uint32>(scaled >> 32)
            sample[j] = start + block_start + offset
            j = j + 1
        }
        uint32 i = 1
        while (i < sample_size) {
            uint32 key = sample[i]
            T key_value = $(values)[key]
            uint32 pos = i
            while (pos > 0 && key_value < $(values)[sample[pos - 1]]) {
                sample[pos] = sample[pos - 1]
                pos = pos - 1
            }
            sample[pos] = key
            i = i + 1
        }
        $(ctx).sample_pivot_pos = sample[sample_size / 2]
        $(ctx).sample_pivot = $(values)[$(ctx).sample_pivot_pos]
        i = 1
        while (i < sample_size) {
            T a = $(values)[sample[i - 1]]
            T b = $(values)[sample[i]]
            byte same = 1
            if (a < b || b < a) {
                same = 0
            }
            if (same != 0) {
                return 1
            }
            i = i + 1
        }
        return 0
    }

    // Estimate the average duplicate-group size from a 0.1% sample.
    // Returns 1 when DNF is preferred, 0 for Lomuto. The sample uses the
    // static __RANDOM_PIVOTS table for cheap stratified offsets.
    #generic func __estimate_use_dnf<typename T>(view<[T]> values, const uint32 start, const uint32 count, ptr<__QuicksortContext<T>> ctx) -> byte {
        if (values == null || ctx == null) {
            return 0
        }
        $(ctx).sample_pivot_pos = start

        uint32 k = count / 1000
        if (k < __MHAT_SAMPLE_MIN) {
            k = __MHAT_SAMPLE_MIN
        } else if (k > __MHAT_SAMPLE_MAX) {
            k = __MHAT_SAMPLE_MAX
        }

        [uint32] sample
        sample.init(k)
        if (sample.length() != k) {
            sample.uninit()
            return 0
        }

        uint32 step = count / k
        if (step == 0) {
            step = 1
        }
        for (uint32 j = 0; j < k; j++) {
            uint32 block_start = j * step
            uint32 remaining = count - block_start
            uint32 span = step
            if (span > remaining) {
                span = remaining
            }

            uint32 r = __next_random_word(getptr($(ctx).pivot_cursor))
            r = r ^ (j * 0x9E3779B9)
            r = r ^ (r >> 16)
            uint64 scaled = cast<uint64>(r) * cast<uint64>(span)
            uint32 offset = unsafe_cast<uint32>(scaled >> 32)
            sample[j] = start + block_start + offset
        }

        __sort_sample_indices<T>(getmview(sample), values, k)
        $(ctx).sample_pivot_pos = sample[k / 2]
        $(ctx).sample_pivot = $(values)[$(ctx).sample_pivot_pos]

        uint64 collisions = 0
        uint32 run = 1
        for (uint32 j = 1; j < k; j++) {
            T left = $(values)[sample[j]]
            T right = $(values)[sample[j - 1]]
            if (left < right || right < left) {
                collisions = collisions + (cast<uint64>(run) * cast<uint64>(run - 1)) / 2
                run = 1
            } else {
                run = run + 1
            }
        }
        collisions = collisions + (cast<uint64>(run) * cast<uint64>(run - 1)) / 2

        uint64 pairs = (cast<uint64>(k) * cast<uint64>(k - 1)) / 2
        byte result = 0
        if (collisions * cast<uint64>(count) > cast<uint64>(__DNF_THRESHOLD) * pairs) {
            result = 1
        }

        sample.uninit()
        return result
    }

    #generic func __median3_partition_lt_4k<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi) -> uint32 {
        if (values == null) {
            return lo
        }
        uint32 mid = lo + (hi - lo) / 2
        if ($(values)[lo] < $(values)[mid]) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[mid]
            $(values)[mid] = tmp
        }
        if ($(values)[hi] < $(values)[lo]) {
            T tmp = $(values)[hi]
            $(values)[hi] = $(values)[lo]
            $(values)[lo] = tmp
        }
        if ($(values)[lo] < $(values)[mid]) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[mid]
            $(values)[mid] = tmp
        }
        T pivot = $(values)[lo]
        uint32 i = lo
        uint32 j = hi
        while (1) {
            while ($(values)[i] < pivot) {
                i = i + 1
            }
            while (pivot < $(values)[j]) {
                j = j - 1
            }
            if (i >= j) {
                return j
            }
            T tmp = $(values)[i]
            $(values)[i] = $(values)[j]
            $(values)[j] = tmp
            i = i + 1
            j = j - 1
        }
        return lo
    }

    #generic func __partition_dnf_kernel<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi, view<T> pivot) -> (uint32 lt, uint32 gt) {
        if (values == null || pivot == null) {
            return (uint32 lt, uint32 gt) { lt = lo, gt = lo }
        }
        uint32 lt = lo
        uint32 i = lo
        uint32 gt = hi
        while (i <= gt) {
            T key = $(values)[i]
            if (key < $(pivot)) {
                T tmp = $(values)[lt]
                $(values)[lt] = $(values)[i]
                $(values)[i] = tmp
                lt = lt + 1
                i = i + 1
            } else if ($(pivot) < key) {
                T tmp = $(values)[i]
                $(values)[i] = $(values)[gt]
                $(values)[gt] = tmp
                gt = gt - 1
            } else {
                i = i + 1
            }
        }
        return (uint32 lt, uint32 gt) { lt = lt, gt = gt }
    }

    #generic func __partition_lomuto_kernel<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi, const uint32 pivot_pos) -> uint32 {
        if (values == null) {
            return lo
        }
        T tmp_pivot = $(values)[pivot_pos]
        $(values)[pivot_pos] = $(values)[hi]
        $(values)[hi] = tmp_pivot
        T pivot_key = $(values)[hi]
        uint32 store = lo
        uint32 i = lo
        while (i < hi) {
            if ($(values)[i] < pivot_key) {
                T tmp = $(values)[store]
                $(values)[store] = $(values)[i]
                $(values)[i] = tmp
                store = store + 1
            }
            i = i + 1
        }
        T tmp_last = $(values)[store]
        $(values)[store] = $(values)[hi]
        $(values)[hi] = tmp_last
        return store
    }

    #generic func __quicksort_lt_4k_rec<typename T>(mview<[T]> values, uint32 lo, uint32 hi, uint32 depth) -> void {
        if (values == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(values, lo, count)
                } else {
                    __insertion_sort_values<T>(values, lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(values, lo, count)
                return
            }
            uint32 split = __median3_partition_lt_4k<T>(values, lo, hi)
            if (split >= hi) {
                __heap_sort_values<T>(values, lo, count)
                return
            }
            uint32 left_count = split - lo + 1
            uint32 right_count = hi - split
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_lt_4k_rec<T>(values, split + 1, hi, depth - 1)
                }
                hi = split
            } else {
                if (left_count > 0) {
                    __quicksort_lt_4k_rec<T>(values, lo, split, depth - 1)
                }
                lo = split + 1
            }
            depth = depth - 1
        }
        return
    }

    #generic func __quicksort_ge_4k_dnf_rec<typename T>(mview<[T]> values, uint32 lo, uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(values, lo, count)
                } else {
                    __insertion_sort_values<T>(values, lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(values, lo, count)
                return
            }
            T pivot_value = $(values)[__get_random_pivot_pos(getptr($(ctx).pivot_cursor), lo, hi)]
        (uint32 lt, uint32 gt) bounds = __partition_dnf_kernel<T>(values, lo, hi, getview(pivot_value))
            uint32 left_count = 0
            if (bounds.lt > lo) {
                left_count = bounds.lt - lo
            }
            uint32 right_count = 0
            if (bounds.gt < hi) {
                right_count = hi - bounds.gt
            }
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_ge_4k_dnf_rec<T>(values, bounds.gt + 1, hi, depth - 1, ctx)
                }
                depth = depth - 1
                hi = bounds.lt - 1
            } else {
                if (left_count > 0) {
                    __quicksort_ge_4k_dnf_rec<T>(values, lo, bounds.lt - 1, depth - 1, ctx)
                }
                if (right_count == 0) {
                    return
                }
                depth = depth - 1
                lo = bounds.gt + 1
            }
        }
        return
    }

    #generic func __quicksort_ge_4k_dnf<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        if (lo >= hi) {
            return
        }
        uint32 count = hi - lo + 1
        if (count <= __SMALL_SORT_LIMIT) {
            if (count <= __NETWORK_LIMIT) {
                __sort_network<T>(values, lo, count)
            } else {
                __insertion_sort_values<T>(values, lo, hi)
            }
            return
        }
        if (depth == 0) {
            __heap_sort_values<T>(values, lo, count)
            return
        }
        (uint32 lt, uint32 gt) bounds = __partition_dnf_kernel<T>(values, lo, hi, getview($(ctx).sample_pivot))
        uint32 left_count = 0
        if (bounds.lt > lo) {
            left_count = bounds.lt - lo
        }
        uint32 right_count = 0
        if (bounds.gt < hi) {
            right_count = hi - bounds.gt
        }
        if (left_count > 0) {
            __quicksort_ge_4k_dnf_rec<T>(values, lo, bounds.lt - 1, depth - 1, ctx)
        }
        if (right_count > 0) {
            __quicksort_ge_4k_dnf_rec<T>(values, bounds.gt + 1, hi, depth - 1, ctx)
        }
        return
    }

    #generic func __quicksort_ge_4k_lomuto_rec<typename T>(mview<[T]> values, uint32 lo, uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(values, lo, count)
                } else {
                    __insertion_sort_values<T>(values, lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(values, lo, count)
                return
            }
            uint32 pivot = __partition_lomuto_kernel<T>(values, lo, hi, __get_random_pivot_pos(getptr($(ctx).pivot_cursor), lo, hi))
            uint32 left_count = pivot - lo
            uint32 right_count = hi - pivot
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_ge_4k_lomuto_rec<T>(values, pivot + 1, hi, depth - 1, ctx)
                }
                depth = depth - 1
                hi = pivot - 1
            } else {
                if (left_count > 0) {
                    __quicksort_ge_4k_lomuto_rec<T>(values, lo, pivot - 1, depth - 1, ctx)
                }
                depth = depth - 1
                lo = pivot + 1
            }
        }
        return
    }

    #generic func __quicksort_ge_4k_lomuto<typename T>(mview<[T]> values, const uint32 lo, const uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        if (lo >= hi) {
            return
        }
        uint32 count = hi - lo + 1
        if (count <= __SMALL_SORT_LIMIT) {
            if (count <= __NETWORK_LIMIT) {
                __sort_network<T>(values, lo, count)
            } else {
                __insertion_sort_values<T>(values, lo, hi)
            }
            return
        }
        if (depth == 0) {
            __heap_sort_values<T>(values, lo, count)
            return
        }
        uint32 pivot = __partition_lomuto_kernel<T>(values, lo, hi, $(ctx).sample_pivot_pos)
        uint32 left_count = pivot - lo
        uint32 right_count = hi - pivot
        if (left_count > 0) {
            __quicksort_ge_4k_lomuto_rec<T>(values, lo, pivot - 1, depth - 1, ctx)
        }
        if (right_count > 0) {
            __quicksort_ge_4k_lomuto_rec<T>(values, pivot + 1, hi, depth - 1, ctx)
        }
        return
    }


    #generic func __sort_network<typename T>(ptr<[T]> values, const uint32 lo, uint32 n) -> void {
        if (values == null) {
            return
        }
        if (n < 2) {
            return
        }

        if (n == 2) {
            // layer 1
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
        } else if (n == 3) {
            // layer 1
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            // layer 2
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            // layer 3
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
        } else if (n == 4) {
            // layer 1
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 2
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 3
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
        } else if (n == 5) {
            // layer 1
            if ($(values)[lo + 3] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 2
            if ($(values)[lo + 2] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 3] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 3]
                $(values)[lo + 3] = tmp
            }
            // layer 3
            if ($(values)[lo + 1] < $(values)[lo + 0]) {
                T tmp = $(values)[lo + 0]
                $(values)[lo + 0] = $(values)[lo + 1]
                $(values)[lo + 1] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 2]) {
                T tmp = $(values)[lo + 2]
                $(values)[lo + 2] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 4
            if ($(values)[lo + 2] < $(values)[lo + 1]) {
                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            // layer 5
            if ($(values)[lo + 3] < $(values)[lo + 2]) {

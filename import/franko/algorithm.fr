                T tmp = $(values)[lo + 1]
                $(values)[lo + 1] = $(values)[lo + 2]
                $(values)[lo + 2] = tmp
            }
            if ($(values)[lo + 4] < $(values)[lo + 3]) {
                T tmp = $(values)[lo + 3]
                $(values)[lo + 3] = $(values)[lo + 4]
                $(values)[lo + 4] = tmp
            }
            if ($(values)[lo + 6] < $(values)[lo + 5]) {
                T tmp = $(values)[lo + 5]
                $(values)[lo + 5] = $(values)[lo + 6]
                $(values)[lo + 6] = tmp
            }
        }
        return
    }

    #generic func __median3_partition_lt_4k<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi) -> uint32 {
        if (values == null) {
            return lo
        }
        uint32 mid = lo + (hi - lo) / 2
        if ($(values)[lo] < $(values)[mid]) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[mid]
            $(values)[mid] = tmp
        }
        if ($(values)[hi] < $(values)[lo]) {
            T tmp = $(values)[hi]
            $(values)[hi] = $(values)[lo]
            $(values)[lo] = tmp
        }
        if ($(values)[lo] < $(values)[mid]) {
            T tmp = $(values)[lo]
            $(values)[lo] = $(values)[mid]
            $(values)[mid] = tmp
        }
        T pivot = $(values)[lo]
        uint32 i = lo
        uint32 j = hi
        while (1) {
            while ($(values)[i] < pivot) {
                i = i + 1
            }
            while (pivot < $(values)[j]) {
                j = j - 1
            }
            if (i >= j) {
                return j
            }
            T tmp = $(values)[i]
            $(values)[i] = $(values)[j]
            $(values)[j] = tmp
            i = i + 1
            j = j - 1
        }
        return lo
    }

    #generic func __partition_dnf_kernel<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi, view<T> pivot) -> (uint32 lt, uint32 gt) {
        if (values == null || pivot == null) {
            return (uint32 lt, uint32 gt) { lt = lo, gt = lo }
        }
        uint32 lt = lo
        uint32 i = lo
        uint32 gt = hi
        while (i <= gt) {
            T key = $(values)[i]
            if (key < $(pivot)) {
                T tmp = $(values)[lt]
                $(values)[lt] = $(values)[i]
                $(values)[i] = tmp
                lt = lt + 1
                i = i + 1
            } else if ($(pivot) < key) {
                T tmp = $(values)[i]
                $(values)[i] = $(values)[gt]
                $(values)[gt] = tmp
                gt = gt - 1
            } else {
                i = i + 1
            }
        }
        return (uint32 lt, uint32 gt) { lt = lt, gt = gt }
    }

    #generic func __partition_lomuto_kernel<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi, const uint32 pivot_pos) -> uint32 {
        if (values == null) {
            return lo
        }
        T tmp_pivot = $(values)[pivot_pos]
        $(values)[pivot_pos] = $(values)[hi]
        $(values)[hi] = tmp_pivot
        T pivot_key = $(values)[hi]
        uint32 store = lo
        uint32 i = lo
        while (i < hi) {
            if ($(values)[i] < pivot_key) {
                T tmp = $(values)[store]
                $(values)[store] = $(values)[i]
                $(values)[i] = tmp
                store = store + 1
            }
            i = i + 1
        }
        T tmp_last = $(values)[store]
        $(values)[store] = $(values)[hi]
        $(values)[hi] = tmp_last
        return store
    }

    #generic func __quicksort_lt_4k_rec<typename T>(ptr<[T]> values, uint32 lo, uint32 hi, uint32 depth) -> void {
        if (values == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(getptr($(values)), lo, count)
                } else {
                    __insertion_sort_values<T>(getptr($(values)), lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(getptr($(values)), lo, count)
                return
            }
            uint32 split = __median3_partition_lt_4k<T>(getptr($(values)), lo, hi)
            if (split >= hi) {
                __heap_sort_values<T>(getptr($(values)), lo, count)
                return
            }
            uint32 left_count = split - lo + 1
            uint32 right_count = hi - split
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_lt_4k_rec<T>(getptr($(values)), split + 1, hi, depth - 1)
                }
                hi = split
            } else {
                if (left_count > 0) {
                    __quicksort_lt_4k_rec<T>(getptr($(values)), lo, split, depth - 1)
                }
                lo = split + 1
            }
            depth = depth - 1
        }
        return
    }

    #generic func __quicksort_ge_4k_dnf_rec<typename T>(ptr<[T]> values, uint32 lo, uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(getptr($(values)), lo, count)
                } else {
                    __insertion_sort_values<T>(getptr($(values)), lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(getptr($(values)), lo, count)
                return
            }
            T pivot_value = $(values)[__get_random_pivot_pos(getptr($(ctx).pivot_cursor), lo, hi)]
        (uint32 lt, uint32 gt) bounds = __partition_dnf_kernel<T>(getptr($(values)), lo, hi, getview(pivot_value))
            uint32 left_count = 0
            if (bounds.lt > lo) {
                left_count = bounds.lt - lo
            }
            uint32 right_count = 0
            if (bounds.gt < hi) {
                right_count = hi - bounds.gt
            }
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_ge_4k_dnf_rec<T>(getptr($(values)), bounds.gt + 1, hi, depth - 1, ctx)
                }
                depth = depth - 1
                hi = bounds.lt - 1
            } else {
                if (left_count > 0) {
                    __quicksort_ge_4k_dnf_rec<T>(getptr($(values)), lo, bounds.lt - 1, depth - 1, ctx)
                }
                if (right_count == 0) {
                    return
                }
                depth = depth - 1
                lo = bounds.gt + 1
            }
        }
        return
    }

    #generic func __quicksort_ge_4k_lomuto_rec<typename T>(ptr<[T]> values, uint32 lo, uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        while (lo < hi) {
            uint32 count = hi - lo + 1
            if (count <= __SMALL_SORT_LIMIT) {
                if (count <= __NETWORK_LIMIT) {
                    __sort_network<T>(getptr($(values)), lo, count)
                } else {
                    __insertion_sort_values<T>(getptr($(values)), lo, hi)
                }
                return
            }
            if (depth == 0) {
                __heap_sort_values<T>(getptr($(values)), lo, count)
                return
            }
            uint32 pivot = __partition_lomuto_kernel<T>(getptr($(values)), lo, hi, __get_random_pivot_pos(getptr($(ctx).pivot_cursor), lo, hi))
            uint32 left_count = pivot - lo
            uint32 right_count = hi - pivot
            if (left_count > right_count) {
                if (right_count > 0) {
                    __quicksort_ge_4k_lomuto_rec<T>(getptr($(values)), pivot + 1, hi, depth - 1, ctx)
                }
                depth = depth - 1
                hi = pivot - 1
            } else {
                if (left_count > 0) {
                    __quicksort_ge_4k_lomuto_rec<T>(getptr($(values)), lo, pivot - 1, depth - 1, ctx)
                }
                depth = depth - 1
                lo = pivot + 1
            }
        }
        return
    }

    #generic func __quicksort_ge_4k_dnf<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        if (lo >= hi) {
            return
        }
        uint32 count = hi - lo + 1
        if (count <= __SMALL_SORT_LIMIT) {
            if (count <= __NETWORK_LIMIT) {
                __sort_network<T>(getptr($(values)), lo, count)
            } else {
                __insertion_sort_values<T>(getptr($(values)), lo, hi)
            }
            return
        }
        if (depth == 0) {
            __heap_sort_values<T>(getptr($(values)), lo, count)
            return
        }
        (uint32 lt, uint32 gt) bounds = __partition_dnf_kernel<T>(getptr($(values)), lo, hi, getview($(ctx).sample_pivot))
        uint32 left_count = 0
        if (bounds.lt > lo) {
            left_count = bounds.lt - lo
        }
        uint32 right_count = 0
        if (bounds.gt < hi) {
            right_count = hi - bounds.gt
        }
        if (left_count > 0) {
            __quicksort_ge_4k_dnf_rec<T>(getptr($(values)), lo, bounds.lt - 1, depth - 1, ctx)
        }
        if (right_count > 0) {
            __quicksort_ge_4k_dnf_rec<T>(getptr($(values)), bounds.gt + 1, hi, depth - 1, ctx)
        }
        return
    }

    #generic func __quicksort_ge_4k_lomuto<typename T>(ptr<[T]> values, const uint32 lo, const uint32 hi, uint32 depth, ptr<__QuicksortContext<T>> ctx) -> void {
        if (values == null || ctx == null) {
            return
        }
        if (lo >= hi) {
            return
        }
        uint32 count = hi - lo + 1
        if (count <= __SMALL_SORT_LIMIT) {
            if (count <= __NETWORK_LIMIT) {
                __sort_network<T>(getptr($(values)), lo, count)
            } else {
                __insertion_sort_values<T>(getptr($(values)), lo, hi)
            }
            return
        }
        if (depth == 0) {
            __heap_sort_values<T>(getptr($(values)), lo, count)
            return
        }
        uint32 pivot = __partition_lomuto_kernel<T>(getptr($(values)), lo, hi, $(ctx).sample_pivot_pos)
        uint32 left_count = pivot - lo
        uint32 right_count = hi - pivot
        if (left_count > 0) {
            __quicksort_ge_4k_lomuto_rec<T>(getptr($(values)), lo, pivot - 1, depth - 1, ctx)
        }
        if (right_count > 0) {
            __quicksort_ge_4k_lomuto_rec<T>(getptr($(values)), pivot + 1, hi, depth - 1, ctx)
        }
        return
    }

    #generic func quicksort<typename T>(ptr<[T]> values, uint32 start, uint32 end) -> void {
        #if (!#is_comparable(T) || !#is_assignable(T)) {
            #panic("franko/algorithm requires an element type that supports ordering and assignment, got " + #what_type(T))
        }

        if (values == null || start >= end) {
            return
        }

        uint32 count = end - start
        byte already_sorted = __is_sorted<T>(values, start, end - 1)
        if (already_sorted != 0) {
            return
        }

        __QuicksortContext<T> ctx
        uint32 depth = 2 * __floor_log2(count)

        if (count >= __PROBE16_MIN_ITEMS) {
            if (count >= __MHAT_MIN_ITEMS) {
                ctx.use_dnf = __estimate_use_dnf<T>(values, start, count, getptr(ctx))
            } else if (count >= __PROBE64_MIN_ITEMS) {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 64, getptr(ctx))
            } else if (count >= __PROBE49_MIN_ITEMS) {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 49, getptr(ctx))
            } else if (count >= __PROBE37_MIN_ITEMS) {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 37, getptr(ctx))
            } else if (count >= __PROBE29_MIN_ITEMS) {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 29, getptr(ctx))
            } else if (count >= __PROBE22_MIN_ITEMS) {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 22, getptr(ctx))
            } else {
                ctx.use_dnf = __sample_has_duplicates<T>(values, start, count, 16, getptr(ctx))
            }

            if (ctx.use_dnf != 0) {
                __quicksort_ge_4k_dnf<T>(getptr($(values)), start, end - 1, depth, getptr(ctx))
            } else {
                __quicksort_ge_4k_lomuto<T>(getptr($(values)), start, end - 1, depth, getptr(ctx))
            }
        } else {
            __quicksort_lt_4k_rec<T>(getptr($(values)), start, end - 1, depth)
        }
        return
    }

    #generic func quicksort<typename T>(ptr<[T]> values) -> void {
        #if (!#is_comparable(T) || !#is_assignable(T)) {
            #panic("franko/algorithm requires an element type that supports ordering and assignment, got " + #what_type(T))
        }

        if (values == null) {
            return
        }
        uint32 count = $(values).length()
        quicksort<T>(getptr($(values)), 0, count)
        return
    }


    const uint32 __NETWORK_LIMIT = 9
    const uint32 __SMALL_SORT_LIMIT = 24
    const uint32 __DNF_THRESHOLD = 70
    const uint32 __MHAT_MIN_ITEMS = 100000
    const uint32 __MHAT_SAMPLE_MIN = 100
    const uint32 __MHAT_SAMPLE_MAX = 20000

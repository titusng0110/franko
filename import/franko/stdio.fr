import "./string"

// franko/stdio — user-level output and input.
//
// Integer formatting, byte-view writing, and the stdin read-ahead
// buffer live in the stdio FFI bridge `stdio.ffi.cpp`. The public
// overload set and the String/width adapters stay in Franko.
struct __IoLineBuffer {
    [byte] data
}

// Bridged output primitives. The public int64/uint64/view<[byte]>
// overloads below are thin Franko wrappers over these definitions.
func __io_stdout_int64(const int64 num, const view<[byte]> end) -> void {
    return
}

func __io_stdout_uint64(const uint64 num, const view<[byte]> end) -> void {
    return
}

func __io_stdout_bytes(const view<[byte]> text, const view<[byte]> end) -> void {
    return
}

func __io_stderr_int64(const int64 num, const view<[byte]> end) -> void {
    return
}

func __io_stderr_uint64(const uint64 num, const view<[byte]> end) -> void {
    return
}

func __io_stderr_bytes(const view<[byte]> text, const view<[byte]> end) -> void {
    return
}

// Bridged stdin state and buffer accessors.
func __io_fill() -> int32 {
    return -1
}

func __io_input_pos() -> uint32 {
    return 0
}

func __io_input_len() -> uint32 {
    return 0
}

func __io_set_input_pos(const uint32 value) -> void {
    return
}

func __io_set_input_len(const uint32 value) -> void {
    return
}

func __io_input_byte(const uint32 index) -> byte {
    return 0
}

func __io_input_memchr(const byte value, const uint32 start, const uint32 count) -> uint32 {
    return 0xFFFFFFFF
}

func __io_input_copy_to(const mview<[byte]> dst, const uint32 dst_start, const uint32 src_start, const uint32 count) -> void {
    return
}

func stdout() -> void {
    stdout([10], end = null)
}

func stderr() -> void {
    stderr([10], end = null)
}

// ------------------------------------------------------------
// stdout: unsigned integers
// ------------------------------------------------------------

func stdout(const uint64 num, const view<[uint8]> end = "\n") -> void {
    __io_stdout_uint64(num, end)
}

func stdout(const uint8 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<uint64>(num), end = end)
}

func stdout(const uint16 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<uint64>(num), end = end)
}

func stdout(const uint32 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<uint64>(num), end = end)
}

// ------------------------------------------------------------
// stdout: signed integers
// ------------------------------------------------------------

func stdout(const int64 num, const view<[uint8]> end = "\n") -> void {
    __io_stdout_int64(num, end)
}

func stdout(const int8 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<int64>(num), end = end)
}

func stdout(const int16 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<int64>(num), end = end)
}

func stdout(const int32 num, const view<[uint8]> end = "\n") -> void {
    stdout(cast<int64>(num), end = end)
}

// ------------------------------------------------------------
// stdout: text and std::String
// ------------------------------------------------------------

func stdout(const view<[uint8]> utf8str, const view<[uint8]> end = "\n") -> void {
    __io_stdout_bytes(utf8str, end)
}

func stdout(const view<std::String> str, const view<std::String> end) -> void {
    [byte] endbuf
    view<[uint8]> endbytes = null
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0 && $(end).to(ptr(endbuf)) == 0) {
            endbytes = view(endbuf)
        }
    }
    stdout(str, end = endbytes)
    if (endbuf.length() != 0) {
        endbuf.uninit()
    }
    return
}

func stdout(const view<std::String> str, const view<[byte]> end = "\n") -> void {
    if (str != null) {
        uint32 n = $(str).length()
        if (n != 0) {
            [byte] buf
            if ($(str).to(ptr(buf)) == 0) {
                stdout(view(buf), end = end)
            }
            if (buf.length() != 0) {
                buf.uninit()
            }
            return
        }
    }
    view<[uint8]> empty = null
    stdout(empty, end = end)
    return
}

// ------------------------------------------------------------
// stderr: unsigned integers
// ------------------------------------------------------------

func stderr(const uint64 num, const view<[uint8]> end = "\n") -> void {
    __io_stderr_uint64(num, end)
}

func stderr(const uint8 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<uint64>(num), end = end)
}

func stderr(const uint16 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<uint64>(num), end = end)
}

func stderr(const uint32 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<uint64>(num), end = end)
}

// ------------------------------------------------------------
// stderr: signed integers
// ------------------------------------------------------------

func stderr(const int64 num, const view<[uint8]> end = "\n") -> void {
    __io_stderr_int64(num, end)
}

func stderr(const int8 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<int64>(num), end = end)
}

func stderr(const int16 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<int64>(num), end = end)
}

func stderr(const int32 num, const view<[uint8]> end = "\n") -> void {
    stderr(cast<int64>(num), end = end)
}

// ------------------------------------------------------------
// stderr: text and std::String
// ------------------------------------------------------------

func stderr(const view<[uint8]> utf8str, const view<[uint8]> end = "\n") -> void {
    __io_stderr_bytes(utf8str, end)
}

func stderr(const view<std::String> str, const view<std::String> end) -> void {
    [byte] endbuf
    view<[uint8]> endbytes = null
    if (end != null) {
        uint32 m = $(end).length()
        if (m != 0 && $(end).to(ptr(endbuf)) == 0) {
            endbytes = view(endbuf)
        }
    }
    stderr(str, end = endbytes)
    if (endbuf.length() != 0) {
        endbuf.uninit()
    }
    return
}

func stderr(const view<std::String> str, const view<[byte]> end = "\n") -> void {
    if (str != null) {
        uint32 n = $(str).length()
        if (n != 0) {
            [byte] buf
            if ($(str).to(ptr(buf)) == 0) {
                stderr(view(buf), end = end)
            }
            if (buf.length() != 0) {
                buf.uninit()
            }
            return
        }
    }
    view<[uint8]> empty = null
    stderr(empty, end = end)
    return
}

// franko/stdio — input.
//
// Input fills a caller-provided buffer (arrays cannot be returned
// directly) and reports how much arrived. The OS reads and the shared
// read-ahead buffer live in stdio.ffi.cpp; these functions keep the
// buffering, line parsing, and public result logic in Franko.

// Read up to `count` bytes from stdin into `buf`, looping over the
// shared 8192-byte input buffer until `count` bytes have been stored,
// end of input is reached, or a read error occurs. Returns (val, err),
// where val is the number of bytes stored and err is 0 on success or
// -1 on error (a null `buf`, or `count` larger than the buffer). A val
// smaller than `count` means end of input, or an error with the bytes
// stored before it in val.
//
// Reads are serviced from the shared stdin buffer first; the OS is read
// in 8192-byte chunks and excess bytes stay buffered for the next call.
// A request larger than 8192 bytes is filled from as many chunks as
// needed.
//
// On Windows, reading a stdin pipe whose writer has closed makes
// ReadFile report failure (ERROR_BROKEN_PIPE) with zero bytes instead
// of succeeding with 0 bytes as POSIX read does. That end-of-input
// normalization lives in the FFI bridge.
func stdin_bytes(mview<[byte]> buf, const uint32 count) -> (uint32 val, int32 err) {
    (uint32 val, int32 err) result
    result.val = 0
    result.err = -1
    if (buf == null) {
        return result
    }
    if ($(buf).length() < count) {
        return result
    }
    if (count == 0) {
        result.err = 0
        return result
    }
    uint32 copied = 0
    while (copied < count) {
        uint32 pos = __io_input_pos()
        uint32 buffer_len = __io_input_len()
        if (pos == buffer_len) {
            int32 fill = __io_fill()
            if (fill < 0) {
                result.val = copied
                result.err = -1
                return result
            }
            if (fill == 0) {
                break
            }
            pos = __io_input_pos()
            buffer_len = __io_input_len()
            if (buffer_len == 0) {
                break
            }
        }
        uint32 available = buffer_len - pos
        uint32 take = count - copied
        if (take > available) {
            take = available
        }
        __io_input_copy_to(buf, copied, pos, take)
        copied = copied + take
        pos = pos + take
        __io_set_input_pos(pos)
        if (pos == buffer_len) {
            __io_set_input_pos(0)
            __io_set_input_len(0)
        }
    }
    result.val = copied
    result.err = 0
    return result
}

// Read one line from stdin into `out`. Reading stops at `\n`, `\r\n`,
// or end of input. The line ending is consumed but not stored. The
// local line buffer is initialized to the exact size of the first
// chunk; when a line does not fit, it doubles up to 81920 bytes. A
// longer line is consumed through its line ending and
// reported as -2, which means "line too long" rather than a memory or
// read error. Returns 0 on success, -1 for a null `out`, a read error,
// or an allocation failure, and -2 for an over-long line. An empty
// string means an empty line or end of input with nothing pending.
func stdin_line(ptr<std::String> out) -> int32 {
    if (out == null) {
        return -1
    }
    view<[byte]> empty = null
    if ($(out).from(empty) != 0) {
        return -1
    }
    __IoLineBuffer line
    uint32 cap = 0
    uint32 len = 0
    uint8 too_long = 0
    while (1) {
        uint32 pos = __io_input_pos()
        uint32 buffer_len = __io_input_len()
        if (pos == buffer_len) {
            int32 fill = __io_fill()
            if (fill < 0) {
                if (cap != 0) {
                    line.data.uninit()
                }
                return -1
            }
            if (fill == 0) {
                break
            }
            pos = __io_input_pos()
            buffer_len = __io_input_len()
        }
        uint32 available = buffer_len - pos
        uint32 nl = __io_input_memchr(10, pos, available)
        uint32 take = available
        uint32 advance = available
        uint8 found = 0
        uint8 strip_cr = 0
        if (nl != 0xFFFFFFFF) {
            take = nl - pos
            advance = take
            found = 1
            if (take != 0) {
                // Drop the CR of a CRLF ending before the size check so
                // it does not count as line content.
                if (__io_input_byte(pos + take - 1) == 13) {
                    take = take - 1
                }
            } else {
                // The LF follows bytes from a previous chunk: a trailing
                // CR there is the CR of a split CRLF.
                strip_cr = 1
            }
        }
        if (too_long == 0 && take != 0) {
            uint32 needed = len + take
            if (needed > 81920) {
                too_long = 1
            } else {
                if (cap == 0) {
                    int32 st = line.data.init(needed)
                    if (st != 0) {
                        return -1
                    }
                    cap = needed
                } else {
                    while (cap < needed) {
                        uint32 next_cap = cap * 2
                        if (next_cap < needed) {
                            next_cap = needed
                        }
                        if (next_cap > 81920) {
                            next_cap = 81920
                        }
                        int32 st = line.data.resize(next_cap)
                        if (st != 0) {
                            line.data.uninit()
                            return -1
                        }
                        cap = next_cap
                    }
                }
                __io_input_copy_to(mview(line.data), len, pos, take)
                len = needed
            }
        }
        pos = pos + advance
        __io_set_input_pos(pos)
        if (found != 0) {
            pos = pos + 1
            __io_set_input_pos(pos)
            if (pos == buffer_len) {
                __io_set_input_pos(0)
                __io_set_input_len(0)
            }
            if (too_long == 0 && strip_cr != 0 && len != 0) {
                if (line.data[len - 1] == 13) {
                    len = len - 1
                }
            }
            break
        }
        if (pos == buffer_len) {
            __io_set_input_pos(0)
            __io_set_input_len(0)
        }
    }
    if (too_long != 0) {
        if (cap != 0) {
            line.data.uninit()
        }
        return -2
    }
    if (len == 0) {
        if (cap != 0) {
            line.data.uninit()
        }
        return 0
    }
    if (len != cap) {
        int32 st = line.data.resize(len)
        if (st != 0) {
            line.data.uninit()
            return -1
        }
    }
    int32 st = $(out).from(view(line.data))
    line.data.uninit()
    if (st != 0) {
        return -1
    }
    return 0
}

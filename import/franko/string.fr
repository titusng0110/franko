// ============================================================
// franko/string — dynamically sized byte strings
//
// Import with:
//
//   import "franko/string"
//
//   std::String s
//   s.from("hello")
//   s += " world"
//   s *= 3
//   s = "reset"
//
// Storage:
//
//   struct String {
//       [byte] _data          // actual buffer; length() is its capacity
//       uint32 _data_size     // number of live bytes in the buffer
//   }
//
// `_data.length()` is the buffer capacity. `_data_size` is the current
// string length in bytes and is what `length()` returns. Bytes past
// `_data_size` are unused buffer space. The buffer starts at 64 bytes
// and grows to the next power of two when full; it is only freed by
// `uninit()`.
//
// The backing array is pointer-only, so String is pointer-only: it
// cannot be passed or returned by value. Methods use `view<String>`
// for read-only access, `mview<String>` for in-place mutation, and
// `ptr<String>` for lifecycle/allocation operations.
//
// Lifecycle:
//
//   - `from(view<[byte]>)` / `from(view<String>)` replace the contents;
//   - `to(ptr<[byte]>)` copies the contents into a byte array, resizing
//     it to the exact logical length;
//   - `to(ptr<String>)` replaces another String;
//   - `clear()` resets the length to 0 and keeps the buffer for reuse;
//   - `shrink_to_fit()` releases unused buffer space;
//   - `uninit()` frees the backing buffer.
//
// `length()` reports the logical byte length. `is_utf8_compliant()`
// validates the stored bytes as UTF-8.
//
// Content operations:
//
//   - `append(...)` grows the string (the += operator calls it);
//   - `from_integer(...)` writes a primitive integer in decimal;
//   - `to_int8` ... `to_uint64` parse decimal, binary, or hexadecimal;
//   - `find`, `find_next`, `count`, and `count_from` search a byte, a
//     byte view, or another String;
//   - `get` and `set` access one byte;
//   - `get_slice` copies [start, end) into a String or byte array;
//   - `insert` and `erase` edit the contents in place;
//   - `split` fills a StringList and `join` concatenates a StringList.
//
// StringList:
//
//   struct StringList {
//       [String] _data         // buffer; _data.length() is capacity
//       uint32 _data_size = 0  // number of live elements
//   }
//
// StringList stores a buffered dynamic array of String values. The
// array length is the buffer capacity and `_data_size` is the live
// element count. The buffer starts at 64 elements and grows to the next
// power of two when full. Passing a null view to `from` releases the
// live elements and keeps the list buffer; `clear` resets the live
// elements in place, keeping both the list buffer and each element's
// String buffer; `shrink_to_fit` releases unused capacity; `uninit`
// frees every element and the buffer.
// ============================================================

namespace std {
    // Internal: next capacity for a growable String or StringList buffer.
    // Buffers start at 64 and always use the smallest power of two that
    // can hold the request, so growth follows 64, 128, 256, ... even
    // after shrink_to_fit leaves an odd capacity. Buffers are only freed
    // by uninit.
    func __string_grow_capacity(const uint32 cap, const uint32 payload) -> uint32 {
        uint32 target = 64
        while (target < cap) {
            if (target > 0xFFFFFFFF / 2) {
                return payload
            }
            target = target * 2
        }
        while (target < payload) {
            if (target > 0xFFFFFFFF / 2) {
                return payload
            }
            target = target * 2
        }
        return target
    }

    struct String {
        [byte] _data
        uint32 _data_size = 0

        // Replace this string with the bytes in `in`. A null view clears
        // the string. Returns 0 on success, -1 on allocation failure.
        func from(ptr<String> self, view<[byte]> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint8 self_source = 0
            if (in == getview($(self)._data)) {
                self_source = 1
            }
            uint32 n = $(in).length()
            if (self_source != 0) {
                n = $(self)._data_size
            }
            int32 st = $(self)._reserve(n)
            if (st != 0) {
                return -1
            }
            if (n != 0 && self_source == 0) {
                $(self)._data.memcpy(in)
            }
            $(self)._data_size = n
            return 0
        }

        // Replace this string with another string. A null view clears the
        // string. Returns 0 on success, -1 on allocation failure.
        func from(ptr<String> self, view<String> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            if (in == getview($(self))) {
                return 0
            }
            uint32 n = $(in)._data_size
            int32 st = $(self)._reserve(n)
            if (st != 0) {
                return -1
            }
            if (n != 0) {
                view<[byte]> src = getview($(in)._data)
                $(self)._data.memcpy(src, 0, 0, n)
            }
            $(self)._data_size = n
            return 0
        }

        // Internal: make sure `_data` has room for at least `payload`
        // bytes. The buffer starts at 64 bytes and grows to the next
        // power of two when full; it is only freed by uninit. Returns 0
        // on success, -1 on allocation failure.
        func _reserve(ptr<String> self, uint32 payload) -> int32 {
            if (payload == 0) {
                return 0
            }
            uint32 cap = $(self)._data.length()
            if (cap >= payload) {
                return 0
            }
            uint32 target = __string_grow_capacity(cap, payload)
            int32 st = 0
            if (cap == 0) {
                st = $(self)._data.init(target)
            } else {
                st = $(self)._data.resize(target)
            }
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Copy this string's bytes into `out`, resizing it to exactly the
        // logical length. Returns 0 on success, -1 for a null destination
        // or allocation failure.
        func to(view<String> self, ptr<[byte]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if (self == null) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            uint32 n = $(self)._data_size
            if (n == 0) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            if ($(out).length() == 0) {
                int32 st = $(out).init(n)
                if (st != 0) {
                    return -1
                }
            } else if ($(out).length() != n) {
                int32 st = $(out).resize(n)
                if (st != 0) {
                    return -1
                }
            }
            view<[byte]> src = getview($(self)._data)
            $(out).memcpy(src, 0, 0, n)
            return 0
        }

        // Replace `out` with a copy of this string. Returns 0 on success,
        // -1 for a null destination or allocation failure.
        func to(view<String> self, ptr<String> out) -> int32 {
            if (out == null) {
                return -1
            }
            return $(out).from(self)
        }

        // Current logical byte length.
        func length(view<String> self) -> uint32 {
            if (self == null) {
                return 0
            }
            return $(self)._data_size
        }

        // Return 1 when the stored bytes are valid UTF-8 and 0 otherwise.
        // Null and empty strings are valid. Overlong encodings, UTF-16
        // surrogates, and code points above U+10FFFF are rejected.
        func is_utf8_compliant(view<String> self) -> uint8 {
            if (self == null) {
                return 1
            }
            uint32 n = $(self)._data_size
            uint32 i = 0
            uint64 high_bits = 0x8080808080808080
            while (i < n) {
                // Fast path: eight ASCII bytes at a time.
                if (n - i >= 8) {
                    uint64 word = $(self)._data.read_uint64_LE(i)
                    if ((word & high_bits) == 0) {
                        i = i + 8
                        continue
                    }
                }
                uint8 b0 = $(self)._data[i]
                if (b0 < 0x80) {
                    i = i + 1
                    continue
                }
                uint32 need = 0
                uint8 lo = 0x80
                uint8 hi = 0xBF
                if (b0 >= 0xC2 && b0 <= 0xDF) {
                    need = 1
                } else if (b0 == 0xE0) {
                    need = 2
                    lo = 0xA0
                } else if ((b0 >= 0xE1 && b0 <= 0xEC) || (b0 >= 0xEE && b0 <= 0xEF)) {
                    need = 2
                } else if (b0 == 0xED) {
                    need = 2
                    hi = 0x9F
                } else if (b0 == 0xF0) {
                    need = 3
                    lo = 0x90
                } else if (b0 >= 0xF1 && b0 <= 0xF3) {
                    need = 3
                } else if (b0 == 0xF4) {
                    need = 3
                    hi = 0x8F
                } else {
                    return 0
                }
                if (n - i < need + 1) {
                    return 0
                }
                uint8 b1 = $(self)._data[i + 1]
                if (b1 < lo || b1 > hi) {
                    return 0
                }
                uint32 k = 2
                while (k <= need) {
                    uint8 bk = $(self)._data[i + k]
                    if (bk < 0x80 || bk > 0xBF) {
                        return 0
                    }
                    k = k + 1
                }
                i = i + need + 1
            }
            return 1
        }

        // Free the backing buffer and return to the empty state.
        func uninit(ptr<String> self) -> void {
            if ($(self)._data.length() != 0) {
                $(self)._data.uninit()
            }
            $(self)._data_size = 0
            return
        }

        // Clear the live contents while keeping the backing buffer
        // allocated for reuse.
        func clear(mview<String> self) -> void {
            $(self)._data_size = 0
            return
        }

        // Resize the backing buffer to the live length to release unused
        // memory. An empty string frees the buffer. Returns 0 on success,
        // -1 on allocation failure.
        func shrink_to_fit(ptr<String> self) -> int32 {
            uint32 n = $(self)._data_size
            uint32 cap = $(self)._data.length()
            if (n == 0) {
                if (cap != 0) {
                    $(self)._data.uninit()
                }
                return 0
            }
            if (n < cap) {
                int32 st = $(self)._data.resize(n)
                if (st != 0) {
                    return -1
                }
            }
            return 0
        }

        // Append one byte. Returns 0 on success, -1 on overflow or
        // allocation failure.
        func append(ptr<String> self, const byte payload) -> int32 {
            uint32 old = $(self)._data_size
            if (old == 0xFFFFFFFF) {
                return -1
            }
            int32 st = $(self)._reserve(old + 1)
            if (st != 0) {
                return -1
            }
            $(self)._data[old] = payload
            $(self)._data_size = old + 1
            return 0
        }

        // Append the bytes in `payload`. Returns 0 on success, -1 on
        // overflow or allocation failure. Appending the string's own
        // buffer is handled without copying stale bytes.
        func append(ptr<String> self, view<[byte]> payload) -> int32 {
            if (payload == null) {
                return 0
            }
            uint32 n = $(payload).length()
            if (n == 0) {
                return 0
            }
            uint8 self_source = 0
            if (payload == getview($(self)._data)) {
                self_source = 1
            }
            uint32 old = $(self)._data_size
            if (self_source != 0) {
                n = old
            }
            if (n == 0) {
                return 0
            }
            if (old > 0xFFFFFFFF - n) {
                return -1
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return -1
            }
            if (self_source != 0) {
                $(self)._data.memmove(old, 0, n)
            } else {
                $(self)._data.memcpy(payload, old, 0, n)
            }
            $(self)._data_size = old + n
            return 0
        }

        // Append another string. Returns 0 on success, -1 on overflow
        // or allocation failure.
        func append(ptr<String> self, view<String> payload) -> int32 {
            if (payload == null) {
                return 0
            }
            uint32 n = $(payload)._data_size
            if (n == 0) {
                return 0
            }
            uint8 self_source = 0
            if (payload == getview($(self))) {
                self_source = 1
            }
            uint32 old = $(self)._data_size
            if (self_source != 0) {
                n = old
            }
            if (n == 0) {
                return 0
            }
            if (old > 0xFFFFFFFF - n) {
                return -1
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return -1
            }
            if (self_source != 0) {
                $(self)._data.memmove(old, 0, n)
            } else {
                view<[byte]> src = getview($(payload)._data)
                $(self)._data.memcpy(src, old, 0, n)
            }
            $(self)._data_size = old + n
            return 0
        }

        // Replace this string with the decimal representation of a
        // int8. Negative values include a leading '-'. Returns 0 on
        // success, -1 on allocation failure.
        func from_integer(ptr<String> self, const int8 value) -> int32 {
            int64 v = cast<int64>(value)
            uint8 negative = 0
            if (v < 0) {
                negative = 1
            }
            int32 st = $(self)._reserve(20)
            if (st != 0) {
                return -1
            }
            uint32 len = 0
            while (1) {
                int64 rem = v % 10
                if (negative != 0) {
                    rem = -rem
                }
                $(self)._data[len] = unsafe_cast<byte>(rem + 48)
                len = len + 1
                v = v / 10
                if (v == 0) {
                    break
                }
            }
            uint32 a = 0
            uint32 b = len - 1
            while (a < b) {
                byte tmp = $(self)._data[a]
                $(self)._data[a] = $(self)._data[b]
                $(self)._data[b] = tmp
                a = a + 1
                b = b - 1
            }
            if (negative != 0) {
                $(self)._data.memmove(1, 0, len)
                $(self)._data[0] = 45
                len = len + 1
            }
            $(self)._data_size = len
            return 0
        }

        // Replace this string with the decimal representation of a
        // int16. Negative values include a leading '-'. Returns 0 on
        // success, -1 on allocation failure.
        func from_integer(ptr<String> self, const int16 value) -> int32 {
            int64 v = cast<int64>(value)
            uint8 negative = 0
            if (v < 0) {
                negative = 1
            }
            int32 st = $(self)._reserve(20)
            if (st != 0) {
                return -1
            }
            uint32 len = 0
            while (1) {
                int64 rem = v % 10
                if (negative != 0) {
                    rem = -rem
                }
                $(self)._data[len] = unsafe_cast<byte>(rem + 48)
                len = len + 1
                v = v / 10
                if (v == 0) {
                    break
                }
            }
            uint32 a = 0
            uint32 b = len - 1
            while (a < b) {
                byte tmp = $(self)._data[a]
                $(self)._data[a] = $(self)._data[b]
                $(self)._data[b] = tmp
                a = a + 1
                b = b - 1
            }
            if (negative != 0) {
                $(self)._data.memmove(1, 0, len)
                $(self)._data[0] = 45
                len = len + 1
            }
            $(self)._data_size = len
            return 0
        }


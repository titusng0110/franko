            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            uint32 m = 0
            if (substring != null) {
                m = $(substring).length()
            }
            if (start_idx > n) {
                return 0
            }
            if (m == 0) {
                return n - start_idx + 1
            }
            if (self == null || substring == null || n - start_idx < m) {
                return 0
            }
            uint32 total = 0
            uint32 i = start_idx
            while (i <= n - m) {
                uint32 hit = $(self)._data.memmem(substring, i, n - i)
                if (hit == 0xFFFFFFFF) {
                    break
                }
                total = total + 1
                i = hit + 1
            }
            return total
        }

        // Count overlapping occurrences of another string at or after
        // `start_idx`.
        func count_from(view<String> self, view<String> substring, const uint32 start_idx) -> uint32 {
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            uint32 m = 0
            if (substring != null) {
                m = $(substring)._data_size
            }
            if (start_idx > n) {
                return 0
            }
            if (m == 0) {
                return n - start_idx + 1
            }
            if (self == null) {
                return 0
            }
            if (substring == null) {
                return 0
            }
            if (n - start_idx < m) {
                return 0
            }
            view<[byte]> needle_data = getview($(substring)._data)
            byte first = $(substring)._data[0]
            uint32 total = 0
            uint32 i = start_idx
            while (i <= n - m) {
                uint32 hit = $(self)._data.memchr(first, i, n - i)
                if (hit == 0xFFFFFFFF) {
                    break
                }
                if (hit > n - m) {
                    break
                }
                if ($(self)._data.memcmp(needle_data, hit, 0, m) == 0) {
                    total = total + 1
                }
                i = hit + 1
            }
            return total
        }

        // Read one byte. Returns 0 for a null string or an out-of-range
        // index.
        func get(view<String> self, const uint32 idx) -> byte {
            if (self == null) {
                return 0
            }
            if (idx >= $(self)._data_size) {
                return 0
            }
            return $(self)._data[idx]
        }

        // Write one byte. A null string or an out-of-range index is
        // ignored.
        func set(mview<String> self, const uint32 idx, const byte value) -> void {
            if (self == null) {
                return
            }
            if (idx >= $(self)._data_size) {
                return
            }
            $(self)._data[idx] = value
            return
        }

        // Copy [start, end) into `out`, completely replacing it. Returns
        // 0 on success, -1 for a null destination, an invalid range, or
        // an allocation failure.
        func get_slice(view<String> self, const uint32 start, const uint32 end, ptr<String> out) -> int32 {
            if (out == null) {
                return -1
            }
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            if (start > end || end > n) {
                return -1
            }
            uint32 len = end - start
            if (getview($(out)) == self) {
                if (len == 0) {
                    if ($(out).length() != 0) {
                        $(out).uninit()
                    }
                    return 0
                }
                $(out)._data.memmove(0, start, len)
                $(out)._data_size = len
                return 0
            }
            if (len == 0) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            int32 st = $(out)._reserve(len)
            if (st != 0) {
                return -1
            }
            view<[byte]> src = getview($(self)._data)
            $(out)._data.memcpy(src, 0, start, len)
            $(out)._data_size = len
            return 0
        }

        // Copy [start, end) into a byte array, completely replacing it.
        // Returns 0 on success, -1 for a null destination, an invalid
        // range, or an allocation failure.
        func get_slice(view<String> self, const uint32 start, const uint32 end, ptr<[byte]> out) -> int32 {
            if (out == null) {
                return -1
            }
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            if (start > end || end > n) {
                return -1
            }
            uint32 len = end - start
            uint8 self_source = 0
            if (self != null && getview($(out)) == getview($(self)._data)) {
                self_source = 1
            }
            if (len == 0) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            if (self_source != 0) {
                $(out).memmove(0, start, len)
                if ($(out).length() != len) {
                    int32 st = $(out).resize(len)
                    if (st != 0) {
                        return -1
                    }
                }
                return 0
            }
            if ($(out).length() == 0) {
                int32 st = $(out).init(len)
                if (st != 0) {
                    return -1
                }
            } else if ($(out).length() != len) {
                int32 st = $(out).resize(len)
                if (st != 0) {
                    return -1
                }
            }
            view<[byte]> src = getview($(self)._data)
            $(out).memcpy(src, 0, start, len)
            return 0
        }

        // Insert one byte at `idx`. Returns 0 on success, -1 for an
        // out-of-range index, overflow, or allocation failure.
        func insert(ptr<String> self, const byte payload, const uint32 idx) -> int32 {
            uint32 old = $(self)._data_size
            if (idx > old) {
                return -1
            }
            if (old == 0xFFFFFFFF) {
                return -1
            }
            int32 st = $(self)._reserve(old + 1)
            if (st != 0) {
                return -1
            }
            $(self)._data.memmove(idx + 1, idx, old - idx)
            $(self)._data[idx] = payload
            $(self)._data_size = old + 1
            return 0
        }

        // Insert a byte substring at `idx`.
        func insert(ptr<String> self, view<[byte]> payload, const uint32 idx) -> int32 {
            uint32 old = $(self)._data_size
            if (idx > old) {
                return -1
            }
            uint32 n = 0
            if (payload != null) {
                n = $(payload).length()
            }
            if (n == 0) {
                return 0
            }
            if (payload == null) {
                return 0
            }
            uint8 self_source = 0
            if (payload == getview($(self)._data)) {
                self_source = 1
            }
            if (self_source != 0) {
                n = old
            }
            if (n == 0) {
                return 0
            }
            if (old > 0xFFFFFFFF - n) {
                return -1
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return -1
            }
            $(self)._data.memmove(idx + n, idx, old - idx)
            if (self_source != 0) {
                $(self)._data.memmove(idx, 0, n)
            } else {
                $(self)._data.memcpy(payload, idx, 0, n)
            }
            $(self)._data_size = old + n
            return 0
        }

        // Insert another string at `idx`.
        func insert(ptr<String> self, view<String> payload, const uint32 idx) -> int32 {
            uint32 old = $(self)._data_size
            if (idx > old) {
                return -1
            }
            uint32 n = 0
            if (payload != null) {
                n = $(payload)._data_size
            }
            if (n == 0) {
                return 0
            }
            if (payload == null) {
                return 0
            }
            uint8 self_source = 0
            if (payload == getview($(self))) {
                self_source = 1
            }
            if (self_source != 0) {
                n = old
            }
            if (n == 0) {
                return 0
            }
            if (old > 0xFFFFFFFF - n) {
                return -1
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return -1
            }
            $(self)._data.memmove(idx + n, idx, old - idx)
            if (self_source != 0) {
                $(self)._data.memmove(idx, 0, n)
            } else {
                view<[byte]> src = getview($(payload)._data)
                $(self)._data.memcpy(src, idx, 0, n)
            }
            $(self)._data_size = old + n
            return 0
        }

        // Erase the byte at `idx`. Returns 0 on success, -1 when `idx`
        // is out of range.
        func erase(mview<String> self, const uint32 idx) -> int32 {
            uint32 n = $(self)._data_size
            if (idx >= n) {
                return -1
            }
            uint32 tail = n - idx - 1
            if (tail != 0) {
                $(self)._data.memmove(idx, idx + 1, tail)
            }
            $(self)._data_size = n - 1
            return 0
        }

        // Erase [start, end). Returns 0 on success, -1 for an invalid
        // range.
        func erase(mview<String> self, const uint32 start, const uint32 end) -> int32 {
            uint32 n = $(self)._data_size
            if (start > end || end > n) {
                return -1
            }
            uint32 len = end - start
            if (len == 0) {
                return 0
            }
            uint32 tail = n - end
            if (tail != 0) {
                $(self)._data.memmove(start, end, tail)
            }
            $(self)._data_size = n - len
            return 0
        }

        // Split on one byte. Completely replaces the live contents of
        // `out`; the buffer is reused. Every delimiter produces a
        // segment, including empty leading, trailing, and consecutive
        // segments.
        func split(view<String> self, const byte splitter, ptr<StringList> out) -> int32 {
            if (out == null) {
                return -1
            }
            uint32 old_out = $(out)._data_size
            uint32 i = 0
            while (i < old_out) {
                $(out)._data[i].uninit()
                i = i + 1
            }
            $(out)._data_size = 0
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            uint32 segments = 1
            uint32 scan = 0
            while (1) {
                uint32 hit = 0xFFFFFFFF
                if (self != null) {
                    hit = $(self)._data.memchr(splitter, scan, n - scan)
                }
                if (hit == 0xFFFFFFFF) {
                    break
                }
                segments = segments + 1
                scan = hit + 1
            }
            uint32 cap = $(out)._data.length()
            if (cap < segments) {
                uint32 target = __string_grow_capacity(cap, segments)
                int32 st = 0
                if (cap == 0) {
                    st = $(out)._data.init(target)
                } else {
                    st = $(out)._data.resize(target)
                }
                if (st != 0) {
                    return -1
                }
            }
            $(out)._data_size = segments
            uint32 start = 0
            scan = 0
            uint32 seg = 0
            while (1) {
                uint32 hit = 0xFFFFFFFF
                if (self != null) {
                    hit = $(self)._data.memchr(splitter, scan, n - scan)
                }
                uint32 end = n
                uint8 found = 0
                if (hit != 0xFFFFFFFF) {
                    end = hit
                    found = 1
                }
                uint32 len = end - start
                ptr<String> dest = getptr($(out)._data[seg])
                int32 st = $(dest)._reserve(len)
                if (st != 0) {
                    return -1
                }
                if (len != 0) {
                    if (self != null) {
                        $(dest)._data.memcpy(getview($(self)._data), 0, start, len)
                    }
                }
                $(dest)._data_size = len
                seg = seg + 1
                if (found == 0) {
                    break
                }
                start = end + 1
                scan = start
            }
            return 0
        }

        // Split on a byte substring. An empty or null splitter does not
        // split; the whole string becomes the only segment. The buffer
        // is reused.
        func split(view<String> self, view<[byte]> splitter, ptr<StringList> out) -> int32 {
            if (out == null) {
                return -1
            }
            uint32 old_out = $(out)._data_size
            uint32 i = 0
            while (i < old_out) {
                $(out)._data[i].uninit()
                i = i + 1
            }
            $(out)._data_size = 0
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            uint32 m = 0
            if (splitter != null) {
                m = $(splitter).length()
            }
            uint32 segments = 1
            if (m != 0) {
                if (splitter == null) {
                    return -1
                }
                if (self != null) {
                    uint32 scan = 0
                    while (n - scan >= m) {
                        uint32 hit = $(self)._data.memmem(splitter, scan, n - scan)
                        if (hit == 0xFFFFFFFF) {
                            break
                        }
                        segments = segments + 1
                        scan = hit + m
                    }
                }
            }
            uint32 cap = $(out)._data.length()
            if (cap < segments) {
                uint32 target = __string_grow_capacity(cap, segments)
                int32 st = 0
                if (cap == 0) {
                    st = $(out)._data.init(target)
                } else {
                    st = $(out)._data.resize(target)
                }
                if (st != 0) {
                    return -1
                }
            }
            $(out)._data_size = segments
            uint32 start = 0
            uint32 scan = 0
            uint32 seg = 0
            while (1) {
                uint32 end = n
                uint8 found = 0
                if (m != 0) {
                    if (splitter != null) {
                        if (self != null) {
                            if (n - scan >= m) {
                                uint32 hit = $(self)._data.memmem(splitter, scan, n - scan)
                                if (hit != 0xFFFFFFFF) {
                                    end = hit
                                    found = 1
                                }
                            }
                        }
                    }
                }
                uint32 len = end - start
                ptr<String> dest = getptr($(out)._data[seg])
                int32 st = $(dest)._reserve(len)
                if (st != 0) {
                    return -1
                }
                if (len != 0) {
                    if (self != null) {
                        $(dest)._data.memcpy(getview($(self)._data), 0, start, len)
                    }
                }
                $(dest)._data_size = len
                seg = seg + 1
                if (found == 0) {
                    break
                }
                start = end + m
                scan = start
            }
            return 0
        }

        // Split on another string. An empty or null splitter does not
        // split; the whole string becomes the only segment. The buffer
        // is reused.
        func split(view<String> self, view<String> splitter, ptr<StringList> out) -> int32 {
            if (out == null) {
                return -1
            }
            uint32 old_out = $(out)._data_size
            uint32 i = 0
            while (i < old_out) {
                $(out)._data[i].uninit()
                i = i + 1
            }
            $(out)._data_size = 0
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            uint32 m = 0
            if (splitter != null) {
                m = $(splitter)._data_size
            }
            view<[byte]> splitter_data = null
            if (splitter != null) {
                splitter_data = getview($(splitter)._data)
            }
            uint32 segments = 1
            if (m != 0) {
                if (splitter_data == null) {
                    return -1
                }
                if (self != null) {
                    uint32 scan = 0
                    while (n - scan >= m) {
                        if ($(self)._data.memcmp(splitter_data, scan, 0, m) == 0) {
                            segments = segments + 1
                            scan = scan + m
                        } else {
                            scan = scan + 1
                        }
                    }
                }
            }
            uint32 cap = $(out)._data.length()
            if (cap < segments) {
                uint32 target = __string_grow_capacity(cap, segments)
                int32 st = 0
                if (cap == 0) {
                    st = $(out)._data.init(target)
                } else {
                    st = $(out)._data.resize(target)
                }
                if (st != 0) {
                    return -1
                }
            }
            $(out)._data_size = segments
            uint32 start = 0
            uint32 scan = 0
            uint32 seg = 0
            while (1) {
                uint32 end = n
                uint8 found = 0
                if (m != 0) {
                    if (splitter_data != null) {
                        if (self != null) {
                            while (n - scan >= m) {
                                if ($(self)._data.memcmp(splitter_data, scan, 0, m) == 0) {
                                    end = scan
                                    found = 1
                                    break
                                }
                                scan = scan + 1
                            }
                        }
                    }
                }
                uint32 len = end - start
                ptr<String> dest = getptr($(out)._data[seg])
                int32 st = $(dest)._reserve(len)
                if (st != 0) {
                    return -1
                }
                if (len != 0) {
                    if (self != null) {
                        $(dest)._data.memcpy(getview($(self)._data), 0, start, len)
                    }
                }
                $(dest)._data_size = len
                seg = seg + 1
                if (found == 0) {
                    break
                }
                start = end + m
                scan = start
            }
            return 0
        }

        // Replace this string with the concatenation of every string in
        // `in`. Returns 0 on success, -1 on overflow or allocation
        // failure.
        func join(ptr<String> self, view<StringList> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint32 count = $(in)._data_size
            view<String> self_view = getview($(self))
            uint8 self_source = 0
            uint32 total = 0
            uint32 i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (total > 0xFFFFFFFF - piece) {
                    return -1
                }
                total = total + piece
                if (getview($(in)._data[i]) == self_view) {
                    self_source = 1
                }
                i = i + 1
            }
            if (total == 0) {
                $(self)._data_size = 0
                return 0
            }
            String result
            ptr<String> dest = self
            if (self_source != 0) {
                dest = getptr(result)
            }
            int32 st = $(dest)._reserve(total)
            if (st != 0) {
                result.uninit()
                return -1
            }
            uint32 pos = 0
            i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (piece != 0) {
                    view<[byte]> src = getview($(in)._data[i]._data)
                    $(dest)._data.memcpy(src, pos, 0, piece)
                    pos = pos + piece
                }
                i = i + 1
            }
            $(dest)._data_size = pos
            if (self_source != 0) {
                st = $(self)._reserve(total)
                if (st != 0) {
                    result.uninit()
                    return -1
                }
                $(self)._data.memcpy(getview(result._data), 0, 0, total)
                $(self)._data_size = total
                result.uninit()
            }
            return 0
        }

        // Replace this string with `in` joined by one byte.
        func join(ptr<String> self, const byte joiner, view<StringList> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint32 count = $(in)._data_size
            view<String> self_view = getview($(self))
            uint8 self_source = 0
            uint32 total = 0
            uint32 i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (total > 0xFFFFFFFF - piece) {
                    return -1
                }
                total = total + piece
                if (getview($(in)._data[i]) == self_view) {
                    self_source = 1
                }
                if (i + 1 < count) {
                    if (total == 0xFFFFFFFF) {
                        return -1
                    }
                    total = total + 1
                }
                i = i + 1
            }
            if (total == 0) {
                $(self)._data_size = 0
                return 0
            }
            String result
            ptr<String> dest = self
            if (self_source != 0) {
                dest = getptr(result)
            }
            int32 st = $(dest)._reserve(total)
            if (st != 0) {
                result.uninit()
                return -1
            }
            uint32 pos = 0
            i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (piece != 0) {
                    view<[byte]> src = getview($(in)._data[i]._data)
                    $(dest)._data.memcpy(src, pos, 0, piece)
                    pos = pos + piece
                }
                if (i + 1 < count) {
                    $(dest)._data[pos] = joiner
                    pos = pos + 1
                }
                i = i + 1
            }
            $(dest)._data_size = pos
            if (self_source != 0) {
                st = $(self)._reserve(total)
                if (st != 0) {
                    result.uninit()
                    return -1
                }
                $(self)._data.memcpy(getview(result._data), 0, 0, total)
                $(self)._data_size = total
                result.uninit()
            }
            return 0
        }

        // Replace this string with `in` joined by a byte substring.
        func join(ptr<String> self, view<[byte]> joiner, view<StringList> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint32 count = $(in)._data_size
            uint32 joiner_len = 0
            if (joiner != null) {
                joiner_len = $(joiner).length()
            }
            view<String> self_view = getview($(self))
            uint8 self_source = 0
            uint32 total = 0
            uint32 i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (total > 0xFFFFFFFF - piece) {
                    return -1
                }
                total = total + piece
                if (getview($(in)._data[i]) == self_view) {
                    self_source = 1
                }
                if (i + 1 < count) {
                    if (total > 0xFFFFFFFF - joiner_len) {
                        return -1
                    }
                    total = total + joiner_len
                }
                i = i + 1
            }
            if (total == 0) {
                $(self)._data_size = 0
                return 0
            }
            uint8 joiner_source = 0
            if (joiner != null && joiner == getview($(self)._data)) {
                joiner_source = 1
            }
            String result
            ptr<String> dest = self
            if (self_source != 0 || joiner_source != 0) {
                dest = getptr(result)
            }
            int32 st = $(dest)._reserve(total)
            if (st != 0) {
                result.uninit()
                return -1
            }
            uint32 pos = 0
            i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (piece != 0) {
                    view<[byte]> src = getview($(in)._data[i]._data)
                    $(dest)._data.memcpy(src, pos, 0, piece)
                    pos = pos + piece
                }
                if (i + 1 < count) {
                    if (joiner != null) {
                        if (joiner_len != 0) {
                            $(dest)._data.memcpy(joiner, pos, 0, joiner_len)
                            pos = pos + joiner_len
                        }
                    }
                }
                i = i + 1
            }
            $(dest)._data_size = pos
            if (self_source != 0 || joiner_source != 0) {
                st = $(self)._reserve(total)
                if (st != 0) {
                    result.uninit()
                    return -1
                }
                $(self)._data.memcpy(getview(result._data), 0, 0, total)
                $(self)._data_size = total
                result.uninit()
            }
            return 0
        }

        // Replace this string with `in` joined by another string.
        func join(ptr<String> self, view<String> joiner, view<StringList> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint32 count = $(in)._data_size
            uint32 joiner_len = 0
            if (joiner != null) {
                joiner_len = $(joiner)._data_size
            }
            view<String> self_view = getview($(self))
            uint8 self_source = 0
            uint32 total = 0
            uint32 i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (total > 0xFFFFFFFF - piece) {
                    return -1
                }
                total = total + piece
                if (getview($(in)._data[i]) == self_view) {
                    self_source = 1
                }
                if (i + 1 < count) {
                    if (total > 0xFFFFFFFF - joiner_len) {
                        return -1
                    }
                    total = total + joiner_len
                }
                i = i + 1
            }
            if (total == 0) {
                $(self)._data_size = 0
                return 0
            }
            uint8 joiner_source = 0
            if (joiner != null && joiner == self_view) {
                joiner_source = 1
            }
            String result
            ptr<String> dest = self
            if (self_source != 0 || joiner_source != 0) {
                dest = getptr(result)
            }
            int32 st = $(dest)._reserve(total)
            if (st != 0) {
                result.uninit()
                return -1
            }
            uint32 pos = 0
            i = 0
            while (i < count) {
                uint32 piece = $(in)._data[i]._data_size
                if (piece != 0) {
                    view<[byte]> src = getview($(in)._data[i]._data)
                    $(dest)._data.memcpy(src, pos, 0, piece)
                    pos = pos + piece
                }
                if (i + 1 < count) {
                    if (joiner != null) {
                        if (joiner_len != 0) {
                            $(dest)._data.memcpy(getview($(joiner)._data), pos, 0, joiner_len)
                            pos = pos + joiner_len
                        }
                    }
                }
                i = i + 1
            }
            $(dest)._data_size = pos
            if (self_source != 0 || joiner_source != 0) {
                st = $(self)._reserve(total)
                if (st != 0) {
                    result.uninit()
                    return -1
                }
                $(self)._data.memcpy(getview(result._data), 0, 0, total)
                $(self)._data_size = total
                result.uninit()
            }
            return 0
        }

        func OPERATOR_EQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) == 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_NEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) != 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_LT(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) < 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_GT(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) > 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_LTEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) <= 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_GTEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) >= 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_MOV(ptr<String> self, view<[byte]> other) -> void {
            $(self).from(other)
            return
        }

        func OPERATOR_MOV(ptr<String> self, view<String> other) -> void {
            $(self).from(other)
            return
        }

        func OPERATOR_MOV(ptr<String> self, view<view<[byte]>> other) -> void {
            if (other == null) {
                $(self)._data_size = 0
                return
            }
            $(self).from($(other))
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<[byte]> other) -> void {
            $(self).append(other)
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<String> other) -> void {
            $(self).append(other)
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<view<[byte]>> other) -> void {
            if (other == null) {
                return
            }
            $(self).append($(other))
            return
        }

        func OPERATOR_MULMOV(ptr<String> self, view<uint32> other) -> void {
            if (other == null) {
                return
            }
            uint32 multiplier = $(other)
            if (multiplier == 0) {
                $(self)._data_size = 0
                return
            }
            uint32 len = $(self)._data_size
            if (len == 0) {
                return
            }
            if (multiplier > 0xFFFFFFFF / len) {
                return
            }
            uint32 total = len * multiplier
            int32 st = $(self)._reserve(total)
            if (st != 0) {
                return
            }
            uint32 filled = len
            while (filled < total) {
                uint32 chunk = filled
                if (chunk > total - filled) {
                    chunk = total - filled
                }
                $(self)._data.memmove(filled, 0, chunk)
                filled = filled + chunk
            }
            $(self)._data_size = total
            return
        }

        func _compare(view<String> self, view<String> other) -> int32 {
            if (self == null && other == null) {
                return 0
            }
            if (self == null) {
                return -1
            }
            if (other == null) {
                return 1
            }
            uint32 a = $(self)._data_size
            uint32 b = $(other)._data_size
            uint32 common = a
            if (b < common) {
                common = b
            }
            if (common != 0) {
                int32 cmp = $(self)._data.memcmp(getview($(other)._data), 0, 0, common)
                if (cmp != 0) {
                    return cmp
                }
            }
            if (a < b) {
                return -1
            }
            if (a > b) {
                return 1
            }
            return 0
        }
    }

    // ============================================================
    // StringList — a dynamic array of String values
    //
    // Storage:
    //
    //   struct StringList {
    //       [String] _data         // buffer; _data.length() is capacity
    //       uint32 _data_size = 0  // number of live elements
    //   }
    //
    // `_data.length()` is the buffer capacity. `_data_size` is the live
    // element count and is what `length()` returns. The buffer starts
    // at 64 elements and grows to the next power of two when full.
    //
    // Every live element owns its own String buffer. `from` replaces the
    // live contents and keeps the list buffer; `clear` resets the live
    // elements in place, keeping both the list buffer and each element's
    // String buffer; `shrink_to_fit` releases unused capacity; `uninit`
    // frees every element and the buffer.
    // ============================================================
    struct StringList {
        [String] _data
        uint32 _data_size = 0

        // Number of live strings in the list.
        func length(view<StringList> self) -> uint32 {
            if (self == null) {
                return 0
            }
            return $(self)._data_size
        }

        // Internal: make sure `_data` has room for at least `payload`
        // elements. The buffer starts at 64 elements and grows to the
        // next power of two when full; it is only freed by uninit.
        // Returns 0 on success, -1 on allocation failure.
        func _reserve(ptr<StringList> self, uint32 payload) -> int32 {
            if (payload == 0) {
                return 0
            }
            uint32 cap = $(self)._data.length()
            if (cap >= payload) {
                return 0
            }
            uint32 target = __string_grow_capacity(cap, payload)
            int32 st = 0
            if (cap == 0) {
                st = $(self)._data.init(target)
            } else {
                st = $(self)._data.resize(target)
            }
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Free every live element and the backing buffer.
        func uninit(ptr<StringList> self) -> void {
            uint32 n = $(self)._data_size
            uint32 i = 0
            while (i < n) {
                $(self)._data[i].uninit()
                i = i + 1
            }
            if ($(self)._data.length() != 0) {
                $(self)._data.uninit()
            }
            $(self)._data_size = 0
            return
        }

        // Clear every live element while keeping the list's backing
        // buffer and each element's String buffer allocated for reuse.
        func clear(mview<StringList> self) -> void {
            uint32 n = $(self)._data_size
            uint32 i = 0
            while (i < n) {
                $(self)._data[i].clear()
                i = i + 1
            }
            $(self)._data_size = 0
            return
        }

        // Resize the backing buffer to the live element count to release
        // unused memory. An empty list frees the buffer. Returns 0 on
        // success, -1 on allocation failure.
        func shrink_to_fit(ptr<StringList> self) -> int32 {
            uint32 n = $(self)._data_size
            uint32 cap = $(self)._data.length()
            if (n == 0) {
                if (cap != 0) {
                    $(self)._data.uninit()
                }
                return 0
            }
            if (n < cap) {
                int32 st = $(self)._data.resize(n)
                if (st != 0) {
                    return -1
                }
            }
            return 0
        }

        // Replace the list with a copy of another list's live elements.
        func from(ptr<StringList> self, view<StringList> in) -> int32 {
            if (in != null && in == getview($(self))) {
                return 0
            }
            uint32 old = $(self)._data_size
            uint32 i = 0
            while (i < old) {
                $(self)._data[i].uninit()
                i = i + 1
            }
            $(self)._data_size = 0
            if (in == null) {
                return 0
            }
            uint32 n = $(in)._data_size
            if (n == 0) {
                return 0
            }
            int32 st = $(self)._reserve(n)
            if (st != 0) {
                return -1
            }
            $(self)._data_size = n
            i = 0
            while (i < n) {
                st = $(self)._data[i].from(getview($(in)._data[i]))
                if (st != 0) {
                    return -1
                }
                i = i + 1
            }
            return 0
        }

        // Append one String copied from a byte array.
        func append(ptr<StringList> self, view<[byte]> in) -> int32 {
            uint32 old = $(self)._data_size
            if (old == 0xFFFFFFFF) {
                return -1
            }
            int32 st = $(self)._reserve(old + 1)
            if (st != 0) {
                return -1
            }
            $(self)._data_size = old + 1
            st = $(self)._data[old].from(in)
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Append one String copied from another string.
        func append(ptr<StringList> self, view<String> in) -> int32 {
            uint32 old = $(self)._data_size
            if (old == 0xFFFFFFFF) {
                return -1
            }
            int32 st = $(self)._reserve(old + 1)
            if (st != 0) {
                return -1
            }
            $(self)._data_size = old + 1
            st = $(self)._data[old].from(in)
            if (st != 0) {
                return -1
            }
            return 0
        }

        func OPERATOR_ADDMOV(ptr<StringList> self, view<[byte]> other) -> void {
            $(self).append(other)
            return
        }

        func OPERATOR_ADDMOV(ptr<StringList> self, view<String> other) -> void {
            $(self).append(other)
            return
        }

        func OPERATOR_ADDMOV(ptr<StringList> self, view<view<[byte]>> other) -> void {
            if (other == null) {
                return
            }
            $(self).append($(other))
            return
        }

        // Find the first element equal to `needle`. Returns (idx, err):
        // err is 0 when found and -1 otherwise; idx is 0 on failure.
        func find(view<StringList> self, view<String> needle) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if (self == null) {
                return result
            }
            uint32 n = $(self)._data_size
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 i = 0
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        result.idx = i
                        result.err = 0
                        return result
                    }
                }
                i = i + 1
            }
            return result
        }

        // Find the first element equal to a byte array.
        func find(view<StringList> self, view<[byte]> needle) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if (self == null) {
                return result
            }
            uint32 n = $(self)._data_size
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 i = 0
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        result.idx = i
                        result.err = 0
                        return result
                    }
                }
                i = i + 1
            }
            return result
        }

        // Find the first element equal to `needle` at or after
        // `start_idx`.
        func find_next(view<StringList> self, view<String> needle, const uint32 start_idx) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if (self == null) {
                return result
            }
            uint32 n = $(self)._data_size
            if (start_idx >= n) {
                return result
            }
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 i = start_idx
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        result.idx = i
                        result.err = 0
                        return result
                    }
                }
                i = i + 1
            }
            return result
        }

        // Find the first element equal to a byte array at or after
        // `start_idx`.
        func find_next(view<StringList> self, view<[byte]> needle, const uint32 start_idx) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if (self == null) {
                return result
            }
            uint32 n = $(self)._data_size
            if (start_idx >= n) {
                return result
            }
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 i = start_idx
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        result.idx = i
                        result.err = 0
                        return result
                    }
                }
                i = i + 1
            }
            return result
        }

        // Count elements equal to `needle`.
        func count(view<StringList> self, view<String> needle) -> uint32 {
            if (self == null) {
                return 0
            }
            uint32 n = $(self)._data_size
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 total = 0
            uint32 i = 0
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        total = total + 1
                    }
                }
                i = i + 1
            }
            return total
        }

        // Count elements equal to a byte array.
        func count(view<StringList> self, view<[byte]> needle) -> uint32 {
            if (self == null) {
                return 0
            }
            uint32 n = $(self)._data_size
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 total = 0
            uint32 i = 0
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        total = total + 1
                    }
                }
                i = i + 1
            }
            return total
        }

        // Count elements equal to `needle` at or after `start_idx`.
        func count_from(view<StringList> self, view<String> needle, const uint32 start_idx) -> uint32 {
            if (self == null) {
                return 0
            }
            uint32 n = $(self)._data_size
            if (start_idx >= n) {
                return 0
            }
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 total = 0
            uint32 i = start_idx
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        total = total + 1
                    }
                }
                i = i + 1
            }
            return total
        }

        // Count elements equal to a byte array at or after `start_idx`.
        func count_from(view<StringList> self, view<[byte]> needle, const uint32 start_idx) -> uint32 {
            if (self == null) {
                return 0
            }
            uint32 n = $(self)._data_size
            if (start_idx >= n) {
                return 0
            }
            uint32 needle_len = 0
            if (needle != null) {
                needle_len = $(needle).length()
            }
            uint32 total = 0
            uint32 i = start_idx
            while (i < n) {
                if ($(self)._data[i].length() == needle_len) {
                    (uint32 idx, int32 err) found = $(self)._data[i].find(needle)
                    if (found.err == 0 && found.idx == 0) {
                        total = total + 1
                    }
                }
                i = i + 1
            }
            return total
        }

        // Copy element `idx` into `out`, completely replacing it. Returns
        // 0 on success, -1 for a null destination or an out-of-range
        // index.
        func get(view<StringList> self, const uint32 idx, ptr<String> out) -> int32 {
            if (out == null) {
                return -1
            }
            if (self == null) {
                return -1
            }
            if (idx >= $(self)._data_size) {
                return -1
            }
            return $(out).from(getview($(self)._data[idx]))
        }

        // Copy element `idx` into a byte array, completely replacing it.
        func get(view<StringList> self, const uint32 idx, ptr<[byte]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if (self == null) {
                return -1
            }
            if (idx >= $(self)._data_size) {
                return -1
            }
            return $(self)._data[idx].to(out)
        }

        // Replace element `idx` with a copy of `value`.
        func set(ptr<StringList> self, const uint32 idx, view<String> value) -> int32 {
            if (idx >= $(self)._data_size) {
                return -1
            }
            return $(self)._data[idx].from(value)
        }

        // Replace element `idx` with a copy of a byte array.
        func set(ptr<StringList> self, const uint32 idx, view<[byte]> value) -> int32 {
            if (idx >= $(self)._data_size) {
                return -1
            }
            return $(self)._data[idx].from(value)
        }

        // Insert a copy of `payload` at `idx`.
        func insert(ptr<StringList> self, view<String> payload, const uint32 idx) -> int32 {
            uint32 old = $(self)._data_size
            if (idx > old || old == 0xFFFFFFFF) {
                return -1
            }
            String tmp
            int32 st = tmp.from(payload)
            if (st != 0) {
                tmp.uninit()
                return -1
            }
            st = $(self)._reserve(old + 1)
            if (st != 0) {
                tmp.uninit()
                return -1
            }
            $(self)._data_size = old + 1
            uint32 i = old
            while (i > idx) {
                st = $(self)._data[i].from(getview($(self)._data[i - 1]))
                if (st != 0) {
                    tmp.uninit()
                    return -1
                }
                i = i - 1
            }
            st = $(self)._data[idx].from(getview(tmp))
            tmp.uninit()
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Insert a copy of a byte array at `idx`.
        func insert(ptr<StringList> self, view<[byte]> payload, const uint32 idx) -> int32 {
            uint32 old = $(self)._data_size
            if (idx > old || old == 0xFFFFFFFF) {
                return -1
            }
            String tmp
            int32 st = tmp.from(payload)
            if (st != 0) {
                tmp.uninit()
                return -1
            }
            st = $(self)._reserve(old + 1)
            if (st != 0) {
                tmp.uninit()
                return -1
            }
            $(self)._data_size = old + 1
            uint32 i = old
            while (i > idx) {
                st = $(self)._data[i].from(getview($(self)._data[i - 1]))
                if (st != 0) {
                    tmp.uninit()
                    return -1
                }
                i = i - 1
            }
            st = $(self)._data[idx].from(getview(tmp))
            tmp.uninit()
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Erase element `idx`.
        func erase(ptr<StringList> self, const uint32 idx) -> int32 {
            uint32 n = $(self)._data_size
            if (idx >= n) {
                return -1
            }
            uint32 i = idx
            while (i + 1 < n) {
                int32 st = $(self)._data[i].from(getview($(self)._data[i + 1]))
                if (st != 0) {
                    return -1
                }
                i = i + 1
            }
            $(self)._data[n - 1].uninit()
            $(self)._data_size = n - 1
            return 0
        }

        // Erase elements [start, end).
        func erase(ptr<StringList> self, const uint32 start, const uint32 end) -> int32 {
            uint32 n = $(self)._data_size
            if (start > end || end > n) {
                return -1
            }
            uint32 count = end - start
            if (count == 0) {
                return 0
            }
            uint32 i = start
            while (i + count < n) {
                int32 st = $(self)._data[i].from(getview($(self)._data[i + count]))
                if (st != 0) {
                    return -1
                }
                i = i + 1
            }
            uint32 drop = n - count
            i = drop
            while (i < n) {
                $(self)._data[i].uninit()
                i = i + 1
            }
            $(self)._data_size = drop
            return 0
        }
    }
}

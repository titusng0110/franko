// ============================================================
// franko/string — dynamically sized byte strings
//
// Import with:
//
//   import "franko/string"
//
//   std::String s
//   s.from("hello")
//   s += " world"
//   s *= 3
//   s = "reset"
//
// Storage:
//
//   struct String {
//       [byte] _data          // actual buffer; length() is its capacity
//       uint32 _data_size     // number of live bytes in the buffer
//   }
//
// `_data.length()` is the buffer capacity. `_data_size` is the current
// string length in bytes and is what `length()` returns. Bytes past
// `_data_size` are unused buffer space.
//
// The backing array is pointer-only, so String is pointer-only: it
// cannot be passed or returned by value. Methods use `view<String>`
// for read-only access and `ptr<String>` for lifecycle/mutation.
//
// Lifecycle:
//
//   - `from(view<[byte]>)` / `from(view<String>)` replace the contents;
//   - `to(ptr<[byte]>)` copies the contents into a byte array, resizing
//     it to the exact logical length;
//   - `to(ptr<String>)` replaces another String;
//   - `uninit()` frees the backing buffer.
//
// `length()` reports the logical byte length. `is_utf8_compliant()`
// validates the stored bytes as UTF-8.
// ============================================================

namespace std {
    func __string_default_buffer_size(uint32 payload) -> uint32 {
        if (payload < 128) {
            return 128
        }
        if (payload > 0xFFFFFFFF - 128) {
            return payload
        }
        return payload + 128
    }

    struct String {
        [byte] _data
        uint32 _data_size = 0

        // Replace this string with the bytes in `in`. A null view clears
        // the string. Returns 0 on success, -1 on allocation failure.
        func from(ptr<String> self, view<[byte]> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            uint8 self_source = 0
            if (in == getview($(self)._data)) {
                self_source = 1
            }
            uint32 n = $(in).length()
            if (self_source != 0) {
                n = $(self)._data_size
            }
            int32 st = $(self)._reserve(n)
            if (st != 0) {
                return -1
            }
            if (n != 0 && self_source == 0) {
                $(self)._data.memcpy(in)
            }
            $(self)._data_size = n
            return 0
        }

        // Replace this string with another string. A null view clears the
        // string. Returns 0 on success, -1 on allocation failure.
        func from(ptr<String> self, view<String> in) -> int32 {
            if (in == null) {
                $(self)._data_size = 0
                return 0
            }
            if (in == getview($(self))) {
                return 0
            }
            uint32 n = $(in)._data_size
            int32 st = $(self)._reserve(n)
            if (st != 0) {
                return -1
            }
            if (n != 0) {
                view<[byte]> src = getview($(in)._data)
                $(self)._data.memcpy(src, 0, 0, n)
            }
            $(self)._data_size = n
            return 0
        }

        // Internal: make sure `_data` has room for at least `payload`
        // bytes. The buffer may be larger than the live contents.
        // Returns 0 on success, -1 on allocation failure.
        func _reserve(ptr<String> self, uint32 payload) -> int32 {
            if (payload == 0) {
                return 0
            }
            uint32 target = __string_default_buffer_size(payload)
            uint32 cap = $(self)._data.length()
            if (cap >= target) {
                return 0
            }
            int32 st = 0
            if (cap == 0) {
                st = $(self)._data.init(target)
            } else {
                st = $(self)._data.resize(target)
            }
            if (st != 0) {
                return -1
            }
            return 0
        }

        // Copy this string's bytes into `out`, resizing it to exactly the
        // logical length. Returns 0 on success, -1 for a null destination
        // or allocation failure.
        func to(view<String> self, ptr<[byte]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if (self == null) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            uint32 n = $(self)._data_size
            if (n == 0) {
                if ($(out).length() != 0) {
                    $(out).uninit()
                }
                return 0
            }
            if ($(out).length() == 0) {
                int32 st = $(out).init(n)
                if (st != 0) {
                    return -1
                }
            } else if ($(out).length() != n) {
                int32 st = $(out).resize(n)
                if (st != 0) {
                    return -1
                }
            }
            view<[byte]> src = getview($(self)._data)
            $(out).memcpy(src, 0, 0, n)
            return 0
        }

        // Replace `out` with a copy of this string. Returns 0 on success,
        // -1 for a null destination or allocation failure.
        func to(view<String> self, ptr<String> out) -> int32 {
            if (out == null) {
                return -1
            }
            return $(out).from(self)
        }

        // Current logical byte length.
        func length(view<String> self) -> uint32 {
            if (self == null) {
                return 0
            }
            return $(self)._data_size
        }

        // Return 1 when the stored bytes are valid UTF-8 and 0 otherwise.
        // Null and empty strings are valid. Overlong encodings, UTF-16
        // surrogates, and code points above U+10FFFF are rejected.
        func is_utf8_compliant(view<String> self) -> uint8 {
            if (self == null) {
                return 1
            }
            uint32 n = $(self)._data_size
            uint32 i = 0
            uint64 high_bits = 0x8080808080808080
            while (i < n) {
                // Fast path: eight ASCII bytes at a time.
                if (n - i >= 8) {
                    uint64 word = $(self)._data.read_uint64_LE(i)
                    if ((word & high_bits) == 0) {
                        i = i + 8
                        continue
                    }
                }
                uint8 b0 = $(self)._data[i]
                if (b0 < 0x80) {
                    i = i + 1
                    continue
                }
                uint32 need = 0
                uint8 lo = 0x80
                uint8 hi = 0xBF
                if (b0 >= 0xC2 && b0 <= 0xDF) {
                    need = 1
                } else if (b0 == 0xE0) {
                    need = 2
                    lo = 0xA0
                } else if ((b0 >= 0xE1 && b0 <= 0xEC) || (b0 >= 0xEE && b0 <= 0xEF)) {
                    need = 2
                } else if (b0 == 0xED) {
                    need = 2
                    hi = 0x9F
                } else if (b0 == 0xF0) {
                    need = 3
                    lo = 0x90
                } else if (b0 >= 0xF1 && b0 <= 0xF3) {
                    need = 3
                } else if (b0 == 0xF4) {
                    need = 3
                    hi = 0x8F
                } else {
                    return 0
                }
                if (n - i < need + 1) {
                    return 0
                }
                uint8 b1 = $(self)._data[i + 1]
                if (b1 < lo || b1 > hi) {
                    return 0
                }
                uint32 k = 2
                while (k <= need) {
                    uint8 bk = $(self)._data[i + k]
                    if (bk < 0x80 || bk > 0xBF) {
                        return 0
                    }
                    k = k + 1
                }
                i = i + need + 1
            }
            return 1
        }

        // Free the backing buffer and return to the empty state.
        func uninit(ptr<String> self) -> void {
            if ($(self)._data.length() != 0) {
                $(self)._data.uninit()
            }
            $(self)._data_size = 0
            return
        }

        func OPERATOR_EQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) == 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_NEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) != 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_LT(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) < 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_GT(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) > 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_LTEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) <= 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_GTEQ(view<String> self, view<String> other) -> uint8 {
            if ($(self)._compare(other) >= 0) {
                return 1
            }
            return 0
        }

        func OPERATOR_MOV(ptr<String> self, view<[byte]> other) -> void {
            $(self).from(other)
            return
        }

        func OPERATOR_MOV(ptr<String> self, view<String> other) -> void {
            $(self).from(other)
            return
        }

        func OPERATOR_MOV(ptr<String> self, view<view<[byte]>> other) -> void {
            if (other == null) {
                $(self)._data_size = 0
                return
            }
            $(self).from($(other))
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<[byte]> other) -> void {
            if (other == null) {
                return
            }
            uint32 n = $(other).length()
            if (n == 0) {
                return
            }
            uint8 self_source = 0
            if (other == getview($(self)._data)) {
                self_source = 1
            }
            uint32 old = $(self)._data_size
            if (self_source != 0) {
                n = old
            }
            if (old > 0xFFFFFFFF - n) {
                return
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return
            }
            if (self_source != 0) {
                $(self)._data.memmove(old, 0, n)
            } else {
                $(self)._data.memcpy(other, old, 0, n)
            }
            $(self)._data_size = old + n
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<String> other) -> void {
            if (other == null) {
                return
            }
            uint32 n = $(other)._data_size
            if (n == 0) {
                return
            }
            uint8 self_source = 0
            if (other == getview($(self))) {
                self_source = 1
            }
            uint32 old = $(self)._data_size
            if (old > 0xFFFFFFFF - n) {
                return
            }
            int32 st = $(self)._reserve(old + n)
            if (st != 0) {
                return
            }
            if (self_source != 0) {
                $(self)._data.memmove(old, 0, n)
            } else {
                view<[byte]> src = getview($(other)._data)
                $(self)._data.memcpy(src, old, 0, n)
            }
            $(self)._data_size = old + n
            return
        }

        func OPERATOR_ADDMOV(ptr<String> self, view<view<[byte]>> other) -> void {
            if (other == null) {
                return
            }
            $(self).OPERATOR_ADDMOV($(other))
            return
        }

        func OPERATOR_MULMOV(ptr<String> self, view<uint32> other) -> void {
            if (other == null) {
                return
            }
            uint32 multiplier = $(other)
            if (multiplier == 0) {
                $(self)._data_size = 0
                return
            }
            uint32 len = $(self)._data_size
            if (len == 0) {
                return
            }
            if (multiplier > 0xFFFFFFFF / len) {
                return
            }
            uint32 total = len * multiplier
            int32 st = $(self)._reserve(total)
            if (st != 0) {
                return
            }
            uint32 filled = len
            while (filled < total) {
                uint32 chunk = filled
                if (chunk > total - filled) {
                    chunk = total - filled
                }
                $(self)._data.memmove(filled, 0, chunk)
                filled = filled + chunk
            }
            $(self)._data_size = total
            return
        }

        func _compare(view<String> self, view<String> other) -> int32 {
            if (self == null && other == null) {
                return 0
            }
            if (self == null) {
                return -1
            }
            if (other == null) {
                return 1
            }
            uint32 a = $(self)._data_size
            uint32 b = $(other)._data_size
            uint32 common = a
            if (b < common) {
                common = b
            }
            if (common != 0) {
                int32 cmp = $(self)._data.memcmp(getview($(other)._data), 0, 0, common)
                if (cmp != 0) {
                    return cmp
                }
            }
            if (a < b) {
                return -1
            }
            if (a > b) {
                return 1
            }
            return 0
        }
    }
}

        // Parse this string as a decimal, 0b/0B binary, or 0x/0X
        // hexadecimal int8. A single leading '-' is allowed for decimal.
        // Returns (val, err): err is 0 on success and -1 on invalid
        // input or overflow; val is 0 on failure.
        func to_int8(view<String> self) -> (int8 val, int32 err) {
            (int8 val, int32 err) result
            result.val = 0
            result.err = -1
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            if (n == 0) {
                return result
            }
            uint32 i = 0
            uint8 negative = 0
            uint8 has_sign = 0
            byte c = $(self)._data[0]
            if (c == 45) {
                has_sign = 1
                negative = 1
                i = 1
                if (i >= n) {
                    return result
                }
            }
            uint64 base = 10
            if (has_sign == 0 && $(self)._data[i] == 48) {
                if (i + 1 < n) {
                    byte prefix = $(self)._data[i + 1]
                    if (prefix == 98 || prefix == 66) {
                        base = 2
                        i = i + 2
                    } else if (prefix == 120 || prefix == 88) {
                        base = 16
                        i = i + 2
                    }
                }
            }
            if (i >= n) {
                return result
            }
            uint64 magnitude = 0
            while (i < n) {
                uint64 cv = cast<uint64>($(self)._data[i])
                uint64 digit = 0
                if (cv >= 48 && cv <= 57) {
                    digit = cv - 48
                } else if (cv >= 97 && cv <= 102) {
                    digit = cv - 97 + 10
                } else if (cv >= 65 && cv <= 70) {
                    digit = cv - 65 + 10
                } else {
                    return result
                }
                if (digit >= base) {
                    return result
                }
                if (magnitude > (0xFFFFFFFFFFFFFFFF - digit) / base) {
                    return result
                }
                magnitude = magnitude * base + digit
                i = i + 1
            }
            if (negative != 0) {
                if (magnitude == 0) {
                    result.val = 0
                    result.err = 0
                    return result
                }
                if (magnitude > 128) {
                    return result
                }
                if (magnitude == 128) {
                    result.val = -128
                    result.err = 0
                    return result
                }
                result.val = -unsafe_cast<int8>(magnitude)
                result.err = 0
                return result
            }
            if (magnitude > 127) {
                return result
            }
            result.val = unsafe_cast<int8>(magnitude)
            result.err = 0
            return result
        }

        // Parse this string as a decimal, 0b/0B binary, or 0x/0X
        // hexadecimal int16. A single leading '-' is allowed for decimal.
        // Returns (val, err): err is 0 on success and -1 on invalid
        // input or overflow; val is 0 on failure.
        func to_int16(view<String> self) -> (int16 val, int32 err) {
            (int16 val, int32 err) result
            result.val = 0
            result.err = -1
            uint32 n = 0
            if (self != null) {
                n = $(self)._data_size
            }
            if (n == 0) {
                return result
            }
            uint32 i = 0

namespace os {
    namespace posix {
        int32_t STDIN_FILENO = 0
        int32_t STDOUT_FILENO = 1
        int32_t STDERR_FILENO = 2

        // FFI intrinsics. The bodies below are stubs only: when this module
        // is imported as "franko/os", the compiler replaces them with the
        // bridge definitions from import/franko/os.ffi.cpp. The stubs
        // report failure (-1) so a missing bridge can never look like
        // silent success.
        func read(int32_t fd, addr<array<byte>> buf, uint64_t count) -> int64_t {
            return -1
        }
        func write(int32_t fd, addr<array<byte>> buf, uint64_t count) -> int64_t {
            return -1
        }
    }

    namespace win32 {
        // Win32 File API (fileapi.h) standard-handle constants.
        // These are (DWORD)-10/-11/-12, spelled as hex because a
        // negative literal cannot fit a uint32_t target.
        uint32_t STD_INPUT_HANDLE = 0xFFFFFFF6
        uint32_t STD_OUTPUT_HANDLE = 0xFFFFFFF5
        uint32_t STD_ERROR_HANDLE = 0xFFFFFFF4

        // FFI intrinsics, bridged by import/franko/os.ffi.cpp like the
        // posix functions above. hFile is a HANDLE widened to 64 bits;
        // obtain one with GetStdHandle. lpOverlapped is dropped: the
        // bridge always passes NULL (synchronous I/O). bytesRead and
        // bytesWritten may be null. The stubs report failure (0) so a
        // missing bridge can never look like silent success.
        func GetStdHandle(uint32_t nStdHandle) -> uint64_t {
            return 0
        }
        func ReadFile(uint64_t hFile, addr<array<byte>> buf, uint32_t count, addr<uint32_t> bytesRead) -> int32_t {
            return 0
        }
        func WriteFile(uint64_t hFile, addr<array<byte>> buf, uint32_t count, addr<uint32_t> bytesWritten) -> int32_t {
            return 0
        }
    }
}

namespace os {
    // The platform-specific FFI surface is selected at compile time. The
    // unselected branch is never analyzed, verified, bridged, or emitted.
    //
    //   #if (#IS_WINDOWS) {
    //       os::win32::WriteFile(...)
    //   } #else #if (#IS_LINUX || #IS_MACOS) {
    //       os::posix::write(...)
    //   }
    //
    // Calling a function that does not exist on the current target is a
    // compile error. The bridge file contains the C++ definitions; only
    // the used blocks are spliced into the generated program.

    #if (#IS_WINDOWS) {
        namespace win32 {
            // Win32 File API (fileapi.h) standard-handle constants.
            // These are (DWORD)-10/-11/-12, spelled as hex because a
            // negative literal cannot fit a uint32 target.
            uint32 STD_INPUT_HANDLE = 0xFFFFFFF6
            uint32 STD_OUTPUT_HANDLE = 0xFFFFFFF5
            uint32 STD_ERROR_HANDLE = 0xFFFFFFF4

            // FFI intrinsics, bridged by import/franko/os.ffi.cpp.
            // hFile is a HANDLE widened to 64 bits; obtain one with
            // GetStdHandle. lpOverlapped is dropped: the bridge always
            // passes NULL (synchronous I/O). bytesRead and bytesWritten
            // are written through (mview) and may be null. The buffer is
            // read-only for WriteFile (view) and written in place for
            // ReadFile (mview). The stubs report failure (0) so a missing
            // bridge can never look like silent success.
            func GetStdHandle(uint32 nStdHandle) -> uint64 {
                return 0
            }
            func ReadFile(uint64 hFile, mview<[byte]> buf, uint32 count, mview<uint32> bytesRead) -> int32 {
                return 0
            }
            func WriteFile(uint64 hFile, view<[byte]> buf, uint32 count, mview<uint32> bytesWritten) -> int32 {
                return 0
            }
        }
    } #else #if (#IS_LINUX || #IS_MACOS) {
        namespace posix {
            int32 STDIN_FILENO = 0
            int32 STDOUT_FILENO = 1
            int32 STDERR_FILENO = 2

            // FFI intrinsics. When this module is used, the compiler
            // replaces the stubs with the bridge definitions from
            // import/franko/os.ffi.cpp. The stubs report failure (-1) so
            // a missing bridge can never look like silent success.
            func read(int32 fd, mview<[byte]> buf, uint64 count) -> int64 {
                return -1
            }
            func write(int32 fd, view<[byte]> buf, uint64 count) -> int64 {
                return -1
            }
        }
    } #else {
        #panic("franko/os supports only linux, windows, and macos targets")
    }
}

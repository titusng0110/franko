namespace os {
    // The platform-specific FFI surface is selected at compile time. The
    // unselected branch is never analyzed, verified, bridged, or emitted.
    //
    //   #if (#IS_WINDOWS) {
    //       os::win32::WriteFile(...)
    //   } #else #if (#IS_LINUX || #IS_MACOS) {
    //       os::posix::write(...)
    //   }
    //
    // Calling a function that does not exist on the current target is a
    // compile error. The bridge file contains the C++ definitions; only
    // the used blocks are spliced into the generated program.

    #if (#IS_WINDOWS) {
        namespace win32 {
            // Win32 File API (fileapi.h) standard-handle constants.
            // These are (DWORD)-10/-11/-12, spelled as hex because a
            // negative literal cannot fit a uint32 target.
            const uint32 STD_INPUT_HANDLE = 0xFFFFFFF6
            const uint32 STD_OUTPUT_HANDLE = 0xFFFFFFF5
            const uint32 STD_ERROR_HANDLE = 0xFFFFFFF4

            // FFI intrinsics, bridged by import/franko/os.ffi.cpp.
            // hFile is a HANDLE widened to 64 bits; obtain one with
            // GetStdHandle. lpOverlapped is dropped: the bridge always
            // passes NULL (synchronous I/O). bytesRead and bytesWritten
            // are written through (mview) and may be null. The buffer is
            // read-only for WriteFile (view) and written in place for
            // ReadFile (mview). The stubs report failure (0) so a missing
            // bridge can never look like silent success.
            func GetStdHandle(const uint32 nStdHandle) -> uint64 {
                return 0
            }
            func ReadFile(const uint64 hFile, const mview<[byte]> buf, const uint32 count, const mview<uint32> bytesRead) -> int32 {
                return 0
            }
            func WriteFile(const uint64 hFile, const view<[byte]> buf, const uint32 count, const mview<uint32> bytesWritten) -> int32 {
                return 0
            }

            // Timing primitives, bridged by import/franko/os.ffi.cpp.
            // QueryPerformanceCounter/Frequency are the monotonic,
            // nanosecond-capable pair; GetSystemTimePreciseAsFileTime is
            // wall-clock UTC in 100-nanosecond intervals since 1601.
            func QueryPerformanceCounter(const mview<int64> counter) -> int32 {
                return 0
            }
            func QueryPerformanceFrequency(const mview<int64> frequency) -> int32 {
                return 0
            }
            func GetSystemTimePreciseAsFileTime() -> uint64 {
                return 0
            }
        }
    } #else #if (#IS_LINUX || #IS_MACOS) {
        namespace posix {
            const int32 STDIN_FILENO = 0
            const int32 STDOUT_FILENO = 1
            const int32 STDERR_FILENO = 2
            const int32 CLOCK_REALTIME = 0
            #if (#IS_LINUX) {
                const int32 CLOCK_MONOTONIC = 1
            } #else {
                const int32 CLOCK_MONOTONIC = 6
            }

            // FFI intrinsics. When this module is used, the compiler
            // replaces the stubs with the bridge definitions from
            // import/franko/os.ffi.cpp. The stubs report failure (-1) so
            // a missing bridge can never look like silent success.
            func read(const int32 fd, const mview<[byte]> buf, const uint64 count) -> int64 {
                return -1
            }
            func write(const int32 fd, const view<[byte]> buf, const uint64 count) -> int64 {
                return -1
            }
            func clock_gettime(const int32 clock_id, const mview<int64> sec, const mview<int64> nanosec) -> int32 {
                return -1
            }
        }
    } #else {
        #panic("franko/os supports only linux, windows, and macos targets")
    }
}

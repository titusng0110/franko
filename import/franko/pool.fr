// ============================================================
// Franko pool allocators — index pools over uint32 slots
//
// Import with:
//
//   import "franko/pool"
//
// Four allocators, all in namespace std:
//
//   std::NextAllocator                   free-list ("next") pool
//   std::SparseSetAllocator              sparse-set pool
//   std::GenerationalNextAllocator       free-list pool + generations
//   std::GenerationalSparseSetAllocator  sparse-set pool + generations
//
// Common API (each method declares the permission it needs: lifecycle
// operations take ptr<X> self, mutating ones mview<X> self, read-only
// ones view<X> self):
//
//   init(slot_count)                 -> int32   set up slot_count slots
//   uninit()                -> int32   tear the pool down
//   grow(new_capacity)              -> int32   enlarge to new_capacity slots
//   new_index()             -> (uint32 idx, int32 err)  take one slot
//   free_index(idx)         -> int32   give one slot back
//   exist(idx)              -> uint8   is slot idx live?
//   write_active_indices(out) -> int32 dump live indices
//   used()                  -> uint32  number of live slots
//   capacity()              -> uint32  number of slots
//   generation(idx)         -> (uint32 gen, int32 err)  (generational only)
//
// The generational allocators' new_index() returns the full handle:
// (uint32 idx, uint32 gen, int32 err).
//
// Status codes are int32: 0 on success, -1 on failure. Sizes,
// indices, and generations are uint32. _END remains an internal
// free-list terminator; public failures are reported by err.
//
// Sentinel values, spelled as literals throughout this file:
//
//   _END       = 0xFFFFFFFF   end of free list (internal)
//   _ALLOCATED = 0xFFFFFFFE   slot is live
//
// Ownership:
//
//   - declare a local `std::NextAllocator a`; the declaration state
//     is the empty pool (capacity 0, used 0), exactly the state the
//     Python-style constructor produces;
//   - call a.init(slot_count) once before use (slot_count > 0);
//   - call a.uninit() when done (frees the slot storage);
//   - a pool may be re-initialized after uninit.
//
// A pool contains dynamic arrays, so it is pointer-only: it cannot be
// passed or returned by value. Methods are called on a pool lvalue
// (a.init(4)) and declare the permission they need: ptr<X> self for
// init/uninit/grow, mview<X> self for new_index/free_index, and
// view<X> self for the observers (exist/generation/used/capacity/
// write_active_indices). The compiler synthesizes the matching
// getptr/getmview/getview(a) as self.
//
// Adapted from Python pseudo-code, with these Franko adjustments:
//
//   - uint32 parameters cannot hold negative values, so the
//     `slot_count <= 0` guards become `slot_count == 0` and the `idx < 0` guards drop
//     out entirely;
//   - slot storage is a dynamic array, whose init/resize can fail, so
//     init/grow report allocation failure with -1 (impossible in the
//     list-based original);
//   - lists are rebuilt element by element (array.fill loops and
//     init_zero) since arrays have no comprehension or extend;
//   - write_active_indices takes `ptr<[uint32]> out` and
//     rejects a null pointer (arrays are not passable by value).
// ============================================================

namespace std {
    // ------------------------------------------------------------
    // Free-list pool. Slots are chained through the _next array; a
    // free slot holds the index of the next free slot, the last free
    // slot holds _END, and a live slot holds _ALLOCATED. Allocation
    // and release are O(1); write_active_indices is O(capacity).
    // ------------------------------------------------------------
    struct NextAllocator {
        uint32 _capacity = 0
        uint32 _used = 0
        uint32 _head = 0xFFFFFFFF
        [uint32] _next

        // Prepare slot_count slots (slot_count > 0), all free and chained in ascending
        // order starting at slot 0. Returns 0 on success, -1 when the
        // pool is already initialized, when slot_count is 0, or when the slot
        // array cannot be allocated.
        func init(ptr<NextAllocator> self, const uint32 slot_count) -> int32 {
            if ($(self)._capacity != 0 || slot_count == 0) {
                return -1
            }
            int32 st = $(self)._next.init(slot_count)
            if (st != 0) {
                return -1
            }
            for (uint32 i = 0; i < slot_count; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[slot_count - 1] = 0xFFFFFFFF
            $(self)._capacity = slot_count
            $(self)._used = 0
            $(self)._head = 0
            return 0
        }

        // Free the slot storage and return to the empty pool. Returns
        // 0 on success, -1 when the pool is not initialized.
        func uninit(ptr<NextAllocator> self) -> int32 {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._head = 0xFFFFFFFF
            $(self)._next.uninit()
            return 0
        }

        // Enlarge the pool to new_capacity slots (new_capacity > capacity). The new
        // slots are chained onto the front of the free list; live
        // slots keep their indices and their contents. Returns 0 on
        // success, -1 when the pool is not initialized, when new_capacity is
        // not greater than the current capacity, or when the slot
        // array cannot be resized.
        func grow(ptr<NextAllocator> self, const uint32 new_capacity) -> int32 {
            if ($(self)._capacity == 0 || new_capacity <= $(self)._capacity) {
                return -1
            }
            uint32 old_capacity = $(self)._capacity
            int32 st = $(self)._next.resize(new_capacity)
            if (st != 0) {
                return -1
            }
            for (uint32 i = old_capacity; i < new_capacity; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[new_capacity - 1] = $(self)._head
            $(self)._head = old_capacity
            $(self)._capacity = new_capacity
            return 0
        }

        // Take the slot at the head of the free list. Returns the
        // index and an error status: err is 0 on success and -1 when
        // the pool is not initialized or every slot is live.
        func new_index(mview<NextAllocator> self) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if ($(self)._capacity == 0 || $(self)._head == 0xFFFFFFFF) {
                return result
            }
            uint32 idx = $(self)._head
            $(self)._head = $(self)._next[idx]
            $(self)._next[idx] = 0xFFFFFFFE
            $(self)._used++
            result.idx = idx
            result.err = 0
            return result
        }

        // Return slot idx to the head of the free list (LIFO reuse).
        // Returns 0 on success, -1 when idx is not a live slot, which
        // covers unknown indices and double release.
        func free_index(mview<NextAllocator> self, const uint32 idx) -> int32 {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._next[idx] = $(self)._head
            $(self)._head = idx
            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<NextAllocator> self, const uint32 idx) -> uint8 {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            return $(self)._next[idx] == 0xFFFFFFFE
        }

        // Write every live index into out, in ascending order. out
        // must hold at least used() elements. Returns 0 on success, -1
        // when out is null, when the pool is not initialized, or when
        // out is too small.
        func write_active_indices(view<NextAllocator> self, mview<[uint32]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            uint32 pos = 0
            for (uint32 i = 0; i < $(self)._capacity; i++) {
                if ($(self)._next[i] == 0xFFFFFFFE) {
                    $(out)[pos] = i
                    pos++
                }
            }
            return 0
        }

        // Number of live slots.
        func used(view<NextAllocator> self) -> uint32 {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<NextAllocator> self) -> uint32 {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Sparse-set pool. _dense holds the live indices in allocation
    // order, and _sparse maps an index to its position in _dense. A
    // slot is live exactly when _sparse[idx] < used() and
    // _dense[_sparse[idx]] == idx. Allocation and release are O(1);
    // write_active_indices is O(used).
    // ------------------------------------------------------------
    struct SparseSetAllocator {
        uint32 _capacity = 0
        uint32 _used = 0
        [uint32] _sparse
        [uint32] _dense

        // Prepare slot_count slots (slot_count > 0), all free. Returns 0 on success, -1
        // when the pool is already initialized, when slot_count is 0, or when
        // the tables cannot be allocated.
        func init(ptr<SparseSetAllocator> self, const uint32 slot_count) -> int32 {
            if ($(self)._capacity != 0 || slot_count == 0) {
                return -1
            }
            int32 st = $(self)._sparse.init(slot_count)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.init(slot_count)
            if (st != 0) {
                $(self)._sparse.uninit()
                return -1
            }
            for (uint32 i = 0; i < slot_count; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = slot_count
            $(self)._used = 0
            return 0
        }

        // Free both tables and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<SparseSetAllocator> self) -> int32 {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._sparse.uninit()
            $(self)._dense.uninit()
            return 0
        }

        // Enlarge the pool to new_capacity slots (new_capacity > capacity). Live slots
        // keep their indices and their dense positions. Returns 0 on
        // success, -1 when the pool is not initialized, when new_capacity is
        // not greater than the current capacity, or when the tables
        // cannot be resized.
        func grow(ptr<SparseSetAllocator> self, const uint32 new_capacity) -> int32 {
            if ($(self)._capacity == 0 || new_capacity <= $(self)._capacity) {
                return -1
            }
            uint32 old_capacity = $(self)._capacity
            int32 st = $(self)._sparse.resize(new_capacity)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.resize(new_capacity)
            if (st != 0) {
                $(self)._sparse.resize(old_capacity)
                return -1
            }
            for (uint32 i = old_capacity; i < new_capacity; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = new_capacity
            return 0
        }

        // Take the slot that sits at dense position used(). Returns
        // the index and an error status: err is 0 on success and -1
        // when the pool is not initialized or every slot is live.
        func new_index(mview<SparseSetAllocator> self) -> (uint32 idx, int32 err) {
            (uint32 idx, int32 err) result
            result.idx = 0
            result.err = -1
            if ($(self)._capacity == 0 || $(self)._used >= $(self)._capacity) {
                return result
            }
            uint32 idx = $(self)._dense[$(self)._used]
            $(self)._sparse[idx] = $(self)._used
            $(self)._used++
            result.idx = idx
            result.err = 0
            return result
        }

        // Release slot idx by swapping it with the last live entry.
        // Returns 0 on success, -1 when idx is not a live slot, which
        // covers unknown indices and double release.
        func free_index(mview<SparseSetAllocator> self, const uint32 idx) -> int32 {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            uint32 del_pos = $(self)._sparse[idx]
            uint32 last_pos = $(self)._used - 1
            uint32 last_idx = $(self)._dense[last_pos]

            $(self)._dense[del_pos] = last_idx
            $(self)._dense[last_pos] = idx
            $(self)._sparse[last_idx] = del_pos
            $(self)._sparse[idx] = last_pos

            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<SparseSetAllocator> self, const uint32 idx) -> uint8 {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            uint32 pos = $(self)._sparse[idx]
            return pos < $(self)._used && $(self)._dense[pos] == idx
        }

        // Write every live index into out, in allocation order (the
        // dense order). out must hold at least used() elements.
        // Returns 0 on success, -1 when out is null, when the pool is
        // not initialized, or when out is too small.
        func write_active_indices(view<SparseSetAllocator> self, mview<[uint32]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            for (uint32 i = 0; i < $(self)._used; i++) {
                $(out)[i] = $(self)._dense[i]
            }
            return 0
        }

        // Number of live slots.
        func used(view<SparseSetAllocator> self) -> uint32 {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<SparseSetAllocator> self) -> uint32 {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Free-list pool with per-slot generation counters. Identical to
    // NextAllocator, plus a counter per slot that is bumped every time
    // the slot is released. An (idx, gen) pair therefore
    // detects a stale reference to a recycled slot.
    // ------------------------------------------------------------
    struct GenerationalNextAllocator {
        uint32 _capacity = 0
        uint32 _used = 0
        uint32 _head = 0xFFFFFFFF
        [uint32] _next
        [uint32] _generations

        // Prepare slot_count slots (slot_count > 0), all free, chained in ascending
        // order starting at slot 0, all generations zero. Returns 0 on
        // success, -1 when the pool is already initialized, when slot_count is
        // 0, or when the storage cannot be allocated.
        func init(ptr<GenerationalNextAllocator> self, const uint32 slot_count) -> int32 {
            if ($(self)._capacity != 0 || slot_count == 0) {
                return -1
            }
            int32 st = $(self)._next.init(slot_count)
            if (st != 0) {
                return -1
            }
            st = $(self)._generations.init_zero(slot_count)
            if (st != 0) {
                $(self)._next.uninit()
                return -1
            }
            for (uint32 i = 0; i < slot_count; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[slot_count - 1] = 0xFFFFFFFF
            $(self)._capacity = slot_count
            $(self)._used = 0
            $(self)._head = 0
            return 0
        }

        // Free the storage and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<GenerationalNextAllocator> self) -> int32 {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._head = 0xFFFFFFFF
            $(self)._next.uninit()
            $(self)._generations.uninit()
            return 0
        }

        // Enlarge the pool to new_capacity slots (new_capacity > capacity). The new
        // slots join the free list with generation 0. Returns 0 on
        // success, -1 when the pool is not initialized, when new_capacity is
        // not greater than the current capacity, or when the storage
        // cannot be resized.
        func grow(ptr<GenerationalNextAllocator> self, const uint32 new_capacity) -> int32 {
            if ($(self)._capacity == 0 || new_capacity <= $(self)._capacity) {
                return -1
            }
            uint32 old_capacity = $(self)._capacity
            int32 st = $(self)._next.resize(new_capacity)
            if (st != 0) {
                return -1
            }
            st = $(self)._generations.resize(new_capacity)
            if (st != 0) {
                $(self)._next.resize(old_capacity)
                return -1
            }
            for (uint32 i = old_capacity; i < new_capacity; i++) {
                $(self)._next[i] = i + 1
                $(self)._generations[i] = 0
            }
            $(self)._next[new_capacity - 1] = $(self)._head
            $(self)._head = old_capacity
            $(self)._capacity = new_capacity
            return 0
        }

        // Take the slot at the head of the free list. Returns the
        // full handle and an error status: err is 0 on success and -1
        // when the pool is not initialized or every slot is live.
        func new_index(mview<GenerationalNextAllocator> self) -> (uint32 idx, uint32 gen, int32 err) {
            (uint32 idx, uint32 gen, int32 err) result
            result.idx = 0
            result.gen = 0
            result.err = -1
            if ($(self)._capacity == 0 || $(self)._head == 0xFFFFFFFF) {
                return result
            }
            uint32 idx = $(self)._head
            $(self)._head = $(self)._next[idx]
            $(self)._next[idx] = 0xFFFFFFFE
            $(self)._used++
            result.idx = idx
            result.gen = $(self)._generations[idx]
            result.err = 0
            return result
        }

        // Return slot idx to the free list (LIFO reuse), bumping its
        // generation. Returns 0 on success, -1 when idx is not a live
        // slot, which covers unknown indices and double release.
        func free_index(mview<GenerationalNextAllocator> self, const uint32 idx) -> int32 {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._generations[idx]++
            $(self)._next[idx] = $(self)._head
            $(self)._head = idx
            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<GenerationalNextAllocator> self, const uint32 idx) -> uint8 {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            return $(self)._next[idx] == 0xFFFFFFFE
        }

        // Generation counter of slot idx: 0 for a slot that was never
        // released, bumped by every release. Returns err = 0 on
        // success and -1 when the pool is not initialized or idx is
        // out of range; gen is 0 when it fails.
        func generation(view<GenerationalNextAllocator> self, const uint32 idx) -> (uint32 gen, int32 err) {
            (uint32 gen, int32 err) result
            result.gen = 0
            result.err = -1
            if ($(self)._capacity == 0) {
                return result
            }
            if (idx >= $(self)._capacity) {
                return result
            }
            result.gen = $(self)._generations[idx]
            result.err = 0
            return result
        }

        // Write every live index into out, in ascending order. out
        // must hold at least used() elements. Returns 0 on success, -1
        // when out is null, when the pool is not initialized, or when
        // out is too small.
        func write_active_indices(view<GenerationalNextAllocator> self, mview<[uint32]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            uint32 pos = 0
            for (uint32 i = 0; i < $(self)._capacity; i++) {
                if ($(self)._next[i] == 0xFFFFFFFE) {
                    $(out)[pos] = i
                    pos++
                }
            }
            return 0
        }

        // Number of live slots.
        func used(view<GenerationalNextAllocator> self) -> uint32 {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<GenerationalNextAllocator> self) -> uint32 {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Sparse-set pool with per-slot generation counters. Identical to
    // SparseSetAllocator, plus a counter per slot that is bumped every
    // time the slot is released. An (idx, gen) pair therefore
    // detects a stale reference to a recycled slot.
    // ------------------------------------------------------------
    struct GenerationalSparseSetAllocator {
        uint32 _capacity = 0
        uint32 _used = 0
        [uint32] _sparse
        [uint32] _dense
        [uint32] _generations

        // Prepare slot_count slots (slot_count > 0), all free, all generations zero.
        // Returns 0 on success, -1 when the pool is already
        // initialized, when slot_count is 0, or when the tables cannot be
        // allocated.
        func init(ptr<GenerationalSparseSetAllocator> self, const uint32 slot_count) -> int32 {
            if ($(self)._capacity != 0 || slot_count == 0) {
                return -1
            }
            int32 st = $(self)._sparse.init(slot_count)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.init(slot_count)
            if (st != 0) {
                $(self)._sparse.uninit()
                return -1
            }
            st = $(self)._generations.init_zero(slot_count)
            if (st != 0) {
                $(self)._sparse.uninit()
                $(self)._dense.uninit()
                return -1
            }
            for (uint32 i = 0; i < slot_count; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = slot_count
            $(self)._used = 0
            return 0
        }

        // Free the tables and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<GenerationalSparseSetAllocator> self) -> int32 {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._sparse.uninit()
            $(self)._dense.uninit()
            $(self)._generations.uninit()
            return 0
        }

        // Enlarge the pool to new_capacity slots (new_capacity > capacity). The new
        // slots are free with generation 0. Returns 0 on success, -1
        // when the pool is not initialized, when new_capacity is not greater
        // than the current capacity, or when the tables cannot be
        // resized.
        func grow(ptr<GenerationalSparseSetAllocator> self, const uint32 new_capacity) -> int32 {
            if ($(self)._capacity == 0 || new_capacity <= $(self)._capacity) {
                return -1
            }
            uint32 old_capacity = $(self)._capacity
            int32 st = $(self)._sparse.resize(new_capacity)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.resize(new_capacity)
            if (st != 0) {
                $(self)._sparse.resize(old_capacity)
                return -1
            }
            st = $(self)._generations.resize(new_capacity)
            if (st != 0) {
                $(self)._sparse.resize(old_capacity)
                $(self)._dense.resize(old_capacity)
                return -1
            }
            for (uint32 i = old_capacity; i < new_capacity; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
                $(self)._generations[i] = 0
            }
            $(self)._capacity = new_capacity
            return 0
        }

        // Take the slot that sits at dense position used(). Returns
        // the full handle and an error status: err is 0 on success and
        // -1 when the pool is not initialized or every slot is live.
        func new_index(mview<GenerationalSparseSetAllocator> self) -> (uint32 idx, uint32 gen, int32 err) {
            (uint32 idx, uint32 gen, int32 err) result
            result.idx = 0
            result.gen = 0
            result.err = -1
            if ($(self)._capacity == 0 || $(self)._used >= $(self)._capacity) {
                return result
            }
            uint32 idx = $(self)._dense[$(self)._used]
            $(self)._sparse[idx] = $(self)._used
            $(self)._used++
            result.idx = idx
            result.gen = $(self)._generations[idx]
            result.err = 0
            return result
        }

        // Release slot idx by swapping it with the last live entry,
        // bumping its generation. Returns 0 on success, -1 when idx is
        // not a live slot, which covers unknown indices and double
        // release.
        func free_index(mview<GenerationalSparseSetAllocator> self, const uint32 idx) -> int32 {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._generations[idx]++

            uint32 del_pos = $(self)._sparse[idx]
            uint32 last_pos = $(self)._used - 1
            uint32 last_idx = $(self)._dense[last_pos]

            $(self)._dense[del_pos] = last_idx
            $(self)._dense[last_pos] = idx
            $(self)._sparse[last_idx] = del_pos
            $(self)._sparse[idx] = last_pos

            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<GenerationalSparseSetAllocator> self, const uint32 idx) -> uint8 {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            uint32 pos = $(self)._sparse[idx]
            return pos < $(self)._used && $(self)._dense[pos] == idx
        }

        // Generation counter of slot idx: 0 for a slot that was never
        // released, bumped by every release. Returns err = 0 on
        // success and -1 when the pool is not initialized or idx is
        // out of range; gen is 0 when it fails.
        func generation(view<GenerationalSparseSetAllocator> self, const uint32 idx) -> (uint32 gen, int32 err) {
            (uint32 gen, int32 err) result
            result.gen = 0
            result.err = -1
            if ($(self)._capacity == 0) {
                return result
            }
            if (idx >= $(self)._capacity) {
                return result
            }
            result.gen = $(self)._generations[idx]
            result.err = 0
            return result
        }

        // Write every live index into out, in allocation order (the
        // dense order). out must hold at least used() elements.
        // Returns 0 on success, -1 when out is null, when the pool is
        // not initialized, or when out is too small.
        func write_active_indices(view<GenerationalSparseSetAllocator> self, mview<[uint32]> out) -> int32 {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            for (uint32 i = 0; i < $(self)._used; i++) {
                $(out)[i] = $(self)._dense[i]
            }
            return 0
        }

        // Number of live slots.
        func used(view<GenerationalSparseSetAllocator> self) -> uint32 {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<GenerationalSparseSetAllocator> self) -> uint32 {
            return $(self)._capacity
        }
    }
}

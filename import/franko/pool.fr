// ============================================================
// Franko pool allocators — index pools over uint32_t slots
//
// Import with:
//
//   import "franko/pool"
//
// Four allocators, all in namespace std:
//
//   std::NextAllocator                   free-list ("next") pool
//   std::SparseSetAllocator              sparse-set pool
//   std::GenerationalNextAllocator       free-list pool + generations
//   std::GenerationalSparseSetAllocator  sparse-set pool + generations
//
// Common API (each method declares the permission it needs: lifecycle
// operations take ptr<X> self, mutating ones mview<X> self, read-only
// ones view<X> self):
//
//   init(C)                 -> int32_t   set up C slots
//   uninit()                -> int32_t   tear the pool down
//   grow(newC)              -> int32_t   enlarge to newC slots
//   new_index()             -> uint32_t  take one slot
//   free_index(idx)         -> int32_t   give one slot back
//   exist(idx)              -> uint8_t   is slot idx live?
//   write_active_indices(out) -> int32_t dump live indices
//   used()                  -> uint32_t  number of live slots
//   capacity()              -> uint32_t  number of slots
//   generation(idx)         -> uint32_t  (generational pools only)
//
// Status codes are int32_t: 0 on success, -1 on failure. Sizes,
// indices, and generations are uint32_t. new_index() and
// generation() report failure with the _END sentinel.
//
// Sentinel values, spelled as literals throughout this file:
//
//   _END       = 0xFFFFFFFF   end of free list, failure result
//   _ALLOCATED = 0xFFFFFFFE   slot is live
//
// Ownership:
//
//   - declare a local `std::NextAllocator a`; the declaration state
//     is the empty pool (capacity 0, used 0), exactly the state the
//     Python-style constructor produces;
//   - call a.init(C) once before use (C > 0);
//   - call a.uninit() when done (frees the slot storage);
//   - a pool may be re-initialized after uninit.
//
// A pool contains dynamic arrays, so it is pointer-only: it cannot be
// passed or returned by value. Methods are called on a pool lvalue
// (a.init(4)) and declare the permission they need: ptr<X> self for
// init/uninit/grow, mview<X> self for new_index/free_index, and
// view<X> self for the observers (exist/generation/used/capacity/
// write_active_indices). The compiler synthesizes the matching
// getptr/getmview/getview(a) as self.
//
// Adapted from Python pseudo-code, with these Franko adjustments:
//
//   - uint32_t parameters cannot hold negative values, so the
//     `C <= 0` guards become `C == 0` and the `idx < 0` guards drop
//     out entirely;
//   - slot storage is a dynamic array, whose init/resize can fail, so
//     init/grow report allocation failure with -1 (impossible in the
//     list-based original);
//   - lists are rebuilt element by element (array.fill loops and
//     init_zero) since arrays have no comprehension or extend;
//   - write_active_indices takes `ptr<array<uint32_t>> out` and
//     rejects a null pointer (arrays are not passable by value).
// ============================================================

namespace std {
    // ------------------------------------------------------------
    // Free-list pool. Slots are chained through the _next array; a
    // free slot holds the index of the next free slot, the last free
    // slot holds _END, and a live slot holds _ALLOCATED. Allocation
    // and release are O(1); write_active_indices is O(capacity).
    // ------------------------------------------------------------
    struct NextAllocator {
        uint32_t _capacity = 0
        uint32_t _used = 0
        uint32_t _head = 0xFFFFFFFF
        array<uint32_t> _next

        // Prepare C slots (C > 0), all free and chained in ascending
        // order starting at slot 0. Returns 0 on success, -1 when the
        // pool is already initialized, when C is 0, or when the slot
        // array cannot be allocated.
        func init(ptr<NextAllocator> self, uint32_t C) -> int32_t {
            if ($(self)._capacity != 0 || C == 0) {
                return -1
            }
            int32_t st = $(self)._next.init(C)
            if (st != 0) {
                return -1
            }
            for (uint32_t i = 0; i < C; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[C - 1] = 0xFFFFFFFF
            $(self)._capacity = C
            $(self)._used = 0
            $(self)._head = 0
            return 0
        }

        // Free the slot storage and return to the empty pool. Returns
        // 0 on success, -1 when the pool is not initialized.
        func uninit(ptr<NextAllocator> self) -> int32_t {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._head = 0xFFFFFFFF
            $(self)._next.uninit()
            return 0
        }

        // Enlarge the pool to newC slots (newC > capacity). The new
        // slots are chained onto the front of the free list; live
        // slots keep their indices and their contents. Returns 0 on
        // success, -1 when the pool is not initialized, when newC is
        // not greater than the current capacity, or when the slot
        // array cannot be resized.
        func grow(ptr<NextAllocator> self, uint32_t newC) -> int32_t {
            if ($(self)._capacity == 0 || newC <= $(self)._capacity) {
                return -1
            }
            uint32_t oldC = $(self)._capacity
            int32_t st = $(self)._next.resize(newC)
            if (st != 0) {
                return -1
            }
            for (uint32_t i = oldC; i < newC; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[newC - 1] = $(self)._head
            $(self)._head = oldC
            $(self)._capacity = newC
            return 0
        }

        // Take the slot at the head of the free list. Returns its
        // index, or 0xFFFFFFFF (_END) when the pool is not initialized
        // or every slot is live.
        func new_index(mview<NextAllocator> self) -> uint32_t {
            if ($(self)._capacity == 0 || $(self)._head == 0xFFFFFFFF) {
                return 0xFFFFFFFF
            }
            uint32_t idx = $(self)._head
            $(self)._head = $(self)._next[idx]
            $(self)._next[idx] = 0xFFFFFFFE
            $(self)._used++
            return idx
        }

        // Return slot idx to the head of the free list (LIFO reuse).
        // Returns 0 on success, -1 when idx is not a live slot, which
        // covers unknown indices and double release.
        func free_index(mview<NextAllocator> self, uint32_t idx) -> int32_t {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._next[idx] = $(self)._head
            $(self)._head = idx
            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<NextAllocator> self, uint32_t idx) -> uint8_t {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            return $(self)._next[idx] == 0xFFFFFFFE
        }

        // Write every live index into out, in ascending order. out
        // must hold at least used() elements. Returns 0 on success, -1
        // when out is null, when the pool is not initialized, or when
        // out is too small.
        func write_active_indices(view<NextAllocator> self, mview<array<uint32_t>> out) -> int32_t {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            uint32_t pos = 0
            for (uint32_t i = 0; i < $(self)._capacity; i++) {
                if ($(self)._next[i] == 0xFFFFFFFE) {
                    $(out)[pos] = i
                    pos++
                }
            }
            return 0
        }

        // Number of live slots.
        func used(view<NextAllocator> self) -> uint32_t {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<NextAllocator> self) -> uint32_t {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Sparse-set pool. _dense holds the live indices in allocation
    // order, and _sparse maps an index to its position in _dense. A
    // slot is live exactly when _sparse[idx] < used() and
    // _dense[_sparse[idx]] == idx. Allocation and release are O(1);
    // write_active_indices is O(used).
    // ------------------------------------------------------------
    struct SparseSetAllocator {
        uint32_t _capacity = 0
        uint32_t _used = 0
        array<uint32_t> _sparse
        array<uint32_t> _dense

        // Prepare C slots (C > 0), all free. Returns 0 on success, -1
        // when the pool is already initialized, when C is 0, or when
        // the tables cannot be allocated.
        func init(ptr<SparseSetAllocator> self, uint32_t C) -> int32_t {
            if ($(self)._capacity != 0 || C == 0) {
                return -1
            }
            int32_t st = $(self)._sparse.init(C)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.init(C)
            if (st != 0) {
                $(self)._sparse.uninit()
                return -1
            }
            for (uint32_t i = 0; i < C; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = C
            $(self)._used = 0
            return 0
        }

        // Free both tables and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<SparseSetAllocator> self) -> int32_t {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._sparse.uninit()
            $(self)._dense.uninit()
            return 0
        }

        // Enlarge the pool to newC slots (newC > capacity). Live slots
        // keep their indices and their dense positions. Returns 0 on
        // success, -1 when the pool is not initialized, when newC is
        // not greater than the current capacity, or when the tables
        // cannot be resized.
        func grow(ptr<SparseSetAllocator> self, uint32_t newC) -> int32_t {
            if ($(self)._capacity == 0 || newC <= $(self)._capacity) {
                return -1
            }
            uint32_t oldC = $(self)._capacity
            int32_t st = $(self)._sparse.resize(newC)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.resize(newC)
            if (st != 0) {
                $(self)._sparse.resize(oldC)
                return -1
            }
            for (uint32_t i = oldC; i < newC; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = newC
            return 0
        }

        // Take the slot that sits at dense position used(). Returns
        // its index, or 0xFFFFFFFF (_END) when the pool is not
        // initialized or every slot is live.
        func new_index(mview<SparseSetAllocator> self) -> uint32_t {
            if ($(self)._capacity == 0 || $(self)._used >= $(self)._capacity) {
                return 0xFFFFFFFF
            }
            uint32_t idx = $(self)._dense[$(self)._used]
            $(self)._sparse[idx] = $(self)._used
            $(self)._used++
            return idx
        }

        // Release slot idx by swapping it with the last live entry.
        // Returns 0 on success, -1 when idx is not a live slot, which
        // covers unknown indices and double release.
        func free_index(mview<SparseSetAllocator> self, uint32_t idx) -> int32_t {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            uint32_t delPos = $(self)._sparse[idx]
            uint32_t lastPos = $(self)._used - 1
            uint32_t lastIdx = $(self)._dense[lastPos]

            $(self)._dense[delPos] = lastIdx
            $(self)._dense[lastPos] = idx
            $(self)._sparse[lastIdx] = delPos
            $(self)._sparse[idx] = lastPos

            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<SparseSetAllocator> self, uint32_t idx) -> uint8_t {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            uint32_t pos = $(self)._sparse[idx]
            return pos < $(self)._used && $(self)._dense[pos] == idx
        }

        // Write every live index into out, in allocation order (the
        // dense order). out must hold at least used() elements.
        // Returns 0 on success, -1 when out is null, when the pool is
        // not initialized, or when out is too small.
        func write_active_indices(view<SparseSetAllocator> self, mview<array<uint32_t>> out) -> int32_t {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            for (uint32_t i = 0; i < $(self)._used; i++) {
                $(out)[i] = $(self)._dense[i]
            }
            return 0
        }

        // Number of live slots.
        func used(view<SparseSetAllocator> self) -> uint32_t {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<SparseSetAllocator> self) -> uint32_t {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Free-list pool with per-slot generation counters. Identical to
    // NextAllocator, plus a counter per slot that is bumped every time
    // the slot is released. An (index, generation) pair therefore
    // detects a stale reference to a recycled slot.
    // ------------------------------------------------------------
    struct GenerationalNextAllocator {
        uint32_t _capacity = 0
        uint32_t _used = 0
        uint32_t _head = 0xFFFFFFFF
        array<uint32_t> _next
        array<uint32_t> _generations

        // Prepare C slots (C > 0), all free, chained in ascending
        // order starting at slot 0, all generations zero. Returns 0 on
        // success, -1 when the pool is already initialized, when C is
        // 0, or when the storage cannot be allocated.
        func init(ptr<GenerationalNextAllocator> self, uint32_t C) -> int32_t {
            if ($(self)._capacity != 0 || C == 0) {
                return -1
            }
            int32_t st = $(self)._next.init(C)
            if (st != 0) {
                return -1
            }
            st = $(self)._generations.init_zero(C)
            if (st != 0) {
                $(self)._next.uninit()
                return -1
            }
            for (uint32_t i = 0; i < C; i++) {
                $(self)._next[i] = i + 1
            }
            $(self)._next[C - 1] = 0xFFFFFFFF
            $(self)._capacity = C
            $(self)._used = 0
            $(self)._head = 0
            return 0
        }

        // Free the storage and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<GenerationalNextAllocator> self) -> int32_t {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._head = 0xFFFFFFFF
            $(self)._next.uninit()
            $(self)._generations.uninit()
            return 0
        }

        // Enlarge the pool to newC slots (newC > capacity). The new
        // slots join the free list with generation 0. Returns 0 on
        // success, -1 when the pool is not initialized, when newC is
        // not greater than the current capacity, or when the storage
        // cannot be resized.
        func grow(ptr<GenerationalNextAllocator> self, uint32_t newC) -> int32_t {
            if ($(self)._capacity == 0 || newC <= $(self)._capacity) {
                return -1
            }
            uint32_t oldC = $(self)._capacity
            int32_t st = $(self)._next.resize(newC)
            if (st != 0) {
                return -1
            }
            st = $(self)._generations.resize(newC)
            if (st != 0) {
                $(self)._next.resize(oldC)
                return -1
            }
            for (uint32_t i = oldC; i < newC; i++) {
                $(self)._next[i] = i + 1
                $(self)._generations[i] = 0
            }
            $(self)._next[newC - 1] = $(self)._head
            $(self)._head = oldC
            $(self)._capacity = newC
            return 0
        }

        // Take the slot at the head of the free list. Returns its
        // index, or 0xFFFFFFFF (_END) when the pool is not initialized
        // or every slot is live.
        func new_index(mview<GenerationalNextAllocator> self) -> uint32_t {
            if ($(self)._capacity == 0 || $(self)._head == 0xFFFFFFFF) {
                return 0xFFFFFFFF
            }
            uint32_t idx = $(self)._head
            $(self)._head = $(self)._next[idx]
            $(self)._next[idx] = 0xFFFFFFFE
            $(self)._used++
            return idx
        }

        // Return slot idx to the free list (LIFO reuse), bumping its
        // generation. Returns 0 on success, -1 when idx is not a live
        // slot, which covers unknown indices and double release.
        func free_index(mview<GenerationalNextAllocator> self, uint32_t idx) -> int32_t {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._generations[idx]++
            $(self)._next[idx] = $(self)._head
            $(self)._head = idx
            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<GenerationalNextAllocator> self, uint32_t idx) -> uint8_t {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            return $(self)._next[idx] == 0xFFFFFFFE
        }

        // Generation counter of slot idx: 0 for a slot that was never
        // released, bumped by every release. Returns 0xFFFFFFFF (_END)
        // when the pool is not initialized or idx is out of range.
        func generation(view<GenerationalNextAllocator> self, uint32_t idx) -> uint32_t {
            if ($(self)._capacity == 0) {
                return 0xFFFFFFFF
            }
            if (idx >= $(self)._capacity) {
                return 0xFFFFFFFF
            }
            return $(self)._generations[idx]
        }

        // Write every live index into out, in ascending order. out
        // must hold at least used() elements. Returns 0 on success, -1
        // when out is null, when the pool is not initialized, or when
        // out is too small.
        func write_active_indices(view<GenerationalNextAllocator> self, mview<array<uint32_t>> out) -> int32_t {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            uint32_t pos = 0
            for (uint32_t i = 0; i < $(self)._capacity; i++) {
                if ($(self)._next[i] == 0xFFFFFFFE) {
                    $(out)[pos] = i
                    pos++
                }
            }
            return 0
        }

        // Number of live slots.
        func used(view<GenerationalNextAllocator> self) -> uint32_t {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<GenerationalNextAllocator> self) -> uint32_t {
            return $(self)._capacity
        }
    }

    // ------------------------------------------------------------
    // Sparse-set pool with per-slot generation counters. Identical to
    // SparseSetAllocator, plus a counter per slot that is bumped every
    // time the slot is released. An (index, generation) pair therefore
    // detects a stale reference to a recycled slot.
    // ------------------------------------------------------------
    struct GenerationalSparseSetAllocator {
        uint32_t _capacity = 0
        uint32_t _used = 0
        array<uint32_t> _sparse
        array<uint32_t> _dense
        array<uint32_t> _generations

        // Prepare C slots (C > 0), all free, all generations zero.
        // Returns 0 on success, -1 when the pool is already
        // initialized, when C is 0, or when the tables cannot be
        // allocated.
        func init(ptr<GenerationalSparseSetAllocator> self, uint32_t C) -> int32_t {
            if ($(self)._capacity != 0 || C == 0) {
                return -1
            }
            int32_t st = $(self)._sparse.init(C)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.init(C)
            if (st != 0) {
                $(self)._sparse.uninit()
                return -1
            }
            st = $(self)._generations.init_zero(C)
            if (st != 0) {
                $(self)._sparse.uninit()
                $(self)._dense.uninit()
                return -1
            }
            for (uint32_t i = 0; i < C; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
            }
            $(self)._capacity = C
            $(self)._used = 0
            return 0
        }

        // Free the tables and return to the empty pool. Returns 0 on
        // success, -1 when the pool is not initialized.
        func uninit(ptr<GenerationalSparseSetAllocator> self) -> int32_t {
            if ($(self)._capacity == 0) {
                return -1
            }
            $(self)._capacity = 0
            $(self)._used = 0
            $(self)._sparse.uninit()
            $(self)._dense.uninit()
            $(self)._generations.uninit()
            return 0
        }

        // Enlarge the pool to newC slots (newC > capacity). The new
        // slots are free with generation 0. Returns 0 on success, -1
        // when the pool is not initialized, when newC is not greater
        // than the current capacity, or when the tables cannot be
        // resized.
        func grow(ptr<GenerationalSparseSetAllocator> self, uint32_t newC) -> int32_t {
            if ($(self)._capacity == 0 || newC <= $(self)._capacity) {
                return -1
            }
            uint32_t oldC = $(self)._capacity
            int32_t st = $(self)._sparse.resize(newC)
            if (st != 0) {
                return -1
            }
            st = $(self)._dense.resize(newC)
            if (st != 0) {
                $(self)._sparse.resize(oldC)
                return -1
            }
            st = $(self)._generations.resize(newC)
            if (st != 0) {
                $(self)._sparse.resize(oldC)
                $(self)._dense.resize(oldC)
                return -1
            }
            for (uint32_t i = oldC; i < newC; i++) {
                $(self)._sparse[i] = i
                $(self)._dense[i] = i
                $(self)._generations[i] = 0
            }
            $(self)._capacity = newC
            return 0
        }

        // Take the slot that sits at dense position used(). Returns
        // its index, or 0xFFFFFFFF (_END) when the pool is not
        // initialized or every slot is live.
        func new_index(mview<GenerationalSparseSetAllocator> self) -> uint32_t {
            if ($(self)._capacity == 0 || $(self)._used >= $(self)._capacity) {
                return 0xFFFFFFFF
            }
            uint32_t idx = $(self)._dense[$(self)._used]
            $(self)._sparse[idx] = $(self)._used
            $(self)._used++
            return idx
        }

        // Release slot idx by swapping it with the last live entry,
        // bumping its generation. Returns 0 on success, -1 when idx is
        // not a live slot, which covers unknown indices and double
        // release.
        func free_index(mview<GenerationalSparseSetAllocator> self, uint32_t idx) -> int32_t {
            if ($(self).exist(idx) == 0) {
                return -1
            }
            $(self)._generations[idx]++

            uint32_t delPos = $(self)._sparse[idx]
            uint32_t lastPos = $(self)._used - 1
            uint32_t lastIdx = $(self)._dense[lastPos]

            $(self)._dense[delPos] = lastIdx
            $(self)._dense[lastPos] = idx
            $(self)._sparse[lastIdx] = delPos
            $(self)._sparse[idx] = lastPos

            $(self)._used--
            return 0
        }

        // 1 when slot idx is live, 0 otherwise (never allocated,
        // already released, or pool not initialized).
        func exist(view<GenerationalSparseSetAllocator> self, uint32_t idx) -> uint8_t {
            if ($(self)._capacity == 0) {
                return 0
            }
            if (idx >= $(self)._capacity) {
                return 0
            }
            uint32_t pos = $(self)._sparse[idx]
            return pos < $(self)._used && $(self)._dense[pos] == idx
        }

        // Generation counter of slot idx: 0 for a slot that was never
        // released, bumped by every release. Returns 0xFFFFFFFF (_END)
        // when the pool is not initialized or idx is out of range.
        func generation(view<GenerationalSparseSetAllocator> self, uint32_t idx) -> uint32_t {
            if ($(self)._capacity == 0) {
                return 0xFFFFFFFF
            }
            if (idx >= $(self)._capacity) {
                return 0xFFFFFFFF
            }
            return $(self)._generations[idx]
        }

        // Write every live index into out, in allocation order (the
        // dense order). out must hold at least used() elements.
        // Returns 0 on success, -1 when out is null, when the pool is
        // not initialized, or when out is too small.
        func write_active_indices(view<GenerationalSparseSetAllocator> self, mview<array<uint32_t>> out) -> int32_t {
            if (out == null) {
                return -1
            }
            if ($(self)._capacity == 0 || $(out).length() < $(self)._used) {
                return -1
            }
            for (uint32_t i = 0; i < $(self)._used; i++) {
                $(out)[i] = $(self)._dense[i]
            }
            return 0
        }

        // Number of live slots.
        func used(view<GenerationalSparseSetAllocator> self) -> uint32_t {
            return $(self)._used
        }

        // Number of slots the pool holds.
        func capacity(view<GenerationalSparseSetAllocator> self) -> uint32_t {
            return $(self)._capacity
        }
    }
}

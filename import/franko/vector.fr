// ============================================================
// Franko Vector of int32 — dynamic-array-backed struct
//
// Import with:
//
//   import "franko/vector"
//
// No generics yet: this is a vector of int32 only.
//
// Everything lives in namespace std. From global scope:
//
//   std::Vector v
//   v.init(4)
//   v.push(7)
//   v.uninit()
//
// Storage:
//
//   struct Vector {
//       [int32] data
//       uint32 len
//       uint32 cap
//   }
//
// Ownership:
//
//   - declare a local `std::Vector v` (len/cap default to 0,
//     data empty);
//   - call v.init once before use;
//   - call v.uninit when done (frees element storage).
//
// A struct containing a dynamic array is pointer-only: it cannot be
// passed or returned by value. Methods are called on a struct lvalue
// (v.push(7)) and declare the permission they need: ptr<Vector> self
// for the lifecycle operations (init/push grow/uninit), mview<Vector>
// self for the mutating ones, view<Vector> self for the read-only
// ones. The compiler synthesizes getptr/getmview/getview(v) as self.
// ============================================================

namespace std {
    struct Vector {
        [int32] data
        uint32 len = 0
        uint32 cap = 0

        // Allocate `capacity` slots. Returns 0 on success, -1 on failure.
        // A zero capacity is rejected without touching the array.
        func init(ptr<Vector> self, uint32 capacity) -> int32 {
            if (capacity == 0) {
                return -1
            }
            int32 st = $(self).data.init(capacity)
            if (st != 0) {
                return -1
            }
            $(self).len = 0
            $(self).cap = capacity
            return 0
        }

        // Push one value, growing the storage when full (4 slots first,
        // then doubling). Works even if init was never called.
        // Returns 0 on success, -1 on allocation failure.
        func push(ptr<Vector> self, int32 value) -> int32 {
            if ($(self).len >= $(self).cap) {
                uint32 new_cap = 4
                if ($(self).cap != 0) {
                    new_cap = $(self).cap * 2
                }
                int32 st = 0
                if ($(self).cap == 0) {
                    st = $(self).data.init(new_cap)
                } else {
                    st = $(self).data.resize(new_cap)
                }
                if (st != 0) {
                    return -1
                }
                $(self).cap = new_cap
            }
            $(self).data[$(self).len] = value
            $(self).len++
            return 0
        }

        // Pop the top value. Returns (val, err): err is 0 on success
        // and -1 when the vector is empty; val is 0 on failure.
        func pop(mview<Vector> self) -> (int32 val, int32 err) {
            (int32 val, int32 err) result
            result.val = 0
            result.err = -1
            if ($(self).len == 0) {
                return result
            }
            $(self).len--
            result.val = $(self).data[$(self).len]
            result.err = 0
            return result
        }

        // Read element `index`. The caller must ensure index < len.
        func get(view<Vector> self, uint32 index) -> int32 {
            return $(self).data[index]
        }

        // Write element `index`. The caller must ensure index < len.
        func set(mview<Vector> self, uint32 index, int32 value) -> void {
            $(self).data[index] = value
            return
        }

        // Number of live elements.
        func length(view<Vector> self) -> uint32 {
            return $(self).len
        }

        // Number of allocated slots.
        func capacity(view<Vector> self) -> uint32 {
            return $(self).cap
        }

        // Free element storage and reset to empty.
        func uninit(ptr<Vector> self) -> void {
            $(self).data.uninit()
            $(self).len = 0
            $(self).cap = 0
            return
        }
    }
}

// ============================================================
// Franko Vector of int32_t — dynamic-array-backed struct
//
// Import with:
//
//   import "franko/vector"
//
// No generics yet: this is a vector of int32_t only.
//
// Everything lives in namespace std. From global scope:
//
//   std::Vector v
//   v.init(4)
//   v.push(7)
//   v.uninit()
//
// Storage:
//
//   struct Vector {
//       array<int32_t> data
//       uint32_t len
//       uint32_t cap
//   }
//
// Ownership:
//
//   - declare a local `std::Vector v` (len/cap default to 0,
//     data empty);
//   - call v.init once before use;
//   - call v.uninit when done (frees element storage).
//
// A struct containing a dynamic array is address-only: it cannot be
// passed or returned by value. Methods take addr<Vector> self and are
// called on a struct lvalue (v.push(7)); the compiler synthesizes
// getaddr(v) as self.
// ============================================================

namespace std {
    struct Vector {
        array<int32_t> data
        uint32_t len = 0
        uint32_t cap = 0

        // Allocate `capacity` slots. Returns 0 on success, -1 on failure.
        // A zero capacity is rejected without touching the array.
        func init(addr<Vector> self, uint32_t capacity) -> int32_t {
            if (capacity == 0) {
                return -1
            }
            int32_t st = $(self).data.init(capacity)
            if (st != 0) {
                return -1
            }
            $(self).len = 0
            $(self).cap = capacity
            return 0
        }

        // Push one value, growing the storage when full (4 slots first,
        // then doubling). Works even if init was never called.
        // Returns 0 on success, -1 on allocation failure.
        func push(addr<Vector> self, int32_t value) -> int32_t {
            if ($(self).len >= $(self).cap) {
                uint32_t newCap = 4
                if ($(self).cap != 0) {
                    newCap = $(self).cap * 2
                }
                int32_t st = 0
                if ($(self).cap == 0) {
                    st = $(self).data.init(newCap)
                } else {
                    st = $(self).data.resize(newCap)
                }
                if (st != 0) {
                    return -1
                }
                $(self).cap = newCap
            }
            $(self).data[$(self).len] = value
            $(self).len++
            return 0
        }

        // Pop the top value into `out`. Returns 0 on success, -1 when the
        // vector is empty or `out` is null.
        func pop(addr<Vector> self, addr<int32_t> out) -> int32_t {
            if (out == null) {
                return -1
            }
            if ($(self).len == 0) {
                return -1
            }
            $(self).len--
            $(out) = $(self).data[$(self).len]
            return 0
        }

        // Read element `index`. The caller must ensure index < len.
        func get(addr<Vector> self, uint32_t index) -> int32_t {
            return $(self).data[index]
        }

        // Write element `index`. The caller must ensure index < len.
        func set(addr<Vector> self, uint32_t index, int32_t value) -> void {
            $(self).data[index] = value
            return
        }

        // Number of live elements.
        func length(addr<Vector> self) -> uint32_t {
            return $(self).len
        }

        // Number of allocated slots.
        func capacity(addr<Vector> self) -> uint32_t {
            return $(self).cap
        }

        // Free element storage and reset to empty.
        func uninit(addr<Vector> self) -> void {
            $(self).data.uninit()
            $(self).len = 0
            $(self).cap = 0
            return
        }
    }
}

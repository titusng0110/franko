// binary_codec.fr -- fixed-size wire-format packet encoder/decoder.
//
// The payload is supplied as the first command-line argument:
//
//   ./programs/binary_codec.out "Hello, Franko!"
//
// The 64-byte packet mixes big- and little-endian header fields, carries
// a byte of bit flags, and ends with an FNV-1a checksum over the header
// prefix and the payload. The program encodes the packet, decodes it with
// the read_* accessors, re-encodes the decoded fields, and verifies that
// the two packet images match byte for byte.

import "franko/io"
import "franko/string"

namespace text {
    // Copy buf[start, start+count) into a std::String.
    func string_from_slice(view<[byte]> buf, uint32 start, uint32 count, ptr<std::String> out) -> int32 {
        if (buf == null) {
            return -1
        }
        if (out == null) {
            return -1
        }
        uint32 n = $(buf).length()
        if (start > n || count > n - start) {
            return -1
        }
        std::String full
        int32 st = full.from(buf)
        if (st != 0) {
            full.uninit()
            return -1
        }
        st = full.get_slice(start, start + count, out)
        full.uninit()
        if (st != 0) {
            return -1
        }
        return 0
    }

    func print_slice(view<[byte]> buf, uint32 start, uint32 count) -> void {
        if (buf == null || count == 0) {
            return
        }
        std::String token
        if (string_from_slice(buf, start, count, getptr(token)) != 0) {
            token.uninit()
            return
        }
        view<[byte]> no_end = null
        print(getview(token), no_end)
        token.uninit()
        return
    }

    func hex_digit(byte value) -> byte {
        if (value < 10) {
            return value + 48
        }
        return value + 55
    }

    func print_hex_byte(byte value) -> void {
        [byte, 2] out
        out[0] = hex_digit(value / 16)
        out[1] = hex_digit(value % 16)
        print(getview(out), null)
        return
    }

    func print_hex(view<[byte]> buf, uint32 start, uint32 count) -> void {
        if (buf == null) {
            return
        }
        for (uint32 i = 0; i < count; i++) {
            if (i != 0) {
                print(" ", null)
            }
            print_hex_byte($(buf)[start + i])
        }
        return
    }
}


enum<uint8> PacketKind {
    data = 1,
    ack = 2,
    ping = 3,
    error = 4
}

struct PacketHeader {
    uint32 magic
    byte version
    PacketKind kind
    byte flags
    byte header_size
    uint32 sequence
    uint32 payload_length
    uint16 stream_id
    uint16 hop_count
    uint32 checksum
}

// Wire layout:
//   0..3    magic "FRNK"
//   4       version
//   5       PacketKind byte
//   6       bit flags
//   7       header size (32)
//   8..11   sequence, big-endian uint32
//   12..15  payload length, little-endian uint32
//   16..17  stream id, big-endian uint16
//   18..19  hop count, little-endian uint16
//   20..23  FNV-1a checksum, big-endian uint32
//   24..31  reserved, zero
//   32..63  payload bytes (at most 32)
uint32 CODEC_MAGIC = 0x46524E4B
byte CODEC_VERSION = 1
uint32 CODEC_HEADER_BYTES = 32
uint32 CODEC_CHECKSUM_OFFSET = 20
uint32 CODEC_PAYLOAD_OFFSET = 32
uint32 CODEC_PAYLOAD_CAP = 32
uint32 CODEC_SEQUENCE = 42
uint16 CODEC_STREAM_ID = 7
uint16 CODEC_HOP_COUNT = 3
uint32 FNV_OFFSET_BASIS = 2166136261
uint32 FNV_PRIME = 16777619

// Compile-time target and layout assertion. The unsupported branch only
// panics, and both branches select the same declarations on every target
// this program supports.
#if (#strcmp(#what_type([byte, 64]), "[uint8,64]") == 0 && (#IS_LINUX || #IS_MACOS || #IS_WINDOWS)) {
    int32 CODEC_LAYOUT_OK = 1
} #else {
    #panic("binary_codec: unsupported target or packet layout")
}

func empty_header() -> PacketHeader {
    return PacketHeader {
        magic = 0,
        version = 0,
        kind = PacketKind::error,
        flags = 0,
        header_size = 0,
        sequence = 0,
        payload_length = 0,
        stream_id = 0,
        hop_count = 0,
        checksum = 0
    }
}

func fnv1a_byte(uint32 hash, byte value) -> uint32 {
    hash ^= cast<uint32>(value)
    hash *= FNV_PRIME
    return hash
}

// FNV-1a over the header prefix [0, 20) and the payload bytes. The
// checksum field itself is not part of the covered range.
func packet_checksum(view<[byte]> raw, uint32 payload_len) -> uint32 {
    if (raw == null) {
        return 0
    }

    uint32 hash = FNV_OFFSET_BASIS

    for (uint32 i = 0; i < CODEC_CHECKSUM_OFFSET; i++) {
        hash = fnv1a_byte(hash, $(raw)[i])
    }

    uint32 end = CODEC_PAYLOAD_OFFSET + payload_len
    if (end > $(raw).length()) {
        end = $(raw).length()
    }
    for (uint32 i = CODEC_PAYLOAD_OFFSET; i < end; i++) {
        hash = fnv1a_byte(hash, $(raw)[i])
    }

    return hash
}

func build_packet(mview<[byte, 64]> packet, view<[byte]> payload, uint32 payload_len, PacketKind kind, uint32 sequence, uint16 stream_id, uint16 hop_count) -> uint32 {
    if (packet == null) {
        return 0
    }
    if (payload == null) {
        return 0
    }

    uint32 copy_len = payload_len
    if (copy_len > $(payload).length()) {
        copy_len = $(payload).length()
    }
    if (copy_len > CODEC_PAYLOAD_CAP) {
        copy_len = CODEC_PAYLOAD_CAP
    }

    $(packet).memset(0)
    $(packet).memcpy("FRNK")

    $(packet)[4] = CODEC_VERSION
    $(packet)[5] = cast<uint8>(kind)
    $(packet)[7] = 32

    [byte, 1] flag_bits
    flag_bits.memset(0)
    if (copy_len > 0) {
        flag_bits.write_bit(0, 1)    // has payload
    }
    flag_bits.write_bit(1, 1)        // ack required
    flag_bits.write_bit(4, 1)        // last fragment
    $(packet)[6] = flag_bits[0]

    $(packet).write_uint32_BE(8, sequence)
    $(packet).write_uint32_LE(12, copy_len)
    $(packet).write_uint16_BE(16, stream_id)
    $(packet).write_uint16_LE(18, hop_count)

    if (copy_len > 0) {
        $(packet).memcpy(payload, CODEC_PAYLOAD_OFFSET, 0, copy_len)
    }

    uint32 checksum = packet_checksum(packet, copy_len)
    $(packet).write_uint32_BE(CODEC_CHECKSUM_OFFSET, checksum)
    return checksum
}

func decode_header(view<[byte]> bytes) -> PacketHeader {
    if (bytes == null) {
        return empty_header()
    }
    if ($(bytes).length() < CODEC_HEADER_BYTES) {
        return empty_header()
    }

    PacketHeader header
    header.magic = $(bytes).read_uint32_BE(0)
    header.version = $(bytes)[4]
    header.kind = unsafe_cast<PacketKind>($(bytes)[5])
    header.flags = $(bytes)[6]
    header.header_size = $(bytes)[7]
    header.sequence = $(bytes).read_uint32_BE(8)
    header.payload_length = $(bytes).read_uint32_LE(12)
    header.stream_id = $(bytes).read_uint16_BE(16)
    header.hop_count = $(bytes).read_uint16_LE(18)
    header.checksum = $(bytes).read_uint32_BE(20)
    return header
}

func print_hex_u32(uint32 value) -> void {
    [byte, 4] raw
    raw.write_uint32_BE(0, value)
    print("0x", null)
    for (uint32 i = 0; i < 4; i++) {
        text::print_hex_byte(raw[i])
    }
    return
}

func kind_name(PacketKind kind) -> view<[byte]> {
    if (kind == PacketKind::data) {
        return "data"
    }
    if (kind == PacketKind::ack) {
        return "ack"
    }
    if (kind == PacketKind::ping) {
        return "ping"
    }
    return "error"
}

func print_header(PacketHeader header) -> void {
    print("magic: ", null)
    print_hex_u32(header.magic)
    print()

    print("version: ", null)
    print(header.version, null)
    print()

    print("kind: ", null)
    print(kind_name(header.kind), null)
    print(" (", null)
    print(cast<uint8>(header.kind), null)
    print(")")

    print("flags: 0x", null)
    text::print_hex_byte(header.flags)
    [byte, 1] flag_bits
    flag_bits[0] = header.flags
    print(" (has_payload=", null)
    print(flag_bits.read_bit(0), null)
    print(" ack_required=", null)
    print(flag_bits.read_bit(1), null)
    print(" compressed=", null)
    print(flag_bits.read_bit(2), null)
    print(" encrypted=", null)
    print(flag_bits.read_bit(3), null)
    print(" last_fragment=", null)
    print(flag_bits.read_bit(4), null)
    print(")")

    print("header_size: ", null)
    print(header.header_size, null)
    print()

    print("sequence: ", null)
    print(header.sequence, null)
    print(" (big-endian)")

    print("payload_length: ", null)
    print(header.payload_length, null)
    print(" (little-endian)")

    print("stream_id: ", null)
    print(header.stream_id, null)
    print(" (big-endian)")

    print("hop_count: ", null)
    print(header.hop_count, null)
    print(" (little-endian)")

    print("checksum: ", null)
    print_hex_u32(header.checksum)
    print(" (FNV-1a)")
    return
}

func main(view<[[byte]]> args) -> int32 {
    if ($(args).length() < 2) {
        print("usage: binary_codec <payload>")
        return 1
    }

    view<[byte]> payload = getview($(args)[1])
    if (payload == null) {
        print("error: null payload argument")
        return 1
    }

    uint32 payload_len = $(payload).length()
    if (payload_len == 0) {
        print("error: empty payload")
        return 1
    }
    if (payload_len > CODEC_PAYLOAD_CAP) {
        print("error: payload exceeds 32 bytes")
        return 1
    }

    print("binary_codec: args-form packet codec")
    print("payload: ", null)
    text::print_slice(payload, 0, payload_len)
    print(" (", null)
    print(payload_len, null)
    print(" bytes)")
    print()

    [byte, 64] packet
    uint32 encoded_checksum = build_packet(getmview(packet), payload, payload_len, PacketKind::data, CODEC_SEQUENCE, CODEC_STREAM_ID, CODEC_HOP_COUNT)

    PacketHeader header = decode_header(getview(packet))

    print("packet fields:")
    print_header(header)
    print()

    print("hex dump:")
    for (uint32 start = 0; start < 64; start += 16) {
        print("  ", null)
        print(start, ": ")
        text::print_hex(getview(packet), start, 16)
        print()
    }
    print()

    print("verification:")
    byte ok = 1

    if (header.magic != CODEC_MAGIC) {
        ok = 0
    }
    if (header.version != CODEC_VERSION) {
        ok = 0
    }
    if (header.kind != PacketKind::data) {
        ok = 0
    }
    if (header.flags != 0x13) {
        ok = 0
    }
    if (header.header_size != 32) {
        ok = 0
    }
    if (header.sequence != CODEC_SEQUENCE) {
        ok = 0
    }
    if (header.payload_length != payload_len) {
        ok = 0
    }
    if (header.stream_id != CODEC_STREAM_ID) {
        ok = 0
    }
    if (header.hop_count != CODEC_HOP_COUNT) {
        ok = 0
    }

    if (ok != 0) {
        print("field validation: ok")
    } else {
        print("field validation: failed")
    }

    uint32 recomputed_checksum = packet_checksum(getview(packet), header.payload_length)
    if (recomputed_checksum == header.checksum && encoded_checksum == header.checksum) {
        print("checksum status: valid")
    } else {
        print("checksum status: invalid")
        ok = 0
    }

    uint32 payload_offset = packet.memmem(payload)
    print("payload lookup: offset ", null)
    print(payload_offset, null)
    if (payload_offset == 0xFFFFFFFF) {
        print(" (not found)")
        ok = 0
    } else {
        print()
    }

    [byte, 32] decoded_payload
    decoded_payload.memset(0)
    decoded_payload.memcpy(getview(packet), 0, CODEC_PAYLOAD_OFFSET, header.payload_length)

    if (header.payload_length == payload_len && decoded_payload.memcmp(payload, 0, 0, payload_len) == 0) {
        print("payload compare: equal")
    } else {
        print("payload compare: mismatch")
        ok = 0
    }

    [byte, 64] rebuilt
    uint32 rebuilt_checksum = build_packet(getmview(rebuilt), getview(decoded_payload), header.payload_length, header.kind, header.sequence, header.stream_id, header.hop_count)
    if (packet.memcmp(getview(rebuilt)) == 0 && rebuilt_checksum == header.checksum) {
        print("roundtrip: identical")
    } else {
        print("roundtrip: mismatch")
        ok = 0
    }

    [byte, 64] damaged
    damaged.memcpy(getview(packet))
    damaged.flip_bit(0)
    PacketHeader damaged_header = decode_header(getview(damaged))
    uint32 damaged_checksum = packet_checksum(getview(damaged), damaged_header.payload_length)
    if (damaged_checksum == damaged_header.checksum) {
        print("tamper check: not detected")
        ok = 0
    } else {
        print("tamper check: rejected")
    }
    print()

    print("reflection:")
    print("type of packet: ", null)
    print(#what_type(packet))
    print("type of header: ", null)
    print(#what_type(PacketHeader))
    print("is_memcpy_safe(packet): ", null)
    print(#is_memcpy_safe(packet))
    print("is_memcpy_safe(PacketHeader): ", null)
    print(#is_memcpy_safe(PacketHeader))
    print(#strcat("strcat: packet=", #what_type(packet), " header=", #what_type(PacketHeader)))
    print("layout assertion: ", null)
    print(CODEC_LAYOUT_OK)

    if (ok == 0) {
        print("result: failed")
        return 1
    }
    print("result: ok")
    return 0
}

// Recursive merge sort of 50 elements using a helper buffer field.
//
// Demonstrates structs with static-array fields, methods with
// explicit self receivers (mview for mutation, view for reads),
// recursive methods,
// array initializer lists, and the array intrinsics memset and
// memcpy(dst, dstStart, srcStart, count).
//
// The two working arrays live in the struct, so the whole sort state
// is one MergeSorter value and no globals are needed. Arrays are not
// assignable or passable by value, so array data moves through the
// intrinsics with pointers.

struct MergeSorter {
    array<int, 50> a
    array<int, 50> b

    func printArray(view<MergeSorter> self, uint n) -> void {
        for (uint i = 0; i < n; i++) {
            print($(self).a[i])
        }

        return
    }

    func initData(mview<MergeSorter> self) -> void {
        $(self).a.memcpy([
            42, 7, 19, 3, 100, 55, 1, 88, 12, 33,
            21, 5, 77, 60, 2, 50, 91, 14, 39, 73,
            8, 65, 27, 44, 6, 99, 31, 58, 16, 82,
            24, 70, 11, 47, 35, 94, 29, 63, 18, 76,
            4, 53, 68, 10, 97, 26, 41, 80, 22, 56
        ])

        $(self).b.memset(0)
        return
    }

    func merge(mview<MergeSorter> self, uint low, uint mid, uint high) -> void {
        uint i = 0
        uint j = 0
        uint k = 0
        uint count = 0

        i = low
        j = mid + 1
        k = low

        while (i <= mid && j <= high) {
            if ($(self).a[i] <= $(self).a[j]) {
                $(self).b[k] = $(self).a[i]
                i++
            } else {
                $(self).b[k] = $(self).a[j]
                j++
            }

            k++
        }

        while (i <= mid) {
            $(self).b[k] = $(self).a[i]
            i++
            k++
        }

        while (j <= high) {
            $(self).b[k] = $(self).a[j]
            j++
            k++
        }

        count = high - low + 1
        $(self).a.memcpy(getview($(self).b), low, low, count)
        return
    }

    func mergeSort(mview<MergeSorter> self, uint low, uint high) -> void {
        uint mid = 0

        if (low < high) {
            mid = low + ((high - low) / 2)

            $(self).mergeSort(low, mid)
            $(self).mergeSort(mid + 1, high)
            $(self).merge(low, mid, high)
        }

        return
    }

    func isSorted(view<MergeSorter> self, uint n) -> byte {
        byte sorted = 1

        for (uint k = 1; k < n; k++) {
            if ($(self).a[k] < $(self).a[k - 1]) {
                sorted = 0
                break
            }
        }

        return sorted
    }
}

func main() -> int {
    MergeSorter sorter
    uint n = 50
    byte sorted = 0

    sorter.initData()

    print(3001)
    sorter.printArray(n)

    sorter.mergeSort(0, n - 1)

    print(3002)
    sorter.printArray(n)

    sorted = sorter.isSorted(n)

    print(3003)
    print(sorted)

    return 0
}

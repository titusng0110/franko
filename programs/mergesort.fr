// ============================================================
// Franko Recursive Merge Sort Showcase: 50 Elements
// Struct + Methods Version With Array Initializer List + Intrinsics
// ============================================================
//
// Demonstrates:
//
//   - structs with static-array fields
//   - methods with explicit addr<MergeSorter> self receivers
//   - recursive methods
//   - void and non-void methods
//   - uint indexes
//   - int32_t values
//   - for loops for counted iteration
//   - merge sort using a helper copy buffer field
//   - array initializer-list assignment
//   - array.memset(...)
//   - array.memcpy(addr<array<...>>, dstStart, srcStart, count)
//
// The two working arrays live in the struct, so no globals are
// needed: the whole sort state is one MergeSorter value.
//
// Arrays are not directly assignable, parameter-passable, or returnable by
// value. When array data must be copied, use array intrinsics with addresses.
// ============================================================

struct MergeSorter {
    array<int32_t, 50> a
    array<int32_t, 50> b

    func printArray(addr<MergeSorter> self, uint n) -> void {
        for (uint i = 0; i < n; i = i + 1) {
            print($(self).a[i])
        }

        return
    }

    func initData(addr<MergeSorter> self) -> void {
        $(self).a = [
            42, 7, 19, 3, 100, 55, 1, 88, 12, 33,
            21, 5, 77, 60, 2, 50, 91, 14, 39, 73,
            8, 65, 27, 44, 6, 99, 31, 58, 16, 82,
            24, 70, 11, 47, 35, 94, 29, 63, 18, 76,
            4, 53, 68, 10, 97, 26, 41, 80, 22, 56
        ]

        $(self).b.memset(0)
        return
    }

    func merge(addr<MergeSorter> self, uint low, uint mid, uint high) -> void {
        uint i = 0
        uint j = 0
        uint k = 0
        uint count = 0

        i = low
        j = mid + 1
        k = low

        while (i <= mid && j <= high) {
            if ($(self).a[i] <= $(self).a[j]) {
                $(self).b[k] = $(self).a[i]
                i = i + 1
            } else {
                $(self).b[k] = $(self).a[j]
                j = j + 1
            }

            k = k + 1
        }

        while (i <= mid) {
            $(self).b[k] = $(self).a[i]
            i = i + 1
            k = k + 1
        }

        while (j <= high) {
            $(self).b[k] = $(self).a[j]
            j = j + 1
            k = k + 1
        }

        count = high - low + 1
        $(self).a.memcpy(getaddr($(self).b), low, low, count)
        return
    }

    func mergeSort(addr<MergeSorter> self, uint low, uint high) -> void {
        uint mid = 0

        if (low < high) {
            mid = low + ((high - low) / 2)

            $(self).mergeSort(low, mid)
            $(self).mergeSort(mid + 1, high)
            $(self).merge(low, mid, high)
        }

        return
    }

    func isSorted(addr<MergeSorter> self, uint n) -> uint8_t {
        uint8_t sorted = 1

        for (uint k = 1; k < n; k = k + 1) {
            if ($(self).a[k] < $(self).a[k - 1]) {
                sorted = 0
            }
        }

        return sorted
    }
}

func main() -> int32_t {
    MergeSorter sorter
    uint n = 50
    uint8_t sorted = 0

    sorter.initData()

    print(3001)
    sorter.printArray(n)

    sorter.mergeSort(0, n - 1)

    print(3002)
    sorter.printArray(n)

    sorted = sorter.isSorted(n)

    print(3003)
    print(sorted)

    return 0
}

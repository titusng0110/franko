// Iterative quicksort of 50 elements using an explicit stack.
//
// Demonstrates structs with a static-array field, methods with
// explicit self receivers (ptr for lifecycle, mview for mutation,
// view for reads), array initializer lists,
// array.memset / array.memcpy, and while-loop-based partitioning.
//
// Arrays live in the struct because Franko arrays are not directly
// assignable, parameter-passable, or returnable by value; methods
// reach them as $(self).data.

struct QuickSort {
    [int, 50] data

    func printArray(view<QuickSort> self, uint n) -> void {
        for (uint i = 0; i < n; i++) {
            print($(self).data[i])
        }

        return
    }

    func initData(mview<QuickSort> self) -> void {
        [int, 50] source

        source.memcpy([
            42, 7, 19, 3, 100, 55, 1, 88, 12, 33,
            21, 5, 77, 60, 2, 50, 91, 14, 39, 73,
            8, 65, 27, 44, 6, 99, 31, 58, 16, 82,
            24, 70, 11, 47, 35, 94, 29, 63, 18, 76,
            4, 53, 68, 10, 97, 26, 41, 80, 22, 56
        ])

        $(self).data.memcpy(getview(source))
        return
    }

    func swap(mview<QuickSort> self, uint a, uint b) -> void {
        int temp = 0

        temp = $(self).data[a]
        $(self).data[a] = $(self).data[b]
        $(self).data[b] = temp
        return
    }

    func partition(mview<QuickSort> self, uint low, uint high) -> uint {
        int pivot = 0
        uint i = 0
        uint j = 0

        pivot = $(self).data[high]
        i = low

        for (j = low; j < high; j++) {
            if ($(self).data[j] <= pivot) {
                $(self).swap(i, j)
                i++
            }
        }

        $(self).swap(i, high)

        return i
    }

    func quicksort(mview<QuickSort> self, uint n) -> void {
        [uint, 128] stackLow
        [uint, 128] stackHigh

        uint top = 0
        uint low = 0
        uint high = 0
        uint pi = 0

        stackLow.memset(0)
        stackHigh.memset(0)

        if (n <= 1) {
            return
        }

        stackLow[top] = 0
        stackHigh[top] = n - 1
        top++

        while (top != 0) {
            top--

            low = stackLow[top]
            high = stackHigh[top]

            if (low < high) {
                pi = $(self).partition(low, high)

                if (pi > low) {
                    stackLow[top] = low
                    stackHigh[top] = pi - 1
                    top++
                }

                if (pi < high) {
                    stackLow[top] = pi + 1
                    stackHigh[top] = high
                    top++
                }
            }
        }

        return
    }

    func isSorted(view<QuickSort> self, uint n) -> byte {
        byte sorted = 1

        for (uint k = 1; k < n; k++) {
            if ($(self).data[k] < $(self).data[k - 1]) {
                sorted = 0
                break
            }
        }

        return sorted
    }
}

func main() -> int {
    QuickSort sorter

    uint n = 50
    byte sorted = 0

    sorter.data.memset(0)
    sorter.initData()

    print(2001)
    sorter.printArray(n)

    sorter.quicksort(n)

    print(2002)
    sorter.printArray(n)

    sorted = sorter.isSorted(n)

    print(2003)
    print(sorted)

    return 0
}

// Integer expression calculator.
//
// Reads a count N followed by N expression lines and evaluates each one
// with a recursive-descent parser supporting + - * / %, parentheses,
// unary minus, and arbitrary ASCII whitespace. The expression is echoed
// before its result or error.
//
// Run with:
//
//   ./programs/calculator.out < programs/calculator.stdin

import "franko/stdio"
import "franko/string"

namespace text {
    func read_line_len(mview<[byte]> buf, const uint32 cap, mview<uint32> line_len) -> int32 {
        if (buf == null) {
            return -1
        }
        if (line_len == null) {
            return -1
        }
        std::String line_text
        if (stdin_line(getptr(line_text)) != 0) {
            line_text.uninit()
            return -1
        }
        uint32 n = line_text.length()
        if (n > cap) {
            line_text.uninit()
            return -1
        }
        uint32 i = 0
        while (i < n) {
            $(buf)[i] = line_text.get(i)
            i = i + 1
        }
        $(line_len) = n
        line_text.uninit()
        return 0
    }

    // Copy buf[start, start+count) into a std::String.
    func string_from_slice(view<[byte]> buf, const uint32 start, const uint32 count, ptr<std::String> out) -> int32 {
        if (buf == null) {
            return -1
        }
        if (out == null) {
            return -1
        }
        uint32 n = $(buf).length()
        if (start > n || count > n - start) {
            return -1
        }
        std::String full
        int32 st = full.from(buf)
        if (st != 0) {
            full.uninit()
            return -1
        }
        st = full.get_slice(start, start + count, out)
        full.uninit()
        if (st != 0) {
            return -1
        }
        return 0
    }

    func parse_int64(view<[byte]> buf, const uint32 start, const uint32 count, mview<int64> out) -> byte {
        if (out == null) {
            return 0
        }
        std::String token
        if (string_from_slice(buf, start, count, getptr(token)) != 0) {
            token.uninit()
            return 0
        }
        (int64 val, int32 err) parsed = token.to_int64()
        token.uninit()
        if (parsed.err != 0) {
            return 0
        }
        $(out) = parsed.val
        return 1
    }

    func parse_uint32(view<[byte]> buf, const uint32 start, const uint32 count, mview<uint32> out) -> byte {
        if (out == null) {
            return 0
        }
        std::String token
        if (string_from_slice(buf, start, count, getptr(token)) != 0) {
            token.uninit()
            return 0
        }
        (uint32 val, int32 err) parsed = token.to_uint32()
        token.uninit()
        if (parsed.err != 0) {
            return 0
        }
        $(out) = parsed.val
        return 1
    }

    func skip_spaces(view<[byte]> buf, mview<uint32> pos) -> void {
        if (buf == null) {
            return
        }
        if (pos == null) {
            return
        }
        uint32 i = $(pos)
        uint32 n = $(buf).length()
        while (i < n) {
            byte b = $(buf)[i]
            if (b != 32 && b != 9) {
                break
            }
            i = i + 1
        }
        $(pos) = i
        return
    }

    func print_slice(view<[byte]> buf, const uint32 start, const uint32 count) -> void {
        if (buf == null || count == 0) {
            return
        }
        std::String token
        if (string_from_slice(buf, start, count, getptr(token)) != 0) {
            token.uninit()
            return
        }
        view<[byte]> no_end = null
        stdout(getview(token), end = no_end)
        token.uninit()
        return
    }
}


enum<uint8> TokenKind {
    endOfInput,
    integer,
    plus,
    minus,
    star,
    slash,
    percent,
    leftParen,
    rightParen,
    invalid
}

enum<uint8> CalcError {
    none,
    unexpectedToken,
    unexpectedEnd,
    expectedRightParen,
    divisionByZero,
    trailingInput
}

struct Token {
    TokenKind kind
    int64 value = 0
    uint32 start = 0
    uint32 count = 0
}

struct Parser {
    view<[byte]> line
    uint32 line_len = 0
    uint32 pos = 0
    Token current
    CalcError error

    // Reset the parser and prime the first token.
    func reset(mview<Parser> self, const view<[byte]> line, const uint32 line_len) -> void {
        $(self).line = line
        $(self).line_len = line_len
        $(self).pos = 0
        $(self).error = CalcError::none
        $(self).current.kind = TokenKind::endOfInput
        $(self).current.value = 0
        $(self).current.start = 0
        $(self).current.count = 0
        $(self).advance()
        return
    }

    func fail(mview<Parser> self, const CalcError err) -> void {
        if ($(self).error == CalcError::none) {
            $(self).error = err
        }
        return
    }

    // Classify the next token, skipping spaces and tabs.
    func advance(mview<Parser> self) -> void {
        view<[byte]> src = $(self).line
        if (src == null) {
            $(self).current.kind = TokenKind::endOfInput
            return
        }

        uint32 i = $(self).pos
        uint32 n = $(self).line_len
        if (n > $(src).length()) {
            n = $(src).length()
        }

        while (i < n) {
            byte b = $(src)[i]
            if (b != 32 && b != 9) {
                break
            }
            i++
        }

        $(self).current.kind = TokenKind::endOfInput
        $(self).current.value = 0
        $(self).current.start = i
        $(self).current.count = 0

        if (i >= n) {
            $(self).pos = i
            return
        }

        byte b = $(src)[i]

        if (b >= 48 && b <= 57) {
            uint32 start = i
            while (i < n) {
                byte digit = $(src)[i]
                if (digit < 48 || digit > 57) {
                    break
                }
                i++
            }

            uint32 count = i - start
            int64 number = 0
            if (text::parse_int64(src, start, count, getmview(number)) == 0) {
                $(self).current.kind = TokenKind::invalid
            } else {
                $(self).current.kind = TokenKind::integer
                $(self).current.value = number
            }
            $(self).current.start = start
            $(self).current.count = count
            $(self).pos = i
            return
        }

        if (b == 43) {
            $(self).current.kind = TokenKind::plus
        } else if (b == 45) {
            $(self).current.kind = TokenKind::minus
        } else if (b == 42) {
            $(self).current.kind = TokenKind::star
        } else if (b == 47) {
            $(self).current.kind = TokenKind::slash
        } else if (b == 37) {
            $(self).current.kind = TokenKind::percent
        } else if (b == 40) {
            $(self).current.kind = TokenKind::leftParen
        } else if (b == 41) {
            $(self).current.kind = TokenKind::rightParen
        } else {
            $(self).current.kind = TokenKind::invalid
        }

        $(self).current.start = i
        $(self).current.count = 1
        $(self).pos = i + 1
        return
    }

    // primary := INTEGER | '(' expression ')'
    func parse_primary(mview<Parser> self) -> int64 {
        if ($(self).error != CalcError::none) {
            return 0
        }

        if ($(self).current.kind == TokenKind::integer) {
            int64 value = $(self).current.value
            $(self).advance()
            return value
        }

        if ($(self).current.kind == TokenKind::leftParen) {
            $(self).advance()
            int64 value = $(self).parse_expression()
            if ($(self).error != CalcError::none) {
                return 0
            }
            if ($(self).current.kind != TokenKind::rightParen) {
                $(self).fail(CalcError::expectedRightParen)
                return 0
            }
            $(self).advance()
            return value
        }

        if ($(self).current.kind == TokenKind::endOfInput) {
            $(self).fail(CalcError::unexpectedEnd)
        } else {
            $(self).fail(CalcError::unexpectedToken)
        }
        return 0
    }

    // factor := '-' factor | primary
    func parse_factor(mview<Parser> self) -> int64 {
        if ($(self).error != CalcError::none) {
            return 0
        }

        if ($(self).current.kind == TokenKind::minus) {
            $(self).advance()
            int64 value = $(self).parse_factor()
            if ($(self).error != CalcError::none) {
                return 0
            }
            return -value
        }

        return $(self).parse_primary()
    }

    // term := factor (('*' | '/' | '%') factor)*
    func parse_term(mview<Parser> self) -> int64 {
        int64 value = $(self).parse_factor()

        while ($(self).error == CalcError::none) {
            TokenKind op = $(self).current.kind
            if (op != TokenKind::star && op != TokenKind::slash && op != TokenKind::percent) {
                break
            }

            $(self).advance()
            int64 rhs = $(self).parse_factor()
            if ($(self).error != CalcError::none) {
                return 0
            }

            if (op == TokenKind::star) {
                value = value * rhs
            } else {
                if (rhs == 0) {
                    $(self).fail(CalcError::divisionByZero)
                    return 0
                }
                if (op == TokenKind::slash) {
                    value = value / rhs
                } else {
                    value = value % rhs
                }
            }
        }

        return value
    }

    // expression := term (('+' | '-') term)*
    func parse_expression(mview<Parser> self) -> int64 {
        int64 value = $(self).parse_term()

        while ($(self).error == CalcError::none) {
            TokenKind op = $(self).current.kind
            if (op != TokenKind::plus && op != TokenKind::minus) {
                break
            }

            $(self).advance()
            int64 rhs = $(self).parse_term()
            if ($(self).error != CalcError::none) {
                return 0
            }

            if (op == TokenKind::plus) {
                value = value + rhs
            } else {
                value = value - rhs
            }
        }

        return value
    }
}

func evaluate(const view<[byte]> line, const uint32 line_len) -> (int64 value, CalcError error) {
    Parser parser
    parser.reset(line, line_len)

    int64 result = parser.parse_expression()
    CalcError err = parser.error
    if (err == CalcError::none && parser.current.kind != TokenKind::endOfInput) {
        err = CalcError::trailingInput
    }

    return (int64 value, CalcError error) { value = result, error = err }
}

func error_text(const CalcError err) -> view<[byte]> {
    if (err == CalcError::unexpectedToken) {
        return "unexpected token"
    }
    if (err == CalcError::unexpectedEnd) {
        return "unexpected end of expression"
    }
    if (err == CalcError::expectedRightParen) {
        return "expected ')'"
    }
    if (err == CalcError::divisionByZero) {
        return "division by zero"
    }
    if (err == CalcError::trailingInput) {
        return "trailing input"
    }
    return "unknown error"
}

func main() -> int32 {
    [byte, 256] line
    uint32 len = 0

    if (text::read_line_len(getmview(line), 256, getmview(len)) != 0) {
        return 1
    }

    uint32 start = 0
    text::skip_spaces(getview(line), getmview(start))

    uint32 end = len
    while (end > start) {
        byte b = line[end - 1]
        if (b != 32 && b != 9) {
            break
        }
        end--
    }

    if (end <= start) {
        return 1
    }

    uint32 expression_count = 0
    if (text::parse_uint32(getview(line), start, end - start, getmview(expression_count)) == 0) {
        return 1
    }

    for (uint32 i = 0; i < expression_count; i++) {
        len = 0
        if (text::read_line_len(getmview(line), 256, getmview(len)) != 0) {
            return 1
        }

        // Echo the expression exactly, then evaluate and report.
        text::print_slice(getview(line), 0, len)
        stdout(" = ", end = null)

        (int64 value, CalcError error) result = evaluate(getview(line), len)

        if (result.error == CalcError::none) {
            stdout(result.value)
        } else {
            stdout("error: ", end = null)
            stdout(error_text(result.error))
        }
    }

    return 0
}

// String literals as byte-array initializer sugar.
//
// Each test stores a literal into a TextBuf field and prints exactly
// the decoded bytes after a marker, so the byte counts are pinned by
// the output rather than by comments.

struct TextBuf {
    array<byte> buf

    func init(addr<TextBuf> self, uint capacity) -> int {
        return $(self).buf.init(capacity)
    }

    func uninit(addr<TextBuf> self) -> void {
        $(self).buf.uninit()
        return
    }

    func testAscii(addr<TextBuf> self) -> void {
        // "Hello,\tWorld!\n\"Franko\"" -> 22 bytes.
        $(self).buf.memset(0)
        $(self).buf = "Hello,\tWorld!\n\"Franko\""

        print(5001)
        for (uint i = 0; i < 22; i = i + 1) {
            print($(self).buf[i])
        }

        return
    }

    func testUnicode(addr<TextBuf> self) -> void {
        // "你好, Franko 😭😍" -> 23 UTF-8 bytes.
        $(self).buf.memset(0)
        $(self).buf = "你好, Franko 😭😍"

        print(5002)
        for (uint i = 0; i < 23; i = i + 1) {
            print($(self).buf[i])
        }

        return
    }

    func testMultiline(addr<TextBuf> self) -> void {
        // A literal multiline string -> 20 bytes.
        $(self).buf.memset(0)
        $(self).buf = "Line 1
Line 2
Line 3"

        print(5003)
        for (uint i = 0; i < 20; i = i + 1) {
            print($(self).buf[i])
        }

        return
    }

    func testEscapes(addr<TextBuf> self) -> void {
        // "A\\B\"C\a\b\f\n\r\t\vZ" -> 13 bytes.
        $(self).buf.memset(0)
        $(self).buf = "A\\B\"C\a\b\f\n\r\t\vZ"

        print(5004)
        for (uint i = 0; i < 13; i = i + 1) {
            print($(self).buf[i])
        }

        return
    }
}

func main() -> int {
    TextBuf t
    t.init(200)

    t.testAscii()
    t.testUnicode()
    t.testMultiline()
    t.testEscapes()

    t.uninit()
    return 0
}

// ============================================================
// Franko Red-Black Tree Showcase
// ============================================================
//
// A classic CLRS-style red-black tree (insertion with fixup
// rotations), implemented with structs and real null pointers.
//
// Empty links are null: every absent child and the empty root are
// null, and address equality against null tests for "no child".
// There is no sentinel node and no nil variable.
//
// Nodes still come from a fixed pool of structs: del is symbol-based
// (it frees a heap variable, not an address), so a dynamic tree cannot
// free nodes through pointers. The pool is a plain global static
// array, so it needs no del.
//
// Maybe-null deref warnings: insertFixup reports two expected warnings
// ('z' after the case-1 grandparent step and 'aunt' behind the
// short-circuit null check). Everywhere else the null guards let the
// checker refine the state, so the rest of the program is
// warning-free.
//
// Demonstrates:
//
//   - struct declarations at global scope
//   - field defaults on primitive fields (key = 0, red = 0)
//   - addr<RbNode> fields (left / right / parent) breaking
//     the by-value cycle so a node can reference itself
//   - null as the empty link (no sentinel node)
//   - address comparison against null with == and !=
//   - guard refinement: deref is valid inside if (p != null)
//   - deref of a provably null variable is an error
//   - a static array of structs used as the node pool
//   - struct globals and global addr variables
//   - global primitives with constant initializers
//   - member access chains: deref(x).field
//   - nested member access: deref(deref(x).parent).left
//   - struct by-value parameters and by-value returns
//   - whole-struct assignment (RbNode view = nodeCopy(root))
//   - getaddr() on struct fields (addr<byte> redP = ...)
//   - recursion (walk, count, blackHeight, noRedRed)
//   - iterative search with while loops
//   - insert-fixup rotations (rotateLeft / rotateRight)
//   - structural invariant checks as the test harness
//
// ============================================================

struct RbNode {
    int32_t key = 0
    byte red = 0
    addr<RbNode> left
    addr<RbNode> right
    addr<RbNode> parent
}

array<RbNode, 64> pool;
addr<RbNode> root;
uint nextFree = 0

// rotLeft: make the right child of x the new parent of x.
func rotateLeft(addr<RbNode> x) -> void {
    if (x == null) {
        return
    }

    addr<RbNode> y = deref(x).right

    if (y != null) {
        deref(x).right = deref(y).left
        if (deref(y).left != null) {
            deref(deref(y).left).parent = x
        }
        deref(y).parent = deref(x).parent
        if (deref(x).parent == null) {
            root = y
        } else {
            if (x == deref(deref(x).parent).left) {
                deref(deref(x).parent).left = y
            } else {
                deref(deref(x).parent).right = y
            }
        }
        deref(y).left = x
        deref(x).parent = y
    }
}

// rotRight: make the left child of x the new parent of x.
func rotateRight(addr<RbNode> x) -> void {
    if (x == null) {
        return
    }

    addr<RbNode> y = deref(x).left

    if (y != null) {
        deref(x).left = deref(y).right
        if (deref(y).right != null) {
            deref(deref(y).right).parent = x
        }
        deref(y).parent = deref(x).parent
        if (deref(x).parent == null) {
            root = y
        } else {
            if (x == deref(deref(x).parent).right) {
                deref(deref(x).parent).right = y
            } else {
                deref(deref(x).parent).left = y
            }
        }
        deref(y).right = x
        deref(x).parent = y
    }
}

// Restore the red-black invariants after inserting node z.
//
// The aunt is read once per iteration so case 1 is shared between the
// left and right mirrors. An absent aunt counts as black, which is
// what the short-circuit null check expresses.
func insertFixup(addr<RbNode> z) -> void {
    if (z == null) {
        return
    }

    while ((deref(z).parent != null) && (deref(deref(z).parent).red != 0)) {
        addr<RbNode> aunt

        if (deref(z).parent == deref(deref(deref(z).parent).parent).left) {
            aunt = deref(deref(deref(z).parent).parent).right
        } else {
            aunt = deref(deref(deref(z).parent).parent).left
        }

        if ((aunt != null) && (deref(aunt).red != 0)) {
            // Case 1: red aunt - recolor and move z up.
            deref(deref(z).parent).red = 0
            deref(aunt).red = 0
            deref(deref(deref(z).parent).parent).red = 1
            z = deref(deref(z).parent).parent
        } else {
            if (deref(z).parent == deref(deref(deref(z).parent).parent).left) {
                if (z == deref(deref(z).parent).right) {
                    z = deref(z).parent
                    rotateLeft(z)
                }
                deref(deref(z).parent).red = 0
                deref(deref(deref(z).parent).parent).red = 1
                rotateRight(deref(deref(z).parent).parent)
            } else {
                if (z == deref(deref(z).parent).left) {
                    z = deref(z).parent
                    rotateRight(z)
                }
                deref(deref(z).parent).red = 0
                deref(deref(deref(z).parent).parent).red = 1
                rotateLeft(deref(deref(z).parent).parent)
            }
        }
    }

    if (root != null) {
        deref(root).red = 0
    }
}

// Standard BST insertion plus red-black fixup.
//
// The fresh node is taken with getaddr(...) right here so z is
// certified non-null for the rest of the function.
func insert(int32_t key) -> void {
    addr<RbNode> z = getaddr(pool[nextFree])
    nextFree = nextFree + 1

    deref(z).key = key
    deref(z).red = 1
    deref(z).left = null
    deref(z).right = null
    deref(z).parent = null

    addr<RbNode> y = null
    addr<RbNode> x = root

    while (x != null) {
        y = x
        if (deref(z).key < deref(x).key) {
            x = deref(x).left
        } else {
            x = deref(x).right
        }
    }

    deref(z).parent = y
    if (y == null) {
        root = z
    } else {
        if (deref(z).key < deref(y).key) {
            deref(y).left = z
        } else {
            deref(y).right = z
        }
    }

    insertFixup(z)
}

// Iterative search; returns 1 when key is present.
func find(addr<RbNode> n, int32_t key) -> byte {
    while (n != null) {
        if (key == deref(n).key) {
            return 1
        }
        if (key < deref(n).key) {
            n = deref(n).left
        } else {
            n = deref(n).right
        }
    }
    return 0
}

// Smallest key in the tree (follow the left spine).
func minKey(addr<RbNode> n) -> int32_t {
    while (n != null) {
        if (deref(n).left == null) {
            return deref(n).key
        }
        n = deref(n).left
    }
    return 0
}

// Number of nodes in the subtree.
func count(addr<RbNode> n) -> uint {
    if (n == null) {
        return 0
    }
    return count(deref(n).left) + 1 + count(deref(n).right)
}

// In-order traversal; prints key and red bit for each node.
func walk(addr<RbNode> n) -> void {
    if (n == null) {
        return
    }
    walk(deref(n).left)
    print(deref(n).key, deref(n).red)
    walk(deref(n).right)
}

// Number of black nodes on every root-to-null path,
// or -1 when two paths of one node disagree (invariant broken).
func blackHeight(addr<RbNode> n) -> int32_t {
    if (n == null) {
        return 1
    }
    int32_t lh = blackHeight(deref(n).left)
    int32_t rh = blackHeight(deref(n).right)
    if ((lh != rh) || (lh < 0)) {
        return -1
    }
    if (deref(n).red == 0) {
        return lh + 1
    }
    return lh
}

// 1 when no red node has a red child, 0 otherwise.
func noRedRed(addr<RbNode> n) -> byte {
    if (n == null) {
        return 1
    }
    if (deref(n).red != 0) {
        addr<RbNode> l = deref(n).left
        addr<RbNode> r = deref(n).right

        byte childRed = 0

        if (l != null) {
            if (deref(l).red != 0) {
                childRed = 1
            }
        }
        if (r != null) {
            if (deref(r).red != 0) {
                childRed = 1
            }
        }

        if (childRed != 0) {
            return 0
        }
    }
    if (noRedRed(deref(n).left) == 0) {
        return 0
    }
    return noRedRed(deref(n).right)
}

// By-value return: copies a whole struct out of the tree.
// Null-safe: a null node copies as a default RbNode.
func nodeCopy(addr<RbNode> p) -> RbNode {
    RbNode fallback
    if (p != null) {
        return deref(p)
    }
    return fallback
}

// By-value parameter: receives a whole-struct copy.
func printNode(RbNode n) -> void {
    print(n.key, n.red)
}

func main() -> int32_t {
    root = null

    print(4301)

    insert(50)
    insert(25)
    insert(75)
    insert(12)
    insert(37)
    insert(62)
    insert(87)
    insert(6)
    insert(18)
    insert(31)
    insert(43)
    insert(68)
    insert(81)
    insert(93)
    insert(8)
    insert(28)

    print(4302)

    print(find(root, 6))
    print(find(root, 28))
    print(find(root, 93))
    print(find(root, 42))
    print(find(root, 15))

    print(4303)

    walk(root)

    print(4304)

    print(count(root))
    print(minKey(root))
    print(blackHeight(root))
    print(noRedRed(root))

    print(4305)

    RbNode view = nodeCopy(root)
    print(view.key, view.red)

    printNode(pool[1])

    if (root != null) {
        addr<byte> redP = getaddr(deref(root).red)
        print(deref(redP))
    }

    return 0
}

// Red-black tree (CLRS insertion).
//
// Nodes live in one array and every link is a slot index into it:
// left / right / parent are uint, and 0xFFFFFFFF is NIL, the "no
// node" index. Free slots come from std::NextAllocator
// (import "franko/pool"); insert() takes one with new_index() and
// drops the key when the allocation returns err != 0.

import "franko/pool"
import "franko/io"

struct RbNode {
    int key = 0
    byte red = 0
    uint left = 0xFFFFFFFF
    uint right = 0xFFFFFFFF
    uint parent = 0xFFFFFFFF
}

[RbNode, 64] nodes
std::NextAllocator slots
uint NIL = 0xFFFFFFFF
uint root = 0xFFFFFFFF

func rotate_left(uint x) -> void {
    if (x == NIL) {
        return
    }
    uint y = nodes[x].right
    if (y == NIL) {
        return
    }
    nodes[x].right = nodes[y].left
    if (nodes[y].left != NIL) {
        nodes[nodes[y].left].parent = x
    }
    nodes[y].parent = nodes[x].parent
    if (nodes[x].parent == NIL) {
        root = y
    } else {
        if (x == nodes[nodes[x].parent].left) {
            nodes[nodes[x].parent].left = y
        } else {
            nodes[nodes[x].parent].right = y
        }
    }
    nodes[y].left = x
    nodes[x].parent = y
    return
}

func rotate_right(uint x) -> void {
    if (x == NIL) {
        return
    }
    uint y = nodes[x].left
    if (y == NIL) {
        return
    }
    nodes[x].left = nodes[y].right
    if (nodes[y].right != NIL) {
        nodes[nodes[y].right].parent = x
    }
    nodes[y].parent = nodes[x].parent
    if (nodes[x].parent == NIL) {
        root = y
    } else {
        if (x == nodes[nodes[x].parent].right) {
            nodes[nodes[x].parent].right = y
        } else {
            nodes[nodes[x].parent].left = y
        }
    }
    nodes[y].right = x
    nodes[x].parent = y
    return
}

func insert_fixup(uint z) -> void {
    while ((nodes[z].parent != NIL) && (nodes[nodes[z].parent].red != 0)) {
        uint aunt = NIL

        if (nodes[z].parent == nodes[nodes[nodes[z].parent].parent].left) {
            aunt = nodes[nodes[nodes[z].parent].parent].right
        } else {
            aunt = nodes[nodes[nodes[z].parent].parent].left
        }

        if ((aunt != NIL) && (nodes[aunt].red != 0)) {
            // Case 1: red aunt - recolor and move up.
            nodes[nodes[z].parent].red = 0
            nodes[aunt].red = 0
            nodes[nodes[nodes[z].parent].parent].red = 1
            z = nodes[nodes[z].parent].parent
        } else {
            // Cases 2 and 3: rotate the parent or the grandparent.
            if (nodes[z].parent == nodes[nodes[nodes[z].parent].parent].left) {
                if (z == nodes[nodes[z].parent].right) {
                    z = nodes[z].parent
                    rotate_left(z)
                }
                nodes[nodes[z].parent].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                rotate_right(nodes[nodes[z].parent].parent)
            } else {
                if (z == nodes[nodes[z].parent].left) {
                    z = nodes[z].parent
                    rotate_right(z)
                }
                nodes[nodes[z].parent].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                rotate_left(nodes[nodes[z].parent].parent)
            }
        }
    }

    if (root != NIL) {
        nodes[root].red = 0
    }
    return
}

func insert(int key) -> void {
    (uint32 idx, int32 err) allocated = slots.new_index()
    if (allocated.err != 0) {
        return
    }
    uint z = allocated.idx

    nodes[z].key = key
    nodes[z].red = 1
    nodes[z].left = NIL
    nodes[z].right = NIL
    nodes[z].parent = NIL

    uint y = NIL
    uint x = root
    while (x != NIL) {
        y = x
        if (nodes[z].key < nodes[x].key) {
            x = nodes[x].left
        } else {
            x = nodes[x].right
        }
    }

    nodes[z].parent = y
    if (y == NIL) {
        root = z
    } else {
        if (nodes[z].key < nodes[y].key) {
            nodes[y].left = z
        } else {
            nodes[y].right = z
        }
    }

    insert_fixup(z)
    return
}

func find(uint n, int key) -> byte {
    while (n != NIL) {
        if (key == nodes[n].key) {
            return 1
        }
        if (key < nodes[n].key) {
            n = nodes[n].left
        } else {
            n = nodes[n].right
        }
    }
    return 0
}

func min_key(uint n) -> (int val, int32 err) {
    (int val, int32 err) result
    result.val = 0
    result.err = -1
    while (n != NIL) {
        if (nodes[n].left == NIL) {
            result.val = nodes[n].key
            result.err = 0
            return result
        }
        n = nodes[n].left
    }
    return result
}

func count(uint n) -> uint {
    if (n == NIL) {
        return 0
    }
    return count(nodes[n].left) + 1 + count(nodes[n].right)
}

func walk(uint n) -> void {
    if (n == NIL) {
        return
    }
    walk(nodes[n].left)
    print(nodes[n].key, " "); print(nodes[n].red)
    walk(nodes[n].right)
    return
}

// Black nodes on every root-to-NIL path; err is -1 when the tree is broken.
func black_height(uint n) -> (int val, int32 err) {
    (int val, int32 err) result
    result.val = 0
    result.err = -1
    if (n == NIL) {
        result.val = 1
        result.err = 0
        return result
    }
    (int val, int32 err) left = black_height(nodes[n].left)
    (int val, int32 err) right = black_height(nodes[n].right)
    if (left.err != 0 || right.err != 0 || left.val != right.val) {
        return result
    }
    result.err = 0
    if (nodes[n].red == 0) {
        result.val = left.val + 1
    } else {
        result.val = left.val
    }
    return result
}

func no_red_red(uint n) -> byte {
    if (n == NIL) {
        return 1
    }
    if (nodes[n].red != 0) {
        byte child_red = 0
        if (nodes[n].left != NIL) {
            if (nodes[nodes[n].left].red != 0) {
                child_red = 1
            }
        }
        if (nodes[n].right != NIL) {
            if (nodes[nodes[n].right].red != 0) {
                child_red = 1
            }
        }
        if (child_red != 0) {
            return 0
        }
    }
    if (no_red_red(nodes[n].left) == 0) {
        return 0
    }
    return no_red_red(nodes[n].right)
}

func main() -> int {
    slots.init(64)

    print(4301)

    insert(50)
    insert(25)
    insert(75)
    insert(12)
    insert(37)
    insert(62)
    insert(87)
    insert(6)
    insert(18)
    insert(31)
    insert(43)
    insert(68)
    insert(81)
    insert(93)
    insert(8)
    insert(28)

    print(4302)

    print(find(root, 6))
    print(find(root, 28))
    print(find(root, 93))
    print(find(root, 42))
    print(find(root, 15))

    print(4303)

    walk(root)

    print(4304)

    print(count(root))
    (int val, int32 err) minimum = min_key(root)
    if (minimum.err == 0) {
        print(minimum.val)
    } else {
        print(0)
    }
    (int val, int32 err) height = black_height(root)
    if (height.err == 0) {
        print(height.val)
    } else {
        print(-1)
    }
    print(no_red_red(root))

    print(4305)

    print(nodes[root].key, " "); print(nodes[root].red)
    print(nodes[1].key, " "); print(nodes[1].red)
    print(nodes[root].red)

    slots.uninit()
    return 0
}

// Shared byte-text helpers for the example programs.
//
// These helpers deliberately use [byte] arrays and views instead of
// franko/string: the string library is still small, and the array
// intrinsics are the intended text tool for most Franko code.
//
// Import from a top-level program with:
//
//   import "./lib/text"
//
// This file is not a smoke-test program; programs/run_programs.py only
// compiles the top-level programs/*.fr files.

import "franko/io"

namespace text {

    // Read one line into a caller-owned byte buffer. LINE_LEN receives
    // the number of stored bytes, not counting the line ending.
    //
    // Returns 0 on success and -1 on error. A zero-length result is
    // either an empty line or end of input; callers that need to tell
    // them apart use a count-prefixed input format.
    func read_line_len(mview<[byte]> buf, uint32 cap, mview<uint32> line_len) -> int32 {
        if (buf == null) {
            return -1
        }
        if (line_len == null) {
            return -1
        }

        (int64 val, int32 err) result = read_line(buf, cap)
        if (result.err != 0) {
            return -1
        }

        $(line_len) = unsafe_cast<uint32>(result.val)
        return 0
    }

    // Print exactly count bytes starting at start, with no separator or
    // trailing newline.
    func print_slice(view<[byte]> buf, uint32 start, uint32 count) -> void {
        if (buf == null) {
            return
        }

        [byte, 1] one
        for (uint32 i = 0; i < count; i++) {
            one[0] = $(buf)[start + i]
            print(getview(one), null)
        }
        return
    }

    // Print exactly count bytes followed by one newline.
    func print_line(view<[byte]> buf, uint32 count) -> void {
        print_slice(buf, 0, count)
        print()
        return
    }

    // Advance *pos past spaces and tabs.
    func skip_spaces(view<[byte]> buf, mview<uint32> pos) -> void {
        if (buf == null) {
            return
        }
        if (pos == null) {
            return
        }

        uint32 i = $(pos)
        uint32 n = $(buf).length()

        while (i < n) {
            byte b = $(buf)[i]
            if (b != 32 && b != 9) {
                break
            }
            i++
        }

        $(pos) = i
        return
    }

    // Return 1 when buf[start, start+count) equals word.
    func match_word(view<[byte]> buf, uint32 start, uint32 count, view<[byte]> word) -> byte {
        if (buf == null) {
            return 0
        }
        if (word == null) {
            return 0
        }
        if (count != $(word).length()) {
            return 0
        }
        if (count == 0) {
            return 1
        }
        if (start + count > $(buf).length()) {
            return 0
        }
        if ($(buf).memcmp(word, start, 0, count) == 0) {
            return 1
        }
        return 0
    }

    // Parse an optional-minus signed decimal in buf[start, start+count).
    // Returns 1 on success and 0 on malformed input.
    func parse_int64(view<[byte]> buf, uint32 start, uint32 count, mview<int64> out) -> byte {
        if (buf == null) {
            return 0
        }
        if (out == null) {
            return 0
        }
        if (count == 0) {
            return 0
        }

        uint32 i = start
        uint32 end = start + count
        byte negative = 0

        if ($(buf)[i] == 45) {
            negative = 1
            i++
            if (i == end) {
                return 0
            }
        }

        int64 value = 0
        while (i < end) {
            byte b = $(buf)[i]
            if (b < 48 || b > 57) {
                return 0
            }
            value = value * 10 + cast<int64>(b - 48)
            i++
        }

        if (negative != 0) {
            value = -value
        }

        $(out) = value
        return 1
    }

    // Parse an unsigned decimal in buf[start, start+count).
    // Returns 1 on success and 0 on malformed input.
    func parse_uint32(view<[byte]> buf, uint32 start, uint32 count, mview<uint32> out) -> byte {
        if (buf == null) {
            return 0
        }
        if (out == null) {
            return 0
        }
        if (count == 0) {
            return 0
        }

        uint32 i = start
        uint32 end = start + count
        uint32 value = 0

        while (i < end) {
            byte b = $(buf)[i]
            if (b < 48 || b > 57) {
                return 0
            }
            value = value * 10 + cast<uint32>(b - 48)
            i++
        }

        $(out) = value
        return 1
    }

    func is_alpha(byte b) -> byte {
        if (b >= 65 && b <= 90) {
            return 1
        }
        if (b >= 97 && b <= 122) {
            return 1
        }
        return 0
    }

    func to_lower(byte b) -> byte {
        if (b >= 65 && b <= 90) {
            return b + 32
        }
        return b
    }

    func hex_digit(byte value) -> byte {
        if (value < 10) {
            return value + 48
        }
        return value + 55
    }

    // Print two uppercase hexadecimal digits.
    func print_hex_byte(byte value) -> void {
        [byte, 2] out
        out[0] = hex_digit(value / 16)
        out[1] = hex_digit(value % 16)
        print(getview(out), null)
        return
    }

    // Print count bytes as space-separated uppercase hex pairs.
    func print_hex(view<[byte]> buf, uint32 start, uint32 count) -> void {
        if (buf == null) {
            return
        }

        for (uint32 i = 0; i < count; i++) {
            if (i != 0) {
                print(" ", null)
            }
            print_hex_byte($(buf)[start + i])
        }
        return
    }
}

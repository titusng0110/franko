import "franko/io"

// Command-line arguments: args[0] is the program name, each argument
// is its raw bytes with no NUL terminator.

func main(view<[[byte]]> args) -> int {
    uint n = $(args).length()
    print(n - 1)
    uint i = 1
    while (i < n) {
        print($(args)[i].length())
        uint j = 0
        while (j < $(args)[i].length()) {
            print($(args)[i][j])
            j++
        }
        i++
    }
    return 0
}

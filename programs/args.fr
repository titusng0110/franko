import "franko/io"

// Command-line arguments: args[0] is the program name, each argument
// is its raw bytes with no NUL terminator.

func main(view<[[byte]]> args) -> int {
    uint n = $(args).length()
    print(n - 1)
    for (uint i = 1; i < n; i++) {
        print($(args)[i].length())
        for (uint j = 0; j < $(args)[i].length(); j++) {
            print($(args)[i][j])
        }
    }
    return 0
}

// Demo: command-line arguments.
//
// The args-form entry point receives the raw command-line arguments
// as nested dynamic byte arrays: args[0] is the program name, and
// each argument is its raw bytes with no NUL terminator.

func main(addr<array<array<byte>>> args) -> int32_t {
    uint32_t n = $(args).length()
    print(n - 1)
    uint32_t i = 1
    while (i < n) {
        print($(args)[i].length())
        uint32_t j = 0
        while (j < $(args)[i].length()) {
            print($(args)[i][j])
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

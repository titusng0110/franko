// ============================================================
// Franko OS FFI Showcase: posix write
// ============================================================
//
// Demonstrates:
//
//   - import "franko/os"
//   - os::posix::STDOUT_FILENO constant
//   - os::posix::write(fd, addr<array<byte>>, count) -> int64_t
//   - passing a dynamic byte array through getaddr(...)
//   - the bridge in import/franko/os.ffi.cpp replacing the os.fr stubs
//
// The program writes a greeting with the raw write syscall and reports
// the byte count. Deliberately a single write: raw fd writes bypass
// the std::cout buffer that print uses, so interleaving several of
// them with print calls would order the bytes surprisingly (the same
// is true in C). Output is deterministic on every platform.
// ============================================================

import "franko/os"

func main() -> int32_t {
    array<byte> greeting;
    greeting.init(14);
    greeting = "hello, franko!";

    int64_t written = os::posix::write(os::posix::STDOUT_FILENO, getaddr(greeting), 14);
    print(written);
    greeting.uninit();

    return 0;
}

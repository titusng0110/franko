// Greeting demo: prompt on stdout, read one name line from stdin, and
// print "Hello, <name>!" on the prompt line. The name and greeting are
// assembled with std::String::from and operator +=.
//
// Run with:
//
//   ./programs/greetings.out < programs/greetings.stdin

import "franko/io"
import "franko/string"

func main() -> int32 {
    // Prompt without a newline; the greeting below completes the line.
    print("What's your name? ", null)

    std::String name
    if (read_line(getptr(name)) != 0) {
        name.uninit()
        return 1
    }

    std::String greeting
    greeting.from("Hello, ")
    greeting += name
    greeting += "!"
    print(getview(greeting))

    greeting.uninit()
    name.uninit()
    return 0
}

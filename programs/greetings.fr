// Greeting demo: prompt on stdout, read one name line from stdin, and
// print "Hello, <name>!" on the prompt line. This is the only example
// program that uses franko/string: the name and greeting are assembled
// with std::String::from and operator +=.
//
// Run with:
//
//   ./programs/greetings.out < programs/greetings.stdin

import "franko/io"
import "franko/string"

func main() -> int32 {
    // Prompt without a newline; the greeting below completes the line.
    print("What's your name? ", null)

    [byte] input
    input.init(64)

    (int64 val, int32 err) line = read_line(getmview(input), 64)
    if (line.err != 0) {
        input.uninit()
        return 1
    }

    // Trim the buffer to the bytes the line actually stored, then build
    // the greeting from the name string.
    uint32 name_len = unsafe_cast<uint32>(line.val)
    if (name_len != 0) {
        if (input.resize(name_len) != 0) {
            input.uninit()
            return 1
        }
    }

    std::String name
    if (name_len != 0) {
        name.from(getview(input))
    }

    std::String greeting
    greeting.from("Hello, ")
    greeting += name
    greeting += "!"
    print(getview(greeting))

    greeting.uninit()
    name.uninit()
    input.uninit()
    return 0
}

// Console greeting: asks for a name on stdout, reads it from stdin,
// and writes back "Hello, [NAME]~".
//
// Everything goes through `franko/io` and `franko/string`: the name is
// read into a byte buffer, copied into a `std::String`, and the greeting
// is assembled with `from`/`+=`. The final `print(str, end)` writes the
// greeting with no suffix. Run with:
//
//   ./programs/greetings.out < programs/greetings.stdin

import "franko/io"
import "franko/string"

func main() -> int {
    // Prompt without a trailing newline.
    print("What's your name? ", null)

    // Read the name without its line ending, at most 32 bytes.
    [byte] input;
    input.init(32);
    int64 got = read_line(getmview(input), 32);

    std::String name;
    if (got > 0) {
        uint len = unsafe_cast<uint>(got);
        input.resize(len);
        name.from(getview(input));
    }

    // "Hello, " + name + "~".
    std::String greeting;
    greeting.from("Hello, ");
    if (name.length() != 0) {
        greeting += name;
    }
    greeting += "~";

    view<[byte]> no_end = null;
    print(getview(greeting), no_end);

    greeting.uninit();
    name.uninit();
    input.uninit();

    return 0;
}

// OS FFI showcase: asks for a name on stdout, reads it from stdin,
// and writes back "Hello, [NAME]~".
//
// import "franko/os" plus the os::IS_* compile-time constants select
// the API per target, so this program compiles for every target: on
// Windows only the win32 calls are emitted (and bridged), on
// linux/macos only the posix ones. Deliberately print-free: raw fd
// writes bypass the std::cout buffer, so every byte goes through the
// selected OS API.
//
// Input line endings depend on how stdin is wired, so the scan
// tolerates both "\r\n" (interactive Windows console) and "\n"
// (pipes). Run with:
//
//   ./programs/greetings.out < programs/greetings.stdin

import "franko/os"

func main() -> int {
    // Static template buffers carry the inferred string size; the
    // write API needs dynamic arrays, so size them from the template
    // with length() and memcpy the template over.
    array<byte, ?> promptT = "What's your name? ";
    array<byte> prompt;
    prompt.init(promptT.length());
    prompt.memcpy(getptr(promptT));

    array<byte> name;
    name.init(32);
    name.memset(0);

    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getptr(prompt), cast<uint32_t>(promptT.length()), null);
        uint64_t hIn = os::win32::GetStdHandle(os::win32::STD_INPUT_HANDLE);
        os::win32::ReadFile(hIn, getptr(name), 32, null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(prompt), cast<uint64_t>(promptT.length()));
        os::posix::read(os::posix::STDIN_FILENO, getptr(name), 32);
    }

    prompt.uninit();

    // Name length: bytes up to the first line ending (10 or 13) or
    // NUL padding (0).
    uint len = 0;
    uint i = 0;
    while (i < 32) {
        byte b = name[i];
        if ((b == 10) || (b == 13) || (b == 0)) {
            break;
        }
        len++;
        i++;
    }

    // "Hello, " template plus up to 32 name bytes plus "~" (126).
    array<byte, ?> helloT = "Hello, ";
    array<byte> out;
    out.init(helloT.length() + 32 + 1);
    out.memset(0);
    out.memcpy(getptr(helloT));
    uint greetingLen = helloT.length();
    uint j = 0;
    while (j < len) {
        out[greetingLen + j] = name[j];
        j++;
    }
    out[greetingLen + len] = 126;

    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getptr(out), cast<uint32_t>(greetingLen + len + 1), null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(out), cast<uint64_t>(greetingLen + len + 1));
    }

    out.uninit();
    name.uninit();

    return 0;
}

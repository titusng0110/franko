// Console greeting: asks for a name on stdout, reads it from stdin,
// and writes back "Hello, [NAME]~".
//
// Everything goes through `franko/io`: `print(text, end)` writes text
// with `end` as the suffix (a null `end` means no suffix, so no
// newline), and `read_line` fills a caller-owned buffer with the name
// and reports its length. Input line endings depend on how stdin is
// wired, so read_line tolerates both "\r\n" (interactive Windows
// console) and "\n" (pipes). Run with:
//
//   ./programs/greetings.out < programs/greetings.stdin

import "franko/io"

func main() -> int {
    // Prompt without a trailing newline.
    print("What's your name? ", null)

    // The name without its line ending, at most 32 bytes.
    [byte] name;
    name.init(32);
    int64 got = read_line(getmview(name), 32);
    uint len = 0;
    if (got > 0) {
        len = unsafe_cast<uint>(got);
    }

    // "Hello, " + name + "~" in one exact-sized buffer. A string
    // literal is a valid memcpy source, and $(...) over it gives its
    // length; the result is printed verbatim (a null `end` means no
    // suffix and no newline).
    uint greetingLen = $("Hello, ").length();
    uint total = greetingLen + len + 1;
    [byte] out;
    out.init(total);
    out.memcpy("Hello, ");
    for (uint j = 0; j < len; j++) {
        out[greetingLen + j] = name[j];
    }
    out[total - 1] = 126;
    print(getview(out), null);

    out.uninit();
    name.uninit();

    return 0;
}

// ============================================================
// Franko OS FFI Showcase: portable greetings
// ============================================================
//
// Demonstrates:
//
//   - import "franko/os"
//   - os::IS_WINDOWS / os::IS_LINUX / os::IS_MACOS target constants
//     selecting the I/O API at compile time
//   - os::win32::GetStdHandle/ReadFile/WriteFile on Windows
//   - os::posix::read/write on linux and macos
//   - passing dynamic byte arrays through getaddr(...)
//   - array<byte, ?> static buffers with inferred size from string
//     literals, copied into dynamic arrays with memcpy; dynamic
//     sizes are derived from the templates with length(), never
//     hardcoded
//   - scanning input without break/continue (flag-guarded loop)
//
// The program asks "What's your name?", reads up to 32 bytes from
// stdin, and writes back "Hello, [NAME]~" with the trailing newline
// stripped. The smoke test feeds programs/greetings.stdin; run it by
// hand with:
//
//   ./programs/greetings.out < programs/greetings.stdin
//
// The target constants are compile-time 0/1, so every condition below
// folds and the untaken branch is pruned before emission: the wrong
// target's ffi.cpp block is never spliced (those blocks are #error on
// the wrong target), which is what lets this one source compile for
// windows, linux, and macos alike. Both branches are still fully
// type-checked and memory-safety-checked.
//
// Deliberately print-free: raw handle/fd writes bypass the std::cout
// buffer, so every byte here goes through the selected OS API.
// ============================================================

import "franko/os"

func main() -> int32_t {
    // Static prompt template: size is inferred from the string.
    // The write APIs need a dynamic array, so size it from the
    // template with length() and memcpy the template over.
    array<byte, ?> promptT = "What's your name? ";
    array<byte> prompt;
    prompt.init(promptT.length());
    prompt.memcpy(getaddr(promptT));

    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getaddr(prompt), promptT.length(), null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getaddr(prompt), cast<uint64_t>(promptT.length()));
    }
    prompt.uninit();

    array<byte> name;
    name.init(32);
    name.memset(0);

    if (os::IS_WINDOWS) {
        uint64_t hIn = os::win32::GetStdHandle(os::win32::STD_INPUT_HANDLE);
        os::win32::ReadFile(hIn, getaddr(name), 32, null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::read(os::posix::STDIN_FILENO, getaddr(name), 32);
    }

    // Name length: bytes up to the first newline (byte 10) or NUL
    // padding (byte 0). Franko has no break/continue, so the whole
    // buffer is scanned behind a done flag.
    uint32_t len = 0;
    uint32_t i = 0;
    uint8_t done = 0;
    while (i < 32) {
        uint8_t b = name[i];
        if (done == 0) {
            if (b == 10) {
                done = 1;
            } else {
                if (b == 0) {
                    done = 1;
                } else {
                    len = len + 1;
                }
            }
        }
        i = i + 1;
    }

    // "Hello, " template plus up to 32 name bytes plus "~" (byte
    // 126): every size derives from the template and the name cap.
    array<byte, ?> helloT = "Hello, ";
    array<byte> greeting;
    greeting.init(helloT.length() + 32 + 1);
    greeting.memset(0);
    greeting.memcpy(getaddr(helloT));
    uint32_t greetingLen = helloT.length();
    uint32_t j = 0;
    while (j < len) {
        greeting[greetingLen + j] = name[j];
        j = j + 1;
    }
    greeting[greetingLen + len] = 126;

    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getaddr(greeting), greetingLen + len + 1, null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getaddr(greeting), cast<uint64_t>(greetingLen + len + 1));
    }

    greeting.uninit();
    name.uninit();

    return 0;
}

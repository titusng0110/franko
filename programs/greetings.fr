// ============================================================
// Franko OS FFI Showcase: greetings over posix/win32 I/O
// ============================================================
//
// Demonstrates:
//
//   - import "franko/os"
//   - target selection with the os::IS_* compile-time constants:
//
//       if (os::IS_WINDOWS) {
//           ... win32 ...
//       } else if (os::IS_LINUX || os::IS_MACOS) {
//           ... posix ...
//       }
//
//   - os::posix::write / os::posix::read on linux and macos
//   - os::win32::GetStdHandle / ReadFile / WriteFile on windows
//   - passing dynamic byte arrays through getaddr(...)
//   - array<byte, ?> static buffers with inferred size from string
//     literals, copied into dynamic arrays with memcpy; dynamic
//     sizes are derived from the templates with length(), never
//     hardcoded
//   - scanning input without break/continue (flag-guarded loop)
//   - tolerating BOTH "\n" and "\r\n" line endings at the program
//     level, never in the compiler
//
// The program asks "What's your name?", reads up to 32 bytes from
// stdin, and writes back "Hello, [NAME]~" with the trailing line
// ending stripped. The smoke test feeds programs/greetings.stdin;
// run it by hand with:
//
//   ./programs/greetings.out < programs/greetings.stdin
//
// Input line endings depend on how stdin is wired, so the scan
// accepts either terminator:
//
//   - an interactive Windows console delivers "\r\n";
//   - a pipe may deliver just "\n" (or "\r\n", e.g. from
//     `echo Titus | greetings.exe` in PowerShell).
//
// Deliberately print-free: raw fd writes bypass the std::cout
// buffer, so every byte here goes through the selected OS API.
// ============================================================

import "franko/os"

func main() -> int32_t {
    // Static prompt template: size is inferred from the string.
    // The write needs a dynamic array, so size it from the
    // template with length() and memcpy the template over.
    array<byte, ?> promptT = "What's your name? ";
    array<byte> prompt;
    prompt.init(promptT.length());
    prompt.memcpy(getaddr(promptT));

    array<byte> name;
    name.init(32);
    name.memset(0);

    // Write the prompt and read the name, selecting the API by
    // target. The conditions fold at Franko-compile time: on
    // Windows only the win32 calls are emitted (and bridged), on
    // linux/macos only the posix ones, so this program compiles
    // for every target.
    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getaddr(prompt), cast<uint32_t>(promptT.length()), null);
        uint64_t hIn = os::win32::GetStdHandle(os::win32::STD_INPUT_HANDLE);
        os::win32::ReadFile(hIn, getaddr(name), 32, null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getaddr(prompt), cast<uint64_t>(promptT.length()));
        os::posix::read(os::posix::STDIN_FILENO, getaddr(name), 32);
    }

    prompt.uninit();

    // Name length: bytes up to the first line ending — newline
    // (byte 10) or carriage return (byte 13) — or NUL padding
    // (byte 0). Both terminators are accepted because "\r\n" and
    // "\n" both arrive depending on how stdin is wired (see the
    // header). Stopping at 13 also covers a lone "\r". Franko has
    // no break/continue, so the whole buffer is scanned behind a
    // done flag.
    uint32_t len = 0;
    uint32_t i = 0;
    uint8_t done = 0;
    while (i < 32) {
        uint8_t b = name[i];
        if (done == 0) {
            if (b == 10) {
                done = 1;
            } else {
                if (b == 13) {
                    done = 1;
                } else {
                    if (b == 0) {
                        done = 1;
                    } else {
                        len = len + 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    // "Hello, " template plus up to 32 name bytes plus "~" (byte
    // 126): every size derives from the template and the name cap.
    array<byte, ?> helloT = "Hello, ";
    array<byte> out;
    out.init(helloT.length() + 32 + 1);
    out.memset(0);
    out.memcpy(getaddr(helloT));
    uint32_t greetingLen = helloT.length();
    uint32_t j = 0;
    while (j < len) {
        out[greetingLen + j] = name[j];
        j = j + 1;
    }
    out[greetingLen + len] = 126;

    // Write the greeting through the same target-selected API as
    // the prompt above.
    if (os::IS_WINDOWS) {
        uint64_t hOut = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(hOut, getaddr(out), cast<uint32_t>(greetingLen + len + 1), null);
    } else if (os::IS_LINUX || os::IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getaddr(out), cast<uint64_t>(greetingLen + len + 1));
    }

    out.uninit();
    name.uninit();

    return 0;
}

import "franko/io"

// Sieve of Eratosthenes: prints all primes <= n.
//
// Demonstrates structs with a dynamic-array field, methods with
// explicit self receivers (ptr for lifecycle, mview for mutation,
// view for reads), array intrinsics
// (init / memset / uninit), uint arithmetic, and strided for loops.

struct Sieve {
    [byte] is_prime
    uint n = 0

    func init(ptr<Sieve> self, uint limit) -> int {
        int init_status = 0

        init_status = $(self).is_prime.init(limit + 1)

        if (init_status != 0) {
            return -1
        }

        $(self).is_prime.memset(1)

        $(self).is_prime[0] = 0

        if (limit >= 1) {
            $(self).is_prime[1] = 0
        }

        $(self).n = limit
        return 0
    }

    func run(mview<Sieve> self) -> void {
        uint p = 0

        for (p = 2; p * p <= $(self).n; p++) {
            if ($(self).is_prime[p] == 0) {
                continue
            }

            for (uint j = p * p; j <= $(self).n; j += p) {
                $(self).is_prime[j] = 0
            }
        }

        return
    }

    func print_results(view<Sieve> self) -> void {
        print(1001)

        for (uint i = 2; i <= $(self).n; i++) {
            if ($(self).is_prime[i] == 0) {
                continue
            }

            print(i)
        }

        print(1002)
        return
    }

    func uninit(ptr<Sieve> self) -> void {
        $(self).is_prime.uninit()
        return
    }
}

func main() -> int {
    Sieve s

    if (s.init(80) != 0) {
        return -1
    }

    s.run()
    s.print_results()
    s.uninit()

    return 0
}

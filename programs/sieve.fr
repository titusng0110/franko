// Sieve of Eratosthenes: prints all primes <= n.
//
// Demonstrates structs with a dynamic-array field, methods with
// explicit self receivers (ptr for lifecycle, mview for mutation,
// view for reads), array intrinsics
// (init / memset / uninit), uint arithmetic, and strided for loops.

struct Sieve {
    array<byte> isPrime
    uint n = 0

    func init(ptr<Sieve> self, uint limit) -> int {
        int initStatus = 0

        initStatus = $(self).isPrime(limit + 1)

        if (initStatus != 0) {
            return -1
        }

        $(self).isPrime.memset(1)

        $(self).isPrime[0] = 0

        if (limit >= 1) {
            $(self).isPrime[1] = 0
        }

        $(self).n = limit
        return 0
    }

    func run(mview<Sieve> self) -> void {
        uint p = 0

        for (p = 2; p * p <= $(self).n; p++) {
            if ($(self).isPrime[p] == 0) {
                continue
            }

            for (uint j = p * p; j <= $(self).n; j += p) {
                $(self).isPrime[j] = 0
            }
        }

        return
    }

    func printResults(view<Sieve> self) -> void {
        print(1001)

        for (uint i = 2; i <= $(self).n; i++) {
            if ($(self).isPrime[i] == 0) {
                continue
            }

            print(i)
        }

        print(1002)
        return
    }

    func uninit(ptr<Sieve> self) -> void {
        $(self).isPrime.uninit()
        return
    }
}

func main() -> int {
    Sieve s

    if (s.init(80) != 0) {
        return -1
    }

    s.run()
    s.printResults()
    s.uninit()

    return 0
}

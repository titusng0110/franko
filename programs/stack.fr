// ============================================================
// Franko Stack Showcase (on top of import "franko/vector")
// ============================================================
//
// Demonstrates:
//
//   - importing a library module through the -p search directory:
//       import "franko/vector"  ->  import/franko/vector.fr
//   - a struct with a dynamic-array field (struct Vector)
//   - addr<Vector> parameters with getaddr at the call site
//   - init / push (with growth) / get / set / pop / uninit
//
// The vector starts with capacity 2, so pushing 5 values grows it
// 2 -> 4 -> 8. Expected output is in stack.expected.
// ============================================================

import "franko/vector"

func main() -> int32_t {
    Vector s
    int32_t st = vec_init(getaddr(s), 2)
    if (st != 0) {
        print(st)
        return 1
    }

    vec_push(getaddr(s), 10)
    vec_push(getaddr(s), 20)
    vec_push(getaddr(s), 30)
    vec_push(getaddr(s), 40)
    vec_push(getaddr(s), 50)

    print(vec_len(getaddr(s)))
    print(vec_cap(getaddr(s)))

    uint32_t n = vec_len(getaddr(s))
    for (uint32_t i = 0; i < n; i = i + 1) {
        print(vec_get(getaddr(s), i))
    }

    vec_set(getaddr(s), 0, 99)
    print(vec_get(getaddr(s), 0))

    int32_t top = 0
    st = vec_pop(getaddr(s), getaddr(top))
    print(st, top)
    st = vec_pop(getaddr(s), getaddr(top))
    print(st, top)

    print(vec_len(getaddr(s)))
    n = vec_len(getaddr(s))
    for (uint32_t i = 0; i < n; i = i + 1) {
        print(vec_get(getaddr(s), i))
    }

    vec_uninit(getaddr(s))

    return 0
}

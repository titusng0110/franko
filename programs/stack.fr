// Stack operations on import "franko/vector": init / push (with
// growth) / get / set / pop / uninit, plus a nested namespace
// (app::stats) called through a fully qualified path. The vector
// starts with capacity 2, so pushing 5 values grows it 2 -> 4 -> 8.

import "franko/vector"
import "franko/io"

// The nested-block form declares the same namespace as
// `namespace app::stats { ... }`.
namespace app {
    namespace stats {
        func remaining(view<std::Vector> s) -> uint {
            return $(s).length()
        }
    }
}

func main() -> int {
    std::Vector s
    int st = s.init(2)
    if (st != 0) {
        print(st)
        return 1
    }

    s.push(10)
    s.push(20)
    s.push(30)
    s.push(40)
    s.push(50)

    print(s.length())
    print(s.capacity())

    uint n = s.length()
    for (uint i = 0; i < n; i++) {
        print(s.get(i))
    }

    s.set(0, 99)
    print(s.get(0))

    (int32 val, int32 err) popped
    popped = s.pop()
    print(popped.err, " "); print(popped.val)
    popped = s.pop()
    print(popped.err, " "); print(popped.val)

    print(app::stats::remaining(getview(s)))
    n = s.length()
    for (uint i = 0; i < n; i++) {
        print(s.get(i))
    }

    s.uninit()

    return 0
}

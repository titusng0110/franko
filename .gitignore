.vscode/
*.exe
*.out
*.class
build/
.venv/
__pycache__/
.antlr/
programs/*.cpp
programs/*.testbin
programs/*.actual

# Spec test artifacts (success fixtures keep only main.fr + main.expected;
# failure fixtures keep only their .fr sources).
tests/**/*.cpp
tests/**/*.bin
tests/**/*.testbin
tests/**/*.actual
tests/**/*.want
tests/**/*.compile.log
tests/**/*.diff

# Library test artifacts (fixtures keep only main.fr plus
# main.expected / main.errors / main.args / main.stdin as applicable).
library_tests/**/*.cpp
library_tests/**/*.bin
library_tests/**/*.actual
library_tests/**/*.compile.log
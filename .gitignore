.vscode/
*.exe
*.out
*.class
build/
.venv/
__pycache__/
.antlr/
# Extracted jemalloc bundles (build outputs materialised by
# update_toolchain.py from the per-target zips in third_party/artifacts/).
third_party/jemalloc/
programs/*.cpp
programs/*.testbin
programs/*.actual

# Language test artifacts (success fixtures keep only main.fr +
# main.expected; failure fixtures keep only their .fr sources).
language_tests/**/*.cpp
language_tests/**/*.bin
language_tests/**/*.testbin
language_tests/**/*.actual
language_tests/**/*.want
language_tests/**/*.compile.log
language_tests/**/*.diff

# Library test artifacts (fixtures keep only main.fr plus
# main.expected / main.errors / main.args / main.stdin as applicable).
library_tests/**/*.cpp
library_tests/**/*.bin
library_tests/**/*.actual
library_tests/**/*.compile.log

# Benchmark artifacts (fixtures keep *.fr, *_cpp.cpp sources,
# benchmark.py, *.md; generated .cpp/.out/.bin are ignored).
benchmark/**/*.cpp
!benchmark/*_cpp.cpp
!benchmark/redblack_cpp_pool.cpp
benchmark/**/*.out
benchmark/**/*.exe
benchmark/**/*.bin
benchmark/**/*.actual
benchmark/**/*.compile.log

# Dual-mode ASan build artifacts (the .asan-suffixed parallels of the
# blocks above; kept after a failing case for inspection).
**/*.asan.cpp
**/*.asan.bin
**/*.asan.testbin
**/*.asan.actual
**/*.asan.compile.log

# JSON compiler artifacts (--emit-json; opt-in and never checked in).
*.raw.ast.json
*.desugared.ast.json
*.imports.ast.json
*.semantic.sast.json
*.legality.sast.json
*.branch-pruned.sast.json
*.inactive-pruned.sast.json
*.null-state.sast.json
*.dangling.sast.json
*.dyn-array.sast.json
*.permissions.sast.json
*.private-id.sast.json
*.ffi-verified.sast.json
*.checked.sast.json
*.diagnostic.json
*.ast/

# -Omax smoke artifacts (language_tests/run_omax_smoke.py).
language_tests/**/*.omax.cpp
language_tests/**/*.omax.bin
language_tests/**/*.omax.actual
language_tests/**/*.omax.compile.log

# Hand-written FFI bridge sources are fixtures, not generated C++.
!**/*.ffi.cpp
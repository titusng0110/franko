// ============================================================
// LIBRARY TEST (io/read): read_bytes larger than the 8192 buffer
// ============================================================
// stdin is 20000 'a' bytes followed by LF, 'x', 'y'. A single
// read_bytes call must drain three shared-buffer chunks and store
// all 20000 bytes. The following read gets the three leftover bytes:
//   read_bytes(buf, 20000) -> 20000, 0
//   read_bytes(buf, 3)     -> 3, 0     (LF, 'x', 'y')
//   read_bytes(buf, 1)     -> 0, 0     (end of input)
// ============================================================

import "franko/io"

func main() -> int32 {
    [byte] buf
    buf.init(20000)

    (uint32 val, int32 err) result = read_bytes(getmview(buf), 20000)
    print(result.val)
    print(result.err)
    print(buf[0])
    print(buf[8191])
    print(buf[8192])
    print(buf[19999])

    (uint32 val, int32 err) tail = read_bytes(getmview(buf), 3)
    print(tail.val)
    print(tail.err)
    print(buf[0])
    print(buf[1])
    print(buf[2])

    (uint32 val, int32 err) eof = read_bytes(getmview(buf), 1)
    print(eof.val)
    print(eof.err)

    buf.uninit()
    return 0
}

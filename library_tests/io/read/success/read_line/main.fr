// ============================================================
// LIBRARY TEST (io/read): read_line
// ============================================================
// stdin is "ab\ncd\n\nef" (9 bytes, no final newline). read_line
// stores one line in a std::String, consumes the terminator, and
// returns 0 on success:
//   read_line -> 0  ("ab")
//   read_line -> 0  ("cd")
//   read_line -> 0  (empty line)
//   read_line -> 0  ("ef"; end of input without a terminator)
//   read_line -> 0  (end of input)
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String line
    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    line.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (io/read): read_line growth
// ============================================================
// stdin is a 300-byte line of 'a' followed by LF, then "xy\n".
// The internal buffer starts at 256 bytes and doubles to 512:
//   read_line -> 0, length 300, first/last byte 'a'
//   read_line -> 0, length 2, "xy"
//   read_line -> 0, length 0 (end of input)
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String line

    print(read_line(getptr(line)))
    print(line.length())
    print(line.get(0))
    print(line.get(299))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())

    line.uninit()
    return 0
}

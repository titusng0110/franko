// ============================================================
// LIBRARY TEST (io/read): read_line growth
// ============================================================
// stdin is a 9000-byte line of 'a' followed by LF, then "xy\n".
// The line crosses the 8192-byte shared input buffer, so read_line
// grows its local buffer:
//   read_line -> 0, length 9000, first/last byte 'a'
//   read_line -> 0, length 2, "xy"
//   read_line -> 0, length 0 (end of input)
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String line

    print(read_line(getptr(line)))
    print(line.length())
    print(line.get(0))
    print(line.get(8999))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())

    line.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (io/read): read_line line-length limit
// ============================================================
// stdin is an 81920-byte line of 'a' followed by LF, an 81921-byte
// line of 'b' followed by LF, "ok\n", and "tail" without a final LF.
// read_line accepts the limit exactly and reports the over-long line
// as -2, consuming it so the following lines still read correctly:
//   read_line -> 0,  length 81920, first/last byte 'a'
//   read_line -> -2, out is empty (line too long)
//   read_line -> 0,  length 2, "ok"
//   read_line -> 0,  length 4, "tail" (end of input)
//   read_line -> 0,  length 0 (end of input)
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String line

    print(read_line(getptr(line)))
    print(line.length())
    print(line.get(0))
    print(line.get(81919))

    print(read_line(getptr(line)))
    print(line.length())

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())
    print(getview(line))

    print(read_line(getptr(line)))
    print(line.length())

    line.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (io/read): read error returns
// ============================================================
// read_bytes and read_line return err = -1 without touching stdin
// when their arguments cannot work, and (0, 0) when the (empty)
// input is exhausted. `two` is a 2-byte buffer:
//   read_bytes(null, 1)           -> 0, -1  (null buffer)
//   read_bytes(getmview(two), 3)  -> 0, -1  (count exceeds buffer)
//   read_bytes(getmview(two), 2)  -> 0, 0   (end of input)
//   read_line(null, 2)            -> 0, -1  (null buffer)
//   read_line(getmview(two), 0)   -> 0, -1  (max is zero)
//   read_line(getmview(two), 3)   -> 0, -1  (max exceeds buffer)
//   read_line(getmview(two), 2)   -> 0, 0   (end of input)
// ============================================================

import "franko/io"

func show_read((int64 val, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.val)
    }
}

func main() -> int32 {
    [byte, 2] two;
    show_read(read_bytes(null, 1));
    show_read(read_bytes(getmview(two), 3));
    show_read(read_bytes(getmview(two), 2));
    show_read(read_line(null, 2));
    show_read(read_line(getmview(two), 0));
    show_read(read_line(getmview(two), 3));
    show_read(read_line(getmview(two), 2));
    return 0;
}

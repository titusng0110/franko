// ============================================================
// LIBRARY TEST (io/read): read error returns
// ============================================================
// read_bytes returns err = -1 without touching stdin when its
// arguments cannot work. read_line returns -1 for a null out string
// and 0 with an empty string at end of input. `two` is a 2-byte
// buffer:
//   read_bytes(null, 1)           -> 0, -1  (null buffer)
//   read_bytes(getmview(two), 3)  -> 0, -1  (count exceeds buffer)
//   read_bytes(getmview(two), 2)  -> 0, 0   (end of input)
//   read_line(null)               -> -1     (null out string)
//   read_line(getptr(line))       -> 0      (end of input)
//   line.length()                 -> 0
// ============================================================

import "franko/io"
import "franko/string"

func show_read((uint32 val, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.val)
    }
}

func main() -> int32 {
    [byte, 2] two
    show_read(read_bytes(null, 1))
    show_read(read_bytes(getmview(two), 3))
    show_read(read_bytes(getmview(two), 2))

    print(read_line(null))

    std::String line
    line.from("stale")
    print(read_line(getptr(line)))
    print(line.length())
    line.uninit()
    return 0
}

import "franko/io"

func test_decimal() -> int32 {
    print(0)
    print(255)
    print(256)
    print(-1)
    print(-128)
    print(2147483647)
    print(-2147483648)
    print(9223372036854775807)
    print(-9223372036854775808)
    print(18446744073709551615)
    return 0
}

// ============================================================
// LIBRARY TEST (io/print): print_err overloads
// ============================================================
// Exercises every print_err overload. The test runner merges stderr
// into stdout, so the expected file contains the combined output in
// write order. Integer custom separators cover both the "fits in the
// 25-byte buffer" path and the second-write path.
// ============================================================

import "franko/io"
import "franko/string"

func test_err_overloads() -> int32 {
    print_err()
    print_err(0)
    print_err(42)
    print_err(65535)
    print_err(4294967295)
    print_err(18446744073709551615)
    print_err(-128)
    print_err(-32768)
    print_err(-2147483648)
    print_err(-9223372036854775808)
    print_err("err text")
    print_err("partial", "END")
    print_err(7, "!!!")
    print_err(-9223372036854775808, "ABCDEF")
    print("stdout line")

    std::String s
    s.from("string")
    print_err(getview(s))
    std::String end
    end.from("!")
    print_err(getview(s), getview(end))
    print_err(getview(s), "?")
    s.uninit()
    end.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (io/print): std::String overloads
// ============================================================
// Covers print(view<std::String>), print(view<std::String>,
// view<std::String>), and print(view<std::String>, view<[byte]>).
// Only live bytes are written; null and empty strings print nothing
// unless a non-empty end argument is supplied.
// ============================================================

import "franko/io"
import "franko/string"

func test_std_string() -> int32 {
    std::String s
    s.from("hello")
    print(getview(s))
    print(getview(s), "!")
    print()

    std::String end
    end.from(" world")
    print(getview(s), getview(end))
    print()

    std::String empty
    print(getview(empty))
    print(getview(empty), "x")
    print()

    view<[byte]> no_end = null
    print(getview(s), no_end)
    print()

    view<std::String> nil = null
    print(nil)
    print(nil, "y")
    print()
    print(nil, getview(end))
    print()
    print(getview(s), nil)
    print()

    print(getview(empty), getview(end))
    print()

    std::String unicode
    unicode.from("你好")
    print(getview(unicode))

    s.uninit()
    end.uninit()
    empty.uninit()
    unicode.uninit()
    return 0
}

import "franko/io"

func test_string() -> int32 {
    print("hi")
    print(1, "!")
    print(2)
    print(3, null)
    print(4)
    print()
    print(5, " ")
    print(6)
    return 0
}

// ============================================================
// LIBRARY TEST (io/print): print(text, end)
// ============================================================
// The two-argument text form writes `text` followed by `end`
// verbatim: a null `end` means no suffix and no newline, which is
// how a program writes a prompt or a partial line. A null `text`
// prints nothing but still writes `end`.
// ============================================================

import "franko/io"

func test_text_end() -> int32 {
    view<[uint8]> nil = null
    print("Hello, ", null)
    print("world")
    print("a", "b")
    print(nil, "c")
    print("done")
    return 0;
}


func test_reads() -> int32 {
    [byte] buf
    buf.init(16)

    (uint32 val, int32 err) r = read_bytes(getmview(buf), 6)
    print(r.val)
    print(r.err)
    print(buf[0])
    print(buf[1])
    print(buf[2])
    print(buf[3])
    print(buf[4])

    mview<[byte]> nilbuf = null
    r = read_bytes(nilbuf, 1)
    print(r.err)
    r = read_bytes(getmview(buf), 99)
    print(r.err)
    r = read_bytes(getmview(buf), 0)
    print(r.val)
    print(r.err)

    std::String line
    print(read_line(getptr(line)))
    print(getview(line))
    print(read_line(getptr(line)))
    print(getview(line))

    ptr<std::String> nilout = null
    print(read_line(nilout))

    line.uninit()
    buf.uninit()
    return 0
}

func main() -> int32 {
    test_decimal();
    test_err_overloads();
    test_std_string();
    test_string();
    test_text_end();
    test_reads();
    return 0;
}

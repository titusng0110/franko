import "franko/stdio"

func test_decimal() -> int32 {
    stdout(0)
    stdout(255)
    stdout(256)
    stdout(-1)
    stdout(-128)
    stdout(2147483647)
    stdout(-2147483648)
    stdout(9223372036854775807)
    stdout(-9223372036854775808)
    stdout(18446744073709551615)
    return 0
}

// ============================================================
// LIBRARY TEST (stdio/stdout): stderr overloads
// ============================================================
// Exercises every stderr overload. The test runner merges stderr
// into stdout, so the expected file contains the combined output in
// write order. Integer custom separators cover both the "fits in the
// 25-byte buffer" path and the second-write path.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_err_overloads() -> int32 {
    stderr()
    stderr(0)
    stderr(42)
    stderr(65535)
    stderr(4294967295)
    stderr(18446744073709551615)
    stderr(-128)
    stderr(-32768)
    stderr(-2147483648)
    stderr(-9223372036854775808)
    stderr("err text")
    stderr("partial", end = "END")
    stderr(7, end = "!!!")
    stderr(-9223372036854775808, end = "ABCDEF")
    stdout("stdout line")

    std::String s
    s.from("string")
    stderr(getview(s))
    std::String end
    end.from("!")
    stderr(getview(s), getview(end))
    stderr(getview(s), end = "?")
    s.uninit()
    end.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (stdio/stdout): std::String overloads
// ============================================================
// Covers stdout(view<std::String>), stdout(view<std::String>,
// view<std::String>), and stdout(view<std::String>, view<[byte]>).
// Only live bytes are written; null and empty strings write no text
// bytes, but a non-empty end argument is still written.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_std_string() -> int32 {
    std::String s
    s.from("hello")
    stdout(getview(s))
    stdout(getview(s), end = "!")
    stdout()

    std::String end
    end.from(" world")
    stdout(getview(s), getview(end))
    stdout()

    std::String empty
    stdout(getview(empty))
    stdout(getview(empty), end = "x")
    stdout()

    view<[byte]> no_end = null
    stdout(getview(s), end = no_end)
    stdout()

    view<std::String> nil = null
    stdout(nil)
    stdout(nil, end = "y")
    stdout()
    stdout(nil, getview(end))
    stdout()
    stdout(getview(s), nil)
    stdout()

    stdout(getview(empty), getview(end))
    stdout()

    std::String unicode
    unicode.from("你好")
    stdout(getview(unicode))

    s.uninit()
    end.uninit()
    empty.uninit()
    unicode.uninit()
    return 0
}

import "franko/stdio"

func test_string() -> int32 {
    stdout("hi")
    stdout(1, end = "!")
    stdout(2)
    stdout(3, end = null)
    stdout(4)
    stdout()
    stdout(5, end = " ")
    stdout(6)
    return 0
}

// ============================================================
// LIBRARY TEST (stdio/stdout): stdout(text, end)
// ============================================================
// The text form writes `text` followed by `end`
// verbatim: a null `end` means no suffix and no newline, which is
// how a program writes a prompt or a partial line. A null `text`
// writes no text bytes but still writes `end`.
// ============================================================

import "franko/stdio"

func test_text_end() -> int32 {
    view<[uint8]> nil = null
    stdout("Hello, ", end = null)
    stdout("world")
    stdout("a", end = "b")
    stdout(nil, end = "c")
    stdout("done")
    return 0;
}


func test_reads() -> int32 {
    [byte] buf
    buf.init(16)

    (uint32 val, int32 err) r = stdin_bytes(getmview(buf), 6)
    stdout(r.val)
    stdout(r.err)
    stdout(buf[0])
    stdout(buf[1])
    stdout(buf[2])
    stdout(buf[3])
    stdout(buf[4])

    mview<[byte]> nilbuf = null
    r = stdin_bytes(nilbuf, 1)
    stdout(r.err)
    r = stdin_bytes(getmview(buf), 99)
    stdout(r.err)
    r = stdin_bytes(getmview(buf), 0)
    stdout(r.val)
    stdout(r.err)

    std::String line
    stdout(stdin_line(getptr(line)))
    stdout(getview(line))
    stdout(stdin_line(getptr(line)))
    stdout(getview(line))

    ptr<std::String> nilout = null
    stdout(stdin_line(nilout))

    line.uninit()
    buf.uninit()
    return 0
}

func main() -> int32 {
    test_decimal();
    test_err_overloads();
    test_std_string();
    test_string();
    test_text_end();
    test_reads();
    return 0;
}

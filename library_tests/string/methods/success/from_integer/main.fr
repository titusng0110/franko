// ============================================================
// LIBRARY TEST (string/methods): from_integer
// ============================================================
// Covers all eight from_integer overloads with zero, positive,
// negative, minimum, and maximum values, plus replacement of a
// longer existing string.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String s

    int8 a = -128
    print(s.from_integer(a))
    print(getview(s))
    a = 0
    print(s.from_integer(a))
    print(getview(s))
    a = 127
    print(s.from_integer(a))
    print(getview(s))

    int16 b = -32768
    print(s.from_integer(b))
    print(getview(s))
    b = 32767
    print(s.from_integer(b))
    print(getview(s))

    int32 c = -2147483648
    print(s.from_integer(c))
    print(getview(s))
    c = 2147483647
    print(s.from_integer(c))
    print(getview(s))

    int64 d = -9223372036854775808
    print(s.from_integer(d))
    print(getview(s))
    d = 9223372036854775807
    print(s.from_integer(d))
    print(getview(s))

    uint8 e = 0
    print(s.from_integer(e))
    print(getview(s))
    e = 255
    print(s.from_integer(e))
    print(getview(s))

    uint16 f = 0
    print(s.from_integer(f))
    print(getview(s))
    f = 65535
    print(s.from_integer(f))
    print(getview(s))

    uint32 g = 0
    print(s.from_integer(g))
    print(getview(s))
    g = 4294967295
    print(s.from_integer(g))
    print(getview(s))

    uint64 h = 0
    print(s.from_integer(h))
    print(getview(s))
    h = 18446744073709551615
    print(s.from_integer(h))
    print(getview(s))

    s.from("long text")
    int32 small = 7
    print(s.from_integer(small))
    print(s.length())
    print(getview(s))

    s.uninit()
    return 0
}

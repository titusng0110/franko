// ============================================================
// LIBRARY TEST (string/methods): find, find_next, count, count_from
// ============================================================
// Covers byte, byte-view, and String needles; found/not-found;
// start indices past the end; empty needles; overlapping substring
// counts; null String views; and get/set bounds behavior.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String s
    s.from("a,b,,c,")
    std::String needle
    needle.from(",,")
    view<[byte]> empty = null

    (uint32 idx, int32 err) hit = s.find(44)
    print(hit.idx)
    print(hit.err)
    hit = s.find("c,")
    print(hit.idx)
    print(hit.err)
    hit = s.find(getview(needle))
    print(hit.idx)
    print(hit.err)
    hit = s.find("zz")
    print(hit.idx)
    print(hit.err)
    hit = s.find(empty)
    print(hit.idx)
    print(hit.err)

    hit = s.find_next(44, 2)
    print(hit.idx)
    print(hit.err)
    hit = s.find_next("c", 0)
    print(hit.idx)
    print(hit.err)
    hit = s.find_next(getview(needle), 4)
    print(hit.idx)
    print(hit.err)
    hit = s.find_next(44, 99)
    print(hit.idx)
    print(hit.err)
    hit = s.find_next(empty, 7)
    print(hit.idx)
    print(hit.err)

    print(s.count(44))
    print(s.count("c"))
    print(s.count(getview(needle)))
    print(s.count(empty))
    print(s.count_from(44, 4))
    print(s.count_from("c", 0))
    print(s.count_from(getview(needle), 0))
    print(s.count_from(empty, 7))
    print(s.count_from(empty, 99))

    std::String repeated
    repeated.from("aaa")
    print(repeated.count("aa"))
    print(repeated.count_from("aa", 1))

    print(s.get(0))
    print(s.get(99))
    s.set(0, 65)
    print(s.get(0))
    s.set(99, 66)
    print(s.get(0))

    repeated.uninit()
    needle.uninit()
    s.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): append, get_slice, insert, erase
// ============================================================
// Covers all append, get_slice, insert, and erase overloads,
// self-append/self-insert/self-slice, invalid indices and ranges,
// and get/set bounds behavior.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    [byte] out
    std::String s
    s.from("abc")
    print(s.append(100))
    print(s.append("ef"))
    std::String tail
    tail.from("gh")
    print(s.append(getview(tail)))
    print(s.length())
    print(s.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String d
    d.from("xy")
    print(d.append(getview(d)))
    print(d.length())
    print(d.append("xy"))
    print(d.length())

    [byte] arr
    arr.init(2)
    arr[0] = 90
    arr[1] = 87
    std::String e
    e.from("ab")
    print(e.append(getview(arr)))
    print(e.length())
    print(e.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    arr.uninit()

    std::String part
    print(s.get_slice(1, 4, getptr(part)))
    print(part.length())
    print(part.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(s.get_slice(4, 1, getptr(part)))
    print(s.get_slice(1, 99, getptr(part)))
    print(s.get_slice(0, 0, getptr(part)))
    print(part.length())

    std::String selfs
    selfs.from("abcdef")
    print(selfs.get_slice(2, 5, getptr(selfs)))
    print(selfs.length())
    print(selfs.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    [byte] bslice
    bslice.init(1)
    print(selfs.get_slice(0, 2, getptr(bslice)))
    print(bslice.length())
    print(getview(bslice))
    if (bslice.length() != 0) {
        bslice.uninit()
    }

    std::String ins
    ins.from("abcd")
    print(ins.insert(45, 2))
    print(ins.insert("XY", 0))
    print(ins.insert(getview(tail), 7))
    print(ins.length())
    print(ins.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(ins.insert(33, 99))
    print(ins.insert("z", 9))
    print(ins.length())
    print(ins.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String si
    si.from("ab")
    print(si.insert(getview(si), 1))
    print(si.length())
    print(si.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(si.erase(0))
    print(si.erase(1, 2))
    print(si.length())
    print(si.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(si.erase(99))
    print(si.erase(1, 0))
    print(si.erase(0, 99))

    print(si.get(0))
    print(si.get(99))
    si.set(0, 65)
    print(si.get(0))
    si.set(99, 66)
    print(si.get(0))

    s.uninit()
    tail.uninit()
    d.uninit()
    e.uninit()
    part.uninit()
    selfs.uninit()
    ins.uninit()
    si.uninit()
    return 0
}

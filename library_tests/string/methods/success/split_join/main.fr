// ============================================================
// LIBRARY TEST (string/methods): split and join
// ============================================================
// Covers all split and join overloads, empty/leading/trailing/
// consecutive segments, empty and null splitters, null lists,
// null joiners, joining a string that is a list element, and a
// joiner that aliases the destination string.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    [byte] out
    std::String text
    text.from("a,b,,c,")
    std::StringList parts

    print(text.split(44, getptr(parts)))
    print(parts.length())
    for (uint32 i = 0; i < parts.length(); i++) {
        std::String item
        print(parts.get(i, getptr(item)))
        print(item.length())
        if (item.length() != 0) {
            print(item.to(getptr(out)))
            print(getview(out))
            if (out.length() != 0) {
                out.uninit()
            }
        } else {
            print(0)
        }
        item.uninit()
    }

    print(text.split(",,", getptr(parts)))
    print(parts.length())
    for (uint32 i = 0; i < parts.length(); i++) {
        std::String item
        print(parts.get(i, getptr(item)))
        print(item.length())
        print(item.to(getptr(out)))
        print(getview(out))
        if (out.length() != 0) {
            out.uninit()
        }
        item.uninit()
    }

    std::String sep
    sep.from(",,")
    print(text.split(getview(sep), getptr(parts)))
    print(parts.length())

    view<[byte]> empty = null
    print(text.split(empty, getptr(parts)))
    print(parts.length())
    std::String whole
    print(parts.get(0, getptr(whole)))
    print(whole.length())
    print(whole.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    whole.uninit()

    print(text.split("zz", getptr(parts)))
    print(parts.length())

    std::StringList words
    words.append("cc")
    words.append("aa")
    std::String joined
    print(joined.join(44, getview(words)))
    print(joined.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    print(joined.join(getview(words)))
    print(joined.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String sep2
    sep2.from("--")
    print(joined.join(getview(sep2), getview(words)))
    print(joined.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String sep3
    sep3.from("|")
    print(joined.join(getview(sep3), getview(words)))
    print(joined.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    view<[byte]> nojoiner = null
    print(joined.join(nojoiner, getview(words)))
    print(joined.length())

    std::StringList empty_list
    print(joined.join(44, getview(empty_list)))
    print(joined.length())

    view<std::StringList> nil_list = null
    print(joined.join(44, nil_list))
    print(joined.length())

    std::String js
    js.from("X")
    std::StringList jl
    jl.append("a")
    jl.append("b")
    print(js.join(getview(js), getview(jl)))
    print(js.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList selflist
    selflist.append("ab")
    selflist.append("cd")
    print(selflist.data[0].join(44, getview(selflist)))
    print(selflist.data[0].to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(selflist.data[1].to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    text.uninit()
    sep.uninit()
    sep2.uninit()
    sep3.uninit()
    joined.uninit()
    js.uninit()
    parts.uninit()
    words.uninit()
    empty_list.uninit()
    jl.uninit()
    selflist.uninit()
    return 0
}

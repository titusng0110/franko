// ============================================================
// LIBRARY TEST (string/methods): to_<integer> conversions
// ============================================================
// Covers all eight to_<type> methods, decimal minus signs, rejected
// plus signs, binary and hexadecimal prefixes, min/max boundaries,
// overflow, malformed input, and empty strings.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    std::String s

    (int8 val, int32 err) r8 = s.to_int8()
    print(r8.val)
    print(r8.err)

    s.from("127")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("+127")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("-128")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("128")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("-129")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0b101")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0B101")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0x7F")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0X7f")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0x80")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("-0x80")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("+0b101")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)

    s.from("--1")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("++1")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("+-1")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("-+1")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0b2")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0xG")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0x")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("0b")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("+")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("-")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("12a")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from(" 12")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("12 ")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)
    s.from("007")
    r8 = s.to_int8()
    print(r8.val)
    print(r8.err)

    (int16 val, int32 err) r16 = s.to_int16()
    s.from("-32768")
    r16 = s.to_int16()
    print(r16.val)
    print(r16.err)
    s.from("32767")
    r16 = s.to_int16()
    print(r16.val)
    print(r16.err)
    s.from("32768")
    r16 = s.to_int16()
    print(r16.val)
    print(r16.err)
    s.from("-0x8000")
    r16 = s.to_int16()
    print(r16.val)
    print(r16.err)

    (int32 val, int32 err) r32 = s.to_int32()
    s.from("-2147483648")
    r32 = s.to_int32()
    print(r32.val)
    print(r32.err)
    s.from("2147483647")
    r32 = s.to_int32()
    print(r32.val)
    print(r32.err)
    s.from("2147483648")
    r32 = s.to_int32()
    print(r32.val)
    print(r32.err)
    s.from("0x7FFFFFFF")
    r32 = s.to_int32()
    print(r32.val)
    print(r32.err)
    s.from("-0x80000000")
    r32 = s.to_int32()
    print(r32.val)
    print(r32.err)

    (int64 val, int32 err) r64 = s.to_int64()
    s.from("-9223372036854775808")
    r64 = s.to_int64()
    print(r64.val)
    print(r64.err)
    s.from("9223372036854775807")
    r64 = s.to_int64()
    print(r64.val)
    print(r64.err)
    s.from("9223372036854775808")
    r64 = s.to_int64()
    print(r64.val)
    print(r64.err)
    s.from("0x7FFFFFFFFFFFFFFF")
    r64 = s.to_int64()
    print(r64.val)
    print(r64.err)
    s.from("-0x8000000000000000")
    r64 = s.to_int64()
    print(r64.val)
    print(r64.err)

    (uint8 val, int32 err) u8 = s.to_uint8()
    s.from("0")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("255")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("+255")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("256")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("-1")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("-0")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("0xFF")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("0b11111111")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)
    s.from("0x100")
    u8 = s.to_uint8()
    print(u8.val)
    print(u8.err)

    (uint16 val, int32 err) u16 = s.to_uint16()
    s.from("65535")
    u16 = s.to_uint16()
    print(u16.val)
    print(u16.err)
    s.from("65536")
    u16 = s.to_uint16()
    print(u16.val)
    print(u16.err)
    s.from("0xFFFF")
    u16 = s.to_uint16()
    print(u16.val)
    print(u16.err)

    (uint32 val, int32 err) u32 = s.to_uint32()
    s.from("4294967295")
    u32 = s.to_uint32()
    print(u32.val)
    print(u32.err)
    s.from("4294967296")
    u32 = s.to_uint32()
    print(u32.val)
    print(u32.err)
    s.from("0xFFFFFFFF")
    u32 = s.to_uint32()
    print(u32.val)
    print(u32.err)

    (uint64 val, int32 err) u64 = s.to_uint64()
    s.from("18446744073709551615")
    u64 = s.to_uint64()
    print(u64.val)
    print(u64.err)
    s.from("18446744073709551616")
    u64 = s.to_uint64()
    print(u64.val)
    print(u64.err)
    s.from("0xFFFFFFFFFFFFFFFF")
    u64 = s.to_uint64()
    print(u64.val)
    print(u64.err)
    s.from("0b1111111111111111111111111111111111111111111111111111111111111111")
    u64 = s.to_uint64()
    print(u64.val)
    print(u64.err)

    s.uninit()
    return 0
}

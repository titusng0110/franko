    s.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/operators): assign, append, multiply
// ============================================================
// Covers = with string literals, String values, and byte arrays;
// += with literals, String values, and byte arrays; *= with 1, 2,
// and 0 (clear). Every result is inspected through to(ptr<[byte]>).
// ============================================================

import "franko/stdio"
import "franko/string"

func test_assign_append_multiply() -> int32 {
    [byte] out
    std::String a
    a = "ab"
    std::String b
    b = "cd"
    a += b
    stdout(a.to(getptr(out)))
    stdout(getview(out))

    a += "ef"
    stdout(a.to(getptr(out)))
    stdout(getview(out))
    stdout(a.length())

    [byte] arr
    arr.init(2)
    arr[0] = 88
    arr[1] = 89
    a = arr
    stdout(a.to(getptr(out)))
    stdout(getview(out))
    stdout(a.length())

    a += arr
    stdout(a.to(getptr(out)))
    stdout(getview(out))

    a *= 2
    stdout(a.to(getptr(out)))
    stdout(getview(out))

    a *= 1
    stdout(a.to(getptr(out)))
    stdout(getview(out))

    a *= 0
    stdout(a.length())
    stdout(a.to(getptr(out)))
    stdout(out.length())

    std::String c
    c = a
    stdout(c.length())

    std::String dup
    dup = "xy"
    stdout(dup.from(getview(dup)))
    stdout(dup.length())
    stdout(dup.to(getptr(out)))
    stdout(getview(out))
    out.uninit()
    dup += dup
    stdout(dup.to(getptr(out)))
    stdout(getview(out))
    out.uninit()

    a.uninit()
    b.uninit()
    c.uninit()
    dup.uninit()
    arr.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/operators): comparisons
// ============================================================
// Covers all six comparators, equal strings, differing bytes,
// prefixes, and empty strings. Comparisons are lexicographic over
// the byte contents; the shorter string is less on a shared prefix.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_comparisons() -> int32 {
    std::String a
    a = "abc"
    std::String b
    b = "abd"
    std::String c
    c = "abc"
    std::String p
    p = "ab"
    std::String e1
    std::String e2

    stdout(a == c)
    stdout(a != b)
    stdout(a < b)
    stdout(a > b)
    stdout(a <= c)
    stdout(a >= c)
    stdout(p < a)
    stdout(a > p)
    stdout(e1 == e2)
    stdout(e1 < a)
    stdout(a > e1)
    stdout(b < a)
    stdout(b > a)

    a.uninit()
    b.uninit()
    c.uninit()
    p.uninit()
    e1.uninit()
    e2.uninit()
    return 0
}

func main() -> int32 {
    test_from_to();
    test_reserve();
    test_utf8();
    test_find_count();
    test_from_integer();
    test_slice_edit();
    test_split_join();
    test_to_integer();
    test_assign_append_multiply();
    test_comparisons();
    return 0;
}

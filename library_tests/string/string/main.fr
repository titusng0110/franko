// ============================================================
// LIBRARY TEST (string/basic): from and to
// ============================================================
// Covers both from() overloads, both to() overloads, static and
// dynamic byte-array sources, null sources, length, and the
// exact-length byte-array output produced by to(ptr<[byte]>).
// ============================================================

import "franko/stdio"
import "franko/string"

func test_from_to() -> int32 {
    std::String s
    stdout(s.length())
    stdout(s.from("hello"))
    stdout(s.length())
    ptr<[byte]> nil_out = null
    stdout(s.to(nil_out))

    [byte] out
    stdout(s.to(getptr(out)))
    stdout(out.length())
    stdout(getview(out))
    out.uninit()

    std::String t
    stdout(t.from(getview(s)))
    stdout(t.length())
    stdout(t == s)

    std::String u
    stdout(s.to(getptr(u)))
    stdout(u == s)

    [byte, 3] fixed
    fixed[0] = 120
    fixed[1] = 121
    fixed[2] = 122
    std::String w
    stdout(w.from(getview(fixed)))
    stdout(w.length())
    stdout(w.to(getptr(out)))
    stdout(getview(out))
    out.uninit()

    view<[byte]> nil = null
    stdout(s.from(nil))
    stdout(s.length())
    stdout(s.to(nil_out))

    s.uninit()
    t.uninit()
    u.uninit()
    w.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/basic): growth and clearing
// ============================================================
// Covers from() at the 63/64/65-byte boundary, append/multiply growth,
// clearing with *= 0 and clear(), reuse after clearing, shrink_to_fit(),
// and UTF-8 validity across those transitions. Capacity is internal and
// is not inspected.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_reserve() -> int32 {
    std::String s
    stdout(s.length())

    [byte] p63
    p63.init_zero(63)
    std::String a
    stdout(a.from(getview(p63)))
    stdout(a.length())
    stdout(a.is_utf8_compliant())

    [byte] p64
    p64.init_zero(64)
    std::String b
    stdout(b.from(getview(p64)))
    stdout(b.length())
    stdout(b.is_utf8_compliant())

    [byte] p65
    p65.init_zero(65)
    std::String d
    stdout(d.from(getview(p65)))
    stdout(d.length())
    stdout(d.is_utf8_compliant())

    std::String c
    stdout(c.from("ab"))
    c += "cd"
    c *= 2
    stdout(c.length())
    stdout(c.is_utf8_compliant())
    c *= 0
    stdout(c.length())
    stdout(c.is_utf8_compliant())
    stdout(c.from(getview(p65)))
    stdout(c.length())
    stdout(c.is_utf8_compliant())

    c.clear()
    stdout(c.length())
    stdout(c.is_utf8_compliant())
    stdout(c.from("reuse"))
    stdout(c.length())
    stdout(getview(c))
    stdout(c.shrink_to_fit())
    stdout(c.length())
    stdout(getview(c))
    c.clear()
    stdout(c.shrink_to_fit())
    stdout(c.length())
    stdout(c.from("again"))
    stdout(getview(c))

    p63.uninit()
    p64.uninit()
    p65.uninit()
    s.uninit()
    a.uninit()
    b.uninit()
    c.uninit()
    d.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/basic): UTF-8 validation
// ============================================================
// Covers ASCII, valid 2/3/4-byte sequences and their boundaries,
// overlong encodings, UTF-16 surrogates, code points above U+10FFFF,
// invalid lead bytes, stray continuation bytes, and truncation.
// ============================================================

import "franko/stdio"
import "franko/string"

func check_2(view<[byte]> bytes) -> void {
    std::String s
    s.from(bytes)
    stdout(s.is_utf8_compliant())
    s.uninit()
    return
}

func test_utf8() -> int32 {
    std::String empty
    stdout(empty.length())
    stdout(empty.is_utf8_compliant())
    empty.uninit()

    std::String ascii
    ascii.from("hello")
    stdout(ascii.is_utf8_compliant())
    ascii.uninit()

    std::String unicode
    unicode.from("你好, Franko 😭😍")
    stdout(unicode.length())
    stdout(unicode.is_utf8_compliant())
    unicode.uninit()

    [byte, 2] two
    two[0] = 0xC2
    two[1] = 0xA2
    check_2(getview(two))

    [byte, 3] three
    three[0] = 0xE4
    three[1] = 0xBD
    three[2] = 0xA0
    check_2(getview(three))

    [byte, 4] four
    four[0] = 0xF0
    four[1] = 0x9F
    four[2] = 0x98
    four[3] = 0xAD
    check_2(getview(four))

    [byte, 2] two_min
    two_min[0] = 0xC2
    two_min[1] = 0x80
    check_2(getview(two_min))

    [byte, 2] two_max
    two_max[0] = 0xDF
    two_max[1] = 0xBF
    check_2(getview(two_max))

    [byte, 3] three_min
    three_min[0] = 0xE0
    three_min[1] = 0xA0
    three_min[2] = 0x80
    check_2(getview(three_min))

    [byte, 3] three_surrogate_max
    three_surrogate_max[0] = 0xED
    three_surrogate_max[1] = 0x9F
    three_surrogate_max[2] = 0xBF
    check_2(getview(three_surrogate_max))

    [byte, 3] three_private
    three_private[0] = 0xEE
    three_private[1] = 0x80
    three_private[2] = 0x80
    check_2(getview(three_private))

    [byte, 3] three_max
    three_max[0] = 0xEF
    three_max[1] = 0xBF
    three_max[2] = 0xBF
    check_2(getview(three_max))

    [byte, 4] four_min
    four_min[0] = 0xF0
    four_min[1] = 0x90
    four_min[2] = 0x80
    four_min[3] = 0x80
    check_2(getview(four_min))

    [byte, 4] four_max
    four_max[0] = 0xF4
    four_max[1] = 0x8F
    four_max[2] = 0xBF
    four_max[3] = 0xBF
    check_2(getview(four_max))

    [byte, 1] continuation
    continuation[0] = 0x80
    check_2(getview(continuation))

    [byte, 2] overlong_two
    overlong_two[0] = 0xC0
    overlong_two[1] = 0x80
    check_2(getview(overlong_two))

    [byte, 3] overlong_three
    overlong_three[0] = 0xE0
    overlong_three[1] = 0x9F
    overlong_three[2] = 0xBF
    check_2(getview(overlong_three))

    [byte, 3] surrogate
    surrogate[0] = 0xED
    surrogate[1] = 0xA0
    surrogate[2] = 0x80
    check_2(getview(surrogate))

    [byte, 4] overlong_four
    overlong_four[0] = 0xF0
    overlong_four[1] = 0x8F
    overlong_four[2] = 0xBF
    overlong_four[3] = 0xBF
    check_2(getview(overlong_four))

    [byte, 4] above_max
    above_max[0] = 0xF4
    above_max[1] = 0x90
    above_max[2] = 0x80
    above_max[3] = 0x80
    check_2(getview(above_max))

    [byte, 4] bad_lead_five
    bad_lead_five[0] = 0xF5
    bad_lead_five[1] = 0x80
    bad_lead_five[2] = 0x80
    bad_lead_five[3] = 0x80
    check_2(getview(bad_lead_five))

    [byte, 1] truncated_two
    truncated_two[0] = 0xC2
    check_2(getview(truncated_two))

    [byte, 2] truncated_three
    truncated_three[0] = 0xE0
    truncated_three[1] = 0xA0
    check_2(getview(truncated_three))

    [byte, 3] truncated_four
    truncated_four[0] = 0xF0
    truncated_four[1] = 0x90
    truncated_four[2] = 0x80
    check_2(getview(truncated_four))

    [byte, 2] bad_second
    bad_second[0] = 0xE0
    bad_second[1] = 0x80
    check_2(getview(bad_second))

    [byte, 1] bad_lead_fe
    bad_lead_fe[0] = 0xFE
    check_2(getview(bad_lead_fe))

    [byte, 1] bad_lead_ff
    bad_lead_ff[0] = 0xFF
    check_2(getview(bad_lead_ff))

    [byte, 3] embedded_nul
    embedded_nul[0] = 0x41
    embedded_nul[1] = 0x00
    embedded_nul[2] = 0x42
    check_2(getview(embedded_nul))

    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): find, find_next, count, count_from
// ============================================================
// Covers byte, byte-view, and String needles; found/not-found;
// start indices past the end; empty needles; overlapping substring
// counts; null String views; and get/set bounds behavior.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_find_count() -> int32 {
    std::String s
    s.from("a,b,,c,")
    std::String needle
    needle.from(",,")
    view<[byte]> empty = null

    (uint32 idx, int32 err) hit = s.find(44)
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find("c,")
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find(getview(needle))
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find("zz")
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find(empty)
    stdout(hit.idx)
    stdout(hit.err)

    hit = s.find_next(44, 2)
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find_next("c", 0)
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find_next(getview(needle), 4)
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find_next(44, 99)
    stdout(hit.idx)
    stdout(hit.err)
    hit = s.find_next(empty, 7)
    stdout(hit.idx)
    stdout(hit.err)

    stdout(s.count(44))
    stdout(s.count("c"))
    stdout(s.count(getview(needle)))
    stdout(s.count(empty))
    stdout(s.count_from(44, 4))
    stdout(s.count_from("c", 0))
    stdout(s.count_from(getview(needle), 0))
    stdout(s.count_from(empty, 7))
    stdout(s.count_from(empty, 99))

    std::String repeated
    repeated.from("aaa")
    stdout(repeated.count("aa"))
    stdout(repeated.count_from("aa", 1))

    stdout(s.get(0))
    stdout(s.get(99))
    s.set(0, 65)
    stdout(s.get(0))
    s.set(99, 66)
    stdout(s.get(0))

    repeated.uninit()
    needle.uninit()
    s.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): from_integer
// ============================================================
// Covers all eight from_integer overloads with zero, positive,
// negative, minimum, and maximum values, plus replacement of a
// longer existing string.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_from_integer() -> int32 {
    std::String s

    int8 a = -128
    stdout(s.from_integer(a))
    stdout(getview(s))
    a = 0
    stdout(s.from_integer(a))
    stdout(getview(s))
    a = 127
    stdout(s.from_integer(a))
    stdout(getview(s))

    int16 b = -32768
    stdout(s.from_integer(b))
    stdout(getview(s))
    b = 32767
    stdout(s.from_integer(b))
    stdout(getview(s))

    int32 c = -2147483648
    stdout(s.from_integer(c))
    stdout(getview(s))
    c = 2147483647
    stdout(s.from_integer(c))
    stdout(getview(s))

    int64 d = -9223372036854775808
    stdout(s.from_integer(d))
    stdout(getview(s))
    d = 9223372036854775807
    stdout(s.from_integer(d))
    stdout(getview(s))

    uint8 e = 0
    stdout(s.from_integer(e))
    stdout(getview(s))
    e = 255
    stdout(s.from_integer(e))
    stdout(getview(s))

    uint16 f = 0
    stdout(s.from_integer(f))
    stdout(getview(s))
    f = 65535
    stdout(s.from_integer(f))
    stdout(getview(s))

    uint32 g = 0
    stdout(s.from_integer(g))
    stdout(getview(s))
    g = 4294967295
    stdout(s.from_integer(g))
    stdout(getview(s))

    uint64 h = 0
    stdout(s.from_integer(h))
    stdout(getview(s))
    h = 18446744073709551615
    stdout(s.from_integer(h))
    stdout(getview(s))

    s.from("long text")
    int32 small = 7
    stdout(s.from_integer(small))
    stdout(s.length())
    stdout(getview(s))

    s.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): append, get_slice, insert, erase
// ============================================================
// Covers all append, get_slice, insert, and erase overloads,
// self-append/self-insert/self-slice, invalid indices and ranges,
// and get/set bounds behavior.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_slice_edit() -> int32 {
    [byte] out
    std::String s
    s.from("abc")
    stdout(s.append(100))
    stdout(s.append("ef"))
    std::String tail
    tail.from("gh")
    stdout(s.append(getview(tail)))
    stdout(s.length())
    stdout(s.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String d
    d.from("xy")
    stdout(d.append(getview(d)))
    stdout(d.length())
    stdout(d.append("xy"))
    stdout(d.length())

    [byte] arr
    arr.init(2)
    arr[0] = 90
    arr[1] = 87
    std::String e
    e.from("ab")
    stdout(e.append(getview(arr)))
    stdout(e.length())
    stdout(e.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    arr.uninit()

    std::String part
    stdout(s.get_slice(1, 4, getptr(part)))
    stdout(part.length())
    stdout(part.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(s.get_slice(4, 1, getptr(part)))
    stdout(s.get_slice(1, 99, getptr(part)))
    stdout(s.get_slice(0, 0, getptr(part)))
    stdout(part.length())

    std::String selfs
    selfs.from("abcdef")
    stdout(selfs.get_slice(2, 5, getptr(selfs)))
    stdout(selfs.length())
    stdout(selfs.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    [byte] bslice
    bslice.init(1)
    stdout(selfs.get_slice(0, 2, getptr(bslice)))
    stdout(bslice.length())
    stdout(getview(bslice))
    if (bslice.length() != 0) {
        bslice.uninit()
    }

    std::String ins
    ins.from("abcd")
    stdout(ins.insert(45, 2))
    stdout(ins.insert("XY", 0))
    stdout(ins.insert(getview(tail), 7))
    stdout(ins.length())
    stdout(ins.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(ins.insert(33, 99))
    stdout(ins.insert("z", 9))
    stdout(ins.length())
    stdout(ins.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String si
    si.from("ab")
    stdout(si.insert(getview(si), 1))
    stdout(si.length())
    stdout(si.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(si.erase(0))
    stdout(si.erase(1, 2))
    stdout(si.length())
    stdout(si.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(si.erase(99))
    stdout(si.erase(1, 0))
    stdout(si.erase(0, 99))

    stdout(si.get(0))
    stdout(si.get(99))
    si.set(0, 65)
    stdout(si.get(0))
    si.set(99, 66)
    stdout(si.get(0))

    s.uninit()
    tail.uninit()
    d.uninit()
    e.uninit()
    part.uninit()
    selfs.uninit()
    ins.uninit()
    si.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): split and join
// ============================================================
// Covers all split and join overloads, empty/leading/trailing/
// consecutive segments, empty and null splitters, null lists,
// null joiners, joining a string that is a list element, and a
// joiner that aliases the destination string.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_split_join() -> int32 {
    [byte] out
    std::String text
    text.from("a,b,,c,")
    std::StringList parts

    stdout(text.split(44, getptr(parts)))
    stdout(parts.length())
    for (uint32 i = 0; i < parts.length(); i++) {
        std::String item
        stdout(parts.get(i, getptr(item)))
        stdout(item.length())
        if (item.length() != 0) {
            stdout(item.to(getptr(out)))
            stdout(getview(out))
            if (out.length() != 0) {
                out.uninit()
            }
        } else {
            stdout(0)
        }
        item.uninit()
    }

    stdout(text.split(",,", getptr(parts)))
    stdout(parts.length())
    for (uint32 i = 0; i < parts.length(); i++) {
        std::String item
        stdout(parts.get(i, getptr(item)))
        stdout(item.length())
        stdout(item.to(getptr(out)))
        stdout(getview(out))
        if (out.length() != 0) {
            out.uninit()
        }
        item.uninit()
    }

    std::String sep
    sep.from(",,")
    stdout(text.split(getview(sep), getptr(parts)))
    stdout(parts.length())

    view<[byte]> empty = null
    stdout(text.split(empty, getptr(parts)))
    stdout(parts.length())
    std::String whole
    stdout(parts.get(0, getptr(whole)))
    stdout(whole.length())
    stdout(whole.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    whole.uninit()

    stdout(text.split("zz", getptr(parts)))
    stdout(parts.length())

    std::StringList words
    words.append("cc")
    words.append("aa")
    std::String joined
    stdout(joined.join(44, getview(words)))
    stdout(joined.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    stdout(joined.join(getview(words)))
    stdout(joined.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String sep2
    sep2.from("--")
    stdout(joined.join(getview(sep2), getview(words)))
    stdout(joined.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::String sep3
    sep3.from("|")
    stdout(joined.join(getview(sep3), getview(words)))
    stdout(joined.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    view<[byte]> nojoiner = null
    stdout(joined.join(nojoiner, getview(words)))
    stdout(joined.length())

    std::StringList empty_list
    stdout(joined.join(44, getview(empty_list)))
    stdout(joined.length())

    view<std::StringList> nil_list = null
    stdout(joined.join(44, nil_list))
    stdout(joined.length())

    std::String js
    js.from("X")
    std::StringList jl
    jl.append("a")
    jl.append("b")
    stdout(js.join(getview(js), getview(jl)))
    stdout(js.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList selflist
    selflist.append("ab")
    selflist.append("cd")
    stdout(selflist._data[0].join(44, getview(selflist)))
    stdout(selflist._data[0].to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(selflist._data[1].to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    text.uninit()
    sep.uninit()
    sep2.uninit()
    sep3.uninit()
    joined.uninit()
    js.uninit()
    parts.uninit()
    words.uninit()
    empty_list.uninit()
    jl.uninit()
    selflist.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/methods): to_<integer> conversions
// ============================================================
// Covers all eight to_<type> methods, decimal minus signs, rejected
// plus signs, binary and hexadecimal prefixes, min/max boundaries,
// overflow, malformed input, and empty strings.
// ============================================================

import "franko/stdio"
import "franko/string"

func test_to_integer() -> int32 {
    std::String s

    (int8 val, int32 err) r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)

    s.from("127")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("+127")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("-128")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("128")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("-129")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("0b101")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("0B101")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("0x7F")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("0X7f")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("0x80")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("-0x80")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("+0b101")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)

    s.from("--1")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("++1")
    r8 = s.to_int8()
    stdout(r8.val)
    stdout(r8.err)
    s.from("+-1")

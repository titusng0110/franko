// ============================================================
// LIBRARY TEST (string/stringlist): StringList methods
// ============================================================
// Covers length, both from overloads, both append overloads, both
// find/find_next/count/count_from needle forms, both get overloads,
// both set overloads, both insert overloads, both erase forms,
// clearing through a null from view and clear(), the 128/256 doubling
// growth, and appending after clearing.
// ============================================================

import "franko/io"
import "franko/string"

func main() -> int32 {
    [byte] out
    std::StringList list
    print(list.length())
    print(list.append("aa"))
    print(list.append("bb"))
    print(list.append("aa"))
    print(list.length())

    std::String needle
    needle.from("aa")
    (uint32 idx, int32 err) hit = list.find(getview(needle))
    print(hit.idx)
    print(hit.err)
    hit = list.find_next(getview(needle), 1)
    print(hit.idx)
    print(hit.err)
    print(list.count(getview(needle)))
    print(list.count_from(getview(needle), 1))
    std::String missing
    missing.from("zz")
    hit = list.find(getview(missing))
    print(hit.idx)
    print(hit.err)

    hit = list.find("aa")
    print(hit.idx)
    print(hit.err)
    hit = list.find_next("aa", 1)
    print(hit.idx)
    print(hit.err)
    print(list.count("aa"))
    print(list.count_from("aa", 1))
    hit = list.find("zz")
    print(hit.idx)
    print(hit.err)
    hit = list.find_next("aa", 99)
    print(hit.idx)
    print(hit.err)

    std::String got
    print(list.get(1, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.get(99, getptr(got)))

    [byte] gotb
    gotb.init(1)
    print(list.get(2, getptr(gotb)))
    print(gotb.length())
    print(getview(gotb))
    if (gotb.length() != 0) {
        gotb.uninit()
    }

    print(list.set(1, "cc"))
    print(list.set(99, "cc"))
    print(list.set(0, getview(needle)))

    print(list.insert("dd", 2))
    print(list.insert(getview(missing), 0))
    print(list.length())
    print(list.insert("xx", 99))

    print(list.erase(0))
    print(list.erase(1, 3))
    print(list.length())
    print(list.erase(99))
    print(list.erase(2, 1))
    print(list.erase(0, 99))

    std::StringList source
    source.append("one")
    source.append("two")
    print(list.from(getview(source)))
    print(list.length())
    print(list.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.get(1, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.from(getview(list)))
    print(list.length())

    view<std::StringList> empty_list = null
    print(list.from(empty_list))
    print(list.length())
    print(list.append("new"))
    print(list.length())
    print(list.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList added
    added += "aa"
    added += "bb"
    std::String addstr
    addstr.from("cc")
    added += addstr
    [byte] addbytes
    addbytes.init(2)
    addbytes[0] = 100
    addbytes[1] = 101
    added += addbytes
    print(added.length())
    print(added.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(added.get(3, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList big
    for (uint32 i = 0; i < 130; i = i + 1) {
        big.append("x")
    }
    print(big.length())
    print(big.data.length())       // 256: 128 doubled once
    print(big.from(empty_list))
    print(big.length())
    print(big.data.length())
    print(big.append("again"))
    print(big.length())
    print(big.data.length())
    big.clear()
    print(big.length())
    print(big.data.length())       // 256: clear keeps the buffer
    print(big.append("after"))
    print(big.length())
    print(big.data.length())
    big.uninit()

    list.clear()
    print(list.length())
    print(list.append("again"))
    print(list.length())

    list.uninit()
    source.uninit()
    added.uninit()
    addstr.uninit()
    addbytes.uninit()
    needle.uninit()
    missing.uninit()
    got.uninit()
    return 0
}

// ============================================================
// LIBRARY TEST (string/stringlist): StringList methods
// ============================================================
// Covers length, both from overloads, both append overloads, both
// find/find_next/count/count_from needle forms, both get overloads,
// both set overloads, both insert overloads, both erase forms,
// clearing through a null from view and clear(), the 64/128/256
// power-of-two growth, shrink_to_fit(), odd-capacity regrowth, and
// appending after clearing.
// ============================================================

import "franko/io"
import "franko/string"

// Capacity is internal. This test inspects it through one helper so the
// private-access warning is pinned once in main.warnings instead of on
// every assertion.
func list_capacity(view<std::StringList> list) -> uint32 {
    if (list == null) {
        return 0
    }
    return $(list)._data.length()
}

func main() -> int32 {
    [byte] out
    std::StringList list
    print(list.length())
    print(list.append("aa"))
    print(list.append("bb"))
    print(list.append("aa"))
    print(list.length())

    std::String needle
    needle.from("aa")
    (uint32 idx, int32 err) hit = list.find(getview(needle))
    print(hit.idx)
    print(hit.err)
    hit = list.find_next(getview(needle), 1)
    print(hit.idx)
    print(hit.err)
    print(list.count(getview(needle)))
    print(list.count_from(getview(needle), 1))
    std::String missing
    missing.from("zz")
    hit = list.find(getview(missing))
    print(hit.idx)
    print(hit.err)

    hit = list.find("aa")
    print(hit.idx)
    print(hit.err)
    hit = list.find_next("aa", 1)
    print(hit.idx)
    print(hit.err)
    print(list.count("aa"))
    print(list.count_from("aa", 1))
    hit = list.find("zz")
    print(hit.idx)
    print(hit.err)
    hit = list.find_next("aa", 99)
    print(hit.idx)
    print(hit.err)

    std::String got
    print(list.get(1, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.get(99, getptr(got)))

    [byte] gotb
    gotb.init(1)
    print(list.get(2, getptr(gotb)))
    print(gotb.length())
    print(getview(gotb))
    if (gotb.length() != 0) {
        gotb.uninit()
    }

    print(list.set(1, "cc"))
    print(list.set(99, "cc"))
    print(list.set(0, getview(needle)))

    print(list.insert("dd", 2))
    print(list.insert(getview(missing), 0))
    print(list.length())
    print(list.insert("xx", 99))

    print(list.erase(0))
    print(list.erase(1, 3))
    print(list.length())
    print(list.erase(99))
    print(list.erase(2, 1))
    print(list.erase(0, 99))

    std::StringList source
    source.append("one")
    source.append("two")
    print(list.from(getview(source)))
    print(list.length())
    print(list.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.get(1, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(list.from(getview(list)))
    print(list.length())

    view<std::StringList> empty_list = null
    print(list.from(empty_list))
    print(list.length())
    print(list.append("new"))
    print(list.length())
    print(list.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList added
    added += "aa"
    added += "bb"
    std::String addstr
    addstr.from("cc")
    added += addstr
    [byte] addbytes
    addbytes.init(2)
    addbytes[0] = 100
    addbytes[1] = 101
    added += addbytes
    print(added.length())
    print(added.get(0, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    print(added.get(3, getptr(got)))
    print(got.to(getptr(out)))
    print(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList odd
    for (uint32 i = 0; i < 41; i = i + 1) {
        odd.append("x")
    }
    print(odd.length())            // 41
    print(list_capacity(getview(odd)))       // 64
    print(odd.shrink_to_fit())     // 0
    print(list_capacity(getview(odd)))       // 41: exact fit
    print(odd.append("y"))         // 0
    print(odd.length())            // 42
    print(list_capacity(getview(odd)))       // 64: back on the power-of-two ladder
    print(odd.shrink_to_fit())     // 0
    print(list_capacity(getview(odd)))       // 42
    print(odd.append("z"))         // 0
    print(list_capacity(getview(odd)))       // 64
    odd.uninit()

    std::StringList big
    big.append("x")
    print(big.length())            // 1
    print(list_capacity(getview(big)))       // 64: initial buffer
    for (uint32 i = 1; i < 65; i = i + 1) {
        big.append("x")
    }
    print(big.length())            // 65
    print(list_capacity(getview(big)))       // 128: doubled once
    for (uint32 i = 65; i < 130; i = i + 1) {
        big.append("x")
    }
    print(big.length())            // 130
    print(list_capacity(getview(big)))       // 256: doubled again
    print(big.shrink_to_fit())
    print(list_capacity(getview(big)))       // 130: trimmed to the live count
    print(big.from(empty_list))
    print(big.length())
    print(list_capacity(getview(big)))
    print(big.append("again"))
    print(big.length())
    print(list_capacity(getview(big)))
    big.clear()
    print(big.length())
    print(list_capacity(getview(big)))       // clear keeps the list buffer
    print(big.append("after"))
    print(big.length())
    print(list_capacity(getview(big)))
    print(big.shrink_to_fit())
    print(list_capacity(getview(big)))       // 1: trimmed to one live element
    big.clear()
    print(big.length())
    print(big.shrink_to_fit())
    print(list_capacity(getview(big)))       // 0: empty list frees the buffer
    big.uninit()

    list.clear()
    print(list.length())
    print(list.append("again"))
    print(list.length())

    list.uninit()
    source.uninit()
    added.uninit()
    addstr.uninit()
    addbytes.uninit()
    needle.uninit()
    missing.uninit()
    got.uninit()
    return 0
}

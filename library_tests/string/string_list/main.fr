// ============================================================
// LIBRARY TEST (string/stringlist): StringList methods
// ============================================================
// Covers length, both from overloads, both append overloads, both
// find/find_next/count/count_from needle forms, both get overloads,
// both set overloads, both insert overloads, both erase forms,
// clearing through a null from view and clear(), the 64/128/256
// power-of-two growth, shrink_to_fit(), odd-capacity regrowth, and
// appending after clearing.
// ============================================================

import "franko/stdio"
import "franko/string"

// Capacity is internal. This test inspects it through one helper so the
// private-access warning is pinned once in main.warnings instead of on
// every assertion.
func list_capacity_0(view<std::StringList> list) -> uint32 {
    if (list == null) {
        return 0
    }
    return $(list)._data.length()
}

func test_basic() -> int32 {
    [byte] out
    std::StringList list
    stdout(list.length())
    stdout(list.append("aa"))
    stdout(list.append("bb"))
    stdout(list.append("aa"))
    stdout(list.length())

    std::String needle
    needle.from("aa")
    (uint32 idx, int32 err) hit = list.find(getview(needle))
    stdout(hit.idx)
    stdout(hit.err)
    hit = list.find_next(getview(needle), 1)
    stdout(hit.idx)
    stdout(hit.err)
    stdout(list.count(getview(needle)))
    stdout(list.count_from(getview(needle), 1))
    std::String missing
    missing.from("zz")
    hit = list.find(getview(missing))
    stdout(hit.idx)
    stdout(hit.err)

    hit = list.find("aa")
    stdout(hit.idx)
    stdout(hit.err)
    hit = list.find_next("aa", 1)
    stdout(hit.idx)
    stdout(hit.err)
    stdout(list.count("aa"))
    stdout(list.count_from("aa", 1))
    hit = list.find("zz")
    stdout(hit.idx)
    stdout(hit.err)
    hit = list.find_next("aa", 99)
    stdout(hit.idx)
    stdout(hit.err)

    std::String got
    stdout(list.get(1, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(list.get(99, getptr(got)))

    [byte] gotb
    gotb.init(1)
    stdout(list.get(2, getptr(gotb)))
    stdout(gotb.length())
    stdout(getview(gotb))
    if (gotb.length() != 0) {
        gotb.uninit()
    }

    stdout(list.set(1, "cc"))
    stdout(list.set(99, "cc"))
    stdout(list.set(0, getview(needle)))

    stdout(list.insert("dd", 2))
    stdout(list.insert(getview(missing), 0))
    stdout(list.length())
    stdout(list.insert("xx", 99))

    stdout(list.erase(0))
    stdout(list.erase(1, 3))
    stdout(list.length())
    stdout(list.erase(99))
    stdout(list.erase(2, 1))
    stdout(list.erase(0, 99))

    std::StringList source
    source.append("one")
    source.append("two")
    stdout(list.from(getview(source)))
    stdout(list.length())
    stdout(list.get(0, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(list.get(1, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(list.from(getview(list)))
    stdout(list.length())

    view<std::StringList> empty_list = null
    stdout(list.from(empty_list))
    stdout(list.length())
    stdout(list.append("new"))
    stdout(list.length())
    stdout(list.get(0, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList added
    added += "aa"
    added += "bb"
    std::String addstr
    addstr.from("cc")
    added += addstr
    [byte] addbytes
    addbytes.init(2)
    addbytes[0] = 100
    addbytes[1] = 101
    added += addbytes
    stdout(added.length())
    stdout(added.get(0, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }
    stdout(added.get(3, getptr(got)))
    stdout(got.to(getptr(out)))
    stdout(getview(out))
    if (out.length() != 0) {
        out.uninit()
    }

    std::StringList odd
    for (uint32 i = 0; i < 41; i = i + 1) {
        odd.append("x")
    }
    stdout(odd.length())            // 41
    stdout(list_capacity_0(getview(odd)))       // 64
    stdout(odd.shrink_to_fit())     // 0
    stdout(list_capacity_0(getview(odd)))       // 41: exact fit
    stdout(odd.append("y"))         // 0
    stdout(odd.length())            // 42
    stdout(list_capacity_0(getview(odd)))       // 64: back on the power-of-two ladder
    stdout(odd.shrink_to_fit())     // 0
    stdout(list_capacity_0(getview(odd)))       // 42
    stdout(odd.append("z"))         // 0
    stdout(list_capacity_0(getview(odd)))       // 64
    odd.uninit()

    std::StringList big
    big.append("x")
    stdout(big.length())            // 1
    stdout(list_capacity_0(getview(big)))       // 64: initial buffer
    for (uint32 i = 1; i < 65; i = i + 1) {
        big.append("x")
    }
    stdout(big.length())            // 65
    stdout(list_capacity_0(getview(big)))       // 128: doubled once
    for (uint32 i = 65; i < 130; i = i + 1) {
        big.append("x")
    }
    stdout(big.length())            // 130
    stdout(list_capacity_0(getview(big)))       // 256: doubled again
    stdout(big.shrink_to_fit())
    stdout(list_capacity_0(getview(big)))       // 130: trimmed to the live count
    stdout(big.from(empty_list))
    stdout(big.length())
    stdout(list_capacity_0(getview(big)))
    stdout(big.append("again"))
    stdout(big.length())
    stdout(list_capacity_0(getview(big)))
    big.clear()
    stdout(big.length())
    stdout(list_capacity_0(getview(big)))       // clear keeps the list buffer
    stdout(big.append("after"))
    stdout(big.length())
    stdout(list_capacity_0(getview(big)))
    stdout(big.shrink_to_fit())
    stdout(list_capacity_0(getview(big)))       // 1: trimmed to one live element
    big.clear()
    stdout(big.length())
    stdout(big.shrink_to_fit())
    stdout(list_capacity_0(getview(big)))       // 0: empty list frees the buffer
    big.uninit()

    list.clear()
    stdout(list.length())
    stdout(list.append("again"))
    stdout(list.length())

    list.uninit()
    source.uninit()
    added.uninit()
    addstr.uninit()
    addbytes.uninit()
    needle.uninit()
    missing.uninit()
    got.uninit()
    return 0
}

func main() -> int32 {
    test_basic();
    return 0;
}

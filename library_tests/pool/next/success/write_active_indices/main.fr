// ============================================================
// LIBRARY TEST (pool/next): write_active_indices
// ============================================================
// Allocator: std::NextAllocator
//
// Covers:
//   success path: write_active_indices(out) returns 0 and fills
//     out with the live indices (ascending index order)
//   failure paths: an uninitialized pool returns -1, a buffer
//     shorter than used() returns -1, a null buffer returns -1,
//     and an uninitialized pool after uninit returns -1
//
// Every line below is asserted exactly: status codes are int32_t
// 0 (success) / -1 (failure), and _END is 4294967295 (0xFFFFFFFF).
// ============================================================

import "franko/pool"

func main() -> int32_t {
    std::NextAllocator a;
    array<uint32_t> out;
    out.init(4);
    print(a.write_active_indices(getaddr(out)));
    print(a.init(4));
    uint32_t i = a.new_index();
    uint32_t j = a.new_index();
    uint32_t k = a.new_index();
    print(a.write_active_indices(getaddr(out)));
    print(out[0], out[1], out[2]);
    print(a.free_index(i));
    print(a.write_active_indices(getaddr(out)));
    print(out[0], out[1]);
    array<uint32_t> small;
    small.init(1);
    print(a.write_active_indices(getaddr(small)));
    print(a.write_active_indices(null));
    print(a.uninit());
    print(a.write_active_indices(getaddr(out)));
    out.uninit();
    small.uninit();
    return 0
}

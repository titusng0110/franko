// ============================================================
// LIBRARY TEST (pool/gen_next): generation
// ============================================================
// Allocator: std::GenerationalNextAllocator
//
// Covers:
//   success path: generation(idx) starts at 0 and is bumped by
//     every free_index; the counter follows the slot across
//     reuse, so (index, generation) identifies one allocation
//   failure paths: generation before init or after uninit returns
//     err -1, an out-of-range index returns err -1, and
//     a failed double release leaves the counter unchanged
//
// Every line below is asserted exactly: status codes are int32
// 0 (success) / -1 (failure), and failures are reported by err = -1.
// ============================================================

import "franko/pool"
import "franko/io"

func show_new((uint32 idx, uint32 gen, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.idx)
    }
}
func show_gen((uint32 gen, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.gen)
    }
}

func main() -> int32 {
    std::GenerationalNextAllocator a;
    show_gen(a.generation(0));
    print(a.init(3));
    (uint32 idx, uint32 gen, int32 err) i_result = a.new_index();
    uint32 i = i_result.idx;
    show_gen(a.generation(i));
    show_gen(a.generation(2));
    show_gen(a.generation(9));
    print(a.free_index(i));
    show_gen(a.generation(i));
    print(a.free_index(i));
    show_gen(a.generation(i));
    (uint32 idx, uint32 gen, int32 err) j_result = a.new_index();
    uint32 j = j_result.idx;
    print(j);
    show_gen(a.generation(j));
    print(a.free_index(j));
    show_gen(a.generation(j));
    print(a.uninit());
    show_gen(a.generation(0));
    return 0
}

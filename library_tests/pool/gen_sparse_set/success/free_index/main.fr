// ============================================================
// LIBRARY TEST (pool/gen_sparse_set): free_index
// ============================================================
// Allocator: std::GenerationalSparseSetAllocator
//
// Covers:
//   success path: free_index(idx) returns 0 and the slot comes
//     back from new_index()
//   failure paths: free_index before init returns -1, a double
//     release returns -1, a never-allocated index returns -1, an
//     out-of-range index returns -1, and release after uninit
//     returns -1
//
// Every line below is asserted exactly: status codes are int32
// 0 (success) / -1 (failure), and failures are reported by err = -1.
// ============================================================

import "franko/pool"
import "franko/io"

func show_new((uint32 idx, uint32 gen, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.idx)
    }
}

func main() -> int32 {
    std::GenerationalSparseSetAllocator a;
    print(a.free_index(0));
    print(a.init(3));
    (uint32 idx, uint32 gen, int32 err) i_result = a.new_index();
    uint32 i = i_result.idx;
    print(a.free_index(i));
    print(a.free_index(i));
    print(a.free_index(2));
    print(a.free_index(9));
    print(a.used());
    print(a.exist(i));
    show_new(a.new_index());
    print(a.used());
    print(a.uninit());
    print(a.free_index(0));
    return 0
}

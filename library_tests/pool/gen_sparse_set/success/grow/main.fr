// ============================================================
// LIBRARY TEST (pool/gen_sparse_set): grow
// ============================================================
// Allocator: std::GenerationalSparseSetAllocator
//
// Covers:
//   success path: grow(new_c) returns 0 for new_c > capacity, old
//     slots keep their indices, new slots are allocatable
//   failure paths: grow before init returns -1, grow to the same
//     capacity returns -1, grow smaller returns -1, and an
//     exhausted grown pool reports err -1
//
// Every line below is asserted exactly: status codes are int32
// 0 (success) / -1 (failure), and failures are reported by err = -1.
// ============================================================

import "franko/pool"
import "franko/io"

func show_new((uint32 idx, uint32 gen, int32 err) result) -> void {
    if (result.err != 0) {
        print(result.err)
    } else {
        print(result.idx)
    }
}

func main() -> int32 {
    std::GenerationalSparseSetAllocator a;
    print(a.grow(8));
    print(a.init(2));
    print(a.grow(2));
    print(a.grow(1));
    (uint32 idx, uint32 gen, int32 err) i_result = a.new_index();
    uint32 i = i_result.idx;
    (uint32 idx, uint32 gen, int32 err) j_result = a.new_index();
    uint32 j = j_result.idx;
    print(a.grow(5));
    print(a.capacity());
    print(a.used());
    print(a.exist(i));
    print(a.exist(j));
    show_new(a.new_index());
    show_new(a.new_index());
    show_new(a.new_index());
    show_new(a.new_index());
    print(a.grow(6));
    show_new(a.new_index());
    print(a.uninit());
    return 0
}

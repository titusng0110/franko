// ============================================================
// LIBRARY TEST (pool/sparse_set): write_active_indices
// ============================================================
// Allocator: std::SparseSetAllocator
//
// Covers:
//   success path: write_active_indices(out) returns 0 and fills
//     out with the live indices (allocation (dense) order)
//   failure paths: an uninitialized pool returns -1, a buffer
//     shorter than used() returns -1, a null buffer returns -1,
//     and an uninitialized pool after uninit returns -1
//
// Every line below is asserted exactly: status codes are int32
// 0 (success) / -1 (failure), and _END is 4294967295 (0xFFFFFFFF).
// ============================================================

import "franko/pool"

func main() -> int32 {
    std::SparseSetAllocator a;
    [uint32] out;
    out.init(4);
    print(a.write_active_indices(getptr(out)));
    print(a.init(4));
    uint32 i = a.new_index();
    uint32 j = a.new_index();
    uint32 k = a.new_index();
    print(a.write_active_indices(getptr(out)));
    print(out[0], out[1], out[2]);
    print(a.free_index(i));
    print(a.write_active_indices(getptr(out)));
    print(out[0], out[1]);
    [uint32] small;
    small.init(1);
    print(a.write_active_indices(getptr(small)));
    print(a.write_active_indices(null));
    print(a.uninit());
    print(a.write_active_indices(getptr(out)));
    out.uninit();
    small.uninit();
    return 0
}

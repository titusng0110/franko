// ============================================================
// LIBRARY TEST (os/target): portable target-selected I/O
// ============================================================
// Covers: selecting between os::win32 and os::posix intrinsics with
// #if / #else and the built-in #IS_* constants.
//
// The condition is a compile-time constant, so only the branch for the
// current target is semantically analyzed: the other platform's FFI
// functions are never verified, bridged, or emitted (their bridge
// bodies are #error on the wrong target). The program writes "hello"
// to stdout through whichever API matches the target.
// ============================================================

import "franko/os"

func main() -> int32 {
    [byte] msg;
    msg.init(5);
    msg.memcpy("hello");

    #if (#IS_WINDOWS) {
        uint64 h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
        os::win32::WriteFile(h, getptr(msg), 5, null);
    } #else #if (#IS_LINUX || #IS_MACOS) {
        os::posix::write(os::posix::STDOUT_FILENO, getptr(msg), 5);
    }

    msg.uninit();
    return 0;
}

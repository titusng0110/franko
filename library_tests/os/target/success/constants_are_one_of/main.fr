// ============================================================
// LIBRARY TEST (os/target): franko/static target constants
// ============================================================
// Covers: the injected static::IS_* constants.
//
// The compiler stamps exactly one of the three OS constants and
// exactly one of the two arch constants to 1 for the compilation
// target, and the rest to 0. Summing each group therefore yields 1 on
// every target, which keeps this fixture's expected stdout portable
// across the platforms the suite runs on.
//
// The references are compile-time constants: they fold to integer
// literals during expression lowering, so the sums fold to 1 as well.
// ============================================================

import "franko/static"
import "franko/io"

func main() -> int32 {
    int32 os_sum = static::IS_LINUX + static::IS_WINDOWS + static::IS_MACOS;
    int32 arch_sum = static::IS_X86_64 + static::IS_ARM64;
    print(os_sum);
    print(arch_sum);
    return 0;
}

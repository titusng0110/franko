// ============================================================
// FAILURE FIXTURE (os/target): assignment to a static target constant
// ============================================================
// static::IS_* are compile-time constants: references fold to integer
// literals, so assignment has no storage to write to and is rejected
// as a non-lvalue. No separate mutability rule is needed.
// ============================================================

import "franko/static"

func main() -> int32 {
    static::IS_LINUX = 1;
    return 0;
}

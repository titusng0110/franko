// ============================================================
// LIBRARY TEST (os/posix): read from stdin
// ============================================================
// Covers: os::posix::read(fd, ptr<[byte]>, count) with stdin
// fed from main.stdin ("ABC\n"). Reads up to 8 bytes, prints the
// count and the first three bytes, then writes those three bytes
// back to stdout and prints that count.
//
// `print` goes through the same OS bridge as raw fd writes, so output
// appears in program order: stdout is exactly "4\n65\n66\n67\nABC3\n"
// on every platform.
// ============================================================

import "franko/os"
import "franko/io"

func main() -> int32 {
    [byte] buf;
    buf.init(8);
    buf.memset(0);
    int64 n = os::posix::read(os::posix::STDIN_FILENO, getptr(buf), 8);
    print(n);
    uint32 i = 0;
    while (i < 3) {
        print(buf[i]);
        i = i + 1;
    }
    int64 m = os::posix::write(1, getptr(buf), 3);
    print(m);
    buf.uninit();
    return 0;
}

// ============================================================
// LIBRARY TEST (os/posix): write to stdout
// ============================================================
// Covers: import "franko/os", os::posix::STDOUT_FILENO, and
// os::posix::write(fd, addr<array<byte>>, count). The write emits
// "hello" with no newline; print(n) then emits the byte count 5,
// so stdout is exactly "hello5\n".
// ============================================================

import "franko/os"

func main() -> int32_t {
    array<byte> msg;
    msg.init(5);
    msg = "hello";
    int64_t n = os::posix::write(os::posix::STDOUT_FILENO, getaddr(msg), 5);
    print(n);
    msg.uninit();
    return 0;
}

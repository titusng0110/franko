// Failure fixture: os/posix/bad_call_arity
// os::posix::write takes exactly (int32, ptr<[byte]>, uint64);
// calling it with two arguments matches no overload.
import "franko/os"

func main() -> int32 {
    [byte] msg;
    msg.init(5);
    msg.memcpy("hello");
    os::posix::write(1, getptr(msg));
    msg.uninit();
    return 0;
}

// ============================================================
// LIBRARY TEST: franko/os — POSIX free functions
// ============================================================
// Covers os::posix::clock_gettime. Standard fds 0/1/2 are reserved
// for franko/stdio and are rejected by the bridge; read/write coverage
// is intentionally omitted here.
// Runs only on non-Windows targets.
// ============================================================

import "franko/os"
import "franko/stdio"

func main() -> int32 {
    int64 sec = 0;
    int64 nanosec = 0;
    int32 clock_status = os::posix::clock_gettime(
            os::posix::CLOCK_REALTIME,
            getmview(sec),
            getmview(nanosec)
    );
    stdout(clock_status);
    if (sec > 1700000000) {
        stdout(1);
    }
    if (nanosec >= 0 && nanosec < 1000000000) {
        stdout(2);
    }

    int64 mono_sec = 0;
    int64 mono_nanosec = 0;
    int32 mono_status = os::posix::clock_gettime(
            os::posix::CLOCK_MONOTONIC,
            getmview(mono_sec),
            getmview(mono_nanosec)
    );
    stdout(mono_status);
    if (mono_sec >= 0 && mono_nanosec >= 0 && mono_nanosec < 1000000000) {
        stdout(3);
    }

    return 0;
}

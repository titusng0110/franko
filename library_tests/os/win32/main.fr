// ============================================================
// LIBRARY TEST: franko/os — Win32 free functions
// ============================================================
// Covers the timing primitives. Standard handles are reserved for
// franko/stdio and are rejected by the bridge; ReadFile/WriteFile
// coverage is intentionally omitted here.
// Runs only on Windows targets.
// ============================================================

import "franko/os"
import "franko/stdio"

func main() -> int32 {
    int64 counter = 0;
    int64 frequency = 0;
    int32 counter_ok = os::win32::QueryPerformanceCounter(
            mview(counter)
    );
    int32 frequency_ok = os::win32::QueryPerformanceFrequency(
            mview(frequency)
    );
    uint64 filetime = os::win32::GetSystemTimePreciseAsFileTime();
    stdout(counter_ok);
    stdout(frequency_ok);
    if (counter > 0) {
        stdout(1);
    }
    if (frequency > 0) {
        stdout(2);
    }
    if (filetime > 116444736000000000) {
        stdout(3);
    }

    return 0;
}

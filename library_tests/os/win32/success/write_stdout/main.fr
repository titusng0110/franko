// ============================================================
// LIBRARY TEST (os/win32): File API via the os FFI bridge.
// ============================================================
// Windows-only: the library runner skips the win32 suite on
// non-Windows platforms. Run on Windows with:
//
//   .\library_tests\run_library_tests.ps1
//
// Covers: import "franko/os", os::win32::STD_OUTPUT_HANDLE,
// os::win32::GetStdHandle(nStdHandle) -> uint64_t (HANDLE widened),
// and os::win32::WriteFile(hFile, addr<array<byte>>, count,
// bytesWritten) -> int32_t with a null out-param.
//
// Expected stdout is exactly "hello1\n": "hello" from WriteFile (no
// newline) plus print(ok) with ok = 1.
// ============================================================

import "franko/os"

func main() -> int32_t {
    uint64_t h = os::win32::GetStdHandle(os::win32::STD_OUTPUT_HANDLE);
    array<byte> msg;
    msg.init(5);
    msg = "hello";
    int32_t ok = os::win32::WriteFile(h, getaddr(msg), 5, null);
    print(ok);
    msg.uninit();
    return 0;
}

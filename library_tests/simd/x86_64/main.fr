import "franko/stdio"
import "franko/simd"

func main() -> int32 {
    [byte, 16] a
    [byte, 16] b
    [byte, 16] indices
    uint32 i = 0
    while (i < 16) {
        a[i] = unsafe_cast<byte>(i + 1)
        b[i] = unsafe_cast<byte>(i + 1)
        indices[i] = unsafe_cast<byte>(i)
        i = i + 1
    }

    simd::x86::xor_si128(mview(b), view(a), 0, 0, 16)
    stdout(b[0])
    stdout(b[15])

    simd::x86::and_si128(mview(b), view(a), 0, 0, 16)
    simd::x86::or_si128(mview(b), view(a), 0, 0, 16)
    simd::x86::andnot_si128(mview(b), view(a), 0, 0, 16)
    simd::x86::adds_epu8(mview(b), view(a), 0, 0, 16)
    simd::x86::subs_epu8(mview(b), view(a), 0, 0, 16)
    simd::x86::max_epu8(mview(b), view(a), 0, 0, 16)
    simd::x86::min_epu8(mview(b), view(a), 0, 0, 16)
    simd::x86::shuffle_epi8(mview(b), view(indices), 0, 0, 16)

    simd::x86::aesenc_si128(mview(b), view(a), 0, 0, 16)
    simd::x86::aesdec_si128(mview(b), view(a), 0, 0, 16)
    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Integer Literal Forms
// ============================================================
// Covers: decimal, hexadecimal (0xFF and 0XFF), and binary
// (0b1010 and 0B1010) literal forms, plus the maximum
// uint64 literal.
// ============================================================

func main() -> int32 {
    int32 dec = 123;
    int32 hex_lower = 0xFF;
    int32 hex_upper_prefix = 0XFF;
    int32 bin_lower = 0b1010;
    int32 bin_upper = 0B1010;
    uint64 max_u64 = 18446744073709551615;

    stdout(dec);
    stdout(hex_lower);
    stdout(hex_upper_prefix);
    stdout(bin_lower);
    stdout(bin_upper);
    stdout(max_u64);

    return 0;
}

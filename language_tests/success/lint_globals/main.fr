import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Capability Linter Ignores Globals
// ============================================================
// The capability linter tracks function-local variables and
// parameters only. global_value is a read-only view and is exercised
// through reads in main: no per-function downgrade warning is emitted
// for it (see main.forbidden).
// ============================================================

view<[byte, 3]> global_value = [1, 2, 3]

func main() -> int32 {
    stdout($(global_value).length());
    stdout($(global_value)[0]);
    stdout($(global_value)[1]);
    stdout($(global_value)[2]);

    return 0;
}

import "franko/stdio"

func f(int32 a) -> int32 {
    stdout("i32")
    return a
}

func f(int64 b) -> int32 {
    stdout("i64")
    return 1
}

func g(int16 a) -> int32 {
    stdout("s16")
    return 0
}

func g(uint16 b) -> int32 {
    stdout("u16")
    return 0
}

func main() -> int32 {
    int32 r = f(10)
    stdout(r)
    int32 s = f(5000000000)
    stdout(s)
    g(100)
    return 0
}

import "franko/io"

// ============================================================
// LANGUAGE TEST: Forward References to Globals and Functions
// ============================================================
// Covers: function signatures and global variable declarations are
// registered before function bodies are analyzed (docs 4.4, 12.11,
// 31.4), so main can read a global variable and call a function
// declared later in the source file.
// ============================================================

func main() -> int32 {
    print(later_global)
    print(later_func(2))
    return 0
}

int32 later_global = 41

func later_func(int32 v) -> int32 {
    return v * 2
}

import "franko/io"

// ============================================================
// LANGUAGE TEST: String Basics
// ============================================================
// Covers: string literals as view<[byte, N]> values over a
// hoisted global byte array, copied into destination buffers with
// memcpy; no null terminator is appended.
// ============================================================

func main() -> int32 {
    // A string literal is a view<[byte, 5]>; memcpy its bytes.
    [byte, 6] s;
    s.memset(0);
    s.memcpy("ABCDE");

    print(s[0]);
    print(s[1]);
    print(s[2]);
    print(s[3]);
    print(s[4]);
    // s[5] must still be 0: no null terminator is appended.
    print(s[5]);

    // memcpy form with a shorter destination tail.
    [byte, 6] t;
    t.memcpy("XYZ");

    print(t[0]);
    print(t[1]);
    print(t[2]);

    return 0;
}

// ============================================================
// LANGUAGE TEST: String Basics
// ============================================================
// Covers: string literals as byte-array initializer sugar,
// per-byte UTF-8 assignment, no null terminator, and the
// declaration initializer form.
// ============================================================

func main() -> int32_t {
    // Assignment form: "ABCDE" desugars to [65, 66, 67, 68, 69].
    array<byte, 6> s;
    s.memset(0);
    s = "ABCDE";

    print(s[0]);
    print(s[1]);
    print(s[2]);
    print(s[3]);
    print(s[4]);
    // s[5] must still be 0: no null terminator is appended.
    print(s[5]);

    // Declaration initializer form.
    array<byte, 6> t = "XYZ";

    print(t[0]);
    print(t[1]);
    print(t[2]);

    return 0;
}

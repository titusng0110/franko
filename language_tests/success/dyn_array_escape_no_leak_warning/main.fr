// A local dynamic array whose owner pointer is stored in a local struct
// field is marked escaped, so the dynamic-array checker must not report a
// missing explicit uninit. The pointer never escapes into global or
// caller-owned storage, which the dangling-pointer store rule rejects.
struct Wrap {
    ptr<[int32]> p
}

func f() -> int32 {
    [int32] d
    d.init(1)
    Wrap w
    w.p = getptr(d)
    if ($(w.p).length() == 1) {
        return 0
    }
    return 1
}

func main() -> int32 {
    return f()
}

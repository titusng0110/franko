import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Structs By Value Through Functions
// ============================================================
// Covers: an assignable struct (all primitive fields) passed
// by value (the callee mutates only its copy) and returned by
// value from a function.
// ============================================================

struct Pair {
    int32 a = 0
    int32 b = 0
}

func bump(Pair p) -> void {
    p.a = p.a + 100;
    p.b = p.b + 200;
}

func make_pair(int32 seed) -> Pair {
    Pair q;
    q.a = seed;
    q.b = seed * 2;
    return q;
}

func main() -> int32 {
    Pair p;
    p.a = 1;
    p.b = 2;
    bump(p);
    stdout(p.a, end = " "); stdout(p.b);

    Pair r = make_pair(5);
    stdout(r.a, end = " "); stdout(r.b);
    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Aggregate Field Initializers on Array-Containing Types
// ============================================================
// The field-wise declaration form does not create a temporary
// value and therefore works for non-passable aggregates (here a
// struct with a dynamic array field and a tuple with a static
// array element). A non-passable struct without pointers may
// declare a custom OPERATOR_MOV for non-literal whole-value
// assignment.
// ============================================================

struct Buffer {
    int32 cap
    [byte] buf

    func OPERATOR_MOV(ptr<Buffer> self, view<Buffer> other) -> void {
        $(self).cap = $(other).cap
        return
    }
}

func main() -> int32 {
    Buffer b { cap = 20 }
    stdout(b.cap)

    Buffer empty {}
    empty.cap = 3
    stdout(empty.cap)

    (int32, [int32, 3]) t { _0 = 1 }
    stdout(t._0)

    return 0
}

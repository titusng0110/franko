import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Namespace Internal Identifier Linting
// ============================================================
// Functions and structs whose names start with '__' are internal
// to their namespace. References from the same namespace or a
// nested namespace are allowed; references from outside warn.
// ============================================================

namespace lib {
    struct __Hidden {
        int32 value = 7

        func get(view<__Hidden> self) -> int32 {
            return $(self).value
        }
    }

    func __secret() -> int32 {
        return 11
    }

    func __internal_only_helper() -> int32 {
        return 3
    }

    func public_api() -> int32 {
        return __secret() + __internal_only_helper()
    }
}

namespace lib::nested {
    func nested_api() -> int32 {
        return lib::__internal_only_helper()
    }
}

namespace other {
    func peek() -> int32 {
        return lib::__secret()
    }
}

func main() -> int32 {
    lib::__Hidden h
    stdout(h.get())
    stdout(lib::__secret())
    stdout(lib::public_api())
    stdout(lib::nested::nested_api())
    stdout(other::peek())

    return 0
}

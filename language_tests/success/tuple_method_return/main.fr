import "franko/io"

struct Box {
    int32 value = 0

    func take(view<Box> self) -> (int32 val, int32 err) {
        return (int32 val, int32 err) { val = $(self).value, err = 0 }
    }

    func handle(view<Box> self) -> (uint32 idx, uint32 gen, int32 err) {
        if ($(self).value == 42) {
            return (uint32 idx, uint32 gen, int32 err) {
                idx = 7,
                gen = 3,
                err = 0
            }
        }

        return (uint32 idx, uint32 gen, int32 err) {
            idx = 7,
            gen = 3,
            err = -1
        }
    }
}

func main() -> int32 {
    Box box { value = 42 }

    (int32 val, int32 err) taken = box.take()
    print(taken.val)
    print(taken.err)

    (uint32 idx, uint32 gen, int32 err) handle = box.handle()
    print(handle.idx)
    print(handle.gen)
    print(handle.err)

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array Literals with Constant Expression Elements
// ============================================================
// Covers: literal elements are ordinary compile-time constant
// expressions (arithmetic and shifts fold exactly like constExpr
// slots), not just bare integer literals. A literal is hoisted to
// a constant global array, so every element must be constant.
// ============================================================

func main() -> int32 {
    [int32] dyn;
    dyn.init(3);
    dyn.memcpy([5 * 2, 1 + 4, 3 * 3 + 1]);

    stdout(dyn[0]);
    stdout(dyn[1]);
    stdout(dyn[2]);

    view<[int32, 3]> t = [10 - 5, 2 * 3, 1 << 3];
    stdout($(t)[0]);
    stdout($(t)[1]);
    stdout($(t)[2]);

    dyn.uninit();
    return 0;
}

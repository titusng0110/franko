import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Syntax — Statement Separators
// ============================================================
// Covers: ';' and newlines as interchangeable statement
// separators, consecutive separators, newlines ignored inside
// parentheses, and multiple statements on one line with ';'.
// ============================================================

func main() -> int32 {
    // Newline-separated statements (no semicolons at all).
    int32 a = 1
    int32 b = 2
    stdout(a)
    stdout(b)

    // Several statements on one line separated by ';'.
    int32 c = 3; int32 d = 4; stdout(c + d)

    // Consecutive separators: ';;' and runs of blank lines.
    a = 10;;
    b = 20;


    stdout(a + b)

    // Newlines inside parentheses are ignored: a single
    // expression may span several lines.
    stdout(
        a
        +
        b
    )

    // Multi-line argument list in a stdout call.
    stdout(c, end = " "); stdout(d)

    // A trailing separator before the closing brace is fine.
    stdout(a);

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array Parameters via ptr<[T]>
// ============================================================
// Covers: passing arrays to functions through ptr<[T]>
// and ptr<[T, N]> parameters with getptr(array) at the
// call site; the callee writes through $(p)[i].
// ============================================================

func fill_dynamic(ptr<[int32]> p) -> void {
    $(p)[0] = 11;
    $(p)[1] = 22;
    $(p)[2] = 33;
    $(p)[3] = 44;
}

func fill_static(ptr<[int32, 8]> p) -> void {
    $(p)[0] = 5;
    $(p)[7] = 9;
}

func main() -> int32 {
    [int32] xs;
    xs.init_zero(4);
    fill_dynamic(getptr(xs));
    stdout(xs[0], end = " "); stdout(xs[1], end = " "); stdout(xs[2], end = " "); stdout(xs[3]);

    [int32, 8] grid;
    fill_static(getptr(grid));
    stdout(grid[0], end = " "); stdout(grid[7]);

    xs.uninit();
    return 0;
}

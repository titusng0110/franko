import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Dynamic Array Lifecycle
// ============================================================
// Covers: init, init_zero (prints elements to prove zeroing),
// resize to a larger size (old and new positions), and uninit.
// ============================================================

func main() -> int32 {
    [int32] xs;
    xs.init(4);
    xs[0] = 10;
    xs[1] = 11;
    xs[2] = 12;
    xs[3] = 13;

    // init_zero allocates zeroed element storage
    [int32] zs;
    zs.init_zero(3);
    stdout(zs[0], end = " "); stdout(zs[1], end = " "); stdout(zs[2]);

    // resize larger: old positions keep their values
    xs.resize(6);
    xs[4] = 14;
    xs[5] = 15;
    stdout(xs[0], end = " "); stdout(xs[1], end = " "); stdout(xs[2], end = " "); stdout(xs[3]);
    stdout(xs[4], end = " "); stdout(xs[5]);

    xs.uninit();
    zs.uninit();

    return 0;
}

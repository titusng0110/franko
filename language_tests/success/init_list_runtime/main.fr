// ============================================================
// LANGUAGE TEST: Initializer Lists with Runtime Elements
// ============================================================
// Covers: initializer elements are ordinary runtime
// expressions (variables, arithmetic, function calls), not
// restricted to compile-time constants.
// ============================================================

func twice(int32_t n) -> int32_t {
    return n * 2;
}

func main() -> int32_t {
    int32_t v = 5;

    array<int32_t> dyn;
    dyn(3);
    dyn = [v, v * 10 + 1, twice(v)];

    print(dyn[0]);
    print(dyn[1]);
    print(dyn[2]);

    dyn.uninit();
    return 0;
}

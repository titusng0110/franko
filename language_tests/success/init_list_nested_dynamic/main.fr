import "franko/io"

// ============================================================
// LANGUAGE TEST: Nested Array Literals with Dynamic Arrays
// ============================================================
// Covers: a nested literal is static at every level, so its rows
// cannot fill dynamic rows directly; copy row by row. The outer
// and inner dynamic arrays are initialized explicitly first, and
// uninit runs inner arrays first, then the outer array.
// ============================================================

func main() -> int32 {
    [[int32]] matrix;

    matrix(2);
    matrix[0](3);
    matrix[1](3);

    matrix[0].memcpy([1, 2, 3]);
    matrix[1].memcpy([4, 5, 6]);

    print(matrix[0][0], " "); print(matrix[0][1], " "); print(matrix[0][2]);
    print(matrix[1][0], " "); print(matrix[1][1], " "); print(matrix[1][2]);

    matrix[0].uninit();
    matrix[1].uninit();
    matrix.uninit();

    return 0;
}

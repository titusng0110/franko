// ============================================================
// LANGUAGE TEST: Initializer Lists on Nested Dynamic Arrays
// ============================================================
// Covers: doc 22.8 (and example 32.7) — initializer lists assign
// elements but never allocate dynamic array storage at any level;
// the outer and inner dynamic arrays are initialized explicitly
// first, the nested list lowers to indexed assignments, and uninit
// runs inner arrays first, then the outer array.
// ============================================================

func main() -> int32_t {
    array<array<int32_t>> matrix;

    matrix(2);
    matrix[0](3);
    matrix[1](3);

    matrix = [
        [1, 2, 3],
        [4, 5, 6]
    ];

    print(matrix[0][0], matrix[0][1], matrix[0][2]);
    print(matrix[1][0], matrix[1][1], matrix[1][2]);

    matrix[0].uninit();
    matrix[1].uninit();
    matrix.uninit();

    return 0;
}

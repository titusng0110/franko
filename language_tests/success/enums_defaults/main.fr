import "franko/stdio"

enum<uint8> Status {
    spawning = 10,
    alive = 20
}

struct Entity {
    int32 id
    Status state
}

struct Wrapper {
    Entity inner
}

Status g;

[Status, 2] g_stats;

func main() -> int32 {
    Status t;
    stdout(t == Status::spawning);
    stdout(g == Status::spawning);

    Entity e;
    stdout(e.state == Status::spawning);

    Wrapper w;
    stdout(w.inner.state == Status::spawning);

    [Status, 2] local_stats;
    stdout(local_stats[0] == Status::spawning);
    stdout(local_stats[1] == Status::spawning);

    [Status] dyn;
    dyn.init(2);
    stdout(dyn[0] == Status::spawning);
    stdout(dyn[1] == Status::spawning);
    dyn.uninit();

    [Status] dynz;
    dynz.init_zero(2);
    stdout(dynz[0] == Status::spawning);
    stdout(dynz[1] == Status::spawning);
    dynz.resize(3);
    stdout(dynz[2] == Status::spawning);
    dynz.uninit();

    stdout(g_stats[0] == Status::spawning);
    stdout(g_stats[1] == Status::spawning);
    return 0;
}

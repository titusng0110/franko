import "franko/io"

// ============================================================
// LANGUAGE TEST: Arrays, Structs, and Initializers
// ============================================================
// Covers: array declarations, static/dynamic arrays, array
// initializer lists (nested), struct fields, and static arrays.
// ============================================================

struct Config {
    int32 id
    int32 size = 0
    [int32, 4] data
}

// --- Static array of bytes ---
[byte, 12] grid;

func main() -> int32 {
    // --- Static Array declaration with array literal initializer ---
    [int32, 3] staticArr;
    staticArr.memcpy([1, 2, 3]);

    // --- Dynamic Array declaration ---
    [int32] dynArr;

    // --- Array access & assignment ---
    staticArr[0] = 100;
    int32 val = staticArr[0];

    // --- Nested array literal ---
    [[int32, 2], 2] matrix;
    matrix.memcpy([[1, 2], [3, 4]]);

    // --- Struct usage ---
    Config cfg;
    cfg.id = 1;
    cfg.size = 10;
    cfg.data[0] = 11;
    cfg.data[1] = 12;

    // --- Struct field array access ---
    int32 cfgVal = cfg.data[0];

    print(val);
    print(cfgVal);

    print(val + cfgVal);
    return 0;
}

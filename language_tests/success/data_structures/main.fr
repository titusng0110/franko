import "franko/io"

// ============================================================
// LANGUAGE TEST: Arrays, Structs, and Initializers
// ============================================================
// Covers: array declarations, static/dynamic arrays, array
// initializer lists (nested), struct fields, static arrays, and
// field-wise struct declaration initialization.
// ============================================================

struct Config {
    int32 id
    int32 size = 0
    [int32, 4] data
}

// --- Static array of bytes ---
[byte, 12] grid;

func main() -> int32 {
    // --- Static Array declaration with array literal initializer ---
    [int32, 3] static_arr;
    static_arr.memcpy([1, 2, 3]);

    // --- Dynamic Array declaration ---
    [int32] dyn_arr;

    // --- Array access & assignment ---
    static_arr[0] = 100;
    int32 val = static_arr[0];

    // --- Nested array literal ---
    [[int32, 2], 2] matrix;
    matrix.memcpy([[1, 2], [3, 4]]);

    // --- Struct usage ---
    Config cfg { id = 1, size = 10 };
    cfg.data[0] = 11;
    cfg.data[1] = 12;

    // --- Struct field array access ---
    int32 cfg_val = cfg.data[0];

    print(val);
    print(cfg_val);

    print(val + cfg_val);
    return 0;
}

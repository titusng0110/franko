import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Static Array Sizes
// ============================================================
// Covers: static array sizes written as decimal, hex, binary,
// and constant expressions; element assignment and printing.
// ============================================================

func main() -> int32 {
    [int32, 1] a;
    [int32, 0x10] b;
    [int32, 0b1000] c;
    [int32, 1 + 2] d;

    a[0] = 11;

    b[0] = 21;
    b[0xF] = 22;

    c[0] = 31;
    c[0b111] = 32;

    d[0] = 41;
    d[1] = 42;
    d[2] = 43;

    stdout(a[0]);
    stdout(b[0], end = " "); stdout(b[0xF]);
    stdout(c[0], end = " "); stdout(c[0b111]);
    stdout(d[0], end = " "); stdout(d[1], end = " "); stdout(d[2]);

    return 0;
}

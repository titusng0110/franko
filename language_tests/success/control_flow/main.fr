import "franko/io"

// ============================================================
// LANGUAGE TEST: Control Flow
// ============================================================
// Covers: if, else, while, for (C-style headers), return, and
// the semantics of braceless bodies (implicit block wrapping).
// ============================================================

func main() -> int32 {
    int32 sum = 0;

    // --- If / Else ---
    if (sum == 0) {
        sum = sum + 1;
    } else {
        sum = sum + 2;
    }

    // --- Braceless body (implicit block) ---
    if (sum != 0) sum = sum + 10;

    // --- While loop ---
    int32 i = 0;
    while (i < 5) {
        sum = sum + i;
        i = i + 1;
    }

    // --- For loop (all parts) ---
    for (int32 j = 0; j < 3; j = j + 1) {
        sum = sum + 100;
    }

    // --- For loop (optional init) ---
    for (; i < 6; i = i + 1) {
        sum = sum + 1;
    }

    // --- For loop (optional update) ---
    for (i = 0; i < 2;) {
        sum = sum + 1;
        i = i + 1;
    }

    // --- For loop (braceless body) ---
    for (i = 0; i < 1; i = i + 1) sum = sum + 1;

    print(sum);
    return 0;
}

// --- Void return function ---
func voidCheck() -> void {
    print(99);
    return;
}

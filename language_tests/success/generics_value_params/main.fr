import "franko/stdio"

#generic struct Buffer<typename T, int32 N> {
    [T, N] data
    int32 count = N
}

#generic func local_size<int32 N>() -> uint32 {
    [int32, N] local
    local.memset(0)
    return local.length()
}

func main() -> int32 {
    Buffer<int32, 1 + 2> b
    stdout(b.count)
    stdout(b.data.length())
    stdout(local_size<4>())
    return 0
}

// ============================================================
// LANGUAGE TEST: compile-time reflection predicates
// ============================================================
// Covers: static::is_primitive, is_memcpy_safe, is_trivial, is_memset_safe,
// is_same_type, what_type, strcmp, panic, is_matchable, is_comparable,
// is_same_type_assignable, and is_passable_by_value.
//
// Point declares OPERATOR_EQ, OPERATOR_LT, and OPERATOR_MOV; Plain has
// only primitive fields; WithDefault has a field default; HasDyn holds
// a dynamic array. Pointers, dynamic arrays, and static arrays cover
// the remaining type shapes.
// ============================================================

import "franko/static"
import "franko/io"

struct Point {
    int32 x
    int32 y

    func OPERATOR_EQ(view<Point> self, view<Point> other) -> uint8 {
        return $(self).x == $(other).x && $(self).y == $(other).y
    }

    func OPERATOR_LT(view<Point> self, view<Point> other) -> uint8 {
        return $(self).x < $(other).x
    }

    func OPERATOR_MOV(ptr<Point> self, view<Point> other) -> void {
        $(self).x = $(other).x
        $(self).y = $(other).y
    }
}

struct Plain {
    int32 x
    int32 y
}

struct WithDefault {
    int32 x = 5
}

struct HasDyn {
    [int32] xs
}

struct HasStaticArray {
    [int32, 3] values
}

func main() -> int32 {
    int32 i = 1
    Point p
    Plain q
    WithDefault d
    HasDyn h
    HasStaticArray hsa
    ptr<int32> ip = null
    [int32, 3] sa
    [int32] da

    print(static::is_primitive(i));
    print(static::is_primitive(p));

    print(static::is_memcpy_safe(p));
    print(static::is_memcpy_safe(da));

    print(static::is_trivial(i));
    print(static::is_trivial(p));
    print(static::is_trivial(d));
    print(static::is_trivial(ip));

    print(static::is_memset_safe(i));
    print(static::is_memset_safe(p));
    print(static::is_memset_safe(d));
    print(static::is_memset_safe(ip));

    print(static::is_same_type(i, i));
    print(static::is_same_type(i, sa));

    print(static::what_type(i));

    print(static::strcmp("abc", "abd"));
    print(static::strcmp("abc", "abc"));
    print(static::strcmp("abd", "abc"));

    print(static::is_matchable(i));
    print(static::is_matchable(ip));
    print(static::is_matchable(p));
    print(static::is_matchable(q));

    print(static::is_comparable(i));
    print(static::is_comparable(p));
    print(static::is_comparable(ip));
    print(static::is_comparable(sa));

    print(static::is_same_type_assignable(i));
    print(static::is_same_type_assignable(ip));
    print(static::is_same_type_assignable(q));
    print(static::is_same_type_assignable(d));
    print(static::is_same_type_assignable(h));

    print(static::is_passable_by_value(i));
    print(static::is_passable_by_value(ip));
    print(static::is_passable_by_value(q));
    print(static::is_passable_by_value(hsa));
    print(static::is_passable_by_value(da));

    static_if (0) {
        static::panic("unreachable");
    }

    return 0;
}

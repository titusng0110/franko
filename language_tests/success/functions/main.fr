// ============================================================
// LANGUAGE TEST: Functions
// ============================================================
// Covers: function declarations, parameters, return types,
// recursion, and void functions.
// ============================================================

// --- Basic function with primitive parameters ---
func add(int32 a, int32 b) -> int32 {
    return a + b;
}

// --- Function with void return type ---
func voidFunc() -> void {
    print(2);
}

// --- Recursive function ---
func factorial(int32 n) -> int32 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// --- Function with struct parameter ---
struct Point {
    int32 x
    int32 y
}

// Note: Struct parameters are allowed if fields are assignable.
func getSum(Point p) -> int32 {
    return p.x + p.y;
}

// --- Function with pointer parameter ---
func processRef(ptr<int32> p) -> int32 {
    return $(p);
}

func main() -> int32 {
    int32 result = add(1, 2);

    Point p;
    p.x = 3;
    p.y = 4;
    result = result + getSum(p);

    result = result + factorial(3);

    int32 val = 100;
    result = result + processRef(getptr(val));

    voidFunc();

    print(result);
    print(result);
    return 0;
}

// ============================================================
// LANGUAGE TEST: pointer storage is null-initialized
// ============================================================
// Covers: ptr/mview/view variables, pointer struct fields, pointer
// tuple elements, pointer static-array elements, pointer dynamic-array
// elements after init and growing resize, and nested pointers.
// ============================================================

import "franko/io"

struct Holder {
    view<int32> p
    mview<int32> m
    view<int32> v
}

func main() -> int32 {
    ptr<int32> p
    mview<int32> m
    view<int32> v
    print(p == null)
    print(m == null)
    print(v == null)

    Holder h
    print(h.p == null)
    print(h.m == null)
    print(h.v == null)

    (view<int32> link, int32 value) t
    print(t.link == null)

    [view<int32>, 3] ps
    print(ps[0] == null)
    print(ps[1] == null)
    print(ps[2] == null)

    [view<int32>] dps
    dps.init(2)
    dps.resize(4)
    print(dps[0] == null)
    print(dps[1] == null)
    print(dps[2] == null)
    print(dps[3] == null)
    dps.uninit()

    ptr<ptr<int32>> pp
    print(pp == null)

    return 0
}

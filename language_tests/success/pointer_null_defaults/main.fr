// ============================================================
// LANGUAGE TEST: pointer storage is null-initialized
// ============================================================
// Covers: ptr/mview/view locals, read-only view globals, array
// pointer locals, and stacked pointers. Aggregates cannot hold
// pointers, so only direct pointer values and stacks are tested.
// ============================================================

import "franko/stdio"

view<int32> g_view

func main() -> int32 {
    ptr<int32> p
    mview<int32> m
    view<int32> v
    stdout(p == null)
    stdout(m == null)
    stdout(v == null)

    stdout(g_view == null)

    ptr<[int32]> ap
    mview<[int32]> am
    view<[int32]> av
    stdout(ap == null)
    stdout(am == null)
    stdout(av == null)

    ptr<view<int32>> pp
    stdout(pp == null)

    view<ptr<int32>> vp
    stdout(vp == null)

    return 0
}

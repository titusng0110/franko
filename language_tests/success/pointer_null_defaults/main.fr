// ============================================================
// LANGUAGE TEST: pointer storage is null-initialized
// ============================================================
// Covers: ptr/mview/view variables, pointer struct fields, pointer
// tuple elements, pointer static-array elements, pointer dynamic-array
// elements after init and growing resize, and nested pointers.
// ============================================================

import "franko/stdio"

struct Holder {
    view<int32> p
    mview<int32> m
    view<int32> v
}

func main() -> int32 {
    ptr<int32> p
    mview<int32> m
    view<int32> v
    stdout(p == null)
    stdout(m == null)
    stdout(v == null)

    Holder h
    stdout(h.p == null)
    stdout(h.m == null)
    stdout(h.v == null)

    (view<int32> link, int32 value) t
    stdout(t.link == null)

    [view<int32>, 3] ps
    stdout(ps[0] == null)
    stdout(ps[1] == null)
    stdout(ps[2] == null)

    [view<int32>] dps
    dps.init(2)
    dps.resize(4)
    stdout(dps[0] == null)
    stdout(dps[1] == null)
    stdout(dps[2] == null)
    stdout(dps[3] == null)
    dps.uninit()

    ptr<ptr<int32>> pp
    stdout(pp == null)

    return 0
}

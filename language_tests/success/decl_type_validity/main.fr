import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Declaration Type Validity
// ============================================================
// Covers: every valid declared variable type form from doc 30:
// struct variable, dynamic array of struct, static array,
// nested static arrays, ptr<T>, and
// ptr<[T]>. Each variable is assigned and read.
// ============================================================

struct X {
    int32 n
    int16 m
}

func main() -> int32 {
    // Struct variable (all fields assignable -> struct is assignable).
    X s;
    s.n = 11;
    s.m = 22;

    // Dynamic array of a struct type.
    [X] xs;
    xs.init_zero(3);
    xs[1].n = 33;

    // Static array of uint8 with size 64.
    [uint8, 64] bytes;
    bytes.memset(5);
    bytes[63] = 9;

    // Nested static array: [[byte, 20], 12].
    [[byte, 20], 12] grid;
    grid.memset(1);
    grid[11][19] = 4;

    // Pointer of a primitive.
    int32 v = 77;
    ptr<int32> p;
    p = getptr(v);
    $(p) = 88;

    // Pointer of a dynamic array type.
    [int32] dyn;
    dyn.init_zero(2);
    ptr<[int32]> ap;
    ap = getptr(dyn);
    $(ap)[1] = 55;

    stdout(s.n);
    stdout(s.m);
    stdout(xs[1].n);
    stdout(bytes[63]);
    stdout(grid[11][19]);
    stdout($(p));
    stdout($(ap)[0]);
    stdout($(ap)[1]);

    xs.uninit();
    dyn.uninit();
    return 0;
}

// ============================================================
// LANGUAGE TEST: Type Equality - Alias Canonicalization
// ============================================================
// Covers: `int`/`int32`, `byte`/`uint8`, and `uint`/`uint32`
// are the same types after alias canonicalization (doc 29.1), so
// values flow between aliased and canonical spellings in both
// directions without conversion.
// ============================================================

func main() -> int32 {
    // int <-> int32
    int i = 42;
    int32 j = i;
    int k = j;

    // byte <-> uint8
    byte by = 200;
    uint8 u8 = by;
    byte by2 = u8;

    // uint <-> uint32
    uint u = 3000000000;
    uint32 u32 = u;
    uint u2 = u32;

    print(i);
    print(j);
    print(k);
    print(by);
    print(u8);
    print(by2);
    print(u);
    print(u32);
    print(u2);
    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Aggregate Literals
// ============================================================
// Covers struct and tuple literal expressions, shuffled field
// order, defaults, partial and empty literals, nested literals,
// view fields initialized from array literals, and view fields
// initialized with getview(...).
// ============================================================

struct Literal {
    int32 x
    int32 def = 2
}

struct Inner {
    int32 v = 7
}

struct Outer {
    Inner inner
    int32 ok = 1
}

struct ViewHolder {
    view<[int32, 3]> values
    int32 ok
}

struct PtrHolder {
    view<int32> value
}

func main() -> int32 {
    Literal a = Literal { def = 1, x = 0 }
    stdout(a.x)
    stdout(a.def)

    Literal b = Literal { x = 3 }
    stdout(b.x)
    stdout(b.def)

    Literal c = Literal {}
    stdout(c.def)

    (int32, int32) t1 = (int32, int32) { _1 = 2, _0 = 1 }
    stdout(t1._0 + t1._1)

    (int32 first, int32 second) t2 = (int32 first, int32 second) {
        first = 3,
        second = 4
    }
    stdout(t2.first + t2.second)

    (int32, int32) t3 = (int32, int32) { _1 = 5 }
    stdout(t3._1)

    (int32, int32) positional = (int32, int32) { 6, 7 }
    stdout(positional._0 + positional._1)

    (int32, int32) positional_partial = (int32, int32) { 8 }
    stdout(positional_partial._0)

    (int32, int32) positional_decl { 9, 10 }
    stdout(positional_decl._0 + positional_decl._1)

    (int32, int32) positional_partial_decl { 11 }
    stdout(positional_partial_decl._0)

    (int32 a, int32 b) t4
    (int32 p, int32 q) source = (int32 p, int32 q) { p = 6, q = 7 }
    t4 = source
    stdout(t4.a + t4.b)

    Outer o = Outer { inner = Inner { v = 42 }, ok = 5 }
    stdout(o.inner.v + o.ok)

    Literal multiline = Literal {
        x = 12,
        def = 13
    }
    stdout(multiline.x + multiline.def)

    ViewHolder h = ViewHolder { values = [1, 2, 3], ok = 1 }
    stdout($(h.values)[2] + h.ok)

    int32 n = 9
    PtrHolder ph = PtrHolder { value = getview(n) }
    stdout(ph.value != null)

    return 0
}

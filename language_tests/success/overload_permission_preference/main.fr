import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Overload Preference for Permission Downgrades
// ============================================================
// Among applicable overloads, exact pointer-permission matches win
// over downgrading ones; among the downgrading matches, the ones
// relying on the fewest downgrades win (see
// failure/pointer_permissions/overload_permission_tie for the
// ambiguous case).
// ============================================================

func f(ptr<[byte, 3]> x) -> void {
    stdout(1);
}

func f(view<[byte, 3]> x) -> void {
    stdout(2);
}

func g(mview<[byte, 3]> a, mview<[byte, 3]> b) -> void {
    stdout(3);
}

func g(mview<[byte, 3]> a, view<[byte, 3]> b) -> void {
    stdout(4);
}

func h(view<[byte, 3]> x) -> void {
    stdout(5);
}

func h(mview<[byte]> x) -> void {
    stdout(6);
}

func main() -> int32 {
    [byte, 3] buf;
    buf.memset(0);

    ptr<[byte, 3]> p = getptr(buf);
    mview<[byte, 3]> m = getmview(buf);
    view<[byte, 3]> v = getview(buf);

    f(p);
    f(m);
    f(v);
    g(p, m);
    g(p, v);
    h(m);

    return 0;
}

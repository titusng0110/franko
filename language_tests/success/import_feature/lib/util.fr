// Utilities for the import test.
//
// Demonstrates a transitive relative import: `import "deep/extra"`
// resolves to ./deep/extra.fr relative to this file's directory.
//
// A struct, a global variable, and functions exported to the importer.

import "deep/extra"

struct Point {
    int32 x = 1
    int32 y = 2
}

int32 offset = 100

func doubleIt(int32 v) -> int32 {
    return v + v
}

func makePointSum() -> int32 {
    Point p
    return p.x + p.y + offset + deepGlobal
}

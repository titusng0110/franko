// ============================================================
// Franko import feature test
// ============================================================
//
// Exercises:
//
//   - a path with a directory component:
//                           import "lib/util"  ->  lib/util.fr
//   - a string literal without prefix or extension:
//                           import "extra_calls"  ->  extra_calls.fr
//   - symbols from imported files compiled into one global AST
//   - transitive imports: lib/util.fr imports deep/extra.fr and both
//     files' symbols are visible here
//
// Expected output is in main.expected.
// ============================================================

import "lib/util"
import "extra_calls"
import "franko/io"

func main() -> int32 {
    // Symbols from lib/util.fr.
    print(offset)
    print(double_it(21))
    print(make_point_sum())

    Point p
    print(p.x)
    print(p.y)

    // Symbols from lib/deep/extra.fr (transitively imported).
    print(helper2())
    print(deep_global)

    // Symbols from extra_calls.fr.
    print(extra_helper())
    print(extra_global)

    print(deep_global + extra_global)

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Pointers — null across function boundaries
// ============================================================
// Covers:
//   - null passed to an ptr<T> parameter (callee checks p == null
//     and returns a marker)
//   - null returned from an ptr<T> function (caller sees null)
//   - p = null assignment makes a certified pointer null again
// ============================================================

func check_ptr(ptr<int32> q) -> int32 {
    if (q == null) {
        return -1
    }
    return $(q)
}

func pick_ptr(uint32 which, ptr<int32> a) -> ptr<int32> {
    if (which != 0) {
        return a
    }
    return null
}

func main() -> int32 {
    int32 x = 20

    // null as an argument: the callee checks and returns a marker.
    stdout(check_ptr(null))
    stdout(check_ptr(getptr(x)))

    // null returned from an ptr<T> function.
    ptr<int32> r1 = pick_ptr(0, getptr(x))
    stdout(r1 == null)
    ptr<int32> r2 = pick_ptr(1, getptr(x))
    stdout(r2 == null)
    if (r2 != null) {
        stdout($(r2))
    }

    // p = null makes a certified pointer null again.
    ptr<int32> p
    p = getptr(x)
    stdout(p != null)
    p = null
    stdout(p == null)

    return 0
}

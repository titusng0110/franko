import "franko/io"

// ============================================================
// LANGUAGE TEST: Methods Memory Lifecycle
// ============================================================
// Covers: doc 26.8
// Dynamic-array fields managed through methods, with setup/teardown
// pairing checked by pointer null-state checking.
// ============================================================

struct Buf {
    [int32] data
    func setup(ptr<Buf> self, uint32 n) -> int32 {
        return $(self).data.init_zero(n)
    }
    func set(ptr<Buf> self, uint32 i, int32 v) -> void {
        $(self).data[i] = v
        return
    }
    func get(ptr<Buf> self, uint32 i) -> int32 {
        return $(self).data[i]
    }
    func teardown(ptr<Buf> self) -> void {
        $(self).data.uninit()
        return
    }
}

func main() -> int32 {
    Buf b
    b.setup(3)
    b.set(0, 11)
    b.set(2, 33)
    print(b.get(0), " "); print(b.get(1), " "); print(b.get(2))
    b.teardown()
    return 0
}

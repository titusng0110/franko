// ============================================================
// LANGUAGE TEST: Methods In Namespaces
// ============================================================
// Covers: doc 26.9
// Struct methods declared in a namespace, called from global scope,
// with qualified struct types in method signatures and callers.
// ============================================================

namespace util {
    struct Counter {
        int32 n = 0
        func bump(ptr<Counter> self) -> void {
            $(self).n = $(self).n + 1
            return
        }
        func value(ptr<Counter> self) -> int32 {
            return $(self).n
        }
    }
}

func readIt(ptr<util::Counter> p) -> int32 {
    return $(p).value()
}

func main() -> int32 {
    util::Counter c
    c.bump()
    c.bump()
    print(c.value())
    print(readIt(getptr(c)))
    ptr<util::Counter> q
    q = getptr(c)
    print($(q).value())
    return 0
}

// ============================================================
// LANGUAGE TEST: #what_type spellings
// ============================================================
// Covers: canonical type spellings from SemanticType.mangleKey() for
// primitive aliases, arrays, pointers, structs, qualified structs, and
// string views. Spellings have no spaces after commas and match the
// function signature hashing keys. The result is a real read-only view
// backed by immutable static storage, and it is also a compile-time
// string that can feed #strcmp.
// ============================================================

import "franko/stdio"

namespace a {
    namespace b {
        struct Point {
            int32 x
        }
    }
}

func main() -> int32 {
    int i = 1
    byte b = 2
    uint u = 3
    [int32, 3] sa
    [int32] da
    ptr<int32> ip = null
    view<[byte, 5]> text = "hello"
    a::b::Point p

    stdout(#what_type(i));
    stdout(#what_type(b));
    stdout(#what_type(u));
    stdout(#what_type(sa));
    stdout(#what_type(da));
    stdout(#what_type(ip));
    stdout(#what_type(text));
    stdout(#what_type(p));

    stdout(#strcmp(#what_type(i), "int32"));
    stdout(#strcmp("int32", #what_type(i)));
    stdout(#strcmp(#what_type(i), #what_type(i)));
    stdout(#strcmp(#what_type(i), "int64"));

    #if (#strcmp(#what_type(i), "int32") == 0) {
        stdout("int32 branch");
    } #else {
        stdout("wrong branch");
    }

    return 0;
}

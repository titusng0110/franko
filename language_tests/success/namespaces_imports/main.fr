import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Namespaces and Print Statements
// ============================================================
// Covers: namespace declarations, qualified names (a::b),
// unqualified references inside namespaces, the dedicated
// print statement, and aggregate literals.
// ============================================================

// --- Namespace declaration ---
namespace math {
    int32 scale = 10

    struct Vec2 {
        int32 x
        int32 y
    }

    func scale_up(int32 v) -> int32 {
        return v * scale
    }
}

// --- Global functions and variables ---
int32 global_offset = 100;

func main() -> int32 {
    // --- Print statements (dedicated statement, not a function) ---
    stdout(123);
    stdout(1, end = " "); stdout(2, end = " "); stdout(3);
    stdout();

    // --- Namespace member access ---
    stdout(math::scale);
    stdout(math::scale_up(5));

    // --- Qualified struct references and aggregate literals ---
    math::Vec2 p = math::Vec2 { x = 10, y = 20 };
    stdout(p.x + p.y);

    // --- Field-wise declaration initialization ---
    math::Vec2 origin { x = 1, y = 2 };
    stdout(origin.x + origin.y);

    // --- Global variables ---
    stdout(global_offset);

    return 0;
}

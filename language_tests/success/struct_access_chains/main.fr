import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Struct Member Access Chains
// ============================================================
// Covers: s.field on a local, $(p).field (assigned through),
// xs[i].field on a static array of structs, dynamic array of
// structs, and ptr(s.field) used to write a field through its
// pointer. No aggregate holds a pointer.
// ============================================================

struct Cell {
    int32 v = 0
}

func main() -> int32 {
    // s.field on a local struct.
    Cell s;
    s.v = 1;
    stdout(s.v);

    // $(p).field, assigned through.
    ptr<Cell> p;
    p = ptr(s);
    $(p).v = 10;
    stdout($(p).v);

    // Dynamic array of structs: element field access.
    [Cell] chain;
    chain.init(2);
    chain[0].v = 100;
    chain[1].v = 200;
    chain[1].v = 222;
    stdout(chain[0].v, end = " "); stdout(chain[1].v);
    chain.uninit();

    // xs[i].field on a static array of structs.
    [Cell, 3] xs;
    xs[0].v = 5;
    xs[1].v = 6;
    xs[2].v = 7;
    stdout(xs[0].v, end = " "); stdout(xs[1].v, end = " "); stdout(xs[2].v);

    // ptr(s.field): write the field through its pointer.
    ptr<int32> fa;
    fa = ptr(s.v);
    $(fa) = 42;
    stdout(s.v);

    // ptr of an array-element field.
    ptr<int32> fa2;
    fa2 = ptr(xs[2].v);
    $(fa2) = 77;
    stdout(xs[2].v);

    return 0;
}

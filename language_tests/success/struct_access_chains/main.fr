// ============================================================
// LANGUAGE TEST: Struct Member Access Chains
// ============================================================
// Covers: s.field on a local, $(p).field (assigned through),
// $(a.next).field (an ptr-typed field dereferenced then a
// field accessed), xs[i].field on a static array of structs, and
// getptr(s.field) used to write a field through its pointer.
// ============================================================

struct Link {
    ptr<Link> next
    int32_t val
}

struct Cell {
    int32_t v = 0
}

func main() -> int32_t {
    // s.field on a local struct.
    Cell s;
    s.v = 1;
    print(s.v);

    // $(p).field, assigned through.
    ptr<Cell> p;
    p = getptr(s);
    $(p).v = 10;
    print($(p).v);

    // $(a.next).field: dereference an ptr-typed field, then
    // access a field of the struct it points to.
    Link l1;
    Link l2;
    l1.val = 100;
    l2.val = 200;
    l1.next = getptr(l2);
    $(l1.next).val = 222;
    print(l1.val, $(l1.next).val);

    // xs[i].field on a static array of structs.
    array<Cell, 3> xs;
    xs[0].v = 5;
    xs[1].v = 6;
    xs[2].v = 7;
    print(xs[0].v, xs[1].v, xs[2].v);

    // getptr(s.field): write the field through its pointer.
    ptr<int32_t> fa;
    fa = getptr(s.v);
    $(fa) = 42;
    print(s.v);

    // getptr of an array-element field.
    ptr<int32_t> fa2;
    fa2 = getptr(xs[2].v);
    $(fa2) = 77;
    print(xs[2].v);

    return 0;
}

import "franko/io"

// ============================================================
// LANGUAGE TEST: Array Literals with Static Array Targets
// ============================================================
// Covers: array literals cannot initialize or assign arrays
// (they are view values); copy the elements with memcpy.
// A shorter literal copies a prefix and leaves the rest untouched;
// memcpy copies min(source, target).
// ============================================================

func main() -> int32 {
    // Full-length copy form.
    [int32, 3] a;
    a.memcpy([10, 20, 30]);

    print(a[0]);
    print(a[1]);
    print(a[2]);

    // Partial copy: [7, 8] copies a[0] and a[1].
    [int32, 4] xs;
    xs.memset(0);
    xs.memcpy([7, 8]);

    print(xs[0]);
    print(xs[1]);
    print(xs[2]);
    print(xs[3]);

    return 0;
}

import "franko/stdio"

func pick(uint8 v) -> int32 {
    return 1
}

func pick(int32 v) -> int32 {
    return 2
}

func pick(int64 v) -> int32 {
    return 3
}

#generic struct Holder<typename T> {
    T value
}

func main() -> int32 {
    stdout(pick(#is_primitive(int32)))
    stdout(pick(#strcmp("a", "b")))
    stdout(pick(#IS_LINUX))

    Holder<int32> h
    h.value = 1
    return 0
}

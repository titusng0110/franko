import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Static-to-Dynamic Array Pointer View Decay
// ============================================================
// Covers the unidirectional implicit/explicit conversion
// mview<[T,N]> / view<[T,N]> -> mview<[T]> /
// view<[T]>, including permission downgrades combined in
// the same step (ptr<[T,N]> -> mview<[T]> ->
// view<[T]>). Decay is representation-preserving: both sides are a
// Franko_Fat_Pointer<T>, and the value keeps mode 2 (static array)
// with its original count N, so no descriptor is built and the same
// storage is indexed through checked bounds. .init/.uninit/.resize
// stay blocked on the result (see failure/array_view_decay). T may
// itself be a static or dynamic array; only the outermost dimension
// decays.
// ============================================================

func take_view(view<[int32]> v) -> uint32 {
    return $(v).length();
}

func take_mview(mview<[int32]> m) -> uint32 {
    return $(m).length();
}

func f(view<[int32, 4]> x) -> int32 {
    return $(x)[0] - 9;
}

func f(view<[int32]> x) -> int32 {
    return 2;
}

[int32, 3] global_xs;
mview<[int32]> global_m = getmview(global_xs);

func main() -> int32 {
    [int32, 4] xs;
    xs[0] = 10;
    xs[1] = 20;
    xs[2] = 30;
    xs[3] = 40;

    // implicit decay, same permission
    mview<[int32]> m = getmview(xs);
    view<[int32]> v = getview(xs);
    stdout($(m).length());
    stdout($(v)[2]);

    // writes through the decayed mview hit the original storage
    $(m)[1] = 99;
    stdout(xs[1]);

    // downgrade combos from a ptr source
    ptr<[int32, 4]> p = getptr(xs);
    mview<[int32]> m2 = p;
    view<[int32]> v2 = p;
    stdout($(m2)[0]);
    stdout($(v2).length());

    // argument conversions
    stdout(take_view(p));
    stdout(take_mview(p));
    stdout(take_view(m));
    stdout(take_view(v));

    // return conversion of a non-literal decayed view is rejected by
    // DanglingPointerChecker (see failure/dangling_pointer/
    // return_decayed_parameter.fr); this fixture only covers the
    // argument and assignment conversions that remain safe here.

    // explicit casts, including combos
    view<[int32]> c = cast<view<[int32]>>(getview(xs));
    mview<[int32]> c2 = cast<mview<[int32]>>(p);
    view<[int32]> c3 = cast<view<[int32]>>(p);
    stdout($(c)[0]);
    stdout($(c2)[3]);
    stdout($(c3).length());

    // T can be a static array: outermost dimension only
    [[int32, 2], 3] g;
    g[0][0] = 1;
    g[2][1] = 6;
    view<[[int32, 2]]> gv = getview(g);
    stdout($(gv).length());
    stdout($(gv)[2][1]);
    stdout($(gv)[0].length());

    // T can be a dynamic array
    [[int32], 2] dg;
    dg[0].init(2);
    dg[1].init(2);
    mview<[[int32]]> dgv = cast<mview<[[int32]]>>(getmview(dg));
    $(dgv)[0][0] = 5;
    stdout(dg[0][0]);
    stdout($(dgv)[1].length());

    // overload preference: exact wins, downgrade beats decay
    stdout(f(getview(xs)));
    stdout(f(getmview(xs)));
    stdout(take_view(getmview(xs)));

    // decay inside a while condition: no temporary descriptor is built
    uint32 i = 0;
    while (take_view(getview(xs)) == 4 && i < 2) {
        i += 1;
    }
    stdout(i);

    // decay in a global initializer
    global_xs[0] = 7;
    $(global_m)[0] = 8;
    stdout(global_xs[0]);
    stdout($(global_m).length());

    return 0;
}

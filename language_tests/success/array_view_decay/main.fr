// ============================================================
// LANGUAGE TEST: Static-to-Dynamic Array Pointer View Decay
// ============================================================
// Covers the unidirectional implicit/explicit conversion
// mview<[T,N]> / view<[T,N]> -> mview<[T]> /
// view<[T]>, including permission downgrades combined in
// the same step (ptr<[T,N]> -> mview<[T]> ->
// view<[T]>). The compiler secretly constructs a
// Franko_Dynamic_Array descriptor (Franko_Borrowed_Dynamic_Array)
// over the static storage; .init/.uninit/.resize stay blocked on
// the result (see failure/array_view_decay). T may itself be a
// static or dynamic array; only the outermost dimension decays.
// ============================================================

func take_view(view<[int32]> v) -> uint32 {
    return $(v).length();
}

func take_mview(mview<[int32]> m) -> uint32 {
    return $(m).length();
}

func ret_decay(mview<[int32, 4]> m) -> view<[int32]> {
    return m;
}

func f(view<[int32, 4]> x) -> int32 {
    return $(x)[0] - 9;
}

func f(view<[int32]> x) -> int32 {
    return 2;
}

[int32, 3] G_XS;
mview<[int32]> G_M = getmview(G_XS);

func main() -> int32 {
    [int32, 4] xs;
    xs[0] = 10;
    xs[1] = 20;
    xs[2] = 30;
    xs[3] = 40;

    // implicit decay, same permission
    mview<[int32]> m = getmview(xs);
    view<[int32]> v = getview(xs);
    print($(m).length());
    print($(v)[2]);

    // writes through the decayed mview hit the original storage
    $(m)[1] = 99;
    print(xs[1]);

    // downgrade combos from a ptr source
    ptr<[int32, 4]> p = getptr(xs);
    mview<[int32]> m2 = p;
    view<[int32]> v2 = p;
    print($(m2)[0]);
    print($(v2).length());

    // argument conversions
    print(take_view(p));
    print(take_mview(p));
    print(take_view(m));
    print(take_view(v));

    // return conversion: a converted view must not outlive its scope (the
    // same untracked dangling class as returning getview of a local), so
    // the call result is intentionally not consumed here
    ret_decay(getmview(xs));

    // explicit casts, including combos
    view<[int32]> c = cast<view<[int32]>>(getview(xs));
    mview<[int32]> c2 = cast<mview<[int32]>>(p);
    view<[int32]> c3 = cast<view<[int32]>>(p);
    print($(c)[0]);
    print($(c2)[3]);
    print($(c3).length());

    // T can be a static array: outermost dimension only
    [[int32, 2], 3] g;
    g[0][0] = 1;
    g[2][1] = 6;
    view<[[int32, 2]]> gv = getview(g);
    print($(gv).length());
    print($(gv)[2][1]);
    print($(gv)[0].length());

    // T can be a dynamic array
    [[int32], 2] dg;
    dg[0].init(2);
    dg[1].init(2);
    mview<[[int32]]> dgv = cast<mview<[[int32]]>>(getmview(dg));
    $(dgv)[0][0] = 5;
    print(dg[0][0]);
    print($(dgv)[1].length());

    // overload preference: exact wins, downgrade beats decay
    print(f(getview(xs)));
    print(f(getmview(xs)));
    print(take_view(getmview(xs)));

    // decay inside a while condition: descriptor rebuilt per iteration
    uint32 i = 0;
    while (take_view(getview(xs)) == 4 && i < 2) {
        i += 1;
    }
    print(i);

    // decay in a global initializer
    G_XS[0] = 7;
    $(G_M)[0] = 8;
    print(G_XS[0]);
    print($(G_M).length());

    return 0;
}

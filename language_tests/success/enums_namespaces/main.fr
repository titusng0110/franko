import "franko/stdio"

namespace ns {
    enum<uint8> Status {
        ok,
        err
    }
}

enum<uint8> Global {
    off,
    on
}

func main() -> int32 {
    ns::Status s = ns::Status::ok;
    stdout(s == ns::Status::ok);
    stdout(s == ns::Status::err);
    s = ns::Status::err;
    stdout(s == ns::Status::err);

    Global g = Global::on;
    stdout(g == Global::on);
    stdout(#is_enum(ns::Status));
    stdout(#what_type(s));
    return 0;
}

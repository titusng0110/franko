// ============================================================
// LANGUAGE TEST: Struct Methods Core
// ============================================================
// Covers: doc 26.1, doc 26.2, doc 26.3, doc 26.5, doc 26.7, doc 26.9
// Methods with explicit ptr<X> self, overloads, calls on variables,
// fields, array elements, and $(p) receivers, local shadowing,
// method-to-method calls, self reassignment, and pointer-only structs.
// ============================================================

struct Inner {
    int32 v = 0
    func bump(ptr<Inner> self) -> void {
        $(self).v = $(self).v + 1
        return
    }
    func get(ptr<Inner> self) -> int32 {
        return $(self).v
    }
}

struct Counter {
    int32 n = 0
    Inner inner
    func bump(ptr<Counter> self) -> void {
        $(self).n = $(self).n + 1
        return
    }
    func add(ptr<Counter> self, int32 v) -> void {
        $(self).n = $(self).n + v
        return
    }
    func add(ptr<Counter> self, int32 a, int32 b) -> void {
        $(self).n = $(self).n + a + b
        return
    }
    func get(ptr<Counter> self) -> int32 {
        return $(self).n
    }
    func doubleBump(ptr<Counter> self) -> void {
        $(self).bump()
        $(self).bump()
        return
    }
    func shadow(ptr<Counter> self) -> int32 {
        int32 n = 100
        $(self).n = 7
        return n
    }
    func bumpInner(ptr<Counter> self) -> void {
        $(self).inner.bump()
        return
    }
    func retarget(ptr<Counter> self, ptr<Counter> other) -> void {
        self = other
        $(self).n = 99
        return
    }
}

struct Big {
    [int32, 4] xs
    func set(ptr<Big> self, uint32 i, int32 v) -> void {
        $(self).xs[i] = v
        return
    }
    func get(ptr<Big> self, uint32 i) -> int32 {
        return $(self).xs[i]
    }
}

func main() -> int32 {
    Counter c
    c.bump()
    print(c.get())
    c.add(5)
    print(c.get())
    c.add(1, 2)
    print(c.get())
    c.doubleBump()
    print(c.get())
    print(c.shadow())
    print(c.get())
    c.bumpInner()
    print(c.inner.get())
    [Counter, 2] arr
    arr[0].bump()
    print(arr[0].get())
    ptr<Counter> p
    p = getptr(c)
    $(p).bump()
    print(c.get())
    Counter d
    d.n = 1
    c.retarget(getptr(d))
    print(c.get())
    print(d.get())
    Big b
    b.set(0, 11)
    b.set(3, 44)
    print(b.get(0), b.get(3))
    return 0
}

import "franko/stdio"

// ============================================================
// Franko nested namespace test
// ============================================================
//
// Exercises:
//
//   - path-header declarations:      namespace a::b { ... }
//   - nested-block declarations:     namespace a { namespace b { ... } }
//   - merging across both forms into one namespace path
//   - qualified struct types:        a::b::Point
//   - qualified variables:           a::b::limit, a::tag, m::n::p
//   - qualified calls:               a::b::add(1), a::c::describe()
//   - unqualified lookup inside a nested namespace (own namespace
//     first, then global fallback)
//   - absolute qualified references from inside a namespace
//
// Expected output is in main.expected.
// ============================================================

namespace a::b {
    struct Point {
        int32 x = 3
        int32 y = 4
    }

    int32 limit = 100

    func add(int32 v) -> int32 {
        // Unqualified: resolves to a::b::limit.
        return v + limit
    }
}

namespace a {
    int32 tag = 7

    namespace b {
        int32 extra = 5
    }

    namespace c {
        func describe() -> int32 {
            // Absolute paths from inside a namespace.
            return a::tag + a::b::limit
        }
    }
}

// The path-header form and the nested-block form below declare the
// same namespace; their contents merge into one namespace.
namespace m::n {
    int32 p = 1
}

namespace m {
    namespace n {
        int32 q = 2
    }
}

func main() -> int32 {
    // Qualified struct type at global scope.
    a::b::Point pt
    stdout(pt.x)
    stdout(pt.y)

    // Qualified variable read and write.
    stdout(a::b::limit)
    a::b::limit = 101
    stdout(a::b::limit)

    // Qualified calls, including into a merged-then-nested path.
    stdout(a::b::add(1))
    stdout(a::b::extra)
    stdout(a::tag)
    stdout(a::c::describe())

    // Merged namespace members from both declaration forms.
    stdout(m::n::p)
    stdout(m::n::q)

    return 0
}

// ============================================================
// LANGUAGE TEST: Desugaring — ndarray Type Sugar
// ============================================================
// Covers: 05-desugaring.md 5.5 and 19-arrays.md 19.2.
//   ndarray<byte, 2, 3>  desugars to  array<array<byte, 3>, 2>
// so grid[i][j] indexes i along the first dimension (2) and j along
// the second dimension (3). A constant second index of 2 is only
// legal because the inner dimension is 3.
// ============================================================

func main() -> int32_t {
    ndarray<byte, 2, 3> grid;

    // Fill with a nonconstant uint8_t value (comparison results are
    // exactly uint8_t, so they assign to byte elements).
    uint32_t i = 0;
    while (i < 2) {
        uint32_t j = 0;
        while (j < 3) {
            grid[i][j] = i < j;
            j = j + 1;
        }
        i = i + 1;
    }

    print(grid[0][0]);
    print(grid[0][1]);
    print(grid[0][2]);
    print(grid[1][0]);
    print(grid[1][1]);
    print(grid[1][2]);

    // Indexed writes with constant indexes in both positions.
    grid[0][2] = 200;
    grid[1][0] = 201;
    print(grid[0][2]);
    print(grid[1][0]);

    return 0;
}

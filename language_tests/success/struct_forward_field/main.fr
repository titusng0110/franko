// ============================================================
// LANGUAGE TEST: Struct Field Forward References
// ============================================================
// Covers: field types may reference structs declared anywhere in the
// program, including structs declared later in the file (doc 25.4);
// the backend forward-declares every struct and orders definitions
// topologically over by-value field dependencies (doc 25.11), so both
// a by-value field of a later struct and an ptr field of a later
// struct compile and work.
// ============================================================

struct Outer {
    Inner inner
    int32_t v
    ptr<Later> link
}

struct Inner {
    int32_t x = 1
}

struct Later {
    int32_t tag = 7
}

func main() -> int32_t {
    Outer o
    o.v = 3
    o.inner.x = 5

    Later l
    o.link = getptr(l)
    $(o.link).tag = 8

    print(o.inner.x)
    print(o.v)
    print($(o.link).tag)

    return 0
}

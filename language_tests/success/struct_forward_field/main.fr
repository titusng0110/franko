import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Struct Field Forward References
// ============================================================
// Covers: field types may reference structs declared anywhere in the
// program, including structs declared later in the file (doc 25.4);
// the backend forward-declares every struct and orders definitions
// topologically over by-value field dependencies (doc 25.11), so both
// a by-value field of a later struct and a dynamic-array field of a
// later struct compile and work. No aggregate holds a pointer.
// ============================================================

struct Outer {
    Inner inner
    int32 v
    [Later] links
}

struct Inner {
    int32 x = 1
}

struct Later {
    int32 tag = 7
}

func main() -> int32 {
    Outer o
    o.v = 3
    o.inner.x = 5

    o.links.init(1)
    o.links[0].tag = 8

    stdout(o.inner.x)
    stdout(o.v)
    stdout(o.links[0].tag)

    o.links.uninit()
    return 0
}

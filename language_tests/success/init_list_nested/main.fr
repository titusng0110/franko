import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Nested Array Literals
// ============================================================
// Covers: nested array literals are view<[[T, M], N]>
// values over hoisted static arrays. memcpy copies them into a
// matching static array; the receiver and the literal must have
// identical element types.
// ============================================================

func show(view<[[int32, 2]]> m) -> void {
    stdout($(m)[0][1]);
    stdout($(m)[2][0]);
}

func main() -> int32 {
    [[int32, 2], 2] matrix;
    matrix.memcpy([[1, 2], [3, 4]]);

    stdout(matrix[0][0]);
    stdout(matrix[0][1]);
    stdout(matrix[1][0]);
    stdout(matrix[1][1]);

    show([[5, 6], [7, 8], [9, 10]]);

    return 0;
}

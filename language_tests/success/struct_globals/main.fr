import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Struct Globals
// ============================================================
// Covers: a struct-typed global variable and field defaults applied
// to globals. Globals are read-only, so mutation uses a local twin.
// ============================================================

struct Conf {
    int32 w = 640
    int32 h = 480
    int64 label
}

Conf g;

func main() -> int32 {
    // Fields with defaults print their defaults.
    stdout(g.w, end = " "); stdout(g.h);
    stdout(g.label);

    // Mutable struct state lives in a local.
    Conf local;
    local.w = 800;
    local.label = 24;
    stdout(local.w, end = " "); stdout(local.label);

    return 0;
}

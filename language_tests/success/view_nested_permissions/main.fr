import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Permission Propagation Through Nested Types
// ============================================================
// Covers language reference section "Permission Propagation":
// Rule 1 (value types are transitive: a view of nested arrays
// locks the inner arrays too) and Rule 2 (permissions stop at
// pointer boundaries: the pointer slots a container holds are
// locked by the container's permission, but the memory behind
// those pointers follows each pointer's own type).
// ============================================================

func main() -> int32 {
    // Rule 2: a view of an array of mviews locks the slots, not
    // the pointees.
    [byte] a;
    a.init(2);
    [mview<[byte]>] store;
    store.init(1);
    store[0] = getmview(a);

    view<[mview<[byte]>]> v = getview(store);
    $($(v)[0])[0] = 5;
    stdout($(store[0]).length());

    // mview can overwrite the pointer slots; the extracted views stay
    // read-only (see failure/pointer_permissions/nested_inner_view_write).
    [byte] t;
    t.init(3);
    [view<[byte]>] slots;
    slots.init(1);
    mview<[view<[byte]>]> m = getmview(slots);
    $(m)[0] = getview(t);
    stdout($(slots[0]).length());

    // Rule 1: transitive locking of value-typed nesting.
    [[byte, 2], 2] grid;
    grid[0].memset(1);
    grid[1].memset(2);
    view<[[byte, 2], 2]> g = getview(grid);
    stdout($(g)[0][0]);
    stdout($(g)[1][1]);
    stdout($(g).length());
    stdout($(g)[0].length());

    // mview of nested arrays: both levels mutable.
    mview<[[byte, 2], 2]> gm = getmview(grid);
    $(gm)[0][0] = 9;
    $(gm)[1][1] = 8;
    stdout(grid[0][0]);
    stdout(grid[1][1]);

    return 0;
}

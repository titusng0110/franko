import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Permission Propagation Through Nested Types
// ============================================================
// Covers language reference section "Permission Propagation":
// value types are transitive (a view of nested arrays locks the
// inner arrays too) and direct pointer permissions (view is
// read-only, mview allows writes). No array holds a pointer.
// ============================================================

func main() -> int32 {
    // Direct permissions: view of an array is read-only, mview writable.
    [byte] a;
    a.init(2);
    a[0] = 5;
    a[1] = 6;
    view<[byte]> v = view(a);
    stdout($(v).length());

    [byte] t;
    t.init(3);
    mview<[byte]> m = mview(t);
    $(m)[0] = 1;
    $(m)[1] = 2;
    $(m)[2] = 3;
    stdout($(m).length());

    // Transitive locking of value-typed nesting.
    [[byte, 2], 2] grid;
    grid[0].memset(1);
    grid[1].memset(2);
    view<[[byte, 2], 2]> g = view(grid);
    stdout($(g)[0][0]);
    stdout($(g)[1][1]);
    stdout($(g).length());
    stdout($(g)[0].length());

    // mview of nested arrays: both levels mutable.
    mview<[[byte, 2], 2]> gm = mview(grid);
    $(gm)[0][0] = 9;
    $(gm)[1][1] = 8;
    stdout(grid[0][0]);
    stdout(grid[1][1]);

    a.uninit();
    t.uninit();
    return 0;
}

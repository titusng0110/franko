// Namespace feature test: library file.
//
// Demonstrates:
//
//   - a namespace declared in an imported file,
//   - qualified struct types (util::Point) in signatures,
//   - unqualified references inside the namespace resolving to the
//     namespace's own symbols first (offset, double_it),
//   - unqualified fallback to a global-namespace symbol (shared_seed).
//
// The same namespace is also declared in merge.fr; both declarations
// merge into one namespace.

namespace util {
    struct Point {
        int32 x = 1
        int32 y = 2
    }

    int32 offset = 100

    func double_it(int32 v) -> int32 {
        // Unqualified: resolves to util::offset and util::double_it.
        return v + v + offset
    }

    func make_point_sum() -> int32 {
        Point p
        return p.x + p.y + offset
    }
}

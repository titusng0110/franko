// ============================================================
// Franko namespace feature test
// ============================================================
//
// Exercises:
//
//   - namespace declarations holding structs, globals, and functions
//   - qualified struct types:   util::Point
//   - qualified variables:      util::offset
//   - qualified calls:          util::double_it(5)
//   - unqualified lookup inside a namespace (own namespace first,
//     then global fallback)
//   - merging repeated namespace declarations across imported files
//   - cross-namespace struct fields by value
//
// Expected output is in main.expected.
// ============================================================

import "lib/util"
import "merge"
import "franko/stdio"

// A global-namespace struct used by value inside a namespace struct.
struct Base {
    int32 seed = 9
}

// Unqualified inside namespace math: math::scale shadows nothing, and
// Base resolves via the global fallback.
namespace math {
    int32 scale = 3

    struct Scaled {
        Base base
        int32 factor = 2
    }

    func scale_seed() -> int32 {
        Base b
        return b.seed + scale
    }
}

// A second namespace declaring a struct with the same simple name as
// util::Point. Same-named structs in different namespaces are distinct
// types, and a by-value field may reference util::Point.
namespace other {
    struct Point {
        int32 z = 4
        util::Point inner
    }
}

int32 shared_seed = 5

func main() -> int32 {
    // Qualified struct type at global scope.
    util::Point p
    stdout(p.x)
    stdout(p.y)

    // Qualified variable assignment and references.
    stdout(util::offset)
    util::offset = 7
    stdout(util::offset)
    util::offset = 100
    stdout(util::double_it(10))
    stdout(util::make_point_sum())

    // Merged namespace member from merge.fr.
    stdout(util::triple_it(1))

    // Namespace struct used by value at global scope.
    math::Scaled s
    stdout(s.factor)
    stdout(s.base.seed)

    // Unqualified fallback inside a namespace: scale_seed sees
    // math::scale and global Base.
    stdout(math::scale_seed())

    // Global namespace still works unqualified.
    stdout(shared_seed)

    // Same-named struct in another namespace, with a by-value field
    // pointing at util::Point.
    other::Point o
    stdout(o.z)
    stdout(o.inner.x)

    return 0
}

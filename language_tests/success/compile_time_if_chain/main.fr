// ============================================================
// LANGUAGE TEST: #else #if chains and braceless bodies
// ============================================================
// The chain selects exactly one assignment for the current target.
// Braceless branches are implicitly blocked, so the declaration in the
// unselected branch never escapes (or is even analyzed).
// ============================================================

import "franko/io"

func main() -> int32 {
    int32 selected = 0;

    #if (#IS_WINDOWS) selected = 1
    #else #if (#IS_LINUX) selected = 2
    #else #if (#IS_MACOS) selected = 3
    #else selected = 4

    print(selected >= 1 && selected <= 4);

    #if (0)
        int32 hidden = 1
    #else
        print("braceless else");

    #if (0) int32 also_hidden = 2

    return 0;
}

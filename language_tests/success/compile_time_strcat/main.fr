// LANGUAGE TEST: #strcat folds multiple compile-time strings

import "franko/stdio"

func main() -> int32 {
    stdout(#strcat("ab", "cd", "ef"))
    stdout(#strcat(#what_type(int32), "_", #what_type(uint8)))
    stdout(#strcmp(#strcat("a", "b"), "ab"))
    stdout(#strcmp(#strcat("a", "b"), "ac"))

    #if (0) {
        #panic(#strcat("dead", " branch"))
    }

    view<[byte, 6]> v = #strcat("hel", "lo", "!")
    stdout($(v)[0])
    return 0
}

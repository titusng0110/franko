// LANGUAGE TEST: #strcat folds multiple compile-time strings

import "franko/io"

func main() -> int32 {
    print(#strcat("ab", "cd", "ef"))
    print(#strcat(#what_type(int32), "_", #what_type(uint8)))
    print(#strcmp(#strcat("a", "b"), "ab"))
    print(#strcmp(#strcat("a", "b"), "ac"))

    #if (0) {
        #panic(#strcat("dead", " branch"))
    }

    view<[byte, 6]> v = #strcat("hel", "lo", "!")
    print($(v)[0])
    return 0
}

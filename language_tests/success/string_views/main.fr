import "franko/stdio"

// ============================================================
// LANGUAGE TEST: String Literals as Materialized Views
// ============================================================
// Covers: a string literal materializes as a view<[byte, N]> over
// a hoisted global byte array; identical literals share one
// global; global string views; strings as function arguments;
// and strings assigned to local view slots. Views live only
// in locals, parameters, and read-only globals — never in
// aggregate storage and never as return values.
// ============================================================

view<[byte, 6]> GREETING = "global";

func blen(view<[byte, 3]> s) -> void {
    stdout($(s).length());
    stdout($(s)[0]);
}

func main() -> int32 {
    // Literals materialize when assigned to a byte view.
    view<[byte, 3]> abc = "abc";
    stdout($(abc).length());
    blen("abc");

    // The same literal text shares one hoisted global.
    view<[byte, 3]> a = "abc";
    view<[byte, 3]> b = "abc";
    stdout(a == b);

    // Global string views.
    stdout($(GREETING).length());
    stdout($(GREETING)[0]);

    // Different content: different globals.
    view<[byte, 3]> c = "xyz";
    stdout(a == c);

    // Strings assigned to local view slots.
    view<[byte, 3]> p0 = "abc";
    view<[byte, 3]> p1 = "xyz";
    stdout($(p0)[1]);
    stdout($(p1)[1]);

    return 0;
}

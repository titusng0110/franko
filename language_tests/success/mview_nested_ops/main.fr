// ============================================================
// LANGUAGE TEST: Permission Propagation Through Nested Types
// (mview: read/write to the end, allocation never)
// ============================================================
// Pins the propagation rules of section "Permission Propagation":
// ptr propagates ownership until a pointer boundary, mview
// propagates read/write until a pointer boundary, view stays
// read-only to the end. Through an mview, lifecycle intrinsics
// are blocked at *every* level — even an inner nested array's
// init/uninit/resize — while element writes, memset, memcpy and
// length() remain allowed all the way down.
// ============================================================

func main() -> int32 {
    // --- mview: element operations at every level stay allowed ---
    [[byte]] grid;
    grid.init(2);
    grid[0].init(3);
    grid[1].init(3);

    mview<[[byte]]> m = getmview(grid);
    $(m)[0][0] = 9;
    $(m)[1].memset(7);
    print($(m).length());
    print($(m)[0].length());
    print(grid[0][0]);
    print(grid[1][2]);

    // memcpy through an inner nested array is allowed: mutation
    // rights propagate to the end, unlike allocation rights.
    [byte, 3] three;
    three[0] = 1;
    three[1] = 2;
    three[2] = 3;
    $(m)[0].memcpy(getptr(three));
    print(grid[0][0]);
    print(grid[0][1]);
    print(grid[0][2]);

    // --- ptr propagates ownership to the end ---
    ptr<[[byte]]> p = getptr(grid);
    $(p)[0].uninit();
    $(p)[0].init(3);
    $(p)[0][0] = 4;
    print(grid[0][0]);

    // --- a pointer boundary resets the region: an inner ptr
    // restores full allocation rights on its pointee ---
    [byte] owned;
    owned.init(2);
    ptr<[byte]> q = getptr(owned);
    mview<ptr<[byte]>> mp = getmview(q);
    $($(mp)).uninit();
    $($(mp)).init(5);
    print($($(mp)).length());

    return 0;
}

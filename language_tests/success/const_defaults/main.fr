import "franko/stdio"

struct Inner {
    int32 n = 1
}

struct AllDefault {
    int32 a = 2
    view<int32> link
    Inner inner
    (Inner item, view<int32> link) pair
}

enum<uint8> Status {
    idle,
    busy
}

struct WithEnum {
    Status state
    Inner inner
}

func main() -> int32 {
    const AllDefault value

    stdout(value.a + value.inner.n)
    stdout(value.link == null)
    stdout(value.pair.item.n)
    stdout(value.pair.link == null)

    const WithEnum stateful
    stdout(stateful.state == Status::idle)
    stdout(stateful.inner.n)

    return 0
}

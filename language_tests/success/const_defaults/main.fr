import "franko/stdio"

struct Inner {
    int32 n = 1
}

struct AllDefault {
    int32 a = 2
    int32 tag = 0
    Inner inner
    (Inner item, Inner other) pair
}

enum<uint8> Status {
    idle,
    busy
}

struct WithEnum {
    Status state
    Inner inner
}

func main() -> int32 {
    const AllDefault value

    stdout(value.a + value.inner.n)
    stdout(value.tag == 0)
    stdout(value.pair.item.n)
    stdout(value.pair.other.n == 1)

    const WithEnum stateful
    stdout(stateful.state == Status::idle)
    stdout(stateful.inner.n)

    return 0
}

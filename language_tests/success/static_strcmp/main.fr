// ============================================================
// LANGUAGE TEST: static::strcmp
// ============================================================
// Covers: lexicographic byte comparison with negative, zero, and
// positive results, plus prefix ordering.
// ============================================================

import "franko/static"
import "franko/io"

func main() -> int32 {
    print(static::strcmp("abc", "abd"));
    print(static::strcmp("abc", "abc"));
    print(static::strcmp("abd", "abc"));
    print(static::strcmp("ab", "abc"));
    print(static::strcmp("abc", "ab"));
    print(static::strcmp("a", "b"));
    print(static::strcmp("b", "a"));

    return 0;
}

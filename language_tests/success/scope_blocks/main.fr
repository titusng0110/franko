import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Scoping — Nested Blocks
// ============================================================
// Covers: nested '{ }' blocks as statements. An inner block
// reads and mutates an outer variable; an inner-scoped variable
// is used only inside the block where it is declared.
// ============================================================

func main() -> int32 {
    int32 outer = 5

    {
        // Inner block reads the outer variable.
        stdout(outer)

        // Inner block mutates the outer variable.
        outer = outer + 10
        stdout(outer)

        // Inner-scoped variable, used only inside this block.
        int32 inner = 7
        stdout(inner)
        inner = inner + outer
        stdout(inner)
    }

    // The mutation done inside the block is visible outside.
    stdout(outer)

    // A sibling block sees the updated outer value.
    {
        stdout(outer + 1)
    }

    return 0
}

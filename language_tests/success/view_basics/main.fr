// ============================================================
// LANGUAGE TEST: View and MView Basics
// ============================================================
// Covers: getptr/getmview/getview creation, implicit permission
// downgrades on assignment and argument passing (ptr -> mview ->
// view), reads through views, writes through ptr/mview, explicit
// downgrades via cast<T>, length() through every permission, and
// nullable views. Blocked operations live in
// failure/pointer_permissions.
// ============================================================

func takePtr(ptr<array<byte, 3>> p) -> void {
    $(p)[0] = 1;
}

func takeMView(mview<array<byte, 3>> m) -> void {
    $(m)[1] = 2;
}

func takeView(view<array<byte, 3>> v) -> void {
    print($(v)[2]);
}

func main() -> int32_t {
    array<byte, 3> buf;
    buf.memset(0);

    // Creation intrinsics over storage-backed lvalues.
    ptr<array<byte, 3>> p = getptr(buf);
    mview<array<byte, 3>> m = getmview(buf);
    view<array<byte, 3>> v = getview(buf);

    // Writes through ptr and mview, reads through view.
    $(p)[0] = 5;
    $(m)[1] = 6;
    print($(v)[0]);
    print($(v)[1]);

    // Implicit downgrades on assignment.
    mview<array<byte, 3>> down1 = p;
    view<array<byte, 3>> down2 = p;
    view<array<byte, 3>> down3 = m;
    print($(down1)[0]);
    print($(down2)[1]);
    print($(down3)[2]);

    // Implicit downgrades when passing arguments.
    takePtr(p);
    takeMView(p);
    takeView(p);
    takeMView(m);
    takeView(m);
    takeView(v);
    print($(v)[0]);
    print($(v)[1]);

    // Explicit permission downgrades via cast<T>.
    view<array<byte, 3>> explicit1 = cast<view<array<byte, 3>>>(p);
    mview<array<byte, 3>> explicit2 = cast<mview<array<byte, 3>>>(p);
    view<array<byte, 3>> explicit3 = cast<view<array<byte, 3>>>(m);
    print($(explicit1)[0]);

    // length() is a read: allowed through every permission.
    print($(p).length());
    print($(m).length());
    print($(v).length());

    // Views are nullable.
    view<array<byte, 3>> nothing = null;
    print(nothing == null);

    // Reassigning a view variable is fine: the pointer variable itself
    // is owner-protected local storage.
    v = getview(buf);
    print($(v)[0]);

    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: View and MView Basics
// ============================================================
// Covers: getptr/getmview/getview creation, implicit permission
// downgrades on assignment and argument passing (ptr -> mview ->
// view), reads through views, writes through ptr/mview, explicit
// downgrades via cast<T>, length() through every permission, and
// nullable views. Blocked operations live in
// failure/pointer_permissions.
// ============================================================

func take_ptr(ptr<[byte, 3]> p) -> void {
    $(p)[0] = 1;
}

func take_mview(mview<[byte, 3]> m) -> void {
    $(m)[1] = 2;
}

func take_view(view<[byte, 3]> v) -> void {
    stdout($(v)[2]);
}

func main() -> int32 {
    [byte, 3] buf;
    buf.memset(0);

    // Creation intrinsics over storage-backed lvalues.
    ptr<[byte, 3]> p = getptr(buf);
    mview<[byte, 3]> m = getmview(buf);
    view<[byte, 3]> v = getview(buf);

    // Writes through ptr and mview, reads through view.
    $(p)[0] = 5;
    $(m)[1] = 6;
    stdout($(v)[0]);
    stdout($(v)[1]);

    // Implicit downgrades on assignment.
    mview<[byte, 3]> down1 = p;
    view<[byte, 3]> down2 = p;
    view<[byte, 3]> down3 = m;
    stdout($(down1)[0]);
    stdout($(down2)[1]);
    stdout($(down3)[2]);

    // Implicit downgrades when passing arguments.
    take_ptr(p);
    take_mview(p);
    take_view(p);
    take_mview(m);
    take_view(m);
    take_view(v);
    stdout($(v)[0]);
    stdout($(v)[1]);

    // Explicit permission downgrades via cast<T>.
    view<[byte, 3]> explicit1 = cast<view<[byte, 3]>>(p);
    mview<[byte, 3]> explicit2 = cast<mview<[byte, 3]>>(p);
    view<[byte, 3]> explicit3 = cast<view<[byte, 3]>>(m);
    stdout($(explicit1)[0]);

    // length() is a read: allowed through every permission.
    stdout($(p).length());
    stdout($(m).length());
    stdout($(v).length());

    // Views are nullable.
    view<[byte, 3]> nothing = null;
    stdout(nothing == null);

    // Reassigning a view variable is fine: the pointer variable itself
    // is owner-protected local storage.
    v = getview(buf);
    stdout($(v)[0]);

    return 0;
}

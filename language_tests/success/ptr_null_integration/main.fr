import "franko/stdio"

// ============================================================
// Franko null-for-pointers Showcase
// ============================================================
//
// Demonstrates:
//
//   - null is only valid for pointers (0 is not null)
//   - pointer declarations are guaranteed null-initialized
//   - ptr(...) certifies an pointer as non-null
//   - assignment from another pointer copies its exact null state
//   - guard refinement: deref inside if (p != null) is valid
//   - loop-guard refinement and provable null after loop exit
//   - null passed to ptr parameters
//   - local mview defaults to null
//   - equality-only pointer comparison (== and != only)
//
// Expected output is in null.expected.
// ============================================================

func take_ptr(ptr<int32> q) -> int32 {
    if (q != null) {
        return $(q)
    }

    return -1
}

func main() -> int32 {
    int32 x = 0
    int32 g_target = 0
    ptr<int32> g

    stdout(1)

    // Pointer declarations are guaranteed null-initialized.
    ptr<int32> p
    stdout(p == null)
    stdout(p != null)

    // ptr certifies the variable as non-null.
    p = ptr(x)
    stdout(p != null)

    $(p) = 42
    stdout($(p))

    // Copying a certified variable keeps it certified.
    ptr<int32> a = p
    $(a) = 7
    stdout($(a))

    // A null declaration, and a copy of it: the copy is null too.
    ptr<int32> b = null
    ptr<int32> c = b
    stdout(c == null)

    // Guard refinement: the deref here is valid on the refined path.
    if (c != null) {
        $(c) = 5
        stdout($(c))
    } else {
        stdout(111)
    }

    // Equality-only comparison between two pointers.
    stdout(a == p)

    stdout(2)

    // Loop-guard refinement, and provable null after loop exit.
    ptr<int32> w
    w = ptr(x)
    while (w != null) {
        $(w) = $(w) + 1
        if ($(w) > 2) {
            w = null
        }
    }
    stdout(w == null)

    stdout(3)

    // Local pointer variable is null-initialized.
    stdout(g == null)
    g = ptr(g_target)
    stdout(g != null)

    stdout(4)

    // Local mview defaults to null.
    mview<int32> link
    stdout(link == null)
    link = mview(x)
    stdout(link != null)
    $(link) = 5
    stdout($(link))

    stdout(5)

    // ptr<view<int32>> null handling.
    view<int32> vv = view(x)
    ptr<view<int32>> pp
    stdout(pp == null)
    pp = ptr(vv)
    stdout(pp != null)

    // Assignment from a certified variable chain stays certified.
    ptr<int32> cn
    cn = g
    stdout(cn != null)

    stdout(6)

    // null across function boundaries.
    stdout(take_ptr(null))
    stdout(take_ptr(ptr(x)))

    ptr<int32> r = null
    stdout(r == null)

    return 0
}

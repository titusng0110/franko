import "franko/stdio"

enum<int32> Types {
    type1 = 1,
    type2 = 10,
    type3 = 20
}

enum<int32> States {
    state1,
    state2,
    state3
}

func main() -> int32 {
    Types t = Types::type1;
    stdout(t == Types::type1);
    stdout(t == Types::type2);
    stdout(Types::type2 == Types::type2);
    t = Types::type3;
    stdout(t == Types::type3);
    stdout(Types::type1 < Types::type2);
    stdout(Types::type3 > Types::type2);
    stdout(Types::type1 <= Types::type1);
    stdout(Types::type2 >= Types::type3);
    stdout(Types::type1 != Types::type2);

    States s = States::state1;
    stdout(s == States::state1);
    s = States::state3;
    stdout(s == States::state3);
    stdout(States::state1 < States::state2);
    stdout(#is_enum(Types));
    stdout(#is_enum(s));
    return 0;
}

// ============================================================
// LANGUAGE TEST: Global constant initializers
// ============================================================
// Covers: global variable declarations with constant initializers
// that are folded at compile time (1 + 2 and 1 << 8).
// ============================================================

int32 g = 1 + 2

uint64 mask = 1 << 8

func main() -> int32 {
    print(g)
    print(mask)
    return 0
}

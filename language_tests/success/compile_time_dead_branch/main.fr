// ============================================================
// LANGUAGE TEST: dead #if branches are not analyzed
// ============================================================
// The unselected branch names a function and a variable that do not
// exist. Compilation succeeds because only the selected branch enters
// semantic analysis. The condition is false on every target because
// exactly one OS constant is 1.
// ============================================================

import "franko/io"

func main() -> int32 {
    #if (#IS_LINUX && #IS_WINDOWS) {
        no_such_function(1);
        int32 x = no_such_variable;
        print(x);
    } #else {
        print("dead branch skipped");
    }

    return 0;
}

// ============================================================
// LANGUAGE TEST: Nested Arrays
// ============================================================
// Covers: static-of-static and dynamic-of-dynamic arrays,
// nested element assignment/printing, and uninit cleanup in
// reverse order (inner arrays first, then the outer array).
// ============================================================

func main() -> int32_t {
    // static array of static arrays
    array<array<int32_t, 4>, 8> m;
    m[0][0] = 1;
    m[0][3] = 4;
    m[7][0] = 71;
    m[7][3] = 74;
    print(m[0][0], m[0][3], m[7][0], m[7][3]);

    // dynamic array of dynamic arrays
    array<array<int32_t>> n;
    n.init(3);
    n[0].init_zero(2);
    n[1].init_zero(2);
    n[2].init_zero(2);
    n[0][0] = 5;
    n[1][1] = 6;
    n[2][0] = 8;
    n[2][1] = 9;
    print(n[0][0], n[0][1], n[1][0], n[1][1], n[2][0], n[2][1]);

    // uninit in reverse order: inner arrays first, then the outer
    n[2].uninit();
    n[1].uninit();
    n[0].uninit();
    n.uninit();

    return 0;
}

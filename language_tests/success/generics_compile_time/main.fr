import "franko/stdio"

#generic func info<typename T>(T v) -> int32 {
    stdout(#what_type(T))
    stdout(#has_default_value(T))
    stdout(#is_primitive(v))
    stdout(#strcmp(#what_type(T), "int32"))

    #if (#is_same_type(T, int32)) {
        #if (#IS_LINUX || #IS_WINDOWS || #IS_MACOS) {
            return 1
        } #else {
            return 0
        }
    } #else {
        return 2
    }
}

func main() -> int32 {
    stdout(info<int32>(5))
    stdout(info<uint8>(5))
    return 0
}

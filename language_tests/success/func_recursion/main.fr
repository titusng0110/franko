import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Function Recursion
// ============================================================
// Covers: direct recursion (factorial) and mutual recursion
// (is_even/is_odd) enabled by forward reference registration.
// ============================================================

func factorial(int32 n) -> int32 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

func is_even(int32 n) -> int32 {
    if (n == 0) {
        return 1;
    }
    return is_odd(n - 1);
}

func is_odd(int32 n) -> int32 {
    if (n == 0) {
        return 0;
    }
    return is_even(n - 1);
}

func main() -> int32 {
    stdout(factorial(5));
    stdout(is_even(4));
    stdout(is_even(7));
    stdout(is_odd(7));
    return 0;
}

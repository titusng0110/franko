import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Global Static Address Initializers
// ============================================================
// Covers: pointer globals initialized with getptr/getmview/getview
// over another global (including hoisted string-literal globals),
// permission downgrades in the initializer, and forward references
// between globals (the backend forward-declares globals, so source
// order does not matter).
// ============================================================

view<[byte, 5]> v = getview(greeting);
ptr<[byte, 5]> p = getptr(greeting);
mview<[byte, 5]> m = getmview(greeting);
view<[byte, 5]> s = "hello";
[byte, 5] greeting;

func main() -> int32 {
    greeting.memset(7);

    stdout($(v).length());
    stdout($(p)[0]);
    stdout($(m)[1]);
    stdout($(s).length());
    stdout($("hello")[0]);

    return 0;
}

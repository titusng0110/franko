import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Global Static Initializers
// ============================================================
// Covers: globals initialized from constant values, read-only views of
// other globals, string expressions, array literals, and static-to-
// dynamic literal view decay. Mutable pointers to globals are rejected
// in the failure suite.
// ============================================================

int32 greeting = 7

view<int32> v = getview(greeting)
view<[byte, 5]> s = "hello"
view<[int32, 4]> G = [1, 2, 3, 4]
view<[int32]> D = [5, 6, 7]

func main() -> int32 {
    stdout($(v))              // 7
    stdout($(s).length())     // 5
    stdout($(s)[0])           // 104
    stdout($(G)[3])           // 4
    stdout($(D).length())     // 3
    stdout($(D)[1])           // 6
    return 0
}

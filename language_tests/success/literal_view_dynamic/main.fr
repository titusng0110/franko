import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Literal Decay to Dynamic Views
// ============================================================
// Covers: a literal (or string literal) consumed at view<[T]>
// in an assignment, call argument, or return is a fat pointer over
// the literal's constant static storage — never a stack temporary or
// a separate descriptor global. Returning one (including
// recursively) is safe.
// ============================================================

func take(view<[int32]> v) -> int32 {
    return $(v)[0] + $(v)[2];
}

func mk(int32 n) -> view<[int32, 3]> {
    if (n == 0) {
        return [7, 8, 9];
    }
    return mk(n - 1);
}

func mdyn(int32 n) -> view<[byte]> {
    if (n == 0) {
        return [1, 2, 3];
    }
    return mdyn(n - 1);
}

func mstr() -> view<[byte]> {
    return "abc";
}

func main() -> int32 {
    // Assignment decay.
    view<[int32]> d = [1, 2, 3, 4];
    stdout($(d)[3]);

    // Call-argument decay.
    stdout(take([10, 20, 30]));

    // Return decay, recursive.
    view<[int32, 3]> w = mk(5);
    stdout($(w)[0]);
    view<[byte]> b = mdyn(5);
    stdout($(b)[2]);
    view<[byte]> s = mstr();
    stdout($(s)[2]);

    return 0;
}

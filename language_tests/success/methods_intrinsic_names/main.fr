import "franko/io"

// ============================================================
// LANGUAGE TEST: Methods Named Like Array Intrinsics
// ============================================================
// Covers: doc 26.2, doc 26.3
// Array-typed receivers dispatch to array intrinsics while
// struct-typed receivers dispatch to methods, even when the method
// name coincides with an intrinsic name.
// ============================================================

struct Counter {
    int32 n = 0
    func init(ptr<Counter> self, int32 v) -> void {
        $(self).n = v
        return
    }
    func get(ptr<Counter> self) -> int32 {
        return $(self).n
    }
}

struct Box {
    [int32] data
    func init(ptr<Box> self, uint32 n) -> int32 {
        return $(self).data.init(n)
    }
    func uninit(ptr<Box> self) -> void {
        $(self).data.uninit()
        return
    }
}

func main() -> int32 {
    Counter c
    c.init(7)
    print(c.get())
    Box b
    b.init(2)
    b.data[0] = 11
    b.data[1] = 22
    print(b.data[0], " "); print(b.data[1])
    b.uninit()
    return 0
}

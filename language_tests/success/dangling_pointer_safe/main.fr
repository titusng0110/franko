import "franko/stdio"

[int32, 4] global_value
view<[int32]> G_VIEW = [1, 2, 3, 4]
view<[int32, 4]> G_STATIC_VIEW = [5, 6, 7, 8]

func return_param(ptr<int32> p) -> ptr<int32> {
    return p
}

func return_global() -> ptr<int32> {
    return getptr(global_value[0])
}

func return_caller_pointee(ptr<int32> p) -> ptr<int32> {
    return getptr($(p))
}

func return_static_literal() -> view<[int32, 4]> {
    return [1, 2, 3, 4]
}

func return_dynamic_literal() -> view<[int32]> {
    return [1, 2, 3, 4]
}

func return_global_dynamic_view() -> view<[int32]> {
    return G_VIEW
}

func return_global_static_view() -> view<[int32, 4]> {
    return G_STATIC_VIEW
}

func reassign_to_global() -> ptr<int32> {
    int32 x = 0
    ptr<int32> p = getptr(x)
    p = getptr(global_value[0])
    return p
}

func local_deref_only() -> int32 {
    int32 x = 7
    ptr<int32> p = getptr(x)
    return $(p)
}

func main() -> int32 {
    int32 x = 3
    ptr<int32> p = return_param(getptr(x))
    stdout($(p))
    stdout($(return_global()))
    stdout($(return_caller_pointee(getptr(x))))
    stdout($(return_static_literal())[0])
    stdout($(return_dynamic_literal()).length())
    stdout($(return_global_dynamic_view()).length())
    stdout($(return_global_static_view())[1])
    stdout($(reassign_to_global()))
    stdout(local_deref_only())
    return 0
}

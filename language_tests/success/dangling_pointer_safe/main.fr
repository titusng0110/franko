import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Safe Pointer and View Uses
// ============================================================
// Covers: using pointer parameters, caller-owned pointee views,
// literal-backed views, and read-only global views without returning
// pointers. Globals are immutable, so global storage is used as a
// view directly, never as a mutable pointer.
// ============================================================

view<[int32, 4]> GLOBAL = [1, 2, 3, 4]

func use_param(ptr<int32> p) -> int32 {
    if (p == null) {
        return -1
    }
    return $(p)
}

func use_view(view<int32> v) -> int32 {
    if (v == null) {
        return -1
    }
    return $(v)
}

func local_deref_only() -> int32 {
    int32 x = 7
    ptr<int32> p = ptr(x)
    return $(p)
}

func main() -> int32 {
    int32 x = 3
    // Pointer parameter used directly (no pointer return).
    stdout(use_param(ptr(x)))
    // Read-only global view used directly.
    stdout($(GLOBAL)[1])
    // Caller-owned view used through a parameter.
    stdout(use_view(view(x)))
    // Static literal view kept directly (static lifetime).
    view<[int32, 4]> lit = [1, 2, 3, 4]
    stdout($(lit)[0])
    // Dynamic literal view kept directly.
    view<[int32]> dyn = [1, 2, 3, 4]
    stdout($(dyn).length())
    // Global decayed to a dynamic view via assignment.
    view<[int32]> gd = GLOBAL
    stdout($(gd).length())
    // Global static view used directly.
    stdout($(GLOBAL)[1])
    stdout(local_deref_only())
    return 0
}

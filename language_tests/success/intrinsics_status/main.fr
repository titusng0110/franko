import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Intrinsic Status Values
// ============================================================
// Covers: status-returning intrinsics (init, init_zero,
// resize) used in value contexts; 0 means success.
// ============================================================

func main() -> int32 {
    [int32] xs;
    int32 status = xs.init(4);
    stdout(status);
    xs[0] = 42;
    status = xs.resize(8);
    stdout(status);
    xs[7] = 43;
    stdout(xs[0], end = " "); stdout(xs[7]);

    [int32] ys;
    int32 s2 = ys.init_zero(3);
    stdout(s2);

    [int32] zs;
    int32 s3 = zs.init(2);
    stdout(s3);

    ys.uninit();
    zs.uninit();
    xs.uninit();

    return 0;
}

// ============================================================
// LANGUAGE TEST: Intrinsic Status Values
// ============================================================
// Covers: status-returning intrinsics (init, init_zero,
// resize, and the target(size) shorthand) used in value
// contexts; 0 means success.
// ============================================================

func main() -> int32 {
    [int32] xs;
    int32 status = xs.init(4);
    print(status);
    xs[0] = 42;
    status = xs.resize(8);
    print(status);
    xs[7] = 43;
    print(xs[0], xs[7]);

    [int32] ys;
    int32 s2 = ys.init_zero(3);
    print(s2);

    [int32] zs;
    int32 s3 = zs(2);
    print(s3);

    ys.uninit();
    zs.uninit();
    xs.uninit();

    return 0;
}

import "franko/io"

func main() -> int32 {
    int32 x = 0
    ptr<int32> p

    if (p != null) {
        if (x != 0) {
            print(1)
        }
        print($(p))
    }

    if (p == null) {
        x = 1
    } else {
        if (x != 0) {
            print(2)
        }
        print($(p))
    }

    while (p != null) {
        if (x != 0) {
            print(3)
        }
        print($(p))
    }

    return 0
}

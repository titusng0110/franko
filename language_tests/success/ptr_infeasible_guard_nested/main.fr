import "franko/stdio"

func main() -> int32 {
    int32 x = 0
    ptr<int32> p

    if (p != null) {
        if (x != 0) {
            stdout(1)
        }
        stdout($(p))
    }

    if (p == null) {
        x = 1
    } else {
        if (x != 0) {
            stdout(2)
        }
        stdout($(p))
    }

    while (p != null) {
        if (x != 0) {
            stdout(3)
        }
        stdout($(p))
    }

    return 0
}

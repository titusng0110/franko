// ============================================================
// LANGUAGE TEST: String UTF-8 Bytes
// ============================================================
// Covers: multi-byte UTF-8 string literals stored as one byte per
// UTF-8 byte in the hoisted global. "你好" is bytes
// 228 189 160 229 165 189.
// ============================================================

func main() -> int32 {
    [byte, 6] s;
    s.memcpy("你好");

    print(s[0]);
    print(s[1]);
    print(s[2]);
    print(s[3]);
    print(s[4]);
    print(s[5]);

    return 0;
}

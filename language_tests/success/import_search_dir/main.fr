// ============================================================
// Franko import search-directory test
// ============================================================
//
// The -p flag (main.flags) points at ./search. Prefix-free imports
// are looked up there first and fall back to this file's directory.
//
//   - "shared"      exists in ./search AND next to this file; the
//                   search-directory copy must win (shared_value = 10).
//   - "my-lib/mod a" has a hyphen and a space in its path and only
//                   exists in ./search.
//   - "local"       only exists next to this file, exercising the
//                   fallback lookup.
// ============================================================

import "shared"
import "my-lib/mod a"
import "local"
// `franko/stdio` is imported via a file-relative path so this test's -p
// override (which points at ./search) does not affect stdlib lookup;
// stdio's own `./os` import then resolves relative to stdio.fr itself.
import "../../../import/franko/stdio"

func main() -> int32 {
    stdout(shared_value)
    stdout(space_value)
    stdout(local_value)
    return 0
}

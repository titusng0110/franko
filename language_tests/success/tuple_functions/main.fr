import "franko/stdio"

func foo((int32 x, int32 y) coord, uint8 somedata) -> (int32 val, int32 err) {
    return (int32 val, int32 err) { val = coord.x, err = coord.y }
}

func main() -> int32 {
    (int32 x, int32 y) coord = (int32 x, int32 y) { x = 3, y = 4 }

    (int32 left, int32 right) result = foo(coord, 9)
    stdout(result.left)
    stdout(result.right)

    return 0
}

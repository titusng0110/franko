import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Global Aggregate Literals
// ============================================================
// Covers: passable-by-value struct/tuple globals, partial aggregate
// literals, recursive zero/default filling, enum defaults, and
// namespaced globals. Globals and their aggregates hold only
// value storage: no pointers or arrays.
// ============================================================

struct Inner {
    int32 a = 5
    int32 tag = 0
}

struct Outer {
    int32 x
    Inner inner
    int32 y = 7
    int32 marker = 0
}

int32 G = 3

Outer O = Outer { x = 1, marker = 104 }
Outer P = Outer { x = 2, inner = Inner { a = 9 } }
(int32, int32) T = (int32, int32) { 4 }

namespace n {
    Outer N = Outer { x = 11 }
}

func main() -> int32 {
    stdout(O.x)                  // 1
    stdout(O.inner.a)            // 5
    stdout(O.y)                  // 7
    stdout(O.marker)             // 104
    stdout(O.inner.tag == 0)     // 1

    stdout(P.inner.a)            // 9
    stdout(P.y)                  // 7
    stdout(P.marker == 0)        // 1

    stdout(T._0)                 // 4
    stdout(T._1)                 // 0

    stdout(n::N.x)               // 11
    stdout(n::N.inner.a)         // 5
    stdout(n::N.y)               // 7

    return 0
}

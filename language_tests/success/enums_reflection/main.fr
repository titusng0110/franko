import "franko/stdio"

enum<uint8> Status {
    spawning = 10,
    alive = 20
}

func main() -> int32 {
    Status s = Status::spawning;
    stdout(#is_enum(Status));
    stdout(#is_enum(s));
    stdout(#is_enum(Status::alive));
    stdout(#is_primitive(Status));
    stdout(#has_default_value(Status));
    stdout(#is_memset_safe(Status));
    stdout(#is_memcpy_safe(Status));
    stdout(#is_matchable(Status));
    stdout(#is_comparable(Status));
    stdout(#is_assignable(Status));
    stdout(#is_value_assignable(Status));
    stdout(#what_type(Status));
    stdout(#what_type(Status::alive));
    stdout(#is_same_type(Status::alive, Status::spawning));
    stdout(#is_same_type(Status, Status));
    return 0;
}

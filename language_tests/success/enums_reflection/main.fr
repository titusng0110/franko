import "franko/io"

enum<uint8> Status {
    spawning = 10,
    alive = 20
}

func main() -> int32 {
    Status s = Status::spawning;
    print(#is_enum(Status));
    print(#is_enum(s));
    print(#is_enum(Status::alive));
    print(#is_primitive(Status));
    print(#has_default_value(Status));
    print(#is_memset_safe(Status));
    print(#is_memcpy_safe(Status));
    print(#is_matchable(Status));
    print(#is_comparable(Status));
    print(#is_assignable(Status));
    print(#is_value_assignable(Status));
    print(#what_type(Status));
    print(#what_type(Status::alive));
    print(#is_same_type(Status::alive, Status::spawning));
    print(#is_same_type(Status, Status));
    return 0;
}

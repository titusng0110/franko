// ============================================================
// LANGUAGE TEST: String Escape Sequences
// ============================================================
// Covers: supported escapes (\t, \n, \", \\) decoded to their
// byte values when a string literal desugars into a byte array.
// ============================================================

func main() -> int32_t {
    // "\t\n\"\\" decodes to byte values 9, 10, 34, 92.
    array<byte, 4> e;
    e = "\t\n\"\\";

    print(e[0]);
    print(e[1]);
    print(e[2]);
    print(e[3]);

    // Escapes mixed with ordinary characters: "a\tb\nc" -> 97, 9, 98, 10, 99.
    array<byte, 5> f;
    f = "a\tb\nc";

    print(f[0]);
    print(f[1]);
    print(f[2]);
    print(f[3]);
    print(f[4]);

    return 0;
}

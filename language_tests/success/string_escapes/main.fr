import "franko/stdio"

// ============================================================
// LANGUAGE TEST: String Escape Sequences
// ============================================================
// Covers: supported escapes (\t, \n, \", \\) decoded to their
// byte values in the hoisted global byte array behind a string
// literal view.
// ============================================================

func main() -> int32 {
    // "\t\n\"\\" decodes to byte values 9, 10, 34, 92.
    [byte, 4] e;
    e.memcpy("\t\n\"\\");

    stdout(e[0]);
    stdout(e[1]);
    stdout(e[2]);
    stdout(e[3]);

    // Escapes mixed with ordinary characters: "a\tb\nc" -> 97, 9, 98, 10, 99.
    [byte, 5] f;
    f.memcpy("a\tb\nc");

    stdout(f[0]);
    stdout(f[1]);
    stdout(f[2]);
    stdout(f[3]);
    stdout(f[4]);

    return 0;
}

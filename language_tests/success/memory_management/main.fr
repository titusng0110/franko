// ============================================================
// LANGUAGE TEST: Memory Management (Pointers)
// ============================================================
// Covers: ptr<T>, getptr, deref, and null literals.
// ============================================================

func main() -> int32 {
    // --- Stack variable ---
    int32 stackVar = 42;

    // --- Pointers & dereferencing ---
    ptr<int32> p = getptr(stackVar);
    int32 derefVal = $(p);

    // --- Writes through an pointer ---
    ptr<int32> stackPtr = getptr(stackVar);
    $(stackPtr) = 200;

    // --- Null pointer ---
    ptr<int32> nullPtr;
    if (nullPtr == null) {
        print(1);
    }
    nullPtr = getptr(stackVar);
    if (nullPtr != null) {
        print(0);
    }

    // --- Pointer of array ---
    [int32] arr;
    arr.init(10); // or arr(10)
    ptr<[int32]> arrPtr = getptr(arr);
    $(arrPtr)[0] = 1;
    int32 arrVal = $(arrPtr)[0];

    // --- Pointer of array with static size ---
    [int32, 5] staticArr;
    ptr<[int32, 5]> staticArrPtr = getptr(staticArr);
    $(staticArrPtr)[0] = 5;

    print(derefVal);
    print($(stackPtr));
    print(arrVal);

    return 0;
}

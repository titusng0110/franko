// ============================================================
// LANGUAGE TEST: Memory Management (Pointers)
// ============================================================
// Covers: ptr<T>, getptr, deref, and null literals.
// ============================================================

func main() -> int32_t {
    // --- Stack variable ---
    int32_t stackVar = 42;

    // --- Pointers & dereferencing ---
    ptr<int32_t> p = getptr(stackVar);
    int32_t derefVal = $(p);

    // --- Writes through an pointer ---
    ptr<int32_t> stackPtr = getptr(stackVar);
    $(stackPtr) = 200;

    // --- Null pointer ---
    ptr<int32_t> nullPtr;
    if (nullPtr == null) {
        print(1);
    }
    nullPtr = getptr(stackVar);
    if (nullPtr != null) {
        print(0);
    }

    // --- Pointer of array ---
    array<int32_t> arr;
    arr.init(10); // or arr(10)
    ptr<array<int32_t>> arrPtr = getptr(arr);
    $(arrPtr)[0] = 1;
    int32_t arrVal = $(arrPtr)[0];

    // --- Pointer of array with static size ---
    array<int32_t, 5> staticArr;
    ptr<array<int32_t, 5>> staticArrPtr = getptr(staticArr);
    $(staticArrPtr)[0] = 5;

    print(derefVal);
    print($(stackPtr));
    print(arrVal);

    return 0;
}

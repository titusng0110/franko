import "franko/stdio"

func main() -> int32 {
    (int32 val, int32 err) res
    (int32, int32) lazy
    (uint hello, int world) a
    (uint different, int name) b

    res.val = (1 + 2) * 3
    res.err = 22
    lazy._0 = 33
    lazy._1 = 44

    a.hello = 55
    a.world = 66

    b = a
    b.different = b.different + 1

    stdout(res.val)
    stdout(res.err)
    stdout(lazy._0)
    stdout(lazy._1)
    stdout(a.hello)
    stdout(a.world)
    stdout(b.different)
    stdout(b.name)
    stdout(#is_same_type(res, lazy))

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array Indexing
// ============================================================
// Covers: constant indexes and nonconstant uint32 index
// variables on static and dynamic arrays, including a loop.
// ============================================================

func main() -> int32 {
    [int32, 5] sa;
    sa[0] = 1;
    sa[4] = 5;

    uint32 i = 1;
    sa[i] = 2;

    [int32] da;
    da.init_zero(4);
    da[0] = 10;
    uint32 j = 2;
    da[j] = 12;

    stdout(sa[0], end = " "); stdout(sa[i], end = " "); stdout(sa[4]);
    stdout(da[0], end = " "); stdout(da[j], end = " "); stdout(da[3]);

    for (uint32 k = 0; k < 4; k = k + 1) {
        da[k] = da[k] + 1;
    }
    stdout(da[0], end = " "); stdout(da[1], end = " "); stdout(da[2], end = " "); stdout(da[3]);

    da.uninit();

    return 0;
}

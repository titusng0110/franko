import "franko/io"

// ============================================================
// LANGUAGE TEST: Break and Continue
// ============================================================
// Covers:
//   - break / break N in while and for loops (label + goto lowering),
//   - continue in while loops,
//   - continue in for loops runs the update (the continue label sits
//     before the desugared update),
//   - break in for loops skips the update,
//   - break N counting across nested loops,
//   - const-expression break levels,
//   - braceless loop bodies.
// ============================================================

func main() -> int32 {
    int32 i = 0;

    // break in a while loop.
    i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 4) {
            break;
        }
    }
    print(i);

    // break is equivalent to break 1.
    i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) {
            break 1;
        }
    }
    print(i);

    // continue in a while loop skips the rest of the body.
    i = 0;
    while (i < 6) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        print(i);
    }

    // continue in a for loop still runs the update: without the update
    // this loop would never terminate.
    int32 sum = 0;
    for (int32 j = 0; j < 5; j = j + 1) {
        if (j == 2) {
            continue;
        }
        sum = sum + j;
    }
    print(sum);

    // break in a for loop skips the update.
    for (int32 k = 0; k < 100; k = k + 1) {
        if (k == 3) {
            break;
        }
        print(k);
    }

    // break 2 exits two nested loops.
    int32 rounds = 0;
    for (int32 a = 0; a < 3; a = a + 1) {
        for (int32 b = 0; b < 3; b = b + 1) {
            if (b == 1) {
                break 2;
            }
            rounds = rounds + 1;
        }
    }
    print(rounds);

    // break levels accept const expressions.
    i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 2) {
            break 1 + 1 - 1;
        }
    }
    print(i);

    // continue targets the innermost loop only.
    int32 outer = 0;
    int32 innerTotal = 0;
    while (outer < 3) {
        outer = outer + 1;
        int32 b2 = 0;
        while (b2 < 3) {
            b2 = b2 + 1;
            if (b2 == 2) {
                continue;
            }
            innerTotal = innerTotal + b2;
        }
    }
    print(innerTotal);

    // braceless loop bodies.
    i = 0;
    while (i < 100) i = i + 1;
    while (i < 100) break;
    print(i);

    int32 m = 0;
    for (int32 n = 0; n < 10; n = n + 1) continue;
    for (int32 n2 = 0; n2 < 4; n2 = n2 + 1) {
        m = m + n2;
    }
    print(m);

    return 0;
}

// ============================================================
// LANGUAGE TEST: Addresses — null across function boundaries
// ============================================================
// Covers:
//   - null passed to an addr<T> parameter (callee checks p == null
//     and returns a marker)
//   - null returned from an addr<T> function (caller sees null)
//   - p = null assignment makes a certified address null again
// ============================================================

func checkAddr(addr<int32_t> q) -> int32_t {
    if (q == null) {
        return -1
    }
    return $(q)
}

func pickAddr(uint32_t which, addr<int32_t> a) -> addr<int32_t> {
    if (which != 0) {
        return a
    }
    return null
}

func main() -> int32_t {
    int32_t x = 20

    // null as an argument: the callee checks and returns a marker.
    print(checkAddr(null))
    print(checkAddr(getaddr(x)))

    // null returned from an addr<T> function.
    addr<int32_t> r1 = pickAddr(0, getaddr(x))
    print(r1 == null)
    addr<int32_t> r2 = pickAddr(1, getaddr(x))
    print(r2 == null)
    if (r2 != null) {
        print($(r2))
    }

    // p = null makes a certified address null again.
    addr<int32_t> p
    p = getaddr(x)
    print(p != null)
    p = null
    print(p == null)

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Syntax — Comments
// ============================================================
// Covers: whole-line '//' comments and trailing comments after
// code on the same line. Only line comments exist in Franko.
// ============================================================

// A whole-line comment before any declaration.
func main() -> int32 {
    // A whole-line comment inside a function body.
    int32 x = 40  // trailing comment after a declaration
    x = x + 2       // trailing comment after an assignment

    stdout(x)  // trailing comment after a stdout call

    // A whole-line comment between statements.
    stdout(x * 2)  // trailing comment after another stdout call

    return 0  // trailing comment on a return statement
}

// A whole-line comment after the last declaration in the file.

// ============================================================
// LANGUAGE TEST: Types and Literals
// ============================================================
// Covers: primitive integer types (signed/unsigned, fixed-width),
// type aliases (int, uint, byte), void, pointer types, and
// array types.
// ============================================================

struct Node {
    ptr<Node> next
    int32 val
}

func main() -> int32 {
    // --- Primitive signed types ---
    int8 i8 = 127;
    int16 i16 = 32767;
    int32 i32 = 2147483647;
    int64 i64 = 9223372036854775807;

    // --- Primitive unsigned types ---
    uint8 u8 = 255;
    uint16 u16 = 65535;
    uint32 u32 = 4294967295;
    uint64 u64 = 18446744073709551615;

    // --- Type aliases ---
    int32 aliasInt = 100;
    uint32 aliasUint = 100;
    uint8 aliasByte = 100;

    // --- Negative literals (unary negation) ---
    int32 negVal = -128;
    int64 negVal64 = -9223372036854775808;

    // --- Integer literals (decimal, binary, hex) ---
    int32 dec = 123;
    int32 bin = 0b1010;
    int32 hex = 0xFF;
    int32 hexUpperPrefix = 0XFF;

    // --- String literals (view<[byte, N]> over a hoisted global) ---
    [byte, 5] str;
    str.memcpy("hello");

    // --- Array types ---
    [int32] dynArray;
    [int32, 10] staticArray;
    [[byte, 12], 12] nestedArray;
    ptr<int32> ptrInt;
    ptr<Node> ptrStruct;

    print(i8);
    print(i16);
    print(i32);
    print(i64);
    print(u8);
    print(u16);
    print(u32);
    print(u64);
    print(aliasInt);
    print(aliasUint);
    print(aliasByte);
    print(negVal);
    print(negVal64);
    print(dec);
    print(bin);
    print(hex);
    print(hexUpperPrefix);

    return 0;
}

// ============================================================
// LANGUAGE TEST: Types and Literals
// ============================================================
// Covers: primitive integer types (signed/unsigned, fixed-width),
// type aliases (int, uint, byte), void, pointer types, and
// array/ndarray types.
// ============================================================

struct Node {
    ptr<Node> next
    int32_t val
}

func main() -> int32_t {
    // --- Primitive signed types ---
    int8_t i8 = 127;
    int16_t i16 = 32767;
    int32_t i32 = 2147483647;
    int64_t i64 = 9223372036854775807;

    // --- Primitive unsigned types ---
    uint8_t u8 = 255;
    uint16_t u16 = 65535;
    uint32_t u32 = 4294967295;
    uint64_t u64 = 18446744073709551615;

    // --- Type aliases ---
    int32_t aliasInt = 100;
    uint32_t aliasUint = 100;
    uint8_t aliasByte = 100;

    // --- Negative literals (unary negation) ---
    int32_t negVal = -128;
    int64_t negVal64 = -9223372036854775808;

    // --- Integer literals (decimal, binary, hex) ---
    int32_t dec = 123;
    int32_t bin = 0b1010;
    int32_t hex = 0xFF;
    int32_t hexUpperPrefix = 0XFF;

    // --- String literals (as initializer for byte arrays) ---
    array<byte, 5> str = "hello";

    // --- Array types ---
    array<int32_t> dynArray;
    array<int32_t, 10> staticArray;
    ndarray<byte, 12, 12> ndArray;
    ptr<int32_t> ptrInt;
    ptr<Node> ptrStruct;

    print(i8);
    print(i16);
    print(i32);
    print(i64);
    print(u8);
    print(u16);
    print(u32);
    print(u64);
    print(aliasInt);
    print(aliasUint);
    print(aliasByte);
    print(negVal);
    print(negVal64);
    print(dec);
    print(bin);
    print(hex);
    print(hexUpperPrefix);

    return 0;
}

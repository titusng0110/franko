import "franko/io"

// ============================================================
// LANGUAGE TEST: Types and Literals
// ============================================================
// Covers: primitive integer types (signed/unsigned, fixed-width),
// type aliases (int, uint, byte), void, pointer types, and
// array types.
// ============================================================

struct Node {
    ptr<Node> next
    int32 val
}

func main() -> int32 {
    // --- Primitive signed types ---
    int8 i8 = 127;
    int16 i16 = 32767;
    int32 i32 = 2147483647;
    int64 i64 = 9223372036854775807;

    // --- Primitive unsigned types ---
    uint8 u8 = 255;
    uint16 u16 = 65535;
    uint32 u32 = 4294967295;
    uint64 u64 = 18446744073709551615;

    // --- Type aliases ---
    int32 alias_int = 100;
    uint32 alias_uint = 100;
    uint8 alias_byte = 100;

    // --- Negative literals (unary negation) ---
    int32 neg_val = -128;
    int64 neg_val64 = -9223372036854775808;

    // --- Integer literals (decimal, binary, hex) ---
    int32 dec = 123;
    int32 bin = 0b1010;
    int32 hex = 0xFF;
    int32 hex_upper_prefix = 0XFF;

    // --- String literals (view<[byte, N]> over a hoisted global) ---
    [byte, 5] str;
    str.memcpy("hello");

    // --- Array types ---
    [int32] dyn_array;
    [int32, 10] static_array;
    [[byte, 12], 12] nested_array;
    ptr<int32> ptr_int;
    ptr<Node> ptr_struct;

    print(i8);
    print(i16);
    print(i32);
    print(i64);
    print(u8);
    print(u16);
    print(u32);
    print(u64);
    print(alias_int);
    print(alias_uint);
    print(alias_byte);
    print(neg_val);
    print(neg_val64);
    print(dec);
    print(bin);
    print(hex);
    print(hex_upper_prefix);

    return 0;
}

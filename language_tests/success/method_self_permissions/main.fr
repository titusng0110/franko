import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Method self Permissions
// ============================================================
// Covers: methods whose self parameter is ptr<X>, mview<X>, or
// view<X>. The hidden self argument is synthesized with
// getptr/getmview/getview matching the declaration, so the
// receiver must carry at least that permission (see
// failure/pointer_permissions/method_self_*).
// ============================================================

struct Box {
    int32 x = 0

    func bump(ptr<Box> self) -> void {
        $(self).x = $(self).x + 1;
    }

    func touch(mview<Box> self) -> void {
        $(self).x = 7;
    }

    func peek(view<Box> self) -> int32 {
        return $(self).x;
    }
}

func main() -> int32 {
    Box b;

    // Owner receiver: every self type works.
    b.bump();
    stdout(b.peek());

    // Read-only receiver: only a view<X> self method is callable.
    view<Box> v = getview(b);
    stdout($(v).peek());

    // Mutable receiver: mview<X> self works.
    mview<Box> m = getmview(b);
    $(m).touch();
    stdout(b.x);

    b.bump();
    stdout($(v).peek());

    return 0;
}

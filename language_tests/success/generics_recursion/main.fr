import "franko/stdio"

#generic func fact<int32 N>() -> int32 {
    #if (N <= 1) {
        return 1
    } #else {
        return N * fact<N - 1>()
    }
}

#generic func is_even<int32 N>() -> int32 {
    #if (N == 0) {
        return 1
    } #else {
        return is_odd<N - 1>()
    }
}

#generic func is_odd<int32 N>() -> int32 {
    #if (N == 0) {
        return 0
    } #else {
        return is_even<N - 1>()
    }
}

func main() -> int32 {
    stdout(fact<5>())
    stdout(is_even<10>())
    stdout(is_odd<7>())
    return 0
}

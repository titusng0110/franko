import "franko/io"

// ============================================================
// LANGUAGE TEST: Aggregate Literals and OPERATOR_MOV
// ============================================================
// Value-assignable structs always use built-in whole-value
// assignment; they cannot declare OPERATOR_MOV. Declaration and
// assignment construction with aggregate literals therefore copy
// fields directly.
//
// A pointer-only struct keeps custom OPERATOR_MOV for non-literal
// whole-value assignment.
// ============================================================

struct Literal {
    int32 x
    int32 source = 0
}

struct Buffer {
    int32 v
    int32 source = 0
    [int32, 1] pad

    func OPERATOR_MOV(ptr<Buffer> self, view<Buffer> other) -> void {
        $(self).v = $(other).v
        $(self).source = 99
        return
    }
}

func seed(ptr<Buffer> out, int32 v) -> void {
    $(out).v = v
    $(out).source = 3
    return
}

func main() -> int32 {
    Literal a = Literal { x = 5, source = 0 }
    print(a.x)
    print(a.source)

    Literal b { x = 5, source = 0 }
    print(b.x)
    print(b.source)

    Literal c
    c = Literal { x = 6, source = 7 }
    print(c.x)
    print(c.source)

    Buffer p { v = 1, source = 2 }
    Buffer q { v = 0, source = 0 }
    seed(getptr(q), 8)
    p = q
    print(p.v)
    print(p.source)

    return 0
}

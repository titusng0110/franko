import "franko/io"

// ============================================================
// LANGUAGE TEST: memcpy Shapes and Ranged memcpy
// ============================================================
// Covers: memcpy (doc 21.6) between dynamic and static arrays in
// every shape combination (doc 32.3); static lengths do not need to
// match — the whole-array form copies the smaller side; and the
// ranged form target.memcpy(source, dstStart, srcStart, count)
// copies an element range between different positions.
// ============================================================

func main() -> int32 {
    // dynamic <- dynamic: count is the smaller length.
    [int32] dd
    dd.init_zero(4)
    dd[0] = 1
    dd[1] = 2
    dd[2] = 3
    dd[3] = 4

    [int32] dd2
    dd2.init_zero(2)
    dd2.memcpy(getptr(dd))
    print(dd2[0], " "); print(dd2[1])

    // static <- static with different lengths.
    [int32, 5] s5
    s5.memset(0)
    s5[0] = 10
    s5[1] = 20
    s5[2] = 30

    [int32, 2] s2
    s2.memset(0)
    s2.memcpy(getptr(s5))
    print(s2[0], " "); print(s2[1])

    // dynamic <- static.
    [int32] ds
    ds.init_zero(3)
    ds.memcpy(getptr(s5))
    print(ds[0], " "); print(ds[1], " "); print(ds[2])

    // static <- dynamic.
    [int32, 3] sd
    sd.memset(0)
    sd.memcpy(getptr(dd))
    print(sd[0], " "); print(sd[1], " "); print(sd[2])

    // Ranged memcpy: dst[1..2] = src[2..3].
    [int32, 4] rd
    rd.memset(0)
    rd.memcpy(getptr(dd), 1, 2, 2)
    print(rd[0], " "); print(rd[1], " "); print(rd[2], " "); print(rd[3])

    dd.uninit()
    dd2.uninit()
    ds.uninit()

    return 0
}

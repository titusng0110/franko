import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Pointers — nested pointer slots and arrays behind ptr
// ============================================================
// Covers:
//   - ptr<mview<int32>>: ptr of a mutable view slot, double
//     dereference to write and read through both levels
//   - ptr<[int32]>: $(p).init(n) and
//     element writes through the dereference
//   - ptr<[int32, 3]>: initializer-list assignment through
//     the dereference
// ============================================================

func main() -> int32 {
    // --- Nested pointers: pointer of a mutable view slot ---
    int32 x = 0
    mview<int32> p
    p = mview(x)

    ptr<mview<int32>> pp
    pp = ptr(p)

    // Double dereference writes x through both levels.
    $($(pp)) = 7
    stdout($($(pp)))
    stdout(x)

    // Writes through p are visible through pp (same pointee).
    $(p) = 8
    stdout($($(pp)))

    // --- Pointer of a dynamic array ---
    [int32] dyn
    ptr<[int32]> ap
    ap = ptr(dyn)

    // Allocate through the pointer.
    $(ap).init(4)
    $(ap)[0] = 10
    $(ap)[3] = 40
    stdout($(ap)[0])
    stdout($(ap)[3])
    stdout(dyn[3])

    dyn.uninit()

    // --- Pointer of a static array: initializer list through deref ---
    [int32, 3] xs
    ptr<[int32, 3]> sp
    sp = ptr(xs)

    // Equivalent to copying [1, 2, 3] into the pointee array.
    $(sp).memcpy([1, 2, 3])
    stdout($(sp)[0])
    stdout($(sp)[1])
    stdout($(sp)[2])
    stdout(xs[2])

    return 0
}

// ============================================================
// LANGUAGE TEST: #strcmp
// ============================================================
// Covers: lexicographic byte comparison with negative, zero, and
// positive results, plus prefix ordering.
// ============================================================

import "franko/stdio"

func main() -> int32 {
    stdout(#strcmp("abc", "abd"));
    stdout(#strcmp("abc", "abc"));
    stdout(#strcmp("abd", "abc"));
    stdout(#strcmp("ab", "abc"));
    stdout(#strcmp("abc", "ab"));
    stdout(#strcmp("a", "b"));
    stdout(#strcmp("b", "a"));

    return 0;
}

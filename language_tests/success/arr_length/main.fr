import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array length() Intrinsic
// ============================================================
// Covers:
//   dynarr.length()      (runtime length, 0 when uninitialized)
//   staticarr.length()   (compile-time constant)
//   nested, field, element, and deref receivers
//   a struct method named `length` still dispatches as a method
// ============================================================

struct Meter {
    int32 step = 0
    func length(ptr<Meter> self) -> int32 {
        return $(self).step + 100
    }
}

struct Holder {
    [int32] items
}

func main() -> int32 {
    [int32] xs;
    stdout(xs.length());
    xs.init(4);
    stdout(xs.length());
    xs.resize(10);
    stdout(xs.length());
    xs.uninit();
    stdout(xs.length());

    [int32, 3] ys;
    ys.memcpy([10, 20, 30]);
    stdout(ys.length());
    stdout(ys.length() + xs.length());

    uint32 n;
    n = ys.length();
    stdout(n);

    [[int32, 2], 3] m;
    m.memcpy([[1, 2], [3, 4], [5, 6]]);
    stdout(m.length());
    stdout(m[0].length());
    stdout(m[2][1]);

    [[int32, 4], 2] g;
    stdout(g.length());
    stdout(g[0].length());

    Holder h;
    h.items.init(2);
    stdout(h.items.length());
    h.items.uninit();

    ptr<[int32, 3]> p;
    p = getptr(ys);
    stdout($(p).length());

    Meter meter;
    meter.step = 5;
    stdout(meter.length());

    for (uint32 i = 0; i < ys.length(); i = i + 1) {
        stdout(ys[i]);
    }

    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Capability Linter (Read-Only Warning)
// ============================================================
// A ptr<T>/mview<T> variable that is only ever read from gets a
// non-fatal downgrade-to-view warning (see main.warnings). The
// build still succeeds and runs.
// ============================================================

func main() -> int32 {
    [byte, 3] buf;
    buf.memset(9);

    // Only reads through the pointer.
    ptr<[byte, 3]> p = getptr(buf);
    stdout($(p)[1]);

    mview<[byte, 3]> m = getmview(buf);
    stdout($(m)[2]);

    return 0;
}

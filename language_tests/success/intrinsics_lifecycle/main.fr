import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array Intrinsics Lifecycle
// ============================================================
// Covers: memset whole-array and ranged forms on a static
// array, memset on a dynamic array, memcpy between static and
// dynamic arrays in both directions via getptr(source), and
// memmove with overlapping ranges inside one array.
// memset fills byte-wise: each 4-byte int32 element becomes
// value * 0x01010101.
// ============================================================

func main() -> int32 {
    // memset whole static array
    [int32, 4] a;
    a.memset(7);
    stdout(a[0], end = " "); stdout(a[1], end = " "); stdout(a[2], end = " "); stdout(a[3]);

    // memset element range on a static array
    [int32, 4] b;
    b.memset(0);
    b.memset(9, 1, 2);
    stdout(b[0], end = " "); stdout(b[1], end = " "); stdout(b[2], end = " "); stdout(b[3]);

    // memset on a dynamic array
    [int32] d;
    d.init(3);
    d.memset(5);
    stdout(d[0], end = " "); stdout(d[1], end = " "); stdout(d[2]);

    // memcpy static -> dynamic
    [int32] e;
    e.init_zero(4);
    e.memcpy(getptr(a));
    stdout(e[0], end = " "); stdout(e[1], end = " "); stdout(e[2], end = " "); stdout(e[3]);
    e.uninit();

    // memcpy dynamic -> static
    [int32, 3] f;
    f.memset(0);
    f.memcpy(getptr(d));
    stdout(f[0], end = " "); stdout(f[1], end = " "); stdout(f[2]);

    // memmove with overlapping ranges inside one array
    [int32, 4] g;
    g.memset(0);
    g[0] = 1;
    g[1] = 2;
    g[2] = 3;
    g.memmove(1, 0, 3);
    stdout(g[0], end = " "); stdout(g[1], end = " "); stdout(g[2], end = " "); stdout(g[3]);

    d.uninit();

    return 0;
}

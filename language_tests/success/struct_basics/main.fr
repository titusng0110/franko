import "franko/io"

// ============================================================
// LANGUAGE TEST: Struct Basics
// ============================================================
// Covers: struct declaration with mixed separators (';' and
// newlines between fields), field default values, a static-array
// field, field assignment and access, and a struct with no
// separator before the closing brace.
// ============================================================

// Fields separated by a mix of ';' and newlines; 'xs' is a
// static-array field; 'b' has no default.
struct Mixed {
    int32 a = 7;
    int64 b
    [int32, 4] xs;
    uint8 tag = 3
}

// No separator between the last field and the closing brace.
struct Tiny { int32 v = 5 }

func main() -> int32 {
    Mixed m;
    m.a = 10;
    m.b = 20;
    m.xs.memcpy([1, 2, 3, 4]);

    // 'tag' is never assigned, so its field default (3) is printed.
    print(m.a, " "); print(m.b, " "); print(m.tag);
    print(m.xs[0] + m.xs[1] + m.xs[2] + m.xs[3]);

    Tiny t;
    t.v = 42;
    print(t.v);

    return 0;
}

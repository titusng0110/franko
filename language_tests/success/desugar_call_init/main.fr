import "franko/io"

// ============================================================
// LANGUAGE TEST: Desugaring — Dynamic Array Call-Init Declaration
// ============================================================
// Covers: 05-desugaring.md 5.2.
//   [int32] arr(20);        desugars to
//   [int32] arr; arr(20);
// The call form is the dynamic-array init intrinsic sugar.
// ============================================================

func main() -> int32 {
    // Stack dynamic array with call-init declaration sugar.
    [int32] arr(20);
    arr[0] = 7;
    arr[19] = 9;
    print(arr[0]);
    print(arr[19]);
    arr.uninit();

    return 0;
}

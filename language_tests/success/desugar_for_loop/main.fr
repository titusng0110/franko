// ============================================================
// LANGUAGE TEST: Desugaring — For Loop Lowering
// ============================================================
// Covers: 05-desugaring.md 5.7 and 18-statements.md 18.4.
// A for loop lowers to an init block plus a while loop whose body is
// followed by the update statement, so the update runs at the end of
// every iteration, including the last.
// ============================================================

func main() -> int32 {
    // All three header parts: init declares the loop variable.
    for (int32 i = 0; i < 3; i = i + 1) {
        print(i);
    }

    // Optional init: the loop variable lives outside the loop, so the
    // final update result is observable after the loop: i is 3, which
    // proves the update ran on the last iteration too.
    int32 i = 0;
    for (; i < 3; i = i + 1) {
        print(i);
    }
    print(i);

    // Optional update: the body advances the loop itself.
    for (i = 0; i < 3;) {
        print(i);
        i = i + 1;
    }

    return 0;
}

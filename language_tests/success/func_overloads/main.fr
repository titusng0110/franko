import "franko/io"

// ============================================================
// LANGUAGE TEST: Function Overloads
// ============================================================
// Covers: overloading on the ordered parameter type list;
// nonconstant arguments must exactly match one overload's
// parameter type, so each call below selects a different body.
// ============================================================

func f(int32 x) -> int32 {
    return x + 1;
}

func f(int64 x) -> int64 {
    return x + 2;
}

func f(uint8 x) -> uint8 {
    return x + 3;
}

func main() -> int32 {
    int32 a = 10;
    int64 b = 20;
    uint8 c = 30;
    print(f(a));
    print(f(b));
    print(f(c));
    return 0;
}

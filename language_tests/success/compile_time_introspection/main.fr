// ============================================================
// LANGUAGE TEST: compile-time reflection predicates
// ============================================================
// Covers: #is_primitive, is_memcpy_safe, has_default_value, is_memset_safe,
// is_same_type, what_type, strcmp, panic, is_matchable, is_comparable,
// is_assignable, and is_value_assignable.
//
// Point declares OPERATOR_EQ and OPERATOR_LT and relies on built-in
// whole-value assignment; Plain has only primitive fields; WithDefault
// has a field default; HasDyn holds a dynamic array. Pointers, dynamic
// arrays, and static arrays cover the remaining type shapes.
// ============================================================

import "franko/stdio"

struct Point {
    int32 x
    int32 y

    func OPERATOR_EQ(view<Point> self, view<Point> other) -> uint8 {
        return $(self).x == $(other).x && $(self).y == $(other).y
    }

    func OPERATOR_LT(view<Point> self, view<Point> other) -> uint8 {
        return $(self).x < $(other).x
    }
}

struct Plain {
    int32 x
    int32 y
}

struct WithDefault {
    int32 x = 5
}

struct HasDyn {
    [int32] xs
}

struct HasStaticArray {
    [int32, 3] values
}

struct Mixed {
    view<int32> link
    int32 value
}

func main() -> int32 {
    int32 i = 1
    Point p
    Plain q
    WithDefault d
    HasDyn h
    HasStaticArray hsa
    Mixed mixed
    ptr<int32> ip = null
    [int32, 3] sa
    [int32] da

    stdout(#is_primitive(i));
    stdout(#is_primitive(p));

    stdout(#is_memcpy_safe(p));
    stdout(#is_memcpy_safe(da));

    stdout(#has_default_value(i));
    stdout(#has_default_value(p));
    stdout(#has_default_value(d));
    stdout(#has_default_value(ip));
    stdout(#has_default_value(sa));
    stdout(#has_default_value(da));
    stdout(#has_default_value(mixed));

    stdout(#is_memset_safe(i));
    stdout(#is_memset_safe(p));
    stdout(#is_memset_safe(d));
    stdout(#is_memset_safe(ip));

    stdout(#is_same_type(i, i));
    stdout(#is_same_type(i, sa));

    stdout(#what_type(i));

    stdout(#strcmp("abc", "abd"));
    stdout(#strcmp("abc", "abc"));
    stdout(#strcmp("abd", "abc"));

    stdout(#is_matchable(i));
    stdout(#is_matchable(ip));
    stdout(#is_matchable(p));
    stdout(#is_matchable(q));

    stdout(#is_comparable(i));
    stdout(#is_comparable(p));
    stdout(#is_comparable(ip));
    stdout(#is_comparable(sa));

    stdout(#is_assignable(i));
    stdout(#is_assignable(ip));
    stdout(#is_assignable(q));
    stdout(#is_assignable(d));
    stdout(#is_assignable(h));

    stdout(#is_value_assignable(i));
    stdout(#is_value_assignable(ip));
    stdout(#is_value_assignable(q));
    stdout(#is_value_assignable(hsa));
    stdout(#is_value_assignable(da));

    #if (0) {
        #panic("unreachable");
    }

    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Declaration forms
// ============================================================
// Covers: primitive declarations (int, int32, uint8, uint32),
// dynamic and static array declarations, ptr<T> declarations with
// getptr/deref.
// ============================================================

func main() -> int32 {
    // Primitive locals, assigned before any read.
    int x
    x = 5

    int32 y
    y = -123456

    uint8 b
    b = 200

    uint32 i
    i = 4000000000

    // Dynamic array: declared empty, then initialized before indexed use.
    [int] xs
    xs.init(4)
    xs[0] = 7
    xs[3] = 10

    // Static array with a constExpr size.
    [uint8, 128] buffer
    buffer[0] = 255
    buffer[127] = 1

    // Pointer: null-initialized, then certified with getptr of a local.
    ptr<int32> p
    stdout(p == null)
    p = getptr(y)
    $(p) = 99

    stdout(x)
    stdout(y)
    stdout(b)
    stdout(i)
    stdout(xs[0])
    stdout(xs[3])
    stdout(buffer[0])
    stdout(buffer[127])
    stdout($(p))

    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Decayed Array Views via Assignment
// ============================================================
// Covers: static-to-dynamic view decay is representation-preserving,
// so a decayed view<[T,N]>/mview<[T,N]> value can be assigned and passed
// as view<[T]>/mview<[T]> without a hidden stack descriptor.
// Element access and length through the decayed fat pointer keep the
// original mode 2 / count N, so indexing the static storage works.
// ============================================================

view<[int32, 4]> global_value = [1, 2, 3, 4]

func take_dynamic(view<[int32]> v) -> int32 {
    return $(v)[0]
}

func main() -> int32 {
    [int32, 4] xs
    xs[0] = 10
    xs[1] = 20
    xs[2] = 30
    xs[3] = 40

    view<[int32]> a = view(xs)
    stdout($(a).length())
    stdout($(a)[2])

    view<[int32]> b = global_value
    stdout($(b).length())
    stdout($(b)[3])

    view<[int32]> c = view(xs)
    view<[int32]> d = c
    view<[int32]> e = d
    stdout($(e)[1])

    view<[int32]> f = cast<view<[int32]>>(view(xs))
    stdout($(f)[0])
    stdout(take_dynamic(view(xs)))

    return 0
}

import "franko/stdio"

#generic struct Node<typename T> {
    T value
    [Node<T>] next
}

#generic struct List<typename T> {
    T head
    [List<T>] tail
}

func main() -> int32 {
    Node<int32> n
    n.value = 5
    n.next.init(1)
    n.next[0].value = 6
    stdout(n.value)
    stdout(n.next[0].value)

    List<int32> l
    l.head = 3
    l.tail.init(2)
    l.tail[0].head = 4
    l.tail[1].head = 5
    stdout(l.head)
    stdout(l.tail[0].head)
    stdout(l.tail[1].head)
    l.tail.uninit()
    n.next.uninit()
    return 0
}

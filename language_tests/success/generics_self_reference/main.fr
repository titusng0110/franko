import "franko/io"

#generic struct Node<typename T> {
    T value
    view<Node> next
}

#generic struct List<typename T> {
    T head
    [List<T>] tail
}

func main() -> int32 {
    Node<int32> n
    n.value = 5
    n.next = getview(n)
    print($(n.next).value)

    List<int32> l
    l.head = 3
    l.tail.init(2)
    l.tail[0].head = 4
    l.tail[1].head = 5
    print(l.head)
    print(l.tail[0].head)
    print(l.tail[1].head)
    l.tail.uninit()
    return 0
}

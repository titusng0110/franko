import "franko/io"

// ============================================================
// LANGUAGE TEST: Fluid Integer Constants
// ============================================================
// Covers: integer literals are fluid; a constant is accepted
// when its value exactly fits the context type, including
// each type's boundary value.
// ============================================================

func main() -> int32 {
    uint8 x = 255;
    int8 s = -128;
    int16 h = 32767;
    int32 w = -2147483648;
    uint64 q = 18446744073709551615;

    print(x);
    print(s);
    print(h);
    print(w);
    print(q);

    return 0;
}

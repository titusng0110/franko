// LANGUAGE TEST: declaration-level #if splicing and scoping

import "franko/io"

struct Point {
    int32 x

    #if (#is_trivial(int32)) {
        func get(view<Point> self) -> int32 {
            return $(self).x
        }
    } #else {
        func bad(view<Point> self) -> int32 {
            return 0
        }
    }
}

#if (#is_trivial(Point)) {
    struct Chosen {
        int32 y
    }
    int32 G = 7
} #else {
    struct Chosen {
        uint8 z
    }
}

namespace n {
    #if (#IS_LINUX) {
        int32 V = 3
    } #else {
        int32 V = 4
    }
}

namespace outer {
    namespace inner {
        #if (#IS_X86_64) {
            int32 W = 5
        } #else {
            int32 W = 6
        }
    }
}

#if (0) {
    struct Missing {
        int32 q
    }
}

#if (#is_trivial(G)) {
    int32 H = 8
} #else {
    int32 H = 0
}

#if (0) {
    int32 chain_value = 1
} #else #if (1) {
    int32 chain_value = 2
} #else {
    int32 chain_value = 3
}

#if (#IS_LINUX) {
    namespace chosen_namespace {
        int32 A = 11
    }
} #else {
    namespace chosen_namespace {
        int32 A = 12
    }
}

func main() -> int32 {
    Point p
    p.x = 41
    print(p.get())

    Chosen c
    c.y = G
    print(c.y)

    print(n::V)
    print(outer::inner::W)
    print(H)
    print(chosen_namespace::A)
    print(chain_value)

    #if (#is_trivial(Chosen)) {
        int32 visible = 9
    }
    print(visible)

    #if (0) { int32 dead = 1 } #else #if (1) { int32 live = 2 }
    print(live)
    return 0
}

// LANGUAGE TEST: declaration-level #if splicing and scoping
//
// The target-constant conditions below are disjunctions over every
// supported OS/architecture. Exactly one OS constant and one architecture
// constant are 1 for any supported target, so the same branch is selected
// everywhere and main.expected stays portable.

import "franko/stdio"

struct Point {
    int32 x

    #if (!#has_default_value(int32)) {
        func get(view<Point> self) -> int32 {
            return $(self).x
        }
    } #else {
        func bad(view<Point> self) -> int32 {
            return 0
        }
    }
}

#if (!#has_default_value(Point)) {
    struct Chosen {
        int32 y
    }
    int32 G = 7
} #else {
    struct Chosen {
        uint8 z
    }
}

namespace n {
    #if (#IS_LINUX || #IS_WINDOWS || #IS_MACOS) {
        int32 V = 3
    } #else {
        int32 V = 4
    }
}

namespace outer {
    namespace inner {
        #if (#IS_X86_64 || #IS_ARM64) {
            int32 W = 5
        } #else {
            int32 W = 6
        }
    }
}

#if (0) {
    struct Missing {
        int32 q
    }
}

#if (!#has_default_value(G)) {
    int32 H = 8
} #else {
    int32 H = 0
}

#if (0) {
    int32 chain_value = 1
} #else #if (1) {
    int32 chain_value = 2
} #else {
    int32 chain_value = 3
}

#if (#IS_LINUX || #IS_WINDOWS || #IS_MACOS) {
    namespace chosen_namespace {
        int32 A = 11
    }
} #else {
    namespace chosen_namespace {
        int32 A = 12
    }
}

func main() -> int32 {
    Point p
    p.x = 41
    stdout(p.get())

    Chosen c
    c.y = G
    stdout(c.y)

    stdout(n::V)
    stdout(outer::inner::W)
    stdout(H)
    stdout(chosen_namespace::A)
    stdout(chain_value)

    #if (!#has_default_value(Chosen)) {
        int32 visible = 9
    }
    stdout(visible)

    #if (0) { int32 dead = 1 } #else #if (1) { int32 live = 2 }
    stdout(live)
    return 0
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Pointers — null-initialization guarantees
// ============================================================
// Covers:
//   - a local ptr<T> declaration is guaranteed null-initialized
//   - a read-only view global is null-initialized
//   - a stacked pointer local is null-initialized
// ============================================================

view<int32> g

func main() -> int32 {
    // Local pointer declaration: null, guaranteed.
    ptr<int32> local
    stdout(local == null)

    // Read-only global view: null before any assignment.
    stdout(g == null)

    // Stacked pointer local: null.
    ptr<view<int32>> pp
    stdout(pp == null)

    return 0
}

import "franko/io"

// ============================================================
// LANGUAGE TEST: Pointers — null-initialization guarantees
// ============================================================
// Covers:
//   - a local ptr<T> declaration is guaranteed null-initialized
//   - a global ptr<T> variable is null-initialized
//   - an ptr-typed struct field is null-initialized
// ============================================================

struct Box {
    int32 v
    ptr<int32> link
}

ptr<int32> g

func main() -> int32 {
    // Local pointer declaration: null, guaranteed.
    ptr<int32> local
    print(local == null)

    // Global pointer variable: null before any assignment.
    print(g == null)

    // Pointer-typed struct field: null.
    Box b
    print(b.link == null)

    return 0
}

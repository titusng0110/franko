// ============================================================
// LANGUAGE TEST: Constant Folding
// ============================================================
// Covers: pure integer constant expressions folded at compile
// time (addition, multiplication, equality, logical not,
// shift), including a folded global initializer.
// ============================================================

int32_t g = 2 * 21;

func main() -> int32_t {
    int32_t sum = 1 + 2;
    int32_t prod = 4 * 5;
    uint8_t eq = 10 == 10;
    uint8_t notZero = !0;
    int32_t shift = 1 << 3;

    print(sum);
    print(prod);
    print(eq);
    print(notZero);
    print(shift);
    print(g);

    return 0;
}

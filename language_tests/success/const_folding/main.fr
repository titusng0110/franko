import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Constant Folding
// ============================================================
// Covers: pure integer constant expressions folded at compile
// time (addition, multiplication, equality, logical not,
// shift), including a folded global initializer.
// ============================================================

int32 g = 2 * 21;

func main() -> int32 {
    int32 sum = 1 + 2;
    int32 prod = 4 * 5;
    uint8 eq = 10 == 10;
    uint8 not_zero = !0;
    int32 shift = 1 << 3;

    stdout(sum);
    stdout(prod);
    stdout(eq);
    stdout(not_zero);
    stdout(shift);
    stdout(g);

    return 0;
}

import "franko/io"

// ============================================================
// LANGUAGE TEST: Mixed Pointer Fields in a Struct
// ============================================================
// Covers: a struct may mix plain value fields, a scalar mview field,
// a dynamic-array mview field, and a static-array view field. Copying
// the struct copies the non-owning pointers; writes through the copies
// reach the original storage. The scalar mview is a thin pointer, the
// array mview is a fat pointer, and both default-initialize to null.
// ============================================================

struct Holder {
    int32 id
    mview<int32> single
    mview<[int32]> dyn
    view<[int32, 3]> fixed
}

func main() -> int32 {
    int32 x = 7

    [int32] d
    d.init(2)
    d[0] = 10
    d[1] = 20

    [int32, 3] s
    s[0] = 1
    s[1] = 2
    s[2] = 3

    Holder empty
    print(empty.single == null)
    print(empty.dyn == null)
    print(empty.fixed == null)

    Holder h
    h.id = 5
    h.single = getmview(x)
    h.dyn = getmview(d)
    h.fixed = getview(s)

    Holder h2 = h
    print(h2.id)
    print($(h2.single))
    print($(h2.dyn)[1])
    print($(h2.fixed)[2])

    $(h2.single) = 9
    $(h2.dyn)[0] = 11
    print(x)
    print(d[0])
    print($(h2.fixed).length())

    d.uninit()
    return 0
}

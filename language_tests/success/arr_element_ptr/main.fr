// ============================================================
// LANGUAGE TEST: Array Elements as Pointable Lvalues
// ============================================================
// Covers: array elements are storage-backed lvalues (docs 15, 20.5),
// so getptr(xs[0]) is valid and yields ptr<T> for the element type;
// nested array elements are pointable when each hop is
// storage-backed; dynamic array elements are pointable too, and the
// pointed-to element can be written through $(...).
// ============================================================

func main() -> int32_t {
    // Static array element pointer.
    array<int32_t, 3> xs
    xs[0] = 7
    ptr<int32_t> p
    p = getptr(xs[0])
    $(p) = 9
    print(xs[0])
    print($(p))

    // Nested static array element pointer: each hop is storage-backed.
    array<array<int32_t, 2>, 2> m
    m[1][0] = 5
    ptr<int32_t> q
    q = getptr(m[1][0])
    $(q) = 6
    print(m[1][0])

    // Dynamic array element pointer.
    array<int32_t> dyn
    dyn.init(2)
    dyn[1] = 3
    ptr<int32_t> r
    r = getptr(dyn[1])
    $(r) = 4
    print(dyn[1])

    dyn.uninit()
    return 0
}

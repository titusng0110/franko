import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Expressions and Operators
// ============================================================
// Covers: arithmetic, relational, logical, bitwise operators,
// unary operators, shift, and operator precedence.
// ============================================================

int32 g_bit_not = ~5;

func main() -> int32 {
    // --- Arithmetic Operators ---
    int32 add = 5 + 3;
    int32 sub = 5 - 3;
    int32 mul = 5 * 3;
    int32 div = 15 / 3;

    // --- Relational Operators ---
    uint8 is_greater = 5 > 3;
    uint8 is_less = 5 < 3;
    uint8 is_eq = 5 == 5;
    uint8 is_neq = 5 != 5;
    uint8 is_ge = 5 >= 3;
    uint8 is_le = 3 <= 5;

    // --- Logical Operators ---
    uint8 logic_and = 1 && 0;
    uint8 logic_or = 1 || 0;
    uint8 logic_not = !0;

    // --- Bitwise Operators ---
    int32 bit_and = 12 & 10;
    int32 bit_or = 12 | 10;
    int32 bit_xor = 12 ^ 10;
    int32 bit_not_zero = ~0;
    int32 bit_not_five = ~5;
    int32 double_not = ~~5;
    int32 bit_not_precedence = ~0 * 2;
    uint8 byte_complement = 1;
    byte_complement = ~byte_complement;

    // --- Shift Operators ---
    int32 shift_left = 1 << 4;
    int32 shift_right = 16 >> 2;

    // --- Unary Operators ---
    int32 neg = -5;
    int32 pos = 5;

    // --- Operator Precedence ---
    // Multiplicative binds tighter than additive.
    int32 prec1 = 10 + 20 * 30; // 10 + 600 = 610
    // Shift binds tighter than relational.
    uint8 prec2 = 1 << 2 > 1; // (1 << 2) > 1 -> 4 > 1 -> 1
    // Equality binds tighter than bitwise AND.
    uint8 prec3 = 1 == 1 && 0; // (1 == 1) && 0 -> 1 && 0 -> 0

    stdout(add);
    stdout(sub);
    stdout(mul);
    stdout(div);

    stdout(is_greater);
    stdout(is_less);
    stdout(is_eq);
    stdout(is_neq);
    stdout(is_ge);
    stdout(is_le);

    stdout(logic_and);
    stdout(logic_or);
    stdout(logic_not);

    stdout(bit_and);
    stdout(bit_or);
    stdout(bit_xor);
    stdout(bit_not_zero);
    stdout(bit_not_five);
    stdout(g_bit_not);
    stdout(double_not);
    stdout(bit_not_precedence);
    stdout(byte_complement);

    stdout(shift_left);
    stdout(shift_right);

    stdout(neg);
    stdout(pos);

    stdout(prec1);
    stdout(prec2);
    stdout(prec3);

    return 0;
}

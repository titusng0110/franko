import "franko/io"

// ============================================================
// LANGUAGE TEST: Expressions and Operators
// ============================================================
// Covers: arithmetic, relational, logical, bitwise operators,
// unary operators, shift, and operator precedence.
// ============================================================

func main() -> int32 {
    // --- Arithmetic Operators ---
    int32 add = 5 + 3;
    int32 sub = 5 - 3;
    int32 mul = 5 * 3;
    int32 div = 15 / 3;

    // --- Relational Operators ---
    uint8 isGreater = 5 > 3;
    uint8 isLess = 5 < 3;
    uint8 isEq = 5 == 5;
    uint8 isNeq = 5 != 5;
    uint8 isGE = 5 >= 3;
    uint8 isLE = 3 <= 5;

    // --- Logical Operators ---
    uint8 logicAnd = 1 && 0;
    uint8 logicOr = 1 || 0;
    uint8 logicNot = !0;

    // --- Bitwise Operators ---
    int32 bitAnd = 12 & 10;
    int32 bitOr = 12 | 10;
    int32 bitXor = 12 ^ 10;

    // --- Shift Operators ---
    int32 shiftLeft = 1 << 4;
    int32 shiftRight = 16 >> 2;

    // --- Unary Operators ---
    int32 neg = -5;
    int32 pos = 5;

    // --- Operator Precedence ---
    // Multiplicative binds tighter than additive.
    int32 prec1 = 10 + 20 * 30; // 10 + 600 = 610
    // Shift binds tighter than relational.
    uint8 prec2 = 1 << 2 > 1; // (1 << 2) > 1 -> 4 > 1 -> 1
    // Equality binds tighter than bitwise AND.
    uint8 prec3 = 1 == 1 && 0; // (1 == 1) && 0 -> 1 && 0 -> 0

    print(add);
    print(sub);
    print(mul);
    print(div);

    print(isGreater);
    print(isLess);
    print(isEq);
    print(isNeq);
    print(isGE);
    print(isLE);

    print(logicAnd);
    print(logicOr);
    print(logicNot);

    print(bitAnd);
    print(bitOr);
    print(bitXor);

    print(shiftLeft);
    print(shiftRight);

    print(neg);
    print(pos);

    print(prec1);
    print(prec2);
    print(prec3);

    return 0;
}

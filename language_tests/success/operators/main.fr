import "franko/io"

// ============================================================
// LANGUAGE TEST: Expressions and Operators
// ============================================================
// Covers: arithmetic, relational, logical, bitwise operators,
// unary operators, shift, and operator precedence.
// ============================================================

func main() -> int32 {
    // --- Arithmetic Operators ---
    int32 add = 5 + 3;
    int32 sub = 5 - 3;
    int32 mul = 5 * 3;
    int32 div = 15 / 3;

    // --- Relational Operators ---
    uint8 is_greater = 5 > 3;
    uint8 is_less = 5 < 3;
    uint8 is_eq = 5 == 5;
    uint8 is_neq = 5 != 5;
    uint8 is_ge = 5 >= 3;
    uint8 is_le = 3 <= 5;

    // --- Logical Operators ---
    uint8 logic_and = 1 && 0;
    uint8 logic_or = 1 || 0;
    uint8 logic_not = !0;

    // --- Bitwise Operators ---
    int32 bit_and = 12 & 10;
    int32 bit_or = 12 | 10;
    int32 bit_xor = 12 ^ 10;

    // --- Shift Operators ---
    int32 shift_left = 1 << 4;
    int32 shift_right = 16 >> 2;

    // --- Unary Operators ---
    int32 neg = -5;
    int32 pos = 5;

    // --- Operator Precedence ---
    // Multiplicative binds tighter than additive.
    int32 prec1 = 10 + 20 * 30; // 10 + 600 = 610
    // Shift binds tighter than relational.
    uint8 prec2 = 1 << 2 > 1; // (1 << 2) > 1 -> 4 > 1 -> 1
    // Equality binds tighter than bitwise AND.
    uint8 prec3 = 1 == 1 && 0; // (1 == 1) && 0 -> 1 && 0 -> 0

    print(add);
    print(sub);
    print(mul);
    print(div);

    print(is_greater);
    print(is_less);
    print(is_eq);
    print(is_neq);
    print(is_ge);
    print(is_le);

    print(logic_and);
    print(logic_or);
    print(logic_not);

    print(bit_and);
    print(bit_or);
    print(bit_xor);

    print(shift_left);
    print(shift_right);

    print(neg);
    print(pos);

    print(prec1);
    print(prec2);
    print(prec3);

    return 0;
}

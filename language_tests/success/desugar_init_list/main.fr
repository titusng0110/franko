// ============================================================
// LANGUAGE TEST: Desugaring — Array Initializer Lists
// ============================================================
// Covers: 05-desugaring.md 5.3 and 21-array-initializer-lists.md.
//   xs = [1, 2, 3];              lowers to xs[0] = 1; xs[1] = 2; xs[2] = 3;
//   array<int32_t, 3> ys = [..]  is declaration sugar: declare, then assign
//                                the initializer list.
// Nested lists lower recursively to nested indexed assignments.
// ============================================================

func main() -> int32_t {
    // Assignment form.
    array<int32_t, 3> xs;
    xs = [1, 2, 3];
    print(xs[0]);
    print(xs[1]);
    print(xs[2]);

    // Declaration form.
    array<int32_t, 3> ys = [4, 5, 6];
    print(ys[0]);
    print(ys[1]);
    print(ys[2]);

    // Nested initializer list lowers recursively.
    array<array<int32_t, 2>, 2> matrix;
    matrix = [
        [1, 2],
        [3, 4]
    ];
    print(matrix[0][0]);
    print(matrix[0][1]);
    print(matrix[1][0]);
    print(matrix[1][1]);

    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Array Literals Are view<[T, N]> Values
// ============================================================
// Covers: array literals as ordinary expressions. A literal has
// type view<[T, N]> (N is the literal length); the element
// type T is inferred from an assignment, return, or call-argument
// context. Literals decay to view<[T]>; array-typed targets
// are rejected (copy with memcpy instead).
// ============================================================

func take(view<[int32]> v) -> int32 {
    return $(v)[0] + $(v)[2];
}

func mk() -> view<[int32, 3]> {
    return [10, 20, 30];
}

func main() -> int32 {
    // Declaration and assignment form.
    view<[int32, 3]> v = [1, 2, 3];
    stdout($(v)[0]);
    stdout($(v)[2]);

    v = [4, 5, 6];
    stdout($(v)[1]);

    // memcpy copies literal elements into an array.
    [int32, 3] buf;
    buf.memcpy([7, 8, 9]);
    stdout(buf[0]);
    stdout(buf[2]);

    // Call-argument and return contexts.
    stdout(take([100, 200, 300]));
    view<[int32, 3]> w = mk();
    stdout($(w)[2]);

    // Decay to a dynamic view.
    view<[int32]> d = [1, 2, 3, 4];
    stdout($(d)[3]);

    return 0;
}

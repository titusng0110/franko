import "franko/stdio"

// Compound assignment: += -= *= /= %= &= |= ^=
//
// Covers all eight operators, non-trivial targets (array element, struct
// field, dereference, global), fluid constants on the right-hand side,
// and the single-evaluation guarantee: the target of a compound
// assignment is evaluated exactly once.

struct Counter {
    int32 n
}

int32 g = 2

func idx() -> uint32 {
    stdout(-1); // marker: this call happens exactly once per statement
    return 1;
}

func main() -> int32 {
    int32 x = 10;
    x += 5;
    x -= 3;
    x *= 4;
    x /= 2;
    x %= 4;
    stdout(x); // ((10 + 5 - 3) * 4 / 2) % 4 = 0

    [int32, 4] xs;
    xs.memcpy([1, 2, 3, 4]);
    xs[idx()] += 10;
    stdout(xs[1]); // marker once, then 12

    Counter c;
    c.n = 7;
    c.n *= 6;
    stdout(c.n); // 42

    int32 v = 5;
    ptr<int32> p = getptr(v);
    $(p) += 100;
    $(p) /= 3;
    stdout(v); // (5 + 100) / 3 = 35

    uint8 u = 200;
    u += 55;
    stdout(u); // 255
    u -= 254;
    stdout(u); // 1

    int32 i = 0;
    int32 sum = 0;
    for (; i < 4; i += 1) {
        sum += i;
    }
    stdout(sum); // 6
    stdout(i); // 4

    g *= 21;
    stdout(g); // 42

    // Compound assignment as a braceless controlled statement.
    int32 br = 1;
    if (br == 1) br += 10;
    stdout(br); // 11

    // Compound assignment in a for-update position.
    int32 step = 0;
    int32 end = 0;
    for (int32 t = 0; t < 3; t += 1) {
        step = t;
        end += 2;
    }
    stdout(step); // 2
    stdout(end); // 6

    // Bitwise compound assignment: &= |= ^=
    int32 mask = 0b1100;
    mask &= 0b1010;
    mask |= 0b0001;
    mask ^= 0b1111;
    stdout(mask); // 6

    uint8 flags = 0xF0;
    flags &= 0x0F;
    flags |= 0x80;
    flags ^= 0xFF;
    stdout(flags); // 127

    xs[0] |= 8;
    xs[1] &= 7;
    xs[2] ^= 5;
    stdout(xs[0]); // 9
    stdout(xs[1]); // 4
    stdout(xs[2]); // 6

    c.n ^= 3;
    stdout(c.n); // 41

    $(p) |= 8;
    stdout(v); // 43

    g |= 16;
    stdout(g); // 58

    return 0;
}

import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Struct Name Clash with a Variable and a Function
// ============================================================
// Covers: struct names live in their own namespace, so a struct
// may share its name with a variable and a function. The compiler
// emits a warning (not part of program output) and the generated
// code is unambiguous. The shared 'Item' spelling is deliberately
// outside the normal casing conventions to exercise the clash.
// ============================================================

struct Item {
    int32 id = 1
}

func Item() -> int32 {
    return 100;
}

func main() -> int32 {
    // Variable named 'Item' of struct type 'Item'.
    Item Item;
    Item.id = 5;
    stdout(Item.id);

    // In a call position, Item(...) resolves to the function.
    stdout(Item());

    // The struct type still names a type for other variables.
    Item other;
    other.id = 9;
    stdout(other.id);

    return 0;
}

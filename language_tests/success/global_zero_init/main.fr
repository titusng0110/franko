import "franko/stdio"

// ============================================================
// LANGUAGE TEST: Global zero-initialization
// ============================================================
// Covers: uninitialized passable-by-value globals are statically
// allocated and zero/default-initialized before main runs.
// ============================================================

struct Zero {
    int32 a
    int32 b
    int32 c
    int32 d
    int32 extra
}

int32 gz

Zero gz_struct

func main() -> int32 {
    stdout(gz)
    stdout(gz_struct.a)
    stdout(gz_struct.b)
    stdout(gz_struct.c)
    stdout(gz_struct.d)
    stdout(gz_struct.extra == 0)
    return 0
}

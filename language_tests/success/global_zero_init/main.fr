import "franko/io"

// ============================================================
// LANGUAGE TEST: Global zero-initialization
// ============================================================
// Covers: uninitialized globals are statically allocated and
// zero-initialized before main runs (primitives and static arrays).
// ============================================================

int32 gz

[int32, 4] garr

func main() -> int32 {
    print(gz)
    print(garr[0])
    print(garr[1])
    print(garr[2])
    print(garr[3])
    return 0
}

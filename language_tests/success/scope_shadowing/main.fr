import "franko/io"

// ============================================================
// LANGUAGE TEST: Scoping — Shadowing
// ============================================================
// Covers: shadowing in nested inner blocks at two depths.
// Each block redeclares 'x', so every print resolves to the
// nearest declaration in the current scope stack.
// ============================================================

func main() -> int32 {
    int32 x = 1
    print(x)          // outermost x

    {
        int32 x = 2  // depth-1 shadow
        print(x)

        {
            int32 x = 3  // depth-2 shadow
            print(x)
            x = 30          // assigns the depth-2 x only
            print(x)
        }

        print(x)       // depth-2 shadow is out of scope again
        x = 20          // assigns the depth-1 x only
        print(x)
    }

    print(x)          // outermost x was never touched
    return 0
}

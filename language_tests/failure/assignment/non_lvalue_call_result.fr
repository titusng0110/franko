// Failure fixture: assignment/non_lvalue_call_result
// The left-hand side of an assignment must be a storage-backed lvalue
// (docs 14, 15): a function-call result is not storage-backed, so
// `f() = 4` is rejected.
func f() -> int32_t {
    return 1
}

func main() -> int32_t {
    f() = 4
    return 0
}

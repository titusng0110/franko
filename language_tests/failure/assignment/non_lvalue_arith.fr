// Failure fixture: assignment/non_lvalue_arith
// The left-hand side of an assignment must be a storage-backed lvalue
// (docs 14, 15): an arithmetic expression is not storage-backed, so
// `a + b = 3` is rejected.
func main() -> int32 {
    int32 a = 1
    int32 b = 2

    a + b = 3

    return 0
}

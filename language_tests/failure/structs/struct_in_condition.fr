import "franko/io"

// Failure fixture: structs/struct_in_condition
// Structs are not integers: if/while conditions reject whole structs; conditions require integer expressions.
struct X {
    int32 a
}

func main() -> int32 {
    X s;

    s.a = 1;

    if (s) {
        print(1);
    }

    return 0;
}

// Failure fixture: operators/modulo_non_integral
// `%` requires integer operands exactly like the other arithmetic
// operators: addresses and arrays are rejected (doc 17.3).
func main() -> int32_t {
    int32_t v = 1;
    addr<int32_t> p = getaddr(v);
    array<int32_t, 2> xs = [1, 2];

    print(p % 3);
    print(xs % 3);

    return 0;
}

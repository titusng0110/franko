// Failure fixture: operators/comparison_result_type_mismatch
// Comparisons always produce uint8 (docs 17.6, 17.9), and there are no
// implicit numeric conversions for nonconstants (doc 31.6), so a
// comparison result does not assign to int32.
func main() -> int32 {
    uint8 cmp = 1 < 2
    int32 y = cmp
    print(y)
    return 0
}

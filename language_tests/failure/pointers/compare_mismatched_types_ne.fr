// Failure fixture: pointers/compare_mismatched_types_ne
// Pointer comparison requires identical pointer types (docs 17.6, 24.5):
// ptr<int32> and ptr<uint8> are different pointer types, so '!='
// rejects the comparison.
func main() -> int32 {
    int32 x = 0
    uint8 b = 0

    ptr<int32> p = getptr(x)
    ptr<uint8> q = getptr(b)

    print(p != q)

    return 0
}

// uninit() through a decayed view is blocked twice over: the view region
// is read-only, and the borrowed descriptor must never be freed anyway.
func main() -> int32 {
    [[int32], 2] g;
    g[0].init(2);
    g[1].init(2);
    view<[[int32], 2]> v = getview(g);
    view<[[int32]]> d = v;
    $(d)[0].uninit();
    return 0;
}

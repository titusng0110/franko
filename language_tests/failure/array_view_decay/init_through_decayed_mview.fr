// Lifecycle intrinsics never survive the decay: the decayed type is
// view<[T]> and lifecycle permissions are not part of the conversion,
// so init() cannot allocate over storage the static array owns.
func main() -> int32 {
    [[int32], 2] g;
    g[0].init(2);
    g[1].init(2);
    mview<[[int32], 2]> m = getmview(g);
    mview<[[int32]]> d = m;
    $(d)[0].init(5);
    return 0;
}

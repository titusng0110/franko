// Two decay overloads that need the same number of conversion steps are
// ambiguous.
func h(mview<[int32]> x) -> uint32 {
    return 1;
}
func h(view<[int32]> x) -> uint32 {
    return 2;
}
func main() -> int32 {
    [int32, 3] xs;
    mview<[int32, 3]> m = getmview(xs);
    print(h(m));
    return 0;
}

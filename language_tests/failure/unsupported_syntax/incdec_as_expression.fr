import "franko/stdio"

// Failure fixture: unsupported_syntax/incdec_as_expression
// `++` and `--` are statement forms only: they never produce a value, so
// `a++` cannot appear as a call argument and `stdout(a++)` does not parse.
func main() -> int32 {
    int32 a = 1;
    stdout(a++);
    return 0;
}

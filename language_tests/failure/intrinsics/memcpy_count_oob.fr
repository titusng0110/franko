// checked against the static sizes at compile time; a count past the
// array size overruns both the destination and the source here.
func main() -> int32_t {
    array<int32_t, 4> a;
    array<int32_t, 4> b;
    a.memset(0);
    b.memset(0);
    a.memcpy(getptr(b), 0, 0, 5);

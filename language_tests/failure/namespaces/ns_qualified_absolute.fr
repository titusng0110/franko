import "franko/io"

// Failure fixture: namespaces/ns_qualified_absolute
// Qualified names resolve strictly from the top level: `b::c::w`
// used inside namespace `a` does not resolve relatively to
// `a::b::c::w`.
namespace a {
    namespace b {
        namespace c {
            int32 w = 5
        }
    }
    func read() -> int32 {
        return b::c::w
    }
}

func main() -> int32 {
    print(a::read())
    return 0
}

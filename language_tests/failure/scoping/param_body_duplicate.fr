// Failure fixture: scoping/param_body_duplicate
// Function body braces do not create an extra scope, so a body-level
// declaration reusing a parameter name is a duplicate-declaration error.
func f(int32 x) -> int32 {
    int32 x
    x = 2
    return x
}

func main() -> int32 {
    print(f(1))
    return 0
}

// Rule 2: the extracted view locks its own pointee even though the
// outer array is accessed through an mview.
func main() -> int32 {
    [byte] t;
    t.init(3);
    [view<[byte]>] slots;
    slots.init(1);
    slots[0] = getview(t);
    mview<[view<[byte]>]> m = getmview(slots);
    $($(m)[0])[0] = 5;
    return 0;
}

// Rule 2: a view of an array of mviews forbids overwriting the
// pointer slots themselves.
func main() -> int32 {
    [byte] a;
    a.init(2);
    [mview<[byte]>] store;
    store.init(1);
    store[0] = getmview(a);
    view<[mview<[byte]>]> v = getview(store);
    $(v)[0] = getmview(a);
    return 0;
}

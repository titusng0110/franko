// Failure fixture: ptr_deref_null/null_guard_inside_deref
// Dereferencing inside a null guard after a branch merge:
// inside `if (p7 == null)` the state is definitely null.
func main() -> int32 {
    int32 x7 = 0
    ptr<int32> p7

    if (x7 != 0) {
        p7 = getptr(x7)
    } else {
        p7 = null
    }

    if (p7 == null) {
        print($(p7))
    }

    return 0
}

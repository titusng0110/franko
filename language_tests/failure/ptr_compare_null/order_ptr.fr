// Failure fixture: ptr_compare_null/order_ptr
// Pointer comparison is equality-only: ordering comparison between
// two pointers is invalid.
func main() -> int32_t {
    int32_t x2 = 0
    ptr<int32_t> p2
    ptr<int32_t> q2

    p2 = getptr(x2)
    q2 = getptr(x2)

    print(p2 < q2)

    return 0
}

import "franko/stdio"

// Runtime fixture: intrinsics/memmem_uninit_needle
// The needle is passed as a caller-owned pointer, so the checker cannot
// prove it is uninitialized; the runtime aborts.
func find(
    ptr<[byte, 4]> hay,
    ptr<[byte]> needle
) -> uint32 {
    return $(hay).memmem(needle)
}

func main() -> int32 {
    [byte, 4] hay
    hay.memset(0)
    [byte] needle
    stdout(find(getptr(hay), getptr(needle)))
    return 0
}

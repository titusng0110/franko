import "franko/io"

// Runtime fixture: intrinsics/memchr_uninit
// Searching through a caller-owned pointer hides the definite state from
// the intra-procedural checker; the runtime aborts.
func search(ptr<[byte]> p) -> uint32 {
    return $(p).memchr(0)
}

func main() -> int32 {
    [byte] buf
    print(search(getptr(buf)))
    return 0
}

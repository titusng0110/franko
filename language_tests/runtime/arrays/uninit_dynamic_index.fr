import "franko/io"

// Runtime fixture: arrays/uninit_dynamic_index
// The uninitialized read happens through a caller-owned pointer, so the
// intra-procedural checker cannot prove it and the array runtime aborts.
func read_first(ptr<[int32]> p) -> int32 {
    return $(p)[0]
}

func main() -> int32 {
    [int32] xs
    print(read_first(getptr(xs)))
    return 0
}

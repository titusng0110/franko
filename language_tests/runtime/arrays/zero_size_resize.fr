// Runtime fixture: arrays/zero_size_resize
// A nonconstant zero size passes compile-time checking (nonconstant sizes
// must have exactly type uint32) and the array runtime raises a runtime
// error on zero-size reallocation (docs 20.3, 21.2).
func main() -> int32 {
    uint32 n = 0
    [int32] xs
    xs.init(4)
    xs.resize(n)
    return 0
}

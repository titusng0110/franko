import "franko/io"

// Runtime fixture: arrays/double_init
// A repeated init is not rejected by the checker because an earlier init
// may have failed with -1 and a retry is valid. The array runtime still
// raises a runtime error on a true double init.
func main() -> int32 {
    [int32] xs
    xs.init(4)
    xs.init(4)
    print(xs[0])
    return 0
}

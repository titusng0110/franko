import "franko/io"

// Runtime fixture: arrays/double_init
// Initializing a dynamic array twice is not fully proven at compile time
// (doc 20.7); the array runtime raises a runtime error (doc 32.3).
func main() -> int32 {
    [int32] xs
    xs.init(4)
    xs.init(4)
    print(xs[0])
    return 0
}

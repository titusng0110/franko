// Runtime fixture: print/print_real_pointer
// Printing a live pointer compiles and runs (docs 19.6, 31.7), but its
// value is not deterministic, so it must never be compared as a golden
// output. This fixture exercises the print and then aborts at runtime
// (uninitialized dynamic array access), so the run is judged by exit
// status only.
func main() -> int32_t {
    int32_t x = 1
    ptr<int32_t> p = getptr(x)

    print(p)

    array<int32_t> xs = [1, 2]
    print(xs[0])

    return 0
}

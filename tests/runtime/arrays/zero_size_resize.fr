// Runtime fixture: arrays/zero_size_resize
// A nonconstant zero size passes compile-time checking (nonconstant sizes
// must have exactly type uint32_t) and the array runtime raises a runtime
// error on zero-size reallocation (docs 19.3, 20.2).
func main() -> int32_t {
    uint32_t n = 0
    array<int32_t> xs
    xs.init(4)
    xs.resize(n)
    return 0
}

// Failure fixture: addr_compare_null/order_addr
// Address comparison is equality-only: ordering comparison between
// two addresses is invalid.
func main() -> int32_t {
    int32_t x2 = 0
    addr<int32_t> p2
    addr<int32_t> q2

    p2 = getaddr(x2)
    q2 = getaddr(x2)

    print(p2 < q2)

    return 0
}

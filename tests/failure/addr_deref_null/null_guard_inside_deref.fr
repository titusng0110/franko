// Failure fixture: addr_deref_null/null_guard_inside_deref
// Dereferencing inside a null guard after a branch merge:
// inside `if (p7 == null)` the state is definitely null.
func main() -> int32_t {
    int32_t x7 = 0
    addr<int32_t> p7

    if (x7 != 0) {
        p7 = getaddr(x7)
    } else {
        p7 = null
    }

    if (p7 == null) {
        print(deref(p7))
    }

    return 0
}

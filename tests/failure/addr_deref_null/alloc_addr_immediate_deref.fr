// Failure fixture: addr_deref_null/alloc_addr_immediate_deref
// The heap slot of an `alloc addr<T>` is null-initialized (docs: the storage
// of an alloc'd address is null-initialized; verified against the generated
// C++ where `h == null` is true right after the declaration).
//
// Therefore dereferencing it before assigning getaddr(...) must be an error.
//
// NOTE: this fixture is a regression test for the MemorySafetyChecker fix:
// the checker used to mark a fresh `alloc addr<T>` as POINTING and accepted
// this program, which segfaults at runtime.
func main() -> int32_t {
    int32_t x = 0
    alloc addr<int32_t> h

    deref(h) = 5
    print(deref(h))

    h = getaddr(x)
    print(deref(h))
    del h
    return 0
}

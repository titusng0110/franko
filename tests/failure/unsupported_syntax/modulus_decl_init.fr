// Failure fixture: unsupported_syntax/modulus_decl_init
// The modulus operator '%' does not exist in the language; the lexer must
// reject it outright (docs: unsupported operators).
//
// Regression guard: ANTLR's lexer used to silently DROP the '%' character,
// so in declaration-initializer position `int32_t c = a % b;` was accepted
// (parsed as `c = a` followed by a bare `b;`). The driver now fails on any
// lexer error; if this fixture ever goes red again, unrecognized characters
// are being skipped.
func main() -> int32_t {
    int32_t a = 10
    int32_t b = 3
    int32_t c = a % b
    print(c)
    return 0
}

// Failure fixture: type_equality/uint8_vs_uint16
// Assigning a nonconstant uint16_t variable to a uint8_t variable violates
// exact primitive type equality (uint8_t != uint16_t, doc 28.1); there are no
// implicit numeric conversions for nonconstants (doc 30.6).

func main() -> int32_t {
    uint16_t big = 300;
    uint8_t small;
    small = big;
    return 0;
}

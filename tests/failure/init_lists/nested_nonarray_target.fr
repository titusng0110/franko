// target element is itself an array (doc 21.7): xs[0] is int32_t here, so
// the generated xs[0] = [1, 2] is rejected.
func main() -> int32_t {
    array<int32_t, 2> xs;
    xs = [[1, 2], [3, 4]];
    return 0;
}

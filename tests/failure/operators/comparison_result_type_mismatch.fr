// Failure fixture: operators/comparison_result_type_mismatch
// Comparisons always produce uint8_t (docs 16.6, 16.9), and there are no
// implicit numeric conversions for nonconstants (doc 29.6), so a
// comparison result does not assign to int32_t.
func main() -> int32_t {
    uint8_t cmp = 1 < 2
    int32_t y = cmp
    print(y)
    return 0
}

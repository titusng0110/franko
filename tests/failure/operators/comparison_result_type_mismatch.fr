// Failure fixture: operators/comparison_result_type_mismatch
// Comparisons always produce uint8_t (docs 16.6, 16.9). A comparison
// result widens to int32_t under the one-way widening rule (doc 14.1),
// but a nonconstant int32_t never narrows back to uint8_t: widening is
// value-preserving only, so the final assignment is still rejected.
func main() -> int32_t {
    uint8_t cmp = 1 < 2
    int32_t y = cmp
    uint8_t z = y
    print(z)
    return 0
}

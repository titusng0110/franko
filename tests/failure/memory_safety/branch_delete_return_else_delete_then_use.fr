// Failure fixture: memory_safety/branch_delete_return_else_delete_then_use
// One branch deletes and returns; the other branch deletes and continues,
// then the variable is used after the merge.
func main() -> int32_t {
    alloc int32_t x8
    int32_t cond8 = 1

    if (cond8 != 0) {
        del x8
        return 0
    } else {
        del x8
    }

    print(x8)

    return 0
}

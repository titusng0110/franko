// Failure fixture: memory_safety/compact_branch_torture
// A compact branch maze that uses and deletes a heap variable on paths
// that merge with different deletion outcomes.
func main() -> int32_t {
    alloc int32_t x26
    int32_t a26 = 1
    int32_t b26 = 1

    if (a26 != 0) {
        if (b26 != 0) {
            del x26
            return 0
        } else {
            print(x26)
        }
    } else {
        del x26
    }

    print(x26)
    del x26

    return 0
}

// Failure fixture: memory_safety/nested_maybe_delete
// Deletion happens only on one nested path; the variable is used after the merge.
func main() -> int32_t {
    alloc int32_t x10
    int32_t a10 = 1
    int32_t b10 = 1

    if (a10 != 0) {
        if (b10 != 0) {
            del x10
        }
    }

    print(x10)

    return 0
}

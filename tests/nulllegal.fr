// ============================================================
// Franko null-for-addresses Torture Test (legality stage)
// ============================================================
//
// This file is expected to FAIL legality checking.
//
// It collects the null-related rules enforced by the legality pass:
//
//   - null is only valid for address types,
//   - integer 0 is not null,
//   - address comparison is equality-only (== and !=),
//   - null comparison is equality-only and address-only.
//
// Violations rejected earlier (during semantic analysis), such as
// deref(null) and passing null to a non-address overload, abort before
// legality runs and are therefore not mixed into this file.
// ============================================================


// ------------------------------------------------------------
// 1. Address compared with integer 0
// ------------------------------------------------------------

func testcase1() -> int32_t {
    int32_t x1 = 0
    addr<int32_t> p1

    p1 = getaddr(x1)

    print(p1 == 0)

    return 0
}


// ------------------------------------------------------------
// 2. Ordering comparison between two addresses
// ------------------------------------------------------------

func testcase2() -> int32_t {
    int32_t x2 = 0
    addr<int32_t> p2
    addr<int32_t> q2

    p2 = getaddr(x2)
    q2 = getaddr(x2)

    print(p2 < q2)

    return 0
}


// ------------------------------------------------------------
// 3. Ordering comparison between an address and null
// ------------------------------------------------------------

func testcase3() -> int32_t {
    addr<int32_t> p3

    print(p3 < null)

    return 0
}


// ------------------------------------------------------------
// 4. Null compared with a non-address value
// ------------------------------------------------------------

func testcase4() -> int32_t {
    print(null == 5)

    return 0
}


// ------------------------------------------------------------
// 5. Integer 0 assigned to an address
// ------------------------------------------------------------

func testcase5() -> int32_t {
    addr<int32_t> p5

    p5 = 0

    return 0
}


// ------------------------------------------------------------
// 6. null assigned to a non-address variable
// ------------------------------------------------------------

func testcase6() -> int32_t {
    int32_t x6 = null

    return 0
}


func main() -> int32_t {
    testcase1()
    testcase2()
    testcase3()
    testcase4()
    testcase5()
    testcase6()

    return 0
}

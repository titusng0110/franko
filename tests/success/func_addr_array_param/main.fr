// ============================================================
// SPEC TEST: Array Parameters via addr<array<T>>
// ============================================================
// Covers: passing arrays to functions through addr<array<T>>
// and addr<array<T, N>> parameters with getaddr(array) at the
// call site; the callee writes through $(p)[i].
// ============================================================

func fillDynamic(addr<array<int32_t>> p) -> void {
    $(p)[0] = 11;
    $(p)[1] = 22;
    $(p)[2] = 33;
    $(p)[3] = 44;
}

func fillStatic(addr<array<int32_t, 8>> p) -> void {
    $(p)[0] = 5;
    $(p)[7] = 9;
}

func main() -> int32_t {
    array<int32_t> xs;
    xs.init_zero(4);
    fillDynamic(getaddr(xs));
    print(xs[0], xs[1], xs[2], xs[3]);

    array<int32_t, 8> grid;
    fillStatic(getaddr(grid));
    print(grid[0], grid[7]);

    xs.uninit();
    return 0;
}

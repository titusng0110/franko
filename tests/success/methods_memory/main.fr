// ============================================================
// SPEC TEST: Methods Memory Lifecycle
// ============================================================
// Covers: doc 26.8, doc 28.4
// Dynamic-array fields managed through methods, on stack and heap
// structs, with setup/teardown pairing checked by memory safety.
// ============================================================

struct Buf {
    array<int32_t> data
    func setup(addr<Buf> self, uint32_t n) -> int32_t {
        return deref(self).data.init_zero(n)
    }
    func set(addr<Buf> self, uint32_t i, int32_t v) -> void {
        deref(self).data[i] = v
        return
    }
    func get(addr<Buf> self, uint32_t i) -> int32_t {
        return deref(self).data[i]
    }
    func teardown(addr<Buf> self) -> void {
        deref(self).data.uninit()
        return
    }
}

func main() -> int32_t {
    Buf b
    b.setup(3)
    b.set(0, 11)
    b.set(2, 33)
    print(b.get(0), b.get(1), b.get(2))
    b.teardown()
    alloc Buf h
    h.setup(2)
    h.set(1, 99)
    print(h.get(0), h.get(1))
    h.teardown()
    del h
    return 0
}

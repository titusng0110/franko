// ============================================================
// SPEC TEST: Type Equality - Alias Canonicalization
// ============================================================
// Covers: `int`/`int32_t`, `byte`/`uint8_t`, and `uint`/`uint32_t`
// are the same types after alias canonicalization (doc 28.1), so
// values flow between aliased and canonical spellings in both
// directions without conversion.
// ============================================================

func main() -> int32_t {
    // int <-> int32_t
    int i = 42;
    int32_t j = i;
    int k = j;

    // byte <-> uint8_t
    byte by = 200;
    uint8_t u8 = by;
    byte by2 = u8;

    // uint <-> uint32_t
    uint u = 3000000000;
    uint32_t u32 = u;
    uint u2 = u32;

    print(i);
    print(j);
    print(k);
    print(by);
    print(u8);
    print(by2);
    print(u);
    print(u32);
    print(u2);
    return 0;
}

// ============================================================
// SPEC TEST: Desugaring — Dynamic Array Call-Init Declaration
// ============================================================
// Covers: 05-desugaring.md 5.2.
//   array<int32_t> arr(20);        desugars to
//   array<int32_t> arr; arr(20);
// The call form is the dynamic-array init intrinsic sugar.
// ============================================================

func main() -> int32_t {
    // Stack dynamic array with call-init declaration sugar.
    array<int32_t> arr(20);
    arr[0] = 7;
    arr[19] = 9;
    print(arr[0]);
    print(arr[19]);
    arr.uninit();

    return 0;
}

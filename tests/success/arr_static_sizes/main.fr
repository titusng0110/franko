// ============================================================
// SPEC TEST: Static Array Sizes
// ============================================================
// Covers: static array sizes written as decimal, hex, binary,
// and constant expressions; element assignment and printing.
// ============================================================

func main() -> int32_t {
    array<int32_t, 1> a;
    array<int32_t, 0x10> b;
    array<int32_t, 0b1000> c;
    array<int32_t, 1 + 2> d;

    a[0] = 11;

    b[0] = 21;
    b[0xF] = 22;

    c[0] = 31;
    c[0b111] = 32;

    d[0] = 41;
    d[1] = 42;
    d[2] = 43;

    print(a[0]);
    print(b[0], b[0xF]);
    print(c[0], c[0b111]);
    print(d[0], d[1], d[2]);

    return 0;
}

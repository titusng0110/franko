// ============================================================
// SPEC TEST: Addresses — nested addresses and arrays behind addr
// ============================================================
// Covers:
//   - addr<addr<int32_t>>: getaddr of an addr variable, double
//     dereference to write and read through both levels
//   - addr<array<int32_t>>: $(p)(n) allocation shorthand and
//     element writes through the dereference
//   - addr<array<int32_t, 3>>: initializer-list assignment through
//     the dereference
// ============================================================

func main() -> int32_t {
    // --- Nested addresses: address of an address variable ---
    int32_t x = 0
    addr<int32_t> p
    p = getaddr(x)

    addr<addr<int32_t>> pp
    pp = getaddr(p)

    // Double dereference writes x through both address levels.
    $($(pp)) = 7
    print($($(pp)))
    print(x)

    // Writes through p are visible through pp (same pointee).
    $(p) = 8
    print($($(pp)))

    // --- Address of a dynamic array ---
    array<int32_t> dyn
    addr<array<int32_t>> ap
    ap = getaddr(dyn)

    // Allocation shorthand: $(ap)(4) is $(ap).init(4).
    $(ap)(4)
    $(ap)[0] = 10
    $(ap)[3] = 40
    print($(ap)[0])
    print($(ap)[3])
    print(dyn[3])

    dyn.uninit()

    // --- Address of a static array: initializer list through deref ---
    array<int32_t, 3> xs
    addr<array<int32_t, 3>> sp
    sp = getaddr(xs)

    // Equivalent to $(sp)[0] = 1; $(sp)[1] = 2; $(sp)[2] = 3;
    $(sp) = [1, 2, 3]
    print($(sp)[0])
    print($(sp)[1])
    print($(sp)[2])
    print(xs[2])

    return 0
}

// ============================================================
// SPEC TEST: Nested Initializer Lists
// ============================================================
// Covers: nested initializer lists recursively lower to
// indexed assignments into nested arrays.
// ============================================================

func main() -> int32_t {
    array<array<int32_t, 2>, 2> matrix;
    matrix = [[1, 2], [3, 4]];

    print(matrix[0][0]);
    print(matrix[0][1]);
    print(matrix[1][0]);
    print(matrix[1][1]);

    return 0;
}

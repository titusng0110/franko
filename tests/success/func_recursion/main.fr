// ============================================================
// SPEC TEST: Function Recursion
// ============================================================
// Covers: direct recursion (factorial) and mutual recursion
// (isEven/isOdd) enabled by forward reference registration.
// ============================================================

func factorial(int32_t n) -> int32_t {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

func isEven(int32_t n) -> int32_t {
    if (n == 0) {
        return 1;
    }
    return isOdd(n - 1);
}

func isOdd(int32_t n) -> int32_t {
    if (n == 0) {
        return 0;
    }
    return isEven(n - 1);
}

func main() -> int32_t {
    print(factorial(5));
    print(isEven(4));
    print(isEven(7));
    print(isOdd(7));
    return 0;
}

// ============================================================
// SPEC TEST: Namespaces and Print Statements
// ============================================================
// Covers: namespace declarations, qualified names (a::b),
// unqualified references inside namespaces, and the dedicated
// print statement.
// ============================================================

// --- Namespace declaration ---
namespace math {
    int32_t scale = 10

    struct Vec2 {
        int32_t x
        int32_t y
    }

    func scaleUp(int32_t v) -> int32_t {
        return v * scale
    }
}

// --- Global functions and variables ---
int32_t globalOffset = 100;

func main() -> int32_t {
    // --- Print statements (dedicated statement, not a function) ---
    print(123);
    print(1, 2, 3);
    print();

    // --- Namespace member access ---
    print(math::scale);
    print(math::scaleUp(5));

    // --- Qualified struct references ---
    math::Vec2 p;
    p.x = 10;
    p.y = 20;
    print(p.x + p.y);

    // --- Struct declaration initializer sugar ---
    math::Vec2 origin;
    origin.x = 1;
    origin.y = 2;
    print(origin.x + origin.y);

    // --- Global variables ---
    print(globalOffset);

    return 0;
}

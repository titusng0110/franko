// ============================================================
// SPEC TEST: Struct Assignability
// ============================================================
// Covers: whole-value assignment a = b for an all-primitive-fields
// struct (modifying b after the copy leaves a unchanged, proving
// each field was copied), passing an assignable struct by value,
// and returning one by value.
// ============================================================

struct Pair {
    int32_t first
    int32_t second = 0
}

// By-value parameter of an assignable struct type.
func sumOf(Pair p) -> int32_t {
    return p.first + p.second;
}

// By-value return of an assignable struct type.
func makePair(int32_t a, int32_t b) -> Pair {
    Pair p;
    p.first = a;
    p.second = b;
    return p;
}

func main() -> int32_t {
    Pair a;
    Pair b;
    b.first = 3;
    b.second = 4;

    // Whole-value assignment: copies every field.
    a = b;

    // Modifying b after the copy must not change a.
    b.first = 100;
    b.second = 200;
    print(a.first, a.second);

    // Argument copied at the call.
    print(sumOf(a));

    // By-value return bound through declaration initializer sugar.
    Pair c = makePair(7, 8);
    print(c.first, c.second);

    return 0;
}

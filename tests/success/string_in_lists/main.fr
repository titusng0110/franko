// ============================================================
// SPEC TEST: Strings Inside Array Initializer Lists
// ============================================================
// Covers: string literals as elements of an array initializer
// list; each string becomes a nested byte list. ["hi", "ok"]
// lowers to byte assignments 104 105 and 111 107.
// ============================================================

func main() -> int32_t {
    array<array<byte, 3>, 2> m;
    m = ["hi", "ok"];

    print(m[0][0]);
    print(m[0][1]);
    print(m[1][0]);
    print(m[1][1]);

    return 0;
}

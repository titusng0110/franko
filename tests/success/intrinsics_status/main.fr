// ============================================================
// SPEC TEST: Intrinsic Status Values
// ============================================================
// Covers: status-returning intrinsics (init, init_zero,
// resize, and the target(size) shorthand) used in value
// contexts; 0 means success.
// ============================================================

func main() -> int32_t {
    array<int32_t> xs;
    int32_t status = xs.init(4);
    print(status);
    xs[0] = 42;
    status = xs.resize(8);
    print(status);
    xs[7] = 43;
    print(xs[0], xs[7]);

    array<int32_t> ys;
    int32_t s2 = ys.init_zero(3);
    print(s2);

    array<int32_t> zs;
    int32_t s3 = zs(2);
    print(s3);

    ys.uninit();
    zs.uninit();
    xs.uninit();

    return 0;
}

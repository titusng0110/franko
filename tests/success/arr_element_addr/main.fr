// ============================================================
// SPEC TEST: Array Elements as Addressable Lvalues
// ============================================================
// Covers: array elements are storage-backed lvalues (docs 15, 19.5),
// so getaddr(xs[0]) is valid and yields addr<T> for the element type;
// nested array elements are addressable when each hop is
// storage-backed; dynamic array elements are addressable too, and the
// pointed-to element can be written through deref(...).
// ============================================================

func main() -> int32_t {
    // Static array element address.
    array<int32_t, 3> xs
    xs[0] = 7
    addr<int32_t> p
    p = getaddr(xs[0])
    deref(p) = 9
    print(xs[0])
    print(deref(p))

    // Nested static array element address: each hop is storage-backed.
    array<array<int32_t, 2>, 2> m
    m[1][0] = 5
    addr<int32_t> q
    q = getaddr(m[1][0])
    deref(q) = 6
    print(m[1][0])

    // Dynamic array element address.
    array<int32_t> dyn
    dyn.init(2)
    dyn[1] = 3
    addr<int32_t> r
    r = getaddr(dyn[1])
    deref(r) = 4
    print(dyn[1])

    dyn.uninit()
    return 0
}

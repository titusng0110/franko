// ============================================================
// SPEC TEST: Expressions and Operators
// ============================================================
// Covers: arithmetic, relational, logical, bitwise operators,
// unary operators, shift, and operator precedence.
// ============================================================

func main() -> int32_t {
    // --- Arithmetic Operators ---
    int32_t add = 5 + 3;
    int32_t sub = 5 - 3;
    int32_t mul = 5 * 3;
    int32_t div = 15 / 3;

    // --- Relational Operators ---
    uint8_t isGreater = 5 > 3;
    uint8_t isLess = 5 < 3;
    uint8_t isEq = 5 == 5;
    uint8_t isNeq = 5 != 5;
    uint8_t isGE = 5 >= 3;
    uint8_t isLE = 3 <= 5;

    // --- Logical Operators ---
    uint8_t logicAnd = 1 && 0;
    uint8_t logicOr = 1 || 0;
    uint8_t logicNot = !0;

    // --- Bitwise Operators ---
    int32_t bitAnd = 12 & 10;
    int32_t bitOr = 12 | 10;
    int32_t bitXor = 12 ^ 10;

    // --- Shift Operators ---
    int32_t shiftLeft = 1 << 4;
    int32_t shiftRight = 16 >> 2;

    // --- Unary Operators ---
    int32_t neg = -5;
    int32_t pos = 5;

    // --- Operator Precedence ---
    // Multiplicative binds tighter than additive.
    int32_t prec1 = 10 + 20 * 30; // 10 + 600 = 610
    // Shift binds tighter than relational.
    uint8_t prec2 = 1 << 2 > 1; // (1 << 2) > 1 -> 4 > 1 -> 1
    // Equality binds tighter than bitwise AND.
    uint8_t prec3 = 1 == 1 && 0; // (1 == 1) && 0 -> 1 && 0 -> 0

    print(add);
    print(sub);
    print(mul);
    print(div);

    print(isGreater);
    print(isLess);
    print(isEq);
    print(isNeq);
    print(isGE);
    print(isLE);

    print(logicAnd);
    print(logicOr);
    print(logicNot);

    print(bitAnd);
    print(bitOr);
    print(bitXor);

    print(shiftLeft);
    print(shiftRight);

    print(neg);
    print(pos);

    print(prec1);
    print(prec2);
    print(prec3);

    return 0;
}

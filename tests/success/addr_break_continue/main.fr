// ============================================================
// SPEC TEST: Break / Continue and Address Null-State Checking
// ============================================================
// Covers:
//   - a break exit keeps the loop-body guard refinement OFF (the break
//     path does not re-test the condition, so a maybe-null address that
//     was certified by the guard stays certified, and a possibly-null
//     one stays maybe-null),
//   - a continue path's state flows around the back edge,
//   - dereferencing a certified address on the break path is accepted.
// ============================================================

func main() -> int32_t {
    int32_t x = 7;
    addr<int32_t> p = getaddr(x);
    int32_t i = 0;

    // p is certified POINTING by the guard; the break path leaves with
    // that certification intact, so $(p) after the loop is accepted.
    while (p != null) {
        if (i == 2) {
            break;
        }
        i = i + 1;
    }
    print($(p));

    // continue path: the guard certification flows around the back
    // edge, so $(p) inside the loop body is accepted on every path.
    addr<int32_t> q = getaddr(x);
    int32_t j = 0;
    while (q != null) {
        j = j + 1;
        if (j == 2) {
            continue;
        }
        if (j == 4) {
            q = null;
        }
    }

    // The loop may exit with q null (guard-fail) or via the condition
    // failing after q = null, so q is maybe-null here: no deref.
    int32_t seen = 0;
    if (q != null) {
        seen = $(q);
    }
    print(seen);

    return 0;
}

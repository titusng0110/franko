// ============================================================
// SPEC TEST: Memory Management (Addresses)
// ============================================================
// Covers: addr<T>, getaddr, deref, and null literals.
// ============================================================

func main() -> int32_t {
    // --- Stack variable ---
    int32_t stackVar = 42;

    // --- Addresses & dereferencing ---
    addr<int32_t> p = getaddr(stackVar);
    int32_t derefVal = deref(p);

    // --- Writes through an address ---
    addr<int32_t> stackAddr = getaddr(stackVar);
    deref(stackAddr) = 200;

    // --- Null address ---
    addr<int32_t> nullAddr;
    if (nullAddr == null) {
        print(1);
    }
    nullAddr = getaddr(stackVar);
    if (nullAddr != null) {
        print(0);
    }

    // --- Address of array ---
    array<int32_t> arr;
    arr.init(10); // or arr(10)
    addr<array<int32_t>> arrPtr = getaddr(arr);
    deref(arrPtr)[0] = 1;
    int32_t arrVal = deref(arrPtr)[0];

    // --- Address of array with static size ---
    array<int32_t, 5> staticArr;
    addr<array<int32_t, 5>> staticArrPtr = getaddr(staticArr);
    deref(staticArrPtr)[0] = 5;

    print(derefVal);
    print(deref(stackAddr));
    print(arrVal);

    return 0;
}

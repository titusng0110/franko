// ============================================================
// SPEC TEST: Nested Dynamic Array Construction
// ============================================================
// Covers: doc 21.1 — init and init_zero default-construct nested
// dynamic array elements into the uninitialized Franko state
// (length 0), ready for init with no explicit placement;
// resize constructs grown elements and destroys dropped ones;
// uninit destroys elements before freeing the outer buffer.
// ============================================================

func main() -> int32_t {
    array<array<int32_t>> m;
    m.init(2);
    print(m[0].length(), m[1].length());

    m[0].init(2);
    m[1].init_zero(2);
    m[0][0] = 1;
    m[0][1] = 2;
    m[1][0] = 3;
    print(m[0][0], m[0][1], m[1][0], m[1][1]);

    // resize larger: old positions keep their values and the grown
    // element is constructed (length 0, ready for init).
    m.resize(3);
    print(m[0][0], m[1][0], m[2].length());
    m[2].init(1);
    m[2][0] = 5;
    print(m[2][0]);

    // resize smaller: dropped elements are destroyed, survivors kept.
    m.resize(1);
    print(m.length(), m[0][0], m[0][1]);

    // init_zero also constructs nested elements.
    array<array<int32_t>> z;
    z.init_zero(2);
    print(z[0].length(), z[1].length());
    z[0].init(1);
    z[0][0] = 9;
    print(z[0][0]);

    // z[0] stays initialized and z[1] stays constructed-but-empty;
    // the outer uninit destroys both without explicit inner uninit.
    z.uninit();
    m[0].uninit();
    m.uninit();

    return 0;
}

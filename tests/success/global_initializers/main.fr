// ============================================================
// SPEC TEST: Global constant initializers
// ============================================================
// Covers: global variable declarations with constant initializers
// that are folded at compile time (1 + 2 and 1 << 8).
// ============================================================

int32_t g = 1 + 2

uint64_t mask = 1 << 8

func main() -> int32_t {
    print(g)
    print(mask)
    return 0
}

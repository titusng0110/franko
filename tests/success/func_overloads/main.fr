// ============================================================
// SPEC TEST: Function Overloads
// ============================================================
// Covers: overloading on the ordered parameter type list;
// nonconstant arguments must exactly match one overload's
// parameter type, so each call below selects a different body.
// ============================================================

func f(int32_t x) -> int32_t {
    return x + 1;
}

func f(int64_t x) -> int64_t {
    return x + 2;
}

func f(uint8_t x) -> uint8_t {
    return x + 3;
}

func main() -> int32_t {
    int32_t a = 10;
    int64_t b = 20;
    uint8_t c = 30;
    print(f(a));
    print(f(b));
    print(f(c));
    return 0;
}

// ============================================================
// SPEC TEST: Addresses — null-initialization guarantees
// ============================================================
// Covers:
//   - a local addr<T> declaration is guaranteed null-initialized
//   - a global addr<T> variable is null-initialized
//   - an addr-typed struct field is null-initialized
// ============================================================

struct Box {
    int32_t v
    addr<int32_t> link
}

addr<int32_t> g

func main() -> int32_t {
    // Local address declaration: null, guaranteed.
    addr<int32_t> local
    print(local == null)

    // Global address variable: null before any assignment.
    print(g == null)

    // Address-typed struct field: null.
    Box b
    print(b.link == null)

    return 0
}

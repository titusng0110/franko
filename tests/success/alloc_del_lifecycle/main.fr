// ============================================================
// SPEC TEST: alloc / del lifecycle
// ============================================================
// Covers: heap primitives (alloc, assign, print, del), heap dynamic
// arrays (alloc, init, use, uninit, del), and heap addresses
// (alloc addr<T>, null check, getaddr, deref, del).
// ============================================================

func main() -> int32_t {
    // --- Heap primitive: assign, print, del ---
    alloc int32_t hp
    hp = 42
    print(hp)
    del hp

    // --- Heap dynamic array: init, use, uninit, del ---
    alloc array<int32_t> ha
    ha.init_zero(3)
    ha[0] = 11
    ha[2] = 33
    print(ha[0])
    print(ha[1])
    print(ha[2])
    ha.uninit()
    del ha

    // --- Heap address: null check right after alloc, then getaddr + deref ---
    int32_t local = 5
    alloc addr<int32_t> ap
    print(ap == null)
    ap = getaddr(local)
    deref(ap) = 77
    print(deref(ap))
    del ap

    return 0
}

// ============================================================
// SPEC TEST: Heap Structs with Dynamic-Array Fields
// ============================================================
// Covers: alloc X s where X owns a dynamic-array field, the field
// allocation call s.data(4), element write/read, and del s
// running the struct destructor, which destroys the member
// dynamic array (no leak).
// ============================================================

struct Buf {
    array<int32_t> data
    int32_t used = 0
}

func main() -> int32_t {
    alloc Buf s;
    s.data(4);
    s.data[0] = 11;
    s.data[1] = 22;
    s.data[2] = 33;
    s.data[3] = 44;
    s.used = 4;
    print(s.used, s.data[0], s.data[1], s.data[2], s.data[3]);

    // The struct destructor destroys the member dynamic array.
    del s;

    return 0;
}

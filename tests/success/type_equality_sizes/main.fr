// ============================================================
// SPEC TEST: Type Equality - Static Array Size Comparison
// ============================================================
// Covers: static array sizes compare numerically after unfolding
// the size expression (doc 29.3): 10 == 0xA == 5 + 5.
// The parameter uses addr<array<int32_t, 10>> because bare array
// parameters are not passable (doc 12.3); address equality is
// defined by the referenced type's equality (doc 29.4), so the
// hex and arithmetic size spellings must still match exactly.
// ============================================================

func first(addr<array<int32_t, 10>> xs) -> int32_t {
    if (xs != null) {
        return $(xs)[0];
    }
    return 0;
}

func main() -> int32_t {
    // Hex spelling of 10 matches the parameter's decimal 10.
    array<int32_t, 0xA> a;
    // Arithmetic size expression unfolds to 10.
    array<int32_t, 5 + 5> b;
    a.memset(0);
    b.memset(0);
    a[0] = 42;
    b[0] = 24;
    print(first(getaddr(a)));
    print(first(getaddr(b)));
    return 0;
}

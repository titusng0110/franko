// ============================================================
// SPEC TEST: Program Structure
// ============================================================
// Covers: top-level items, separators, blocks, and the basic
// program shape.
// ============================================================

// A global variable declaration.
int32_t globalCounter = 0;

// A struct declaration.
struct Point {
    int32_t x
    int32_t y
}

// A namespace declaration.
namespace util {
    int32_t offset = 100
    func doubleIt(int32_t v) -> int32_t {
        return v + v + offset
    }
}

// A function declaration.
func main() -> int32_t {
    // Mixed separators: newlines and semicolons.
    Point p;
    p.x = 1
    p.y = 2;

    // Mixed separators: consecutive separators.
    int32_t sum = 0;;
    sum = p.x + p.y;;

    // Local block creating a nested scope.
    {
        int32_t local = 10;
        sum = sum + local
    }

    // Newlines inside parentheses (grouping depth).
    print(
        sum
    )

    print(sum);
    return 0;
}

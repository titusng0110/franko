{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Franko",
  "scopeName": "source.franko",
  "fileTypes": [
    "fr",
    "franko"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#compile-time"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#operator-methods"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#member-intrinsics"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#library-functions"
    },
    {
      "include": "#scope-resolution"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "match": "(//).*$",
      "name": "comment.line.double-slash.franko",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.franko"
        }
      }
    },
    "strings": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.franko"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.franko"
        }
      },
      "name": "string.quoted.double.franko",
      "patterns": [
        {
          "match": "\\\\(?:[\\\\\"abfnrtv])",
          "name": "constant.character.escape.franko"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.unknown-escape.franko"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.franko"
        },
        {
          "match": "\\b0[bB][01]+\\b",
          "name": "constant.numeric.binary.franko"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.franko"
        }
      ]
    },
    "compile-time": {
      "patterns": [
        {
          "match": "#(if|else)\\b",
          "name": "keyword.control.directive.compile-time.franko"
        },
        {
          "match": "#generic\\b",
          "name": "storage.modifier.generic.franko"
        },
        {
          "match": "#(inline|noinline)\\b",
          "name": "storage.modifier.inline.franko"
        },
        {
          "match": "#(IS_LINUX|IS_WINDOWS|IS_MACOS|IS_X86_64|IS_ARM64)\\b",
          "name": "support.constant.compile-time.franko"
        },
        {
          "match": "#(panic|warning)\\b",
          "name": "keyword.control.directive.compile-time.franko"
        },
        {
          "match": "#(is_primitive|is_enum|is_memcpy_safe|has_default_value|is_memset_safe|is_same_type|is_matchable|is_comparable|is_assignable|is_value_assignable|what_type)\\b",
          "name": "support.function.builtin.compile-time.franko"
        },
        {
          "match": "#[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "invalid.illegal.compile-time.franko"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"([^\"]*)\")?",
          "captures": {
            "1": {
              "name": "keyword.other.import.franko"
            },
            "2": {
              "name": "string.quoted.double.import.franko"
            }
          }
        },
        {
          "match": "\\b(func)\\s+(OPERATOR_(?:EQ|NEQ|GT|LT|GTEQ|LTEQ|MOV|ADDMOV|SUBMOV|MULMOV|DIVMOV|MODMOV|ORMOV|ANDMOV|XORMOV))\\b",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.function.franko"
            },
            "2": {
              "name": "entity.name.function.operator.franko"
            }
          }
        },
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.function.franko"
            },
            "2": {
              "name": "entity.name.function.franko"
            }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.struct.franko"
            },
            "2": {
              "name": "entity.name.type.struct.franko"
            }
          }
        },
        {
          "match": "\\b(enum)\\s*(?:(<)\\s*([A-Za-z0-9_]+)\\s*(>))?\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.enum.franko"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.franko"
            },
            "3": {
              "name": "storage.type.primitive.franko"
            },
            "4": {
              "name": "punctuation.definition.typeparameters.end.franko"
            },
            "5": {
              "name": "entity.name.type.enum.franko"
            }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.namespace.franko"
            },
            "2": {
              "name": "entity.name.namespace.franko"
            }
          }
        }
      ]
    },
    "operator-methods": {
      "match": "\\bOPERATOR_(?:EQ|NEQ|GT|LT|GTEQ|LTEQ|MOV|ADDMOV|SUBMOV|MULMOV|DIVMOV|MODMOV|ORMOV|ANDMOV|XORMOV)\\b",
      "name": "entity.name.function.operator.franko"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(return|if|else|while|for|break|continue)\\b",
          "name": "keyword.control.franko"
        },
        {
          "match": "\\bconst\\b",
          "name": "storage.modifier.const.franko"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.self.franko"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.franko"
        },
        {
          "match": "\\btypename\\b",
          "name": "storage.type.generic.franko"
        }
      ]
    },
    "member-intrinsics": {
      "match": "(\\.)(init_zero|init|resize|uninit|memset|memcpy|memmove|memcmp|length|memchr|memmem|read_bit|write_bit|flip_bit|swap_bits|reverse_bits|memset_not|memset_xor|memset_and|memset_or|shift_bits_left|shift_bits_right|popcount|count_trailing_zeros|count_leading_zeros|(?:read|write)_(?:u?int(?:16|32|64))_(?:LE|BE))\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.dot.franko"
        },
        "2": {
          "name": "support.function.builtin.array.franko"
        }
      }
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^>]+>)?\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.franko"
            },
            "2": {
              "name": "entity.name.function.member.franko"
            }
          }
        },
        {
          "match": "(\\.)(_[0-9]+)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.franko"
            },
            "2": {
              "name": "variable.other.property.tuple.franko"
            }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.franko"
            },
            "2": {
              "name": "variable.other.property.franko"
            }
          }
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "match": "\\b(cast|unsafe_cast)\\b(?=\\s*<)",
          "name": "keyword.operator.cast.franko"
        },
        {
          "match": "\\b(ptr|mview|view)\\b(?=\\s*\\()",
          "name": "support.function.builtin.pointer.franko"
        },
        {
          "match": "\\$",
          "name": "keyword.operator.dereference.franko"
        },
        {
          "match": "\\?",
          "name": "keyword.operator.inferred-size.franko"
        }
      ]
    },
    "library-functions": {
      "match": "\\bstdout\\b(?=\\s*\\()",
      "name": "support.function.builtin.stdio.franko"
    },
    "scope-resolution": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.franko"
        },
        "2": {
          "name": "punctuation.accessor.scope.franko"
        }
      }
    },
    "function-calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^>]+>)?\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.franko"
        }
      }
    },
    "types": {
      "patterns": [
        {
          "match": "\\bvoid\\b",
          "name": "storage.type.void.franko"
        },
        {
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|int|uint|byte)\\b",
          "name": "storage.type.primitive.franko"
        },
        {
          "match": "\\b(ptr|mview|view)\\b(?=\\s*<)",
          "name": "storage.type.pointer.franko"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.franko"
        }
      ]
    },
    "constants": {
      "match": "\\b(?:_{0,2})[A-Z][A-Z0-9_]{1,}\\b",
      "name": "variable.other.constant.franko"
    },
    "operators": {
      "match": "->|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%&|^~!<>=]",
      "name": "keyword.operator.franko"
    },
    "punctuation": {
      "match": "[()\\[\\]{},;]",
      "name": "punctuation.franko"
    }
  }
}

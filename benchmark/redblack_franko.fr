// Red-black tree benchmark: insert 2M int32 keys, then delete all 2M.
// Key pattern: -999999, 1000000, -999998, 999999, ... (all 2M keys in
// [-999999, 1000000] exactly once). Nodes live in a heap dynamic array;
// slot indices come from std::NextAllocator. Insert is iterative CLRS
// insertion; delete is CLRS deletion with fixup. An in-order audit walk
// (order + count + sum + red-red + black-height) verifies the tree after
// inserts. Timed externally by benchmark.py; stdout is a small
// deterministic summary used to check that every build mode computes
// the same result.

import "franko/pool"
import "franko/io"

uint32 SIZE = 2000000

struct Node {
    int32 key = 0
    byte red = 0
    uint32 left = 0xFFFFFFFF
    uint32 right = 0xFFFFFFFF
    uint32 parent = 0xFFFFFFFF
}

[Node] nodes
std::NextAllocator pool
uint32 NIL = 0xFFFFFFFF
uint32 root = 0xFFFFFFFF

int32 gPrev = 0
uint32 gCount = 0
int64 gSum = 0
int32 gBad = 0

func keyAt(int32 i) -> int32 {
    if (i % 2 == 0) {
        return -999999 + i / 2
    }
    return 1000000 - i / 2
}

func isBlack(uint32 n) -> byte {
    if (n == NIL) {
        return 1
    }
    if (nodes[n].red == 0) {
        return 1
    }
    return 0
}

func rotateLeft(uint32 x) -> void {
    if (x == NIL) {
        return
    }
    uint32 y = nodes[x].right
    if (y == NIL) {
        return
    }
    nodes[x].right = nodes[y].left
    if (nodes[y].left != NIL) {
        nodes[nodes[y].left].parent = x
    }
    nodes[y].parent = nodes[x].parent
    if (nodes[x].parent == NIL) {
        root = y
    } else {
        if (x == nodes[nodes[x].parent].left) {
            nodes[nodes[x].parent].left = y
        } else {
            nodes[nodes[x].parent].right = y
        }
    }
    nodes[y].left = x
    nodes[x].parent = y
    return
}

func rotateRight(uint32 x) -> void {
    if (x == NIL) {
        return
    }
    uint32 y = nodes[x].left
    if (y == NIL) {
        return
    }
    nodes[x].left = nodes[y].right
    if (nodes[y].right != NIL) {
        nodes[nodes[y].right].parent = x
    }
    nodes[y].parent = nodes[x].parent
    if (nodes[x].parent == NIL) {
        root = y
    } else {
        if (x == nodes[nodes[x].parent].right) {
            nodes[nodes[x].parent].right = y
        } else {
            nodes[nodes[x].parent].left = y
        }
    }
    nodes[y].right = x
    nodes[x].parent = y
    return
}

func insertFixup(uint32 z) -> void {
    while ((z != root) && (nodes[nodes[z].parent].red != 0)) {
        if (nodes[z].parent == nodes[nodes[nodes[z].parent].parent].left) {
            uint32 aunt = nodes[nodes[nodes[z].parent].parent].right
            if (isBlack(aunt) == 0) {
                nodes[nodes[z].parent].red = 0
                nodes[aunt].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                z = nodes[nodes[z].parent].parent
            } else {
                if (z == nodes[nodes[z].parent].right) {
                    z = nodes[z].parent
                    rotateLeft(z)
                }
                nodes[nodes[z].parent].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                rotateRight(nodes[nodes[z].parent].parent)
            }
        } else {
            uint32 aunt2 = nodes[nodes[nodes[z].parent].parent].left
            if (isBlack(aunt2) == 0) {
                nodes[nodes[z].parent].red = 0
                nodes[aunt2].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                z = nodes[nodes[z].parent].parent
            } else {
                if (z == nodes[nodes[z].parent].left) {
                    z = nodes[z].parent
                    rotateRight(z)
                }
                nodes[nodes[z].parent].red = 0
                nodes[nodes[nodes[z].parent].parent].red = 1
                rotateLeft(nodes[nodes[z].parent].parent)
            }
        }
    }
    if (root != NIL) {
        nodes[root].red = 0
    }
    return
}

func rbInsert(int32 key) -> void {
    uint32 z = pool.new_index()
    nodes[z].key = key
    nodes[z].red = 1
    nodes[z].left = NIL
    nodes[z].right = NIL
    nodes[z].parent = NIL

    uint32 y = NIL
    uint32 x = root
    while (x != NIL) {
        y = x
        if (nodes[z].key < nodes[x].key) {
            x = nodes[x].left
        } else {
            x = nodes[x].right
        }
    }

    nodes[z].parent = y
    if (y == NIL) {
        root = z
    } else {
        if (nodes[z].key < nodes[y].key) {
            nodes[y].left = z
        } else {
            nodes[y].right = z
        }
    }

    insertFixup(z)
    return
}

func transplant(uint32 u, uint32 v) -> void {
    uint32 up = nodes[u].parent
    if (up == NIL) {
        root = v
    } else {
        if (u == nodes[up].left) {
            nodes[up].left = v
        } else {
            nodes[up].right = v
        }
    }
    if (v != NIL) {
        nodes[v].parent = up
    }
    return
}

func minNode(uint32 n) -> uint32 {
    while (nodes[n].left != NIL) {
        n = nodes[n].left
    }
    return n
}

func deleteFixup(uint32 x, uint32 p) -> void {
    while ((x != root) && (isBlack(x) != 0)) {
        if (x == nodes[p].left) {
            uint32 w = nodes[p].right
            uint32 wl = NIL
            uint32 wr = NIL
            if (w != NIL) {
                wl = nodes[w].left
                wr = nodes[w].right
            }
            if (isBlack(w) == 0) {
                nodes[w].red = 0
                nodes[p].red = 1
                rotateLeft(p)
                w = nodes[p].right
                wl = NIL
                wr = NIL
                if (w != NIL) {
                    wl = nodes[w].left
                    wr = nodes[w].right
                }
            }
            if ((isBlack(wl) != 0) && (isBlack(wr) != 0)) {
                if (w != NIL) {
                    nodes[w].red = 1
                }
                x = p
                p = nodes[x].parent
            } else {
                if (isBlack(wr) != 0) {
                    nodes[wl].red = 0
                    nodes[w].red = 1
                    rotateRight(w)
                    w = nodes[p].right
                    wr = nodes[w].right
                }
                if (nodes[p].red != 0) {
                    nodes[w].red = 1
                } else {
                    nodes[w].red = 0
                }
                nodes[p].red = 0
                nodes[wr].red = 0
                rotateLeft(p)
                x = root
            }
        } else {
            uint32 w2 = nodes[p].left
            uint32 wl2 = NIL
            uint32 wr2 = NIL
            if (w2 != NIL) {
                wl2 = nodes[w2].left
                wr2 = nodes[w2].right
            }
            if (isBlack(w2) == 0) {
                nodes[w2].red = 0
                nodes[p].red = 1
                rotateRight(p)
                w2 = nodes[p].left
                wl2 = NIL
                wr2 = NIL
                if (w2 != NIL) {
                    wl2 = nodes[w2].left
                    wr2 = nodes[w2].right
                }
            }
            if ((isBlack(wl2) != 0) && (isBlack(wr2) != 0)) {
                if (w2 != NIL) {
                    nodes[w2].red = 1
                }
                x = p
                p = nodes[x].parent
            } else {
                if (isBlack(wl2) != 0) {
                    nodes[wr2].red = 0
                    nodes[w2].red = 1
                    rotateLeft(w2)
                    w2 = nodes[p].left
                    wl2 = nodes[w2].left
                }
                if (nodes[p].red != 0) {
                    nodes[w2].red = 1
                } else {
                    nodes[w2].red = 0
                }
                nodes[p].red = 0
                nodes[wl2].red = 0
                rotateRight(p)
                x = root
            }
        }
    }
    if (x != NIL) {
        nodes[x].red = 0
    }
    return
}

func deleteNode(uint32 z) -> void {
    byte yWasBlack = 1
    if (nodes[z].red != 0) {
        yWasBlack = 0
    }
    uint32 x = NIL
    uint32 xParent = NIL
    if (nodes[z].left == NIL) {
        x = nodes[z].right
        xParent = nodes[z].parent
        transplant(z, nodes[z].right)
        pool.free_index(z)
    } else {
        if (nodes[z].right == NIL) {
            x = nodes[z].left
            xParent = nodes[z].parent
            transplant(z, nodes[z].left)
            pool.free_index(z)
        } else {
            uint32 y = minNode(nodes[z].right)
            yWasBlack = 1
            if (nodes[y].red != 0) {
                yWasBlack = 0
            }
            x = nodes[y].right
            uint32 yParent = nodes[y].parent
            if (yParent == z) {
                xParent = y
            } else {
                transplant(y, nodes[y].right)
                nodes[y].right = nodes[z].right
                nodes[nodes[z].right].parent = y
                xParent = yParent
            }
            transplant(z, y)
            nodes[y].left = nodes[z].left
            nodes[nodes[z].left].parent = y
            if (nodes[z].red != 0) {
                nodes[y].red = 1
            } else {
                nodes[y].red = 0
            }
            pool.free_index(z)
        }
    }
    if (yWasBlack != 0) {
        deleteFixup(x, xParent)
    }
    return
}

func rbDelete(uint32 n, int32 key) -> uint32 {
    uint32 z = n
    while (z != NIL) {
        if (key == nodes[z].key) {
            deleteNode(z)
            return root
        }
        if (key < nodes[z].key) {
            z = nodes[z].left
        } else {
            z = nodes[z].right
        }
    }
    return root
}

// In-order audit: BST order, node count, key sum, red-red and
// black-height consistency. Returns black-height, -1 on violation.
func audit(uint32 n) -> int32 {
    if (n == NIL) {
        return 0
    }
    int32 lh = audit(nodes[n].left)
    if (nodes[n].key <= gPrev) {
        gBad = 1
    }
    gPrev = nodes[n].key
    gCount = gCount + 1
    gSum = gSum + cast<int64>(nodes[n].key)
    int32 rh = audit(nodes[n].right)
    if (lh < 0) {
        return -1
    }
    if (rh < 0) {
        return -1
    }
    if (lh != rh) {
        return -1
    }
    if (nodes[n].red != 0) {
        if (nodes[n].left != NIL) {
            if (nodes[nodes[n].left].red != 0) {
                return -1
            }
        }
        if (nodes[n].right != NIL) {
            if (nodes[nodes[n].right].red != 0) {
                return -1
            }
        }
        return lh
    }
    return lh + 1
}

func main() -> int32 {
    nodes.init(SIZE)
    pool.init(SIZE)

    for (uint32 i = 0; i < SIZE; i = i + 1) {
        rbInsert(keyAt(unsafe_cast<int32>(i)))
    }

    gPrev = -1000000
    gCount = 0
    gSum = 0
    gBad = 0
    int32 bh = audit(root)
    print("count="); print(gCount)
    print("sum="); print(gSum)
    print("bad="); print(gBad)
    print("bh="); print(bh)

    for (uint32 i = 0; i < SIZE; i = i + 1) {
        root = rbDelete(root, keyAt(unsafe_cast<int32>(i)))
    }

    print("empty=")
    if (root == NIL) {
        print(1)
    } else {
        print(0)
    }
    print("used="); print(pool.used())

    nodes.uninit()
    pool.uninit()
    return 0
}

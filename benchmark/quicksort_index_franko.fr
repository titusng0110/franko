// Index-sorting Franko quicksort for the 10M benchmark.
//
// Same sortedness check, pivot table, partition, and 2..5 networks as the
// in-place version; sorts a dynamic [uint32] index array by
// values[order[i]] and applies the permutation at the end.
//
// RANDOM_PIVOTS holds 128 values generated once with Python's deterministic
// random generator:
//
//   import random
//   rng = random.Random(12600)
//   [rng.getrandbits(32) for _ in range(64)]
//
// The sort never moves the data array. It sorts a dynamic [uint32] of
// indices 0..N-1 by comparing values[order[i]], so every swap moves only
// an index. After the indices are sorted, one final O(N) pass applies the
// permutation to the data.
//
// Every partition consumes the next random value and reduces it modulo
// the subproblem size to choose the pivot slot. Any subproblem with at
// most 9 elements finishes in the standard optimal-size sorting network
// for 2..5 inputs. The networks are listed layer by layer; compare-
// exchanges inside one layer are independent.
//
// Before sorting, main runs one read-only sortedness check over the
// indices. If the indices are already in data order, quicksort is
// skipped; otherwise quicksort sorts the full range. The check never
// writes to the index or data arrays.
//
// Compare-exchanges and swaps are written inline so the base case does
// not pay for helper calls.

import "franko/io"

view<[uint32, 128]> RANDOM_PIVOTS = [
    0x5694C774, 0xBCF2DC90, 0xC22D6ECF, 0x82DF89C3, 0x2E5D3BB4, 0x11754AC0, 0x68E420EE, 0xD2794F96,
    0x5B22CDE9, 0xA49A1665, 0x59D5FEF7, 0x596C9D24, 0xB5AA244F, 0xBC390961, 0x747F2BF2, 0x4546145D,
    0xBB3A57E1, 0xFD0D1D76, 0xE36237A5, 0x64E4AB28, 0x8407E185, 0xA4462908, 0x637D4682, 0x1DB262CA,
    0x0FFC45EE, 0xA04A36C8, 0x5A3139A4, 0x14732B44, 0x020EE9DF, 0x30FA1FB5, 0xEEB9A7A8, 0xCA05052F,
    0xE66313B3, 0x0594024D, 0xB16A9E7D, 0xCB06A3E8, 0x1B72E31A, 0x4AC319B5, 0x550F2307, 0x4610C2CC,
    0x38015908, 0xD57934AC, 0x8E2BC2E8, 0xF3FC112C, 0x21781428, 0x903FDB8C, 0x03B709D8, 0x5C6A595F,
    0x0917E134, 0x496E7177, 0x746C2637, 0x5D2660A8, 0x025C93DE, 0x8BD36979, 0x5BCFBA15, 0x1B21A66C,
    0x9380C385, 0x93955A50, 0xBAE7A676, 0xC954CF68, 0x2B7A649F, 0x2098B166, 0xB5786F09, 0xB18B96F8,
    0xAF582D70, 0xD40BB203, 0x9E673610, 0x95CA46C8, 0x5279D564, 0x2A160FF2, 0xC340384B, 0xCDA8C1C4,
    0xEC728A93, 0x36D973A8, 0x950644C7, 0x1A47EB14, 0x251CB0BA, 0xD1F7EC0E, 0xB1D9FEDD, 0x2B7E4DF2,
    0x0FB500C1, 0x237B49EE, 0x43798CCC, 0x7FC34DBF, 0xD2C9B7E1, 0x4D45C92C, 0xC9336211, 0x3E63582B,
    0x8D725577, 0x1BFF2619, 0x530C4B22, 0xC3454468, 0xD4447108, 0x47FE1542, 0x395548CE, 0x5CB5A4E7,
    0x41460FA7, 0x135AAB36, 0x3D8F178D, 0xC1AAACE6, 0x8DA93957, 0x99178372, 0x6C0083B2, 0xFA32566E,
    0xBAAA83E8, 0xA4D6C6EE, 0x72440145, 0x6CD399A0, 0x2A24EF25, 0x0346380B, 0x8ADADA48, 0x5E4D312E,
    0x39B14C81, 0xFC5266E7, 0x07DB9769, 0xE95E4B04, 0xAFCD0D88, 0xE1D42113, 0x8DD9B701, 0xDE39B842,
    0x3E81243F, 0x5B02B41B, 0x391FFABD, 0x2751AF9F, 0x4071A3F8, 0xC4EC845A, 0xD80970E2, 0x3CBFCC9D
]

uint32 NETWORK_LIMIT = 5
uint32 DNF_THRESHOLD = 30
uint32 pivot_cursor = 0
uint32 use_dnf = 0

// Sort the n <= 5 index slots order[lo .. lo+n-1] by values[order[*]].
// Each compare-exchange and its swap are written out inline.
func sort_network(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 n) -> void {
    if (order == null) {
        return
    }
    if (values == null) {
        return
    }
    if (n < 2) {
        return
    }

    if (n == 2) {
        // layer 1
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
    } else if (n == 3) {
        // layer 1
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
    } else if (n == 4) {
        // layer 1
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
    } else if (n == 5) {
        // layer 1
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
    }
    return
}

// Read-only sortedness check over the index slots order[lo .. hi].
// Returns 1 when values[order[*]] is nondecreasing. No writes.
func is_sorted(view<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> byte {
    if (order == null) {
        return 0
    }
    if (values == null) {
        return 0
    }

    uint32 i = lo + 1
    while (i <= hi) {
        if ($(values)[$(order)[i]] < $(values)[$(order)[i - 1]]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Heapsort helpers used only for the small distinctness sample.
func sift_down_indices(mview<[uint32]> sample, view<[int64]> values, uint32 root, uint32 end) -> void {
    if (sample == null || values == null) {
        return
    }
    while (root * 2 + 1 <= end) {
        uint32 child = root * 2 + 1
        if (child + 1 <= end && $(values)[$(sample)[child]] < $(values)[$(sample)[child + 1]]) {
            child = child + 1
        }
        if ($(values)[$(sample)[root]] < $(values)[$(sample)[child]]) {
            uint32 tmp = $(sample)[root]
            $(sample)[root] = $(sample)[child]
            $(sample)[child] = tmp
            root = child
        } else {
            return
        }
    }
    return
}

func sort_sample_indices(mview<[uint32]> sample, view<[int64]> values, uint32 n) -> void {
    if (sample == null || values == null || n < 2) {
        return
    }
    uint32 start = n / 2
    while (start > 0) {
        start = start - 1
        sift_down_indices(sample, values, start, n - 1)
    }
    uint32 end = n - 1
    while (end > 0) {
        uint32 tmp = $(sample)[0]
        $(sample)[0] = $(sample)[end]
        $(sample)[end] = tmp
        end = end - 1
        sift_down_indices(sample, values, 0, end)
    }
    return
}

// Estimate the average duplicate-group size from a 0.1% sample.
// Returns 1 when DNF is preferred, 0 for Lomuto. The sample uses the
// global RANDOM_PIVOTS table for cheap stratified offsets.
func estimate_use_dnf(view<[int64]> values, uint32 count) -> byte {
    if (values == null) {
        return 0
    }

    uint32 k = count / 1000
    if (k < 1024) {
        k = 1024
    }
    if (k > 65536) {
        k = 65536
    }
    if (k > count) {
        k = count
    }
    if (k < 2) {
        return 0
    }

    [uint32] sample
    sample.init(k)
    if (sample.length() != k) {
        sample.uninit()
        return 0
    }

    uint32 step = count / k
    if (step == 0) {
        step = 1
    }
    for (uint32 j = 0; j < k; j++) {
        uint32 block_start = j * step
        uint32 remaining = count - block_start
        uint32 span = step
        if (span > remaining) {
            span = remaining
        }

        uint32 r = $(RANDOM_PIVOTS)[j & 127]
        r = r ^ (j * 0x9E3779B9)
        r = r ^ (r >> 16)
        uint64 scaled = cast<uint64>(r) * cast<uint64>(span)
        uint32 offset = unsafe_cast<uint32>(scaled >> 32)
        sample[j] = block_start + offset
    }

    sort_sample_indices(getmview(sample), values, k)

    uint64 collisions = 0
    uint32 run = 1
    for (uint32 j = 1; j < k; j++) {
        if ($(values)[sample[j]] == $(values)[sample[j - 1]]) {
            run = run + 1
        } else {
            collisions = collisions + (cast<uint64>(run) * cast<uint64>(run - 1)) / 2
            run = 1
        }
    }
    collisions = collisions + (cast<uint64>(run) * cast<uint64>(run - 1)) / 2

    uint64 pairs = (cast<uint64>(k) * cast<uint64>(k - 1)) / 2
    byte result = 0
    if (collisions * cast<uint64>(count) > cast<uint64>(DNF_THRESHOLD) * pairs) {
        result = 1
    }

    sample.uninit()
    return result
}

func partition_lomuto(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> uint32 {
    if (order == null) {
        return lo
    }
    if (values == null) {
        return lo
    }
    if (RANDOM_PIVOTS == null) {
        return lo
    }

    uint32 count = hi - lo + 1
    uint32 sample = $(RANDOM_PIVOTS)[pivot_cursor & 127]
    uint64 scaled = cast<uint64>(sample) * cast<uint64>(count)
    uint32 pivot_pos = lo + unsafe_cast<uint32>(scaled >> 32)
    pivot_cursor = pivot_cursor + 1

    uint32 tmp_pivot = $(order)[pivot_pos]
    $(order)[pivot_pos] = $(order)[hi]
    $(order)[hi] = tmp_pivot

    int64 pivot_key = $(values)[$(order)[hi]]
    uint32 store = lo
    uint32 i = lo
    while (i < hi) {
        if ($(values)[$(order)[i]] < pivot_key) {
            uint32 tmp_store = $(order)[store]
            $(order)[store] = $(order)[i]
            $(order)[i] = tmp_store
            store = store + 1
        }
        i = i + 1
    }

    uint32 tmp_last = $(order)[store]
    $(order)[store] = $(order)[hi]
    $(order)[hi] = tmp_last
    return store
}

// Dutch national flag partition over the index slots:
//   order[lo .. lt-1] has keys < pivot
//   order[lt .. gt]   has keys == pivot
//   order[gt+1 .. hi] has keys > pivot
// Only indices move; values is read-only. The equal block is final.
func partition_dnf(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> (uint32 lt, uint32 gt) {
    if (order == null) {
        return (uint32 lt, uint32 gt) { lt = lo, gt = lo }
    }
    if (values == null) {
        return (uint32 lt, uint32 gt) { lt = lo, gt = lo }
    }
    if (RANDOM_PIVOTS == null) {
        return (uint32 lt, uint32 gt) { lt = lo, gt = lo }
    }

    uint32 count = hi - lo + 1
    uint32 sample = $(RANDOM_PIVOTS)[pivot_cursor & 127]
    uint64 scaled = cast<uint64>(sample) * cast<uint64>(count)
    uint32 pivot_pos = lo + unsafe_cast<uint32>(scaled >> 32)
    pivot_cursor = pivot_cursor + 1

    int64 pivot = $(values)[$(order)[pivot_pos]]

    uint32 lt = lo
    uint32 i = lo
    uint32 gt = hi
    while (i <= gt) {
        int64 key = $(values)[$(order)[i]]
        if (key < pivot) {
            uint32 tmp = $(order)[lt]
            $(order)[lt] = $(order)[i]
            $(order)[i] = tmp
            lt = lt + 1
            i = i + 1
        } else if (key > pivot) {
            uint32 tmp = $(order)[i]
            $(order)[i] = $(order)[gt]
            $(order)[gt] = tmp
            gt = gt - 1
        } else {
            i = i + 1
        }
    }
    return (uint32 lt, uint32 gt) { lt = lt, gt = gt }
}

// Sort the index slots order[lo .. hi] by values[order[*]].
func quicksort(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> void {
    if (order == null) {
        return
    }
    if (values == null) {
        return
    }
    if (lo >= hi) {
        return
    }

    uint32 count = hi - lo + 1
    if (count <= NETWORK_LIMIT) {
        sort_network(order, values, lo, count)
        return
    }

    if (use_dnf != 0) {
        (uint32 lt, uint32 gt) bounds = partition_dnf(order, values, lo, hi)
        if (bounds.lt > lo) {
            quicksort(order, values, lo, bounds.lt - 1)
        }
        if (bounds.gt < hi) {
            quicksort(order, values, bounds.gt + 1, hi)
        }
    } else {
        uint32 pivot = partition_lomuto(order, values, lo, hi)
        if (pivot > lo) {
            quicksort(order, values, lo, pivot - 1)
        }
        if (pivot < hi) {
            quicksort(order, values, pivot + 1, hi)
        }
    }
    return
}

func verify_sorted(view<[int64]> values, uint32 n) -> byte {
    if (values == null) {
        return 0
    }

    uint32 i = 1
    while (i < n) {
        if ($(values)[i] < $(values)[i - 1]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

func main(view<[[byte]]> args) -> int32 {
    uint32 dataset = 0
    if ($(args).length() >= 2) {
        view<[byte]> mode_arg = getview($(args)[1])
        if ($(mode_arg).length() >= 1) {
            byte mode_byte = $(mode_arg)[0]
            if (mode_byte == 51) {
                dataset = 3
            } else if (mode_byte == 50) {
                dataset = 2
            } else if (mode_byte == 49) {
                dataset = 1
            }
        }
    }

    uint32 count = 10000000

    [int64] values
    [uint32] order
    [int64] moved

    values.init(count)
    if (values.length() != count) {
        print("allocation failed")
        values.uninit()
        return 1
    }

    order.init(count)
    if (order.length() != count) {
        print("allocation failed")
        order.uninit()
        values.uninit()
        return 1
    }

    moved.init(count)
    if (moved.length() != count) {
        print("allocation failed")
        moved.uninit()
        order.uninit()
        values.uninit()
        return 1
    }

    uint64 state = 0x9E3779B97F4A7C15
    for (uint32 i = 0; i < count; i++) {
        state = state + 0x9E3779B97F4A7C15
        uint64 z = state
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB
        z = z ^ (z >> 31)
        if (dataset == 3) {
            values[i] = unsafe_cast<int64>(z % 10)
        } else if (dataset == 2) {
            values[i] = unsafe_cast<int64>(z % 100000)
        } else if (dataset == 1) {
            values[i] = unsafe_cast<int64>(z % 1000000)
        } else {
            values[i] = unsafe_cast<int64>(z & 0x7FFFFFFFFFFFFFFF)
        }
        order[i] = i
    }

    view<[int64]> data = getview(values)

    byte already_sorted = is_sorted(getview(order), data, 0, count - 1)
    if (already_sorted == 0) {
        use_dnf = cast<uint32>(estimate_use_dnf(data, count))
        pivot_cursor = 0
        quicksort(getmview(order), data, 0, count - 1)
    }

    for (uint32 i = 0; i < count; i++) {
        moved[i] = $(data)[order[i]]
    }
    for (uint32 i = 0; i < count; i++) {
        values[i] = moved[i]
    }

    byte sorted_ok = 1
    uint64 checksum = 0
    for (uint32 i = 0; i < count; i++) {
        if (i != 0 && values[i] < values[i - 1]) {
            sorted_ok = 0
        }
        checksum = checksum + unsafe_cast<uint64>(values[i])
    }

    print("sorted ", null)
    if (sorted_ok != 0) {
        print("ok")
    } else {
        print("FAILED")
    }
    print("checksum ", null)
    print(checksum)

    moved.uninit()
    order.uninit()
    values.uninit()
    return 0
}

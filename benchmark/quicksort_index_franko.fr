// Index-sorting Franko quicksort for the 10M benchmark.
//
// Same bubble pass, pivot table, partition, and 2..9 networks as the
// in-place version; sorts a dynamic [uint32] index array by
// values[order[i]] and applies the permutation at the end.
//
// RANDOM_PIVOTS holds 64 values generated once with Python's deterministic
// random generator:
//
//   import random
//   rng = random.Random(12600)
//   [rng.getrandbits(32) for _ in range(64)]
//
// The sort never moves the data array. It sorts a dynamic [uint32] of
// indices 0..N-1 by comparing values[order[i]], so every swap moves only
// an index. After the indices are sorted, one final O(N) pass applies the
// permutation to the data.
//
// Every partition consumes the next random value and reduces it modulo
// the subproblem size to choose the pivot slot. Any subproblem with at
// most 9 elements finishes in the standard optimal-size sorting network
// for 2..9 inputs. The networks are listed layer by layer; compare-
// exchanges inside one layer are independent.
//
// Before sorting, main runs one bubble-sort pass over the indices. That
// pass doubles as the sortedness check: if it performs no swap, the
// indices are already in data order and quicksort is skipped. Otherwise
// the pass leaves the largest key's index at the last slot, so quicksort
// only needs to handle the prefix before it.
//
// Compare-exchanges and swaps are written inline so the base case does
// not pay for helper calls.

import "franko/io"

view<[uint32, 64]> RANDOM_PIVOTS = [
    0x5694C774, 0xBCF2DC90, 0xC22D6ECF, 0x82DF89C3,
    0x2E5D3BB4, 0x11754AC0, 0x68E420EE, 0xD2794F96,
    0x5B22CDE9, 0xA49A1665, 0x59D5FEF7, 0x596C9D24,
    0xB5AA244F, 0xBC390961, 0x747F2BF2, 0x4546145D,
    0xBB3A57E1, 0xFD0D1D76, 0xE36237A5, 0x64E4AB28,
    0x8407E185, 0xA4462908, 0x637D4682, 0x1DB262CA,
    0x0FFC45EE, 0xA04A36C8, 0x5A3139A4, 0x14732B44,
    0x020EE9DF, 0x30FA1FB5, 0xEEB9A7A8, 0xCA05052F,
    0xE66313B3, 0x0594024D, 0xB16A9E7D, 0xCB06A3E8,
    0x1B72E31A, 0x4AC319B5, 0x550F2307, 0x4610C2CC,
    0x38015908, 0xD57934AC, 0x8E2BC2E8, 0xF3FC112C,
    0x21781428, 0x903FDB8C, 0x03B709D8, 0x5C6A595F,
    0x0917E134, 0x496E7177, 0x746C2637, 0x5D2660A8,
    0x025C93DE, 0x8BD36979, 0x5BCFBA15, 0x1B21A66C,
    0x9380C385, 0x93955A50, 0xBAE7A676, 0xC954CF68,
    0x2B7A649F, 0x2098B166, 0xB5786F09, 0xB18B96F8
]

uint32 NETWORK_LIMIT = 9
uint32 pivot_cursor = 0

// Sort the n <= 9 index slots order[lo .. lo+n-1] by values[order[*]].
// Each compare-exchange and its swap are written out inline.
func sort_network(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 n) -> void {
    if (order == null) {
        return
    }
    if (values == null) {
        return
    }
    if (n < 2) {
        return
    }

    if (n == 2) {
        // layer 1
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
    } else if (n == 3) {
        // layer 1
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
    } else if (n == 4) {
        // layer 1
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
    } else if (n == 5) {
        // layer 1
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
    } else if (n == 6) {
        // layer 1
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
    } else if (n == 7) {
        // layer 1
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        // layer 6
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
    } else if (n == 8) {
        // layer 1
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 6]]) {
            uint32 tmp = $(order)[lo + 6]
            $(order)[lo + 6] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        // layer 6
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
    } else if (n == 9) {
        // layer 1
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 8]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 8]
            $(order)[lo + 8] = tmp
        }
        // layer 2
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 8]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 8]
            $(order)[lo + 8] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        // layer 3
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 8]] < $(values)[$(order)[lo + 7]]) {
            uint32 tmp = $(order)[lo + 7]
            $(order)[lo + 7] = $(order)[lo + 8]
            $(order)[lo + 8] = tmp
        }
        // layer 4
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        // layer 5
        if ($(values)[$(order)[lo + 1]] < $(values)[$(order)[lo + 0]]) {
            uint32 tmp = $(order)[lo + 0]
            $(order)[lo + 0] = $(order)[lo + 1]
            $(order)[lo + 1] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 8]] < $(values)[$(order)[lo + 6]]) {
            uint32 tmp = $(order)[lo + 6]
            $(order)[lo + 6] = $(order)[lo + 8]
            $(order)[lo + 8] = tmp
        }
        // layer 6
        if ($(values)[$(order)[lo + 3]] < $(values)[$(order)[lo + 2]]) {
            uint32 tmp = $(order)[lo + 2]
            $(order)[lo + 2] = $(order)[lo + 3]
            $(order)[lo + 3] = tmp
        }
        if ($(values)[$(order)[lo + 5]] < $(values)[$(order)[lo + 4]]) {
            uint32 tmp = $(order)[lo + 4]
            $(order)[lo + 4] = $(order)[lo + 5]
            $(order)[lo + 5] = tmp
        }
        if ($(values)[$(order)[lo + 7]] < $(values)[$(order)[lo + 6]]) {
            uint32 tmp = $(order)[lo + 6]
            $(order)[lo + 6] = $(order)[lo + 7]
            $(order)[lo + 7] = tmp
        }
        // layer 7
        if ($(values)[$(order)[lo + 2]] < $(values)[$(order)[lo + 1]]) {
            uint32 tmp = $(order)[lo + 1]
            $(order)[lo + 1] = $(order)[lo + 2]
            $(order)[lo + 2] = tmp
        }
        if ($(values)[$(order)[lo + 4]] < $(values)[$(order)[lo + 3]]) {
            uint32 tmp = $(order)[lo + 3]
            $(order)[lo + 3] = $(order)[lo + 4]
            $(order)[lo + 4] = tmp
        }
        if ($(values)[$(order)[lo + 6]] < $(values)[$(order)[lo + 5]]) {
            uint32 tmp = $(order)[lo + 5]
            $(order)[lo + 5] = $(order)[lo + 6]
            $(order)[lo + 6] = tmp
        }
    }
    return
}

// One bubble-sort pass over the indices. Returns 1 when no adjacent pair
// was out of order. When it returns 0, the index with the largest key has
// been moved to hi. Only the index array moves; values is read-only.
func bubble_pass(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> byte {
    if (order == null) {
        return 0
    }
    if (values == null) {
        return 0
    }

    byte swapped = 0
    uint32 i = lo
    while (i < hi) {
        if ($(values)[$(order)[i + 1]] < $(values)[$(order)[i]]) {
            uint32 tmp = $(order)[i]
            $(order)[i] = $(order)[i + 1]
            $(order)[i + 1] = tmp
            swapped = 1
        }
        i = i + 1
    }

    if (swapped != 0) {
        return 0
    }
    return 1
}

// Partition the index slots order[lo .. hi] around a pivot slot selected
// from RANDOM_PIVOTS. The pivot key is values[order[pivot_pos]]; only
// indices move. pivot_cursor advances for every partition, so successive
// subproblems use different hardcoded random values.
func partition(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> uint32 {
    if (order == null) {
        return lo
    }
    if (values == null) {
        return lo
    }
    if (RANDOM_PIVOTS == null) {
        return lo
    }

    uint32 count = hi - lo + 1
    // The pivot table has 64 entries, so the cursor wraps with a mask.
    // Multiply-high maps the 32-bit sample to 0..count-1 for any count
    // up to 0xFFFFFFFF: (sample * count) >> 32, no division.
    uint32 sample = $(RANDOM_PIVOTS)[pivot_cursor & 63]
    uint64 scaled = cast<uint64>(sample) * cast<uint64>(count)
    uint32 pivot_pos = lo + unsafe_cast<uint32>(scaled >> 32)
    pivot_cursor = pivot_cursor + 1

    uint32 tmp_pivot = $(order)[pivot_pos]
    $(order)[pivot_pos] = $(order)[hi]
    $(order)[hi] = tmp_pivot

    int64 pivot_key = $(values)[$(order)[hi]]
    uint32 store = lo
    uint32 i = lo
    while (i < hi) {
        if ($(values)[$(order)[i]] < pivot_key) {
            uint32 tmp_store = $(order)[store]
            $(order)[store] = $(order)[i]
            $(order)[i] = tmp_store
            store = store + 1
        }
        i = i + 1
    }

    uint32 tmp_last = $(order)[store]
    $(order)[store] = $(order)[hi]
    $(order)[hi] = tmp_last
    return store
}

// Sort the index slots order[lo .. hi] by values[order[*]].
func quicksort(mview<[uint32]> order, view<[int64]> values, uint32 lo, uint32 hi) -> void {
    if (order == null) {
        return
    }
    if (values == null) {
        return
    }

    uint32 count = hi - lo + 1
    if (count <= NETWORK_LIMIT) {
        sort_network(order, values, lo, count)
        return
    }

    uint32 pivot = partition(order, values, lo, hi)
    if (pivot > lo) {
        quicksort(order, values, lo, pivot - 1)
    }
    if (pivot < hi) {
        quicksort(order, values, pivot + 1, hi)
    }
    return
}

func verify_sorted(view<[int64]> values, uint32 n) -> byte {
    if (values == null) {
        return 0
    }

    uint32 i = 1
    while (i < n) {
        if ($(values)[i] < $(values)[i - 1]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

func main() -> int32 {
    uint32 count = 10000000

    [int64] values
    [uint32] order
    [int64] moved

    values.init(count)
    if (values.length() != count) {
        print("allocation failed")
        values.uninit()
        return 1
    }

    order.init(count)
    if (order.length() != count) {
        print("allocation failed")
        order.uninit()
        values.uninit()
        return 1
    }

    moved.init(count)
    if (moved.length() != count) {
        print("allocation failed")
        moved.uninit()
        order.uninit()
        values.uninit()
        return 1
    }

    uint64 state = 0x9E3779B97F4A7C15
    for (uint32 i = 0; i < count; i++) {
        state = state + 0x9E3779B97F4A7C15
        uint64 z = state
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB
        z = z ^ (z >> 31)
        values[i] = unsafe_cast<int64>(z & 0x7FFFFFFFFFFFFFFF)
        order[i] = i
    }

    view<[int64]> data = getview(values)

    pivot_cursor = 0
    byte already_sorted = bubble_pass(getmview(order), data, 0, count - 1)
    if (already_sorted == 0) {
        quicksort(getmview(order), data, 0, count - 2)
    }

    for (uint32 i = 0; i < count; i++) {
        moved[i] = $(data)[order[i]]
    }
    for (uint32 i = 0; i < count; i++) {
        values[i] = moved[i]
    }

    byte sorted_ok = 1
    uint64 checksum = 0
    for (uint32 i = 0; i < count; i++) {
        if (i != 0 && values[i] < values[i - 1]) {
            sorted_ok = 0
        }
        checksum = checksum + unsafe_cast<uint64>(values[i])
    }

    print("sorted ", null)
    if (sorted_ok != 0) {
        print("ok")
    } else {
        print("FAILED")
    }
    print("checksum ", null)
    print(checksum)

    moved.uninit()
    order.uninit()
    values.uninit()
    return 0
}

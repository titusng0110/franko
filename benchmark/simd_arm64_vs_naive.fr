func bench_vorrq_u8_4096(uint32 reps) -> (int64, int64, int64, int64) {
    [byte, 4096] master
    [byte, 4096] master_source
    [byte, 4096] target
    [byte, 4096] source
    uint32 i = 0
    while (i < 4096) {
        master[i] = unsafe_cast<byte>((i * 13 + 7) & 255)
        target[i] = master[i]
        source[i] = unsafe_cast<byte>((i * 29 + 11) & 255)
        master_source[i] = source[i]
        i = i + 1
    }
    copy_bytes(mview(target), view(master), 4096)
    copy_bytes(mview(source), view(master_source), 4096)
    int64 simd_checksum = 0
    int64 start = std::mono_time()
    uint32 r = 0

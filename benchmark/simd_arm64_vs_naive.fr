import "franko/stdio"
import "franko/time"
import "franko/simd"

// ARM64 SIMD vs naive Franko.
//
// Each case calls the module function and the scalar reference on buffers
// of 64, 512, or 4096 bytes (4,000,000 / 2,000,000 / 1,000,000 calls).
// One input byte rotates per iteration and a rotating target byte is
// checksummed so the optimizer cannot remove the work. Build with -Omax
// and run on an arm64 host targeting the Apple M3 feature set.

// Copy helpers.
func copy_bytes(mview<[byte]> dst, view<[byte]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_i8(mview<[int8]> dst, view<[int8]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_i16(mview<[int16]> dst, view<[int16]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_u16(mview<[uint16]> dst, view<[uint16]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_u32(mview<[uint32]> dst, view<[uint32]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

// Naive scalar references.
func naive_veorq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] ^ $(source)[i]
        i = i + 1
    }
    return
}

func naive_vandq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] & $(source)[i]
        i = i + 1
    }
    return
}

func naive_vorrq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] | $(source)[i]
        i = i + 1
    }
    return
}

func naive_vbicq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] & (~($(source)[i]))
        i = i + 1
    }
    return
}

func naive_vqaddq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 sum = cast<uint32>($(target)[i]) + cast<uint32>($(source)[i])
        if (sum > 255) {
            $(target)[i] = 255
        } else {
            $(target)[i] = unsafe_cast<byte>(sum)
        }
        i = i + 1
    }
    return
}

func naive_vqsubq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        if (a > b) {
            $(target)[i] = a - b
        } else {
            $(target)[i] = 0
        }
        i = i + 1
    }
    return
}

func naive_vmaxq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        if ($(target)[i] > $(source)[i]) {
            i = i + 1
        } else {
            $(target)[i] = $(source)[i]
            i = i + 1
        }
    }
    return
}

func naive_vminq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        if ($(target)[i] < $(source)[i]) {
            i = i + 1
        } else {
            $(target)[i] = $(source)[i]
            i = i + 1
        }
    }
    return
}

func naive_vaddq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] + $(source)[i]
        i = i + 1
    }
    return
}

func naive_vsubq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = $(target)[i] - $(source)[i]
        i = i + 1
    }
    return
}

func naive_vrhaddq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 sum = cast<uint32>($(target)[i]) + cast<uint32>($(source)[i]) + 1
        $(target)[i] = unsafe_cast<byte>(sum >> 1)
        i = i + 1
    }
    return
}

func naive_vbslq_u8(mview<[byte]> target, view<[byte]> source, view<[byte]> mask, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = ($(target)[i] & $(mask)[i]) | ($(source)[i] & (~($(mask)[i])))
        i = i + 1
    }
    return
}

func naive_vextq_u8(mview<[byte]> target, view<[byte]> source, uint32 count, uint32 shift) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 base = i - (i % 16)
        uint32 offset = (i % 16) + shift
        if (offset < 16) {
            $(target)[i] = $(target)[base + offset]
        } else {
            $(target)[i] = $(source)[base + offset - 16]
        }
        i = i + 1
    }
    return
}

func naive_vzip1q_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] block
        uint32 j = 0
        while (j < 16) {
            block[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            if ((j % 2) == 0) {
                $(target)[base + j] = block[j / 2]
            } else {
                $(target)[base + j] = $(source)[base + (j / 2)]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func naive_vzip2q_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] block
        uint32 j = 0
        while (j < 16) {
            block[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            if ((j % 2) == 0) {
                $(target)[base + j] = block[8 + (j / 2)]
            } else {
                $(target)[base + j] = $(source)[base + 8 + (j / 2)]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func naive_vqmovun_s16(mview<[byte]> target, view<[int16]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        int32 value = cast<int32>($(source)[i])
        if (value < 0) {
            $(target)[i] = 0
        } else if (value > 255) {
            $(target)[i] = 255
        } else {
            $(target)[i] = unsafe_cast<byte>(value)
        }
        i = i + 1
    }
    return
}

func naive_vabdq_u8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        if (a > b) {
            $(target)[i] = a - b
        } else {
            $(target)[i] = b - a
        }
        i = i + 1
    }
    return
}

func naive_vpaddlq_u16(mview<[uint32]> target, view<[uint16]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(target)[i] = cast<uint32>($(source)[2 * i]) + cast<uint32>($(source)[2 * i + 1])
        i = i + 1
    }
    return
}

func naive_vabsq_s8(mview<[int8]> target, view<[int8]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        int8 value = $(source)[i]
        if (value < 0) {
            $(target)[i] = 0 - value
        } else {
            $(target)[i] = value
        }
        i = i + 1
    }
    return
}

func naive_vqtbl1q_u8(mview<[byte]> target, view<[byte]> indices, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] table
        uint32 j = 0
        while (j < 16) {
            table[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            byte index = $(indices)[base + j]
            if (index < 16) {
                $(target)[base + j] = table[cast<uint32>(index)]
            } else {
                $(target)[base + j] = 0
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

// Benchmarks.
func bench_veorq_u8_64(uint32 reps) -> (int64, int64, int64, int64) {
    [byte, 64] master
    [byte, 64] master_source
    [byte, 64] target
    [byte, 64] source
    uint32 i = 0
    while (i < 64) {
        master[i] = unsafe_cast<byte>((i * 13 + 7) & 255)
        target[i] = master[i]
        source[i] = unsafe_cast<byte>((i * 29 + 11) & 255)
        master_source[i] = source[i]
        i = i + 1
    }
    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    int64 simd_checksum = 0
    int64 start = std::mono_time()
    uint32 r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        simd::arm::veorq_u8(mview(target), view(source), 0, 0, 64)
        simd_checksum = simd_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 simd_ns = std::mono_time() - start

    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    int64 naive_checksum = 0
    start = std::mono_time()
    r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        naive_veorq_u8(mview(target), view(source), 64)
        naive_checksum = naive_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 naive_ns = std::mono_time() - start

    return (int64, int64, int64, int64) { simd_ns, naive_ns, simd_checksum, naive_checksum }
}

func main() -> int32 {
    uint32 reps64 = 4000000
    uint32 reps512 = 2000000
    uint32 reps4096 = 1000000
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) veorq_u8_64_r = bench_veorq_u8_64(reps64)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) veorq_u8_512_r = bench_veorq_u8_512(reps512)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) veorq_u8_4096_r = bench_veorq_u8_4096(reps4096)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vandq_u8_64_r = bench_vandq_u8_64(reps64)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vandq_u8_512_r = bench_vandq_u8_512(reps512)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vandq_u8_4096_r = bench_vandq_u8_4096(reps4096)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vorrq_u8_64_r = bench_vorrq_u8_64(reps64)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vorrq_u8_512_r = bench_vorrq_u8_512(reps512)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vorrq_u8_4096_r = bench_vorrq_u8_4096(reps4096)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vbicq_u8_64_r = bench_vbicq_u8_64(reps64)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vbicq_u8_512_r = bench_vbicq_u8_512(reps512)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vbicq_u8_4096_r = bench_vbicq_u8_4096(reps4096)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vqaddq_u8_64_r = bench_vqaddq_u8_64(reps64)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vqaddq_u8_512_r = bench_vqaddq_u8_512(reps512)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vqaddq_u8_4096_r = bench_vqaddq_u8_4096(reps4096)
    (int64 simd_ns, int64 naive_ns, int64 simd_checksum, int64 naive_checksum) vqsubq_u8_64_r = bench_vqsubq_u8_64(reps64)

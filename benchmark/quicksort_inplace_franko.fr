// In-place Franko quicksort benchmark using franko/algorithm.

import "franko/stdio"
import "franko/time"
import "franko/algorithm"

func parse_uint(view<[byte]> text) -> uint32 {
    if (text == null) {
        return 0
    }
    uint32 value = 0
    uint32 i = 0
    while (i < $(text).length()) {
        uint32 digit = cast<uint32>($(text)[i])
        if (digit >= 48 && digit <= 57) {
            value = value * 10 + (digit - 48)
        }
        i = i + 1
    }
    return value
}

func main(view<[[byte]]> args) -> int32 {
    uint32 dataset = 0
    if ($(args).length() >= 2) {
        view<[byte]> mode_arg = getview($(args)[1])
        if ($(mode_arg).length() >= 1) {
            byte mode_byte = $(mode_arg)[0]
            if (mode_byte == 53) {
                dataset = 5
            } else if (mode_byte == 52) {
                dataset = 4
            } else if (mode_byte == 51) {
                dataset = 3
            } else if (mode_byte == 50) {
                dataset = 2
            } else if (mode_byte == 49) {
                dataset = 1
            }
        }
    }

    uint32 count = 10000000
    if ($(args).length() >= 3) {
        uint32 parsed_count = parse_uint(getview($(args)[2]))
        if (parsed_count > 0) {
            count = parsed_count
        }
    }
    uint32 repeat = 1
    if ($(args).length() >= 4) {
        uint32 parsed_repeat = parse_uint(getview($(args)[3]))
        if (parsed_repeat > 0) {
            repeat = parsed_repeat
        }
    }

    uint32 pct_mod = 1
    if (dataset == 1) {
        pct_mod = count / 10
    } else if (dataset == 2) {
        pct_mod = count / 100
    } else if (dataset == 4) {
        pct_mod = count / 200
    } else if (dataset == 5) {
        pct_mod = count / 400
    }
    if (pct_mod == 0) {
        pct_mod = 1
    }

    [int64] values
    values.init(count)
    if (values.length() != count) {
        stdout("allocation failed")
        values.uninit()
        return 1
    }

    byte sorted_ok = 1
    uint64 total_checksum = 0
    uint32 rep = 0
    int64 sort_total_ns = 0
    while (rep < repeat) {
        uint64 state = 0x9E3779B97F4A7C15
        for (uint32 i = 0; i < count; i++) {
            state = state + 0x9E3779B97F4A7C15
            uint64 z = state
            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
            z = (z ^ (z >> 27)) * 0x94D049BB133111EB
            z = z ^ (z >> 31)
            if (dataset == 3) {
                values[i] = unsafe_cast<int64>(z % 10)
            } else if (dataset == 1 || dataset == 2 ||
                       dataset == 4 || dataset == 5) {
                values[i] = unsafe_cast<int64>(z % cast<uint64>(pct_mod))
            } else {
                values[i] = unsafe_cast<int64>(z & 0x7FFFFFFFFFFFFFFF)
            }
        }

        int64 sort_start_ns = std::mono_time()
        std::quicksort<int64>(getmview(values), 0, count)
        sort_total_ns = sort_total_ns + (std::mono_time() - sort_start_ns)

        uint64 checksum = 0
        for (uint32 i = 0; i < count; i++) {
            if (i != 0 && values[i] < values[i - 1]) {
                sorted_ok = 0
            }
            checksum = checksum + unsafe_cast<uint64>(values[i])
        }
        total_checksum = total_checksum + checksum
        rep = rep + 1
    }

    int64 elapsed_ns = sort_total_ns

    stdout("sorted ", end = null)
    if (sorted_ok != 0) {
        stdout("ok")
    } else {
        stdout("FAILED")
    }
    stdout("checksum ", end = null)
    stdout(total_checksum)
    stdout("elapsed_ns ", end = null)
    stdout(elapsed_ns)

    values.uninit()
    return 0
}

func bench_blendv_epi8_64(uint32 reps) -> (int64, int64, int64, int64) {
    [byte, 64] master
    [byte, 64] master_source
    [byte, 64] target
    [byte, 64] source
    [byte, 64] master_mask
    [byte, 64] mask
    uint32 i = 0
    while (i < 64) {
        master[i] = unsafe_cast<byte>((i * 13 + 7) & 255)
        target[i] = master[i]
        source[i] = unsafe_cast<byte>((i * 29 + 11) & 255)
        master_source[i] = source[i]
        if (i == 15) {
            mask[i] = 0x0F
        } else if ((i % 2) == 0) {
            mask[i] = 0xFF
        } else {
            mask[i] = 0x00
        }
        master_mask[i] = mask[i]
        i = i + 1
    }
    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    copy_bytes(mview(mask), view(master_mask), 64)
    int64 simd_checksum = 0
    int64 start = std::mono_time()
    uint32 r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        simd::x86::blendv_epi8(mview(target), view(source), view(mask), 0, 0, 0, 64)
        simd_checksum = simd_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 simd_ns = std::mono_time() - start

    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    copy_bytes(mview(mask), view(master_mask), 64)
    int64 naive_checksum = 0
    start = std::mono_time()
    r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        naive_blendv_epi8(mview(target), view(source), view(mask), 64)
        naive_checksum = naive_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 naive_ns = std::mono_time() - start

    return (int64, int64, int64, int64) { simd_ns, naive_ns, simd_checksum, naive_checksum }
}


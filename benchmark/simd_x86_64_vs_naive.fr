import "franko/stdio"
import "franko/time"
import "franko/simd"

// x86_64 SIMD vs naive Franko.
//
// Each case calls the module function and the scalar reference on buffers
// of 64, 512, or 4096 bytes (4,000,000 / 2,000,000 / 1,000,000 calls).
// One input byte rotates per iteration and a rotating target byte is
// checksummed so the optimizer cannot remove the work. Build with -Omax
// and run on an x86_64 host.
//
// The naive functions are straightforward scalar Franko: single loads
// hoisted into locals, canonical branches, no SIMD. They are deliberately
// allowed to auto-vectorize; that is part of the measurement.
//
// Naive semantics match the bridge implementation (Intel intrinsic
// semantics), including `andnot_si256` computing `~target & source` and
// `shuffle_epi8` using the low four index bits when bit 7 is clear.

// Copy helpers.
func copy_bytes(mview<[byte]> dst, view<[byte]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_i8(mview<[int8]> dst, view<[int8]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func copy_i16(mview<[int16]> dst, view<[int16]> src, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        $(dst)[i] = $(src)[i]
        i = i + 1
    }
    return
}

func naive_xor_si256(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = a ^ b
        i = i + 1
    }
    return
}

func naive_and_si256(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = a & b
        i = i + 1
    }
    return
}

func naive_or_si256(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = a | b
        i = i + 1
    }
    return
}

func naive_andnot_si256(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = (~a) & b
        i = i + 1
    }
    return
}

func naive_adds_epu8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 sum = cast<uint32>($(target)[i]) + cast<uint32>($(source)[i])
        if (sum > 255) {
            $(target)[i] = 255
        } else {
            $(target)[i] = unsafe_cast<byte>(sum)
        }
        i = i + 1
    }
    return
}

func naive_subs_epu8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        if (a > b) {
            $(target)[i] = a - b
        } else {
            $(target)[i] = 0
        }
        i = i + 1
    }
    return
}

func naive_max_epu8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        if (a < b) {
            $(target)[i] = b
        }
        i = i + 1
    }
    return
}

func naive_min_epu8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        if (a > b) {
            $(target)[i] = b
        }
        i = i + 1
    }
    return
}

func naive_add_epi8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = a + b
        i = i + 1
    }
    return
}

func naive_sub_epi8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        byte a = $(target)[i]
        byte b = $(source)[i]
        $(target)[i] = a - b
        i = i + 1
    }
    return
}

func naive_avg_epu8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 sum = cast<uint32>($(target)[i]) + cast<uint32>($(source)[i]) + 1
        $(target)[i] = unsafe_cast<byte>(sum >> 1)
        i = i + 1
    }
    return
}

func naive_blendv_epi8(mview<[byte]> target, view<[byte]> source, view<[byte]> mask, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        uint32 m = cast<uint32>($(mask)[i])
        if ((m & 128) != 0) {
            $(target)[i] = $(source)[i]
        }
        i = i + 1
    }
    return
}

func naive_alignr_epi8(mview<[byte]> target, view<[byte]> source, uint32 count, uint32 shift) -> void {
    if (shift >= 16) {
        uint32 z = 0
        while (z < count) {
            $(target)[z] = 0
            z = z + 1
        }
        return
    }
    uint32 base = 0
    while (base < count) {
        [byte, 16] block
        uint32 j = 0
        while (j < 16) {
            block[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            uint32 offset = j + shift
            if (offset < 16) {
                $(target)[base + j] = $(source)[base + offset]
            } else {
                $(target)[base + j] = block[offset - 16]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func naive_unpacklo_epi8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] block
        uint32 j = 0
        while (j < 16) {
            block[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            if ((j % 2) == 0) {
                $(target)[base + j] = block[j / 2]
            } else {
                $(target)[base + j] = $(source)[base + (j / 2)]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func naive_unpackhi_epi8(mview<[byte]> target, view<[byte]> source, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] block
        uint32 j = 0
        while (j < 16) {
            block[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            if ((j % 2) == 0) {
                $(target)[base + j] = block[8 + (j / 2)]
            } else {
                $(target)[base + j] = $(source)[base + 8 + (j / 2)]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func naive_packus_epi16(mview<[byte]> target, view<[int16]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        int32 value = cast<int32>($(source)[i])
        if (value < 0) {
            $(target)[i] = 0
        } else if (value > 255) {
            $(target)[i] = 255
        } else {
            $(target)[i] = unsafe_cast<byte>(value)
        }
        i = i + 1
    }
    return
}

func naive_sad_epu8(view<[byte]> left, view<[byte]> right, uint32 count) -> uint64 {
    uint64 total = 0
    uint32 i = 0
    while (i < count) {
        byte a = $(left)[i]
        byte b = $(right)[i]
        if (a > b) {
            total = total + cast<uint64>(a - b)
        } else {
            total = total + cast<uint64>(b - a)
        }
        i = i + 1
    }
    return total
}

func naive_abs_epi8(mview<[int8]> target, view<[int8]> source, uint32 count) -> void {
    uint32 i = 0
    while (i < count) {
        int8 value = $(source)[i]
        if (value < 0) {
            $(target)[i] = 0 - value
        } else {
            $(target)[i] = value
        }
        i = i + 1
    }
    return
}

func naive_shuffle_epi8(mview<[byte]> target, view<[byte]> indices, uint32 count) -> void {
    uint32 base = 0
    while (base < count) {
        [byte, 16] table
        uint32 j = 0
        while (j < 16) {
            table[j] = $(target)[base + j]
            j = j + 1
        }
        j = 0
        while (j < 16) {
            uint32 ctrl = cast<uint32>($(indices)[base + j])
            if ((ctrl & 128) != 0) {
                $(target)[base + j] = 0
            } else {
                $(target)[base + j] = table[ctrl & 15]
            }
            j = j + 1
        }
        base = base + 16
    }
    return
}

func bench_xor_si256_64(uint32 reps) -> (int64, int64, int64, int64) {
    [byte, 64] master
    [byte, 64] master_source
    [byte, 64] target
    [byte, 64] source
    uint32 i = 0
    while (i < 64) {
        master[i] = unsafe_cast<byte>((i * 13 + 7) & 255)
        target[i] = master[i]
        source[i] = unsafe_cast<byte>((i * 29 + 11) & 255)
        master_source[i] = source[i]
        i = i + 1
    }
    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    int64 simd_checksum = 0
    int64 start = std::mono_time()
    uint32 r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        simd::x86::xor_si256(mview(target), view(source), 0, 0, 64)
        simd_checksum = simd_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 simd_ns = std::mono_time() - start

    copy_bytes(mview(target), view(master), 64)
    copy_bytes(mview(source), view(master_source), 64)
    int64 naive_checksum = 0
    start = std::mono_time()
    r = 0
    while (r < reps) {
        source[r & 63] = unsafe_cast<byte>(r)
        naive_xor_si256(mview(target), view(source), 64)
        naive_checksum = naive_checksum + cast<int64>(target[r & 63])
        r = r + 1
    }
    int64 naive_ns = std::mono_time() - start

    return (int64, int64, int64, int64) { simd_ns, naive_ns, simd_checksum, naive_checksum }
}


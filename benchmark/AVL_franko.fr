// AVL tree benchmark: insert 2M int32 keys, then delete all 2M keys.
// Key pattern: -999999, 1000000, -999998, 999999, ... (all 2M keys in
// [-999999, 1000000] exactly once). Nodes live in a heap dynamic array;
// slot indices come from std::NextAllocator. Timed externally by
// benchmark.py; stdout is a small deterministic summary used to check
// that every build mode computes the same result.

import "franko/pool"
import "franko/io"

uint32 SIZE = 2000000

struct Node {
    int32 key = 0
    int32 height = 1
    uint32 left = 0xFFFFFFFF
    uint32 right = 0xFFFFFFFF
}

[Node] nodes
std::NextAllocator pool
uint32 NIL = 0xFFFFFFFF
uint32 root = 0xFFFFFFFF

func keyAt(int32 i) -> int32 {
    if (i % 2 == 0) {
        return -999999 + i / 2
    }
    return 1000000 - i / 2
}

func heightAt(uint32 n) -> int32 {
    if (n == NIL) {
        return 0
    }
    return nodes[n].height
}

func updateHeight(uint32 x) -> void {
    int32 lh = heightAt(nodes[x].left)
    int32 rh = heightAt(nodes[x].right)
    int32 h = lh
    if (rh > h) {
        h = rh
    }
    nodes[x].height = h + 1
    return
}

func rotateLeft(uint32 x) -> uint32 {
    uint32 y = nodes[x].right
    nodes[x].right = nodes[y].left
    nodes[y].left = x
    updateHeight(x)
    updateHeight(y)
    return y
}

func rotateRight(uint32 x) -> uint32 {
    uint32 y = nodes[x].left
    nodes[x].left = nodes[y].right
    nodes[y].right = x
    updateHeight(x)
    updateHeight(y)
    return y
}

func rebalance(uint32 n) -> uint32 {
    int32 lh = heightAt(nodes[n].left)
    int32 rh = heightAt(nodes[n].right)
    int32 diff = lh - rh
    if (diff > 1) {
        uint32 l = nodes[n].left
        if (heightAt(nodes[l].left) < heightAt(nodes[l].right)) {
            nodes[n].left = rotateLeft(l)
        }
        return rotateRight(n)
    }
    if (diff < -1) {
        uint32 r = nodes[n].right
        if (heightAt(nodes[r].right) < heightAt(nodes[r].left)) {
            nodes[n].right = rotateRight(r)
        }
        return rotateLeft(n)
    }
    updateHeight(n)
    return n
}

func avlInsert(uint32 n, int32 key) -> uint32 {
    if (n == NIL) {
        uint32 z = pool.new_index()
        nodes[z].key = key
        nodes[z].height = 1
        nodes[z].left = NIL
        nodes[z].right = NIL
        return z
    }
    if (key < nodes[n].key) {
        nodes[n].left = avlInsert(nodes[n].left, key)
    } else {
        nodes[n].right = avlInsert(nodes[n].right, key)
    }
    return rebalance(n)
}

func minNode(uint32 n) -> uint32 {
    while (nodes[n].left != NIL) {
        n = nodes[n].left
    }
    return n
}

func avlDelete(uint32 n, int32 key) -> uint32 {
    if (n == NIL) {
        return NIL
    }
    if (key < nodes[n].key) {
        nodes[n].left = avlDelete(nodes[n].left, key)
    } else {
        if (key > nodes[n].key) {
            nodes[n].right = avlDelete(nodes[n].right, key)
        } else {
            if (nodes[n].left == NIL) {
                uint32 r = nodes[n].right
                pool.free_index(n)
                return r
            }
            if (nodes[n].right == NIL) {
                uint32 l = nodes[n].left
                pool.free_index(n)
                return l
            }
            uint32 s = minNode(nodes[n].right)
            int32 k = nodes[s].key
            nodes[n].key = k
            nodes[n].right = avlDelete(nodes[n].right, k)
        }
    }
    return rebalance(n)
}

func main() -> int32 {
    nodes.init(SIZE)
    pool.init(SIZE)

    for (uint32 i = 0; i < SIZE; i = i + 1) {
        root = avlInsert(root, keyAt(unsafe_cast<int32>(i)))
    }
    print("height="); print(heightAt(root))

    for (uint32 i = 0; i < SIZE; i = i + 1) {
        root = avlDelete(root, keyAt(unsafe_cast<int32>(i)))
    }

    print("empty=")
    if (root == NIL) {
        print(1)
    } else {
        print(0)
    }
    print("used="); print(pool.used())

    nodes.uninit()
    pool.uninit()
    return 0
}
